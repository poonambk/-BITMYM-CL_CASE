  ENDMETHOD.


  METHOD ui5_single_items_atp_int.
    DATA: lt_singleitems   TYPE /sopromet/ritems_tab.

    LOOP AT is_data_ui5-reservationtosingleitems ASSIGNING FIELD-SYMBOL(<ls_singleitems>).
      APPEND INITIAL LINE TO lt_singleitems ASSIGNING FIELD-SYMBOL(<ls_singleitem_input>).
      MOVE-CORRESPONDING <ls_singleitems> TO <ls_singleitem_input>.
      IF <ls_singleitem_input>-menge IS INITIAL.
        <ls_singleitem_input>-menge = 1.
      ENDIF.
      IF <ls_singleitem_input>-meins IS INITIAL.
        DATA(l_o_mat) = /sopromet/cl_l_material=>get_ref( <ls_singleitems>-matnr ).
        DATA(l_mara)  = l_o_mat->get_mara( ).
        DATA(l_mvke) = l_o_mat->get_mvke( iv_vkorg = gs_comwa-vkorg iv_vtweg = gs_comwa-vtweg iv_spart = gs_comwa-spart ).
        <ls_singleitem_input>-meins = l_mara-meins.
        IF l_mvke-vrkme IS NOT INITIAL.
          <ls_singleitem_input>-meins = l_mvke-vrkme.
        ENDIF.
      ENDIF.

    ENDLOOP.

    ui5_single_items_atp_check( EXPORTING io_case = me
                                          io_appl = go_appl
                                          id_consistency_check = abap_true
                                CHANGING ct_single_items = lt_singleitems ).

    DATA(ls_entity) = is_data_ui5.
    CLEAR ls_entity-reservationtosingleitems[].
    LOOP AT lt_singleitems INTO DATA(ls_single_item).
      APPEND INITIAL LINE TO ls_entity-reservationtosingleitems ASSIGNING FIELD-SYMBOL(<ls_res_single_item>).
      MOVE-CORRESPONDING ls_single_item TO <ls_res_single_item>.
    ENDLOOP.

    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_entity
                                                     CHANGING cr_data = es_data ).
  ENDMETHOD.


  METHOD check_before_save_customer.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR2-689, User: SCOSAR, Date: 25.07.2024___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332

    DATA: lo_partner TYPE REF TO /bitmym/cl_partner,
          ld_schema  TYPE pargr,
          lt_vbpa    TYPE /sopromet/vbpav_tab,
          lr_parvw   TYPE RANGE OF tpar-parvw.

    rd_return = abap_true.

*____SR2-689____BEGIN INSERT___*
    rd_return = check_before_save_customer_mbl( ).
    CHECK rd_return EQ abap_true.

    "check if shipto partner is defined in partner list of soldto
    rd_return = go_partner->check_partner_in_list( /bitmym/cl_partner=>c_parvw_we ).
    CHECK rd_return EQ abap_true.

    "check if shipto partner is defined in partner list of soldto
    rd_return = go_partner->check_partner_in_list( /bitmym/cl_partner=>c_parvw_sb ).
    CHECK rd_return EQ abap_true.

*____SR2-689____END   INSERT___*

    get_property go_partner 'GD_SCHEMA' ld_schema.
    get_property go_partner 'GT_VBPA' lt_vbpa.

*   Sold-to validation
    rd_return = go_partner->check_customer_exists( gs_comwa-kunnr ).
    CHECK rd_return EQ abap_true.

*   Ship-to validation
    IF gs_comwa-kunwe IS NOT INITIAL.
      rd_return = go_partner->check_customer_exists( gs_comwa-kunwe ).
    ENDIF.
    CHECK rd_return EQ abap_true.

*   Partner List validation (in partner schema)
    SELECT tpaer~pargr, tpaer~parvw, tpaer~papfl FROM tpaer INNER JOIN tpar ON tpar~parvw EQ tpaer~parvw INTO TABLE @DATA(lt_tpaer) WHERE pargr EQ @ld_schema.

    LOOP AT lt_tpaer ASSIGNING FIELD-SYMBOL(<fs_tpaer>).
      rd_return = go_partner->check_partner_exists( <fs_tpaer>-parvw ).
      CHECK rd_return EQ abap_false.
      EXIT.
    ENDLOOP.
    CHECK rd_return EQ abap_true.

*   Partner List validation (not in partner schema)
    lr_parvw[] = CORRESPONDING #( lt_tpaer MAPPING low = parvw ).
    MODIFY lr_parvw FROM VALUE #( sign = 'I' option = 'EQ' ) TRANSPORTING sign option WHERE sign IS INITIAL.

    DELETE lt_vbpa WHERE parvw IN lr_parvw.
    IF lt_vbpa[] IS NOT INITIAL.

      SELECT * FROM tpar INTO TABLE @DATA(lt_tpar) FOR ALL ENTRIES IN @lt_vbpa WHERE parvw EQ @lt_vbpa-parvw.
      LOOP AT lt_tpar ASSIGNING FIELD-SYMBOL(<fs_tpar>).
        rd_return = go_partner->check_partner_exists( <fs_tpaer>-parvw ).
        CHECK rd_return EQ abap_false.
        EXIT.
      ENDLOOP.
      CHECK rd_return EQ abap_true.
    ENDIF.

*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save_customer
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS_CUSTOMER SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  METHOD check_before_save_items.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR2-970, User: SCOSAR, Date: 11.10.2024___*
*___ SR2-871, User: SSINGH, Date: 21.10.2024___*
*___ SR2-1098, User: SCOSAR, Date: 12.11.2024___*
*___ SR2-1184, User: SCOSAR, Date: 16.12.2024___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332
*___ SR2-2530, User: SCOSAR, Date: 25.11.2025___*
*___ SR2-3080, User: SCOSAR, Date: 20.04.2026___*

    DATA: lt_items TYPE /bitmym/b_items_st_tab,      "SR2-871
          l_sernr  TYPE sernr,          "SR2-871
          l_matnr  TYPE matnr.          "SR2-871

    rd_return = abap_true.

*____SR2-3080____BEGIN INSERT___*
    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  ).
    ENDIF.
    go_rstyp->set_data_vkorg( gs_comwa-vkorg ).
    DATA(ls_rstyp_data) = go_rstyp->get_data( ).
*____SR2-3080____END   INSERT___*

*____SR2-970____BEGIN INSERT___*
    IF gs_comwa-xfollowup EQ abap_true.
*____SR2-3080____BEGIN COMMENT___*
*      IF go_rstyp IS INITIAL.
*        go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  ).
*      ENDIF.
*      go_rstyp->set_data_vkorg( gs_comwa-vkorg ).
*      IF go_rstyp->get_data( )-gs_rstypo-flw_up_bookings_items EQ abap_false.
*____SR2-3080____END   COMMENT___*
      IF ls_rstyp_data-gs_rstypo-flw_up_bookings_items EQ abap_false. "SR2-3080
        IF go_act_reservation IS NOT INITIAL.
          go_act_reservation->get_property( EXPORTING i_feld = 'GT_BOOKING_ITEMS' IMPORTING e_value = lt_items ).

          IF lt_items[] IS NOT INITIAL.
            rd_return = abap_false.
            /bitmym/cl_message=>message( id = 'E539(/SOPROMET/ZL)' ).
            MESSAGE e539(/sopromet/zl) INTO DATA(ld_msg).
          ENDIF.

        ENDIF.
      ENDIF.
    ENDIF.
*____SR2-970____END   INSERT___*
*____SR2-871____BEGIN INSERT___*
    IF go_act_reservation IS NOT INITIAL.
      go_act_reservation->get_property( EXPORTING i_feld = 'GT_BOOKING_ITEMS' IMPORTING e_value = lt_items ).
      IF lt_items[] IS NOT INITIAL.
        DATA(lt_items_tmp) = lt_items[].
        SORT lt_items_tmp BY matnr sernr.
        LOOP AT lt_items_tmp ASSIGNING FIELD-SYMBOL(<fs>) WHERE sernr IS NOT INITIAL.
          IF l_sernr = <fs>-sernr AND l_matnr = <fs>-matnr.
            rd_return = abap_false.
            /bitmym/cl_message=>message( id = 'E030(/BITMYM/S4)' v1 = <fs>-sernr ).
          ENDIF.
          l_sernr = <fs>-sernr.
          l_matnr = <fs>-matnr.
        ENDLOOP.

*____SR2-1098____BEGIN INSERT___*

        SELECT material
          FROM /bitmym/i_material_plant AS t1
         INNER JOIN /bitmym/i_globalsetting AS t2 ON t2~serialnumberprofile EQ t1~serialnumberprofile
         INNER JOIN /bitmym/i_plant_assign AS t4 ON t4~plant EQ t1~plant "SR2-2530
         INNER JOIN @lt_items AS t3 ON t3~matnr EQ t1~material
         WHERE t4~salesorg            EQ @gs_comwa-vkorg    "SR2-2530
           AND t4~distributionchannel EQ @gs_comwa-vtweg    "SR2-2530
           AND t4~division            EQ @gs_comwa-spart    "SR2-2530
          INTO TABLE @DATA(lt_set).

        SELECT material
          FROM /bitmym/i_material_plant AS t1
         INNER JOIN /bitmym/i_globalsetting AS t2 ON t2~serialnumberprofile NE t1~serialnumberprofile
         INNER JOIN /bitmym/i_plant_assign AS t4 ON t4~plant EQ t1~plant "SR2-2530
         INNER JOIN @lt_items AS t3 ON t3~matnr EQ t1~material
         WHERE t4~salesorg            EQ @gs_comwa-vkorg    "SR2-2530
           AND t4~distributionchannel EQ @gs_comwa-vtweg    "SR2-2530
           AND t4~division            EQ @gs_comwa-spart    "SR2-2530
          INTO TABLE @DATA(lt_si).

        LOOP AT lt_items ASSIGNING <fs> WHERE sernr IS NOT INITIAL
                                          AND updated EQ abap_false
                                          AND abgru IS INITIAL
                                          AND menge NE 1.
          rd_return = abap_false.
          /bitmym/cl_message=>message( id = 'E031(/BITMYM/S4)' v1 = <fs>-sernr ).
          MESSAGE e031(/bitmym/s4) INTO ld_msg. "for where used
        ENDLOOP.
*____SR2-1098____END   INSERT___*

*____SR2-1184____BEGIN INSERT___*
        LOOP AT lt_items ASSIGNING <fs>.
          IF /sopromet/cl_l_material=>check_matnr_sales_ext( EXPORTING i_matnr = <fs>-matnr io_main = go_appl ) EQ abap_false.
            rd_return = abap_false.
            /bitmym/cl_message=>message( id = 'E542(/SOPROMET/ZL)' v1 = <fs>-matnr v2 = gs_comwa-vkorg v3 = gs_comwa-vtweg ).
            MESSAGE e542(/sopromet/zl) INTO ld_msg. "for where used
          ELSEIF line_exists( lt_set[ material = <fs>-matnr ] ) AND
                 line_exists( lt_si[ material = <fs>-matnr ] ).
            rd_return = abap_false.
            /bitmym/cl_message=>message( id = 'E033(/BITMYM/S4)' v1 = <fs>-matnr ).
            MESSAGE e033(/bitmym/s4) INTO ld_msg. "for where used
          ENDIF.
        ENDLOOP.
*____SR2-1184____END   INSERT___*

      ENDIF.
    ENDIF.
*____SR2-871____END   INSERT___*

*____SR2-3080____BEGIN INSERT___*
    IF ls_rstyp_data-gs_rstypo-mhdvariant_li IS NOT INITIAL.
      SELECT DISTINCT t1~material, t1~materialname, t1~qablock, t1~\_qablock-qablocktext
        FROM /bitmym/i_mhdsingleitemcheck( activitytype = '', bookingtype = @gs_comwa-rstyp ) AS t1
       INNER JOIN @lt_items AS t2 ON t2~matnr EQ t1~material
       WHERE t1~qablock IS NOT INITIAL
        INTO TABLE @DATA(lt_mhdcheck).

      LOOP AT lt_mhdcheck INTO DATA(ls_mhdcheck).
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E062(/BITMYM/S4)' v1 = ls_mhdcheck-materialname v2 = ls_mhdcheck-material v3 = ls_mhdcheck-qablocktext ).
        MESSAGE e062(/bitmym/s4) INTO ld_msg. "for where used
      ENDLOOP.
    ENDIF.
*____SR2-3080____END   INSERT___*


*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save_items
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS_ITEMS SPOTS /BITMYM/CL_CASE .
  ENDMETHOD.


  METHOD clear_serial_no_buffer.
*____HS# 017121, VON: BGUNAWAN, DATUM: 16.12.2022___*

    CALL FUNCTION 'SERIAL_INTTAB_REFRESH'.
  ENDMETHOD.


  method GET_DETAIL_BOOKING_TEMPLATE.
*____HS# 015183, VON: SSINGH, DATUM: 27.09.2021___*
    DATA : ls_template TYPE /bitmym/ui5_tmpl.
    io_ui5->ui5_keytab2struct( CHANGING cs_struct = ls_template  ).
