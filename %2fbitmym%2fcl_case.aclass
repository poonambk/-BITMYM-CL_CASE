    copy_booking_text( ).

  ENDMETHOD.


METHOD REFERENCE_DOC_CALC_DATES.
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 16.09.2015____*
  data ld_error TYPE abap_bool.

  ed_success = ABAP_true.

  IF gs_comwa-vbelv IS NOT INITIAL.
    reference_order_calc_dates( EXPORTING ID_WITHOUT_SELECTION = abap_true CHANGING ed_success = ld_error ).
  ENDIF.

  reference_booking_calc_dates( EXPORTING  ID_WITHOUT_SELECTION = abap_true CHANGING ed_success = ld_error ).

  IF ld_error = abap_true.
    ed_success = ABAP_FALSE.
  ENDIF.
ENDMETHOD.


METHOD reference_order_calc_dates.
*____HS# 9775, VON: T.Kern - 09.02.2014
*____HS# 9826, VON: O.Pecharroman Perez, DATUM: - 23.02.2014
*____HS# 11446, VON: O.Pecharroman Perez, DATUM: - 25.10.2016
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 12480, VON: O.Pecharroman, DATUM:  26.04.2017 ___*
*____HS# 012926, VON: OPECHARROMAN, DATUM: 25.01.2019___*
*____HS# 013137, VON: OPECHARROMAN, DATUM: 17.05.2019___*

  DATA: lo_res   TYPE REF TO /sopromet/cl_l_reservation,
        ls_comwa TYPE /sopromet/zzls01,
        ls_com   TYPE /bitmym/case_common_date,             "HS# 013137
        ls_route TYPE /bitmym/routes_calculated_tab.        "HS# 9826

  gs_comwa-odate = gs_vbak-vdatu.
  gs_comwa-vsbeb = gs_vbak-vsbed.
  gs_comwa-vedat = gs_vbak-vdatu.                           "HS# 11446

* Init " HS 12480
  go_partner = /bitmym/cl_partner=>create( io_case = me ).
  partner_get_data( ).                                      "#HS 12926
  go_partner->set_ref_partner_comwa( CHANGING c_comwa = gs_comwa ).
*  partner_selection( id_no_dialog = abap_true id_suppress_mess = abap_true ). "#HS 12926
*  partner_put_data( ). "#HS 12926
*  partner_get_data( ). "#HS 12926.
* End HS# 12480

ENHANCEMENT-POINT reference_order_calc_dates SPOTS /bitmym/case .
  IF id_without_selection IS INITIAL AND                    "HS# 10154
     gs_comwa-vedat LT sy-datlo.                            "HS# 10154
    MESSAGE i322(/sopromet/zl) WITH gs_comwa-vedat          "HS# 10154
     INTO gd_dummy_message.                                 "HS# 11637
    call_message.                                           "HS# 11637
    ed_success = abap_true.                                 "HS# 10154
  ENDIF.                                                    "HS# 10154

  go_appl->set_property( i_feld = 'GS_COMWA'  i_value = gs_comwa ).

  CREATE OBJECT lo_res
    EXPORTING
      i_no_status_read = 'X'
      id_no_equi_read  = abap_true.

  CHECK lo_res IS BOUND.

  lo_res->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).
  lo_res->set_property( i_feld = 'GT_ROUTE' i_value = ls_route ). "HS# 9826
  ls_comwa = lo_res->day_compute_days_70( ).
  lo_res->get_property( EXPORTING i_feld = 'GT_ROUTE' IMPORTING e_value = ls_route ). "HS# 9826

* Start HS# 013137  Comment -->
* Field vedat is now also recalculated, it has to be return back. Use structure instead of field by field
*  gs_comwa-vdate = ls_comwa-vdate.
*  gs_comwa-abdat = ls_comwa-abdat.
*  gs_comwa-rdate = ls_comwa-rdate.
*  gs_comwa-frdat = ls_comwa-frdat.
* End HS# 013137  Comment -->
  MOVE-CORRESPONDING ls_comwa TO ls_com.                    "HS# 013137
  MOVE-CORRESPONDING ls_com   TO gs_comwa.                  "HS# 013137

ENHANCEMENT-POINT reference_order_calc_dates_02 SPOTS /bitmym/case .

  go_appl->set_property( i_feld = 'GS_COMWA'  i_value = gs_comwa ).

ENDMETHOD.


METHOD reference_order_copy_data.
*> HS#9774: T.Kern - 09.02.14
*____HS# 10113, VON: S.Taori, DATUM: 11.09.2014 ___*
*____HS# 12303, VON: Opecharroman,  DATUM: 01.02.2018____*

