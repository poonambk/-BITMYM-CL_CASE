METHOD set_icon_avail.

  DATA: l_icon_on      TYPE char1,
        l_icon         TYPE char30,
        ls_res         TYPE /sopromet/zzlrv,
        l_store_loc_on TYPE char1.

  FIELD-SYMBOLS:  <item> TYPE /sopromet/ritems_wa.

  go_act_reservation->get_reservation_data( IMPORTING e_reservation = ls_res ).

  LOOP AT ct_single_items ASSIGNING <item> WHERE NOT menge IS INITIAL.

    CLEAR: l_icon.

    IF ls_res-vbeln IS NOT INITIAL.

      l_icon = /sopromet/cl_l_reservation=>c_icon_delivered.

    ELSE.

*> Spalte Icon Verfügbarkeit
      IF <item>-kbmeng IS NOT INITIAL.

        l_icon    = /sopromet/cl_l_reservation=>c_icon_green.

      ELSE.

        l_icon = /sopromet/cl_l_reservation=>c_icon_red.

      ENDIF.

    ENDIF.

    CALL FUNCTION 'ICON_CREATE'
      EXPORTING
        name                  = l_icon
        add_stdinf            = space
      IMPORTING
        result                = <item>-icon_avail
      EXCEPTIONS
        icon_not_found        = 1
        outputfield_too_short = 2
        OTHERS                = 3.

  ENDLOOP.

ENDMETHOD.


