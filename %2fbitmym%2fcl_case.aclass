  METHOD ui5_s4h_bookings_get_notes.
*____HS# 015080, VON: OPECHARROMAN, DATUM: 08.04.2021___*

    DATA: lo_texte TYPE REF TO /bitmym/cl_texte,
          ls_comwa TYPE /bitmym/ui5_comwa.

*___Create CASE Object using reservation form UI5 COMWA
    get_property io_ui5 'GS_UI5_COMWA' ls_comwa.

*___Init case object
    DATA(lo_case) = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_case = ls_comwa-lrsam id_reservation = ls_comwa-lresn ).

    IF  ls_comwa-lrsam IS INITIAL AND ls_comwa-lresn IS INITIAL.
*___Init Text object for booking creation
      CREATE OBJECT lo_texte
        EXPORTING
          io_case = lo_case
          io_ui5  = io_ui5.

      set_property lo_case 'GO_TEXTE' lo_texte.
      set_property lo_texte 'GS_COMWA-trtyp_o' /sopromet/cl_l_screen=>c_trtyp_create.
      set_property lo_case 'GS_COMWA-RSTYP' ls_comwa-rstyp.
    ENDIF.

    lo_case->ui5_s4h_bookings_get_notes_int( IMPORTING es_response_context = es_response_context et_entityset = et_entityset ).

  ENDMETHOD.


METHOD ui5_s4h_bookings_get_notes_int.
*____HS# 015080, VON: OPECHARROMAN, DATUM: 08.04.2021___*
*____HS# 017968, VON: SCOSAR, DATUM: 23.03.2023___*
*___ SR1-1105, User: SCOSAR, Date: 25.01.2024___*

  DATA: ls_comwa TYPE /bitmym/ui5_comwa,
        lt_head  TYPE lv70t_ty_xthead_table.

  CHECK go_texte IS BOUND.

*  Get notes from text object
  et_entityset = go_texte->get_notes_from_sd_text( ).
*  DELETE et_entityset[] WHERE note1 IS INITIAL.
  get_property go_texte 'GT_HEAD' lt_head.

*__Get CASE Object to get reservation form UI5 COMWA
  get_property go_ui5 'GS_UI5_COMWA' ls_comwa.

* et_entityset is created from lt_head. So all tdids are in both tables.
* Initialized <fs_head> and in following loops read table will read the corresponding value
  READ TABLE lt_head ASSIGNING FIELD-SYMBOL(<fs_head>) INDEX 1.

  CHECK sy-subrc EQ 0.

*___ Start HS# 017968 SCOSAR
  IF et_entityset[] IS NOT INITIAL.
    DATA(ld_partner_langu) = go_texte->get_partner_lang( ). "SR1-1105
*    SELECT sprsl, sptxt FROM t002t INTO TABLE @DATA(lt_t002t) FOR ALL ENTRIES IN @et_entityset WHERE spras EQ @sy-langu AND sprsl EQ @et_entityset-tdspras . "SR1-1105
    SELECT sprsl, sptxt FROM t002t INTO TABLE @DATA(lt_t002t) FOR ALL ENTRIES IN @et_entityset WHERE spras EQ @/bitmym/if_ui5~gd_language AND ( sprsl EQ @et_entityset-tdspras OR sprsl EQ @ld_partner_langu ). "SR1-1105

  ENDIF.
*___ End HS# 017968 SCOSAR

  LOOP AT et_entityset ASSIGNING FIELD-SYMBOL(<fs_entity>).
*____SR1-1105____BEGIN INSERT___*
    IF <fs_entity>-tdspras IS NOT INITIAL.
      "delete the same tdid where tdspras is initial only when there's another record which has tdspras
      DELETE et_entityset WHERE tdid EQ <fs_entity>-tdid AND tdspras IS INITIAL.
    ENDIF.
*____SR1-1105____END   INSERT___*

    MOVE-CORRESPONDING ls_comwa TO <fs_entity>.

    <fs_entity>-sptxt = VALUE #( lt_t002t[ sprsl = <fs_entity>-tdspras ]-sptxt OPTIONAL ). "HS# 017968

    IF  <fs_head>-tdid NE <fs_entity>-tdid.
      READ TABLE lt_head ASSIGNING <fs_head> WITH KEY tdid = <fs_entity>-tdid.
    ENDIF.


*   Check not actually required as tdid will always be found
    CHECK <fs_head> IS NOT INITIAL.
    <fs_entity>-tdname = <fs_head>-tdtext.

  ENDLOOP.

  MODIFY et_entityset FROM VALUE #( tdspras = ld_partner_langu sptxt = VALUE #( lt_t002t[ sprsl = <fs_entity>-tdspras ]-sptxt OPTIONAL ) ) TRANSPORTING tdspras sptxt WHERE tdspras IS INITIAL. "SR1-1105

ENDMETHOD.


