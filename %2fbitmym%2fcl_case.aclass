METHOD chg_doc_case_display.
*___ SR2-1030, User: OOGUR, Date: 30.10.2024___*

  DATA:ls_range TYPE /bitmym/change_document_log.           "SR2-1030



*____SR2-1030____BEGIN INSERT___*

  CHECK gs_case IS NOT INITIAL.

  ls_range-it_objekt   = VALUE #( ( sign = 'I' opt = 'EQ' low = gc_tabname_case ) ).
  ls_range-it_objektid = VALUE #( ( sign = 'I' opt = 'EQ' low = gs_case-vkorg && gs_case-zzlrsam  ) ).
  ls_range-it_tabname  = VALUE #( ( sign = 'I' opt = 'EQ' low = gc_tabname_case ) ).
  ls_range-it_tabkey   = VALUE #( ( sign = 'I' opt = 'EQ' low = sy-mandt && gs_case-vkorg && gs_case-zzlrsam  ) ).

  CHECK ls_range IS NOT INITIAL.
  /bitmym/cl_changedocument=>create( is_range = ls_range )->start( ).

*____SR2-1030____END   INSERT___*


*____SR2-1030____BEGIN COMMENT___*
*  DATA: ls_seltab TYPE rsparams,
*        lt_seltab TYPE STANDARD TABLE OF rsparams.
*
*  DATA: tabkey    TYPE cdpos-tabkey.
*
*  MOVE 'OBJEKT'       TO ls_seltab-selname.
*  MOVE 'P'            TO ls_seltab-kind.
*  MOVE 'I'            TO ls_seltab-sign.
*  MOVE 'EQ'           TO ls_seltab-option.
*  MOVE '/BITMYM/CASE' TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'OBJEKTID'   TO ls_seltab-selname.
*  CONCATENATE gs_case-vkorg gs_case-zzlrsam INTO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'ZEIT'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'DATUM'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'AENDERER'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'TABNAME'         TO ls_seltab-selname.
*  MOVE '/BITMYM/CASE'    TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'TABKEY'    TO ls_seltab-selname.
*  CONCATENATE sy-mandt gs_case-vkorg gs_case-zzlrsam INTO tabkey.
*  MOVE tabkey      TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
**---> Aufruf Report RSSCD100 für Lesen Änderungsbelege
*  SUBMIT RSSCD100
*                     WITH SELECTION-TABLE lt_seltab
*                     AND RETURN.
*____SR2-1030____END   COMMENT___*





ENDMETHOD.


METHOD chg_doc_res_display.
  CHECK go_act_reservation IS NOT INITIAL.
