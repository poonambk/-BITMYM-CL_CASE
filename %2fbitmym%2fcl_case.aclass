  METHOD ui5_get_messages_int.
*____HS# 017602, VON: SSINGH, DATUM: 13.12.2022___*
    IF /bitmym/if_ui5~gs_paging IS NOT INITIAL.
      SELECT * FROM /bitmym/bookchat
        WHERE (/bitmym/if_ui5~gv_filter_string)
        ORDER BY Credatetime DESCENDING
        INTO TABLE @et_data
        UP TO @/bitmym/if_ui5~gs_paging-top ROWS
        OFFSET @/bitmym/if_ui5~gs_paging-skip.

    ELSE.

      SELECT * FROM /bitmym/bookchat INTO TABLE et_data
        WHERE (/bitmym/if_ui5~gv_filter_string) .
    ENDIF.

  ENDMETHOD.


  method UI5_GET_MESSAGES.
*____HS# 017602, VON: SSINGH, DATUM: 15.12.2022___*
    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_get_messages_int( IMPORTING et_data = et_data ).
  endmethod.


  METHOD fill_booking_serial_no_atp.
*____HS# 017121, VON: BGUNAWAN, DATUM: 12.12.2022___*

    DATA: lt_serial_no  TYPE /bitmym/b_serno_tab,
          lt_matnr_copy TYPE /sopromet/zzls07_tab.

    IF gs_comwa-ref_book IS NOT INITIAL.
      SELECT * FROM /bitmym/b_serno INTO TABLE lt_serial_no
        WHERE lresn = gs_comwa-ref_book.
    ELSE.
      CHECK go_act_reservation IS NOT INITIAL.

      go_act_reservation->get_property(
        EXPORTING
          i_feld  = 'GT_BOOK_SERIALNO'
        IMPORTING
          e_value = lt_serial_no
      ).
    ENDIF.

    CHECK lt_serial_no[] IS NOT INITIAL.

    lt_matnr_copy = ct_matnr.
    CLEAR ct_matnr.

    LOOP AT lt_matnr_copy INTO DATA(ls_matnr).
      READ TABLE lt_serial_no INTO DATA(ls_serial_no) WITH KEY matnr = ls_matnr-matnr.
      IF sy-subrc = 0.
        LOOP AT lt_serial_no INTO ls_serial_no WHERE matnr = ls_matnr-matnr.
          ls_matnr-menge = ls_matnr-menge.
          ls_matnr-sernr = ls_serial_no-sernr.
          APPEND ls_matnr TO ct_matnr.
        ENDLOOP.
      ELSE.
        "no serial number assignment
        APPEND ls_matnr TO ct_matnr.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD ui5_message_create_int.
*____HS# 017602, VON: SSINGH, DATUM: 13.12.2022___*
    DATA : ls_data_ui5 TYPE /bitmym/bookchat,
           lt_bookchat TYPE /bitmym/bookchat_tt.
    DATA : ls_res    TYPE /sopromet/zzlrv,
           l_sent    TYPE abap_bool,
           l_string  TYPE string,
           lo_alert  TYPE REF TO /bitmym/cl_alert,
           l_linkage TYPE /bitmym/alert,
           l_status  TYPE jstat-stat.
    CHECK /bitmym/if_ui5~go_data_provider IS BOUND.

    /bitmym/if_ui5~go_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    APPEND INITIAL LINE TO lt_bookchat ASSIGNING FIELD-SYMBOL(<fs>).
    MOVE-CORRESPONDING ls_data_ui5 TO <fs>.
    <fs>-id      = cl_uuid_factory=>create_system_uuid( )->create_uuid_x16( ).
    CONVERT DATE sy-datum TIME sy-uzeit INTO TIME STAMP <fs>-credatetime TIME ZONE sy-zonlo.
    IF /bitmym/if_ui5~g_mobile_call = 'X'.
      <fs>-intf_cid = /bitmym/if_ui5~gs_callerid-intf_cid.
      <fs>-mobile   = 'X'.
      SELECT SINGLE name1 FROM kna1 INTO <fs>-name1 WHERE kunnr = /bitmym/if_ui5~gs_callerid-kunnr.
    ELSE.
      SELECT SINGLE name_text FROM user_addrp INTO <fs>-name1 WHERE bname = sy-uname.
    ENDIF.

    CALL FUNCTION '/BITMYM/UPDATE_BOOKCHAT' IN UPDATE TASK
      EXPORTING
        it_bookchat = lt_bookchat.
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_data_ui5-lresn
      IMPORTING
        e_reservation = ls_res.
    CALL FUNCTION '/SOPROMET/STATUS_READ'
      EXPORTING
        i_objnr             = ls_res-objnr
        i_no_status_refresh = 'X'
      IMPORTING
        e_stat              = l_status.
    lo_alert = /bitmym/cl_alert=>create( id_objnr = ls_res-objnr id_status = l_status ).
    IF /bitmym/if_ui5~g_mobile_call = 'X'.


      CHECK lo_alert IS BOUND.
      l_string = ls_data_ui5-sdata.
      lo_alert->call_push_noti_flp(
          i_text = l_string
             ).
    ELSE.
      IF lo_alert IS BOUND.
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
          EXPORTING
            input         = ls_data_ui5-lresn
         IMPORTING
           OUTPUT        = ls_data_ui5-lresn
                  .

        CONCATENATE c_booking ls_data_ui5-lresn ':' ls_data_ui5-sdata INTO ls_data_ui5-sdata separated by space.
        set_property lo_alert 'G_JSON' ls_data_ui5-sdata.
        set_property lo_alert 'gs_reservation' ls_res.
        lo_alert->CALL_PUSH_NOTIFICATION_ext( i_caller_id = ls_data_ui5-intf_cid ).
      ENDIF.
    ENDIF.
    es_data = ls_data_ui5.



  ENDMETHOD.


  method UI5_MESSAGE_CREATE.
*____HS# 017602, VON: SSINGH, DATUM: 13.12.2022___*
    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_message_create_int( IMPORTING es_data = es_data ).
  endmethod.


  METHOD check_before_save_reservation.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332

    rd_return = abap_true.

    CHECK gs_comwa-rscat IS INITIAL.

*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save_reservation
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS_RESERVATION SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  METHOD check_before_save_overlap.
*___ SR2-3185, User: PKSHIRSAGAR, Date: 04.05.2026___*

    DATA: lt_items TYPE /bitmym/b_items_st_tab,
          l_sernr  TYPE sernr,
          l_matnr  TYPE matnr.

    rd_return = abap_true.
    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp ).
    ENDIF.
    go_rstyp->set_data_vkorg( gs_comwa-vkorg ).
    DATA(ls_rstyp_data) = go_rstyp->get_data( ).

    IF ls_rstyp_data-gs_rstypo-overlap_check EQ abap_true.
      IF go_act_reservation IS NOT INITIAL.
        go_act_reservation->get_property( EXPORTING i_feld = 'GT_BOOKING_ITEMS' IMPORTING e_value = lt_items ).
      ENDIF.
      CHECK lt_items IS NOT INITIAL.

      DATA(ld_date_from) = COND sy-datum( WHEN gs_comwa-vdate IS NOT INITIAL
                                          THEN gs_comwa-vdate
                                          ELSE gs_comwa-odate ).
      DATA(ld_date_to) = gs_comwa-vedat.
      CHECK ld_date_from IS NOT INITIAL AND ld_date_to IS NOT INITIAL.

      DATA(lt_items_tmp) = lt_items.
      SORT lt_items_tmp BY matnr sernr.

      LOOP AT lt_items_tmp ASSIGNING FIELD-SYMBOL(<ls_item>) WHERE matnr IS NOT INITIAL.
        IF l_sernr = <ls_item>-sernr AND l_matnr = <ls_item>-matnr.
          CONTINUE.
        ENDIF.
        l_sernr = <ls_item>-sernr.
        l_matnr = <ls_item>-matnr.

        "Read candidate bookings from CDS view /BITMYM/I_BOOKING
        SELECT booking
          FROM /bitmym/i_booking
          WHERE booking         NE @gs_comwa-zzlresn
            AND followupbooking EQ @abap_false
          INTO TABLE @DATA(lt_booking_candidates).
        CHECK lt_booking_candidates IS NOT INITIAL.

        SELECT zzlresn
          FROM /sopromet/zzlrv
          FOR ALL ENTRIES IN @lt_booking_candidates
          WHERE zzlresn EQ @lt_booking_candidates-booking
            AND vkorg  EQ @gs_comwa-vkorg
            AND kunnr  EQ @gs_comwa-kunnr
            AND matnr  EQ @l_matnr
            AND vdate  LE @ld_date_to
            AND vedat  GE @ld_date_from
            AND zzlrsam NE @gs_comwa-zzlrsam
          INTO TABLE @DATA(lt_overlap).

        IF lt_overlap IS NOT INITIAL.
          rd_return = abap_false.
          /bitmym/cl_message=>message( id = 'E003(/BITMYM/S4)' ).
          MESSAGE e003(/bitmym/s4) INTO DATA(ld_msg).
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

  ENDMETHOD.


  METHOD check_before_save_dates.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR1-866, User: SCOSAR, Date: 16.06.2023___*
*___ SR1-1539, User: PKUNAL, Date: 25.07.2023___*
*___ SR2-990, User: STEKDEMIR, Date: 18.10.2024___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332

*    Validations copied from /BITMYM/CL_SCREEN_8002->PAI_8001_DATES
    DATA: ld_time  TYPE sy-uzeit.

    rd_return = abap_true.

*___VDATE <= ODATE <= VEDAT <= ABDAT <= RDATE <= FRDAT

    IF checks_related_req_del_date( ) EQ abap_false.        "HS 14556
*      gs_comwa-edatu = gs_comwa-vdate.           "HS 14456 "SR2-990
      gs_comwa-edatu = gs_comwa-odate.                      "SR2-990
    ENDIF.                                                  "HS 14456

    IF gs_comwa-odate LT sy-datum.
*      rd_return = abap_false. "it's an info message, no error
      /bitmym/cl_message=>message( id = 'I110(/SOPROMET/ZL)' ).
      MESSAGE i110(/sopromet/zl) INTO gd_dummy_message.     "HS# 11637
*      call_message( ). "SR1-866
    ENDIF.

    IF gs_comwa-odate LT gs_comwa-vdate.
      rd_return = abap_false.
      /bitmym/cl_message=>message( id = 'E159(/SOPROMET/ZL)' ).
      MESSAGE e159(/sopromet/zl) INTO gd_dummy_message.     "HS# 11637
*      call_message( ). "SR1-866
    ENDIF.

    IF NOT ( gs_comwa-odate >= gs_comwa-vdate AND gs_comwa-odate <= gs_comwa-rdate ).
      rd_return = abap_false.
      /bitmym/cl_message=>message( id = 'E111(/SOPROMET/ZL)' ).
      MESSAGE e111(/sopromet/zl) INTO gd_dummy_message.     "HS# 11637
*      call_message( ). "SR1-866
    ENDIF.

*___HS# 13576___________________START_INSERT
    IF NOT gs_comwa-edatu IS INITIAL.
      IF gs_comwa-edatu LT gs_comwa-vdate.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E471(/SOPROMET/ZL)' ).
        MESSAGE e471(/sopromet/zl) INTO gd_dummy_message.
*        call_message( ). "SR1-866
      ENDIF.
      IF gs_comwa-edatu NOT BETWEEN gs_comwa-vdate AND gs_comwa-odate.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E470(/SOPROMET/ZL)' ).
        MESSAGE e470(/sopromet/zl) INTO gd_dummy_message.
*        call_message( ). "SR1-866
      ENDIF.
    ENDIF.
*___HS# 13576___________________END_INSERT

*--> Abholungsdatum zeigen
    IF NOT gs_comwa-abdat IS INITIAL.
      IF NOT ( gs_comwa-abdat BETWEEN gs_comwa-odate AND gs_comwa-rdate ).
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E128(/SOPROMET/ZL)' ).
        MESSAGE e128(/sopromet/zl) INTO gd_dummy_message.   "HS# 11637
*        call_message( ). "SR1-866

*        ____SR1-866____BEGIN INSERT___*
      ELSEIF NOT ( gs_comwa-abdat BETWEEN gs_comwa-vedat AND gs_comwa-rdate ).
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E519(/SOPROMET/ZL)' ).
        MESSAGE e519(/sopromet/zl) INTO gd_dummy_message.
*        ____SR1-866____END   INSERT___*
      ENDIF.
    ENDIF.

    IF gs_comwa-vedat IS NOT INITIAL.
      IF gs_comwa-vedat LT gs_comwa-odate.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E155(/SOPROMET/ZL)' ).
        MESSAGE e155(/sopromet/zl) WITH gs_comwa-vedat gs_comwa-odate INTO gd_dummy_message. "HS# 11637
*        call_message( ). "SR1-866
      ENDIF.

      IF gs_comwa-rdate LT gs_comwa-vedat.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E246(/SOPROMET/ZL)' ).
        MESSAGE e246(/sopromet/zl) INTO gd_dummy_message.   "HS# 11637
*        call_message( ). "SR1-866
      ENDIF.
    ENDIF.

    IF gs_comwa-rdate_bu IS NOT INITIAL.              "*___ SR1-1539
      DATA(lv_rdate) = gs_comwa-rdate_bu.             "*___ SR1-1539
    ELSE.                                             "*___ SR1-1539
      lv_rdate = gs_comwa-rdate.                      "*___ SR1-1539
    ENDIF.                                            "*___ SR1-1539

*    IF gs_comwa-frdat LT gs_comwa-rdate.             "*___ SR1-1539
    IF gs_comwa-frdat LT lv_rdate.                    "*___ SR1-1539
      rd_return = abap_false.
      /bitmym/cl_message=>message( id = 'E245(/SOPROMET/ZL)' ).
      MESSAGE e245(/sopromet/zl) INTO gd_dummy_message.     "HS# 11637
*      call_message( ). "SR1-866
    ENDIF.

    IF gs_comwa-vtime NE gs_comwa-vtime.
      IF gs_comwa-vtime IS NOT INITIAL AND gs_comwa-vdate EQ sy-datum.
        ld_time = sy-uzeit.
        ADD 120 TO ld_time.
        IF gs_comwa-vtime LT ld_time.
          gs_comwa-vtime = ld_time.
        ENDIF.
      ENDIF.
    ENDIF.
*HS# 10168

*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save_dates
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS_DATES SPOTS /BITMYM/CL_CASE .

ENDMETHOD.


  METHOD compute_pricing_date_after_chg.
*____HS# 016825, VON: BGUNAWAN, DATUM: 15.06.2022___*
*___ SR1-685, User: STEKDEMIR, Date: 30.01.2024___*

    DATA: ls_date_data TYPE /bitmym/case_common_date.

* Move input structure dates
    MOVE-CORRESPONDING cs_dates TO ls_date_data.

    CHECK ( ls_date_data IS NOT INITIAL ).

    IF ls_date_data-odate <> gs_case-odate AND
*      ls_date_data-prsdt = gs_case-prsdt. "SR1-685 ls_date_data-prsdt = ls_date_data-odate will overwrite it anyway commented by codereview
      gs_case-prsdt = ls_date_data-odate.
      ls_date_data-prsdt = ls_date_data-odate.
      MOVE-CORRESPONDING ls_date_data TO cs_dates.
    ELSEIF ls_date_data-odate = gs_case-odate AND
      ls_date_data-prsdt <> gs_case-prsdt.
      gs_case-prsdt = ls_date_data-prsdt.
    ENDIF.

  ENDMETHOD.


  METHOD ui5_get_equip_single_items.
