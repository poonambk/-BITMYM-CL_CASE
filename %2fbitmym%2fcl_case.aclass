METHOD start_tree_case.
*____HS# 10467, VON: O.PECHARROMAN, DATUM: 11.09.2015___*
*____HS# 12010, VON: M.Knauer,      DATUM: 12.10.2017___*

  DATA:   ld_select VALUE 'X',
          ld_first  TYPE tv_nodekey,
          ld_map    TYPE /sopromet/ty_tree_map.

  CHECK go_tree_case IS INITIAL.

*__Tree für Case anlegen
  go_tree_case = /bitmym/cl_tree=>create(
                                          id_tree          = /bitmym/cl_tree=>c_tree_case
                                          i_tree_dynnr     = i_tree_dynnr
                                          i_tree_repid     = i_tree_repid
                                          i_tree_extension = i_tree_extension
                                          id_container     = id_container
                                          io_application   = go_appl   ).

  go_tree_case->set_property( i_feld = 'GT_SET_SELECTION' i_value = gt_mat_selection ).
  go_tree_case->create_tree( id_dark = id_dark ).           "HS# 12010

  IF id_dark IS INITIAL.                                    "HS# 12010
*_____Tree anzeigen
    go_tree_case->add_nodes( ).
    go_tree_case->expand_root_nodes( ).
    ld_first = go_tree_case->get_first_node( ).
    IF ld_first IS NOT INITIAL.
      ld_map = go_tree_case->get_map_of_node( ld_first ).
      go_act_reservation = ld_map-objkey.

      go_tree_case->set_selected_node( ld_first ).
    ENDIF.
*HS# 10467
  ENDIF.                                                    "HS# 12010
ENHANCEMENT-POINT start_tree_case SPOTS /bitmym/cl_case .

ENDMETHOD.


METHOD start_tree_flow.
  DATA: ls_comwa TYPE /sopromet/zzls01.

  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
  CHECK ls_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create.

  CHECK go_tree_flow IS INITIAL.

  go_tree_flow = /bitmym/cl_tree=>create(  id_tree          = /bitmym/cl_tree=>c_tree_flow
                                            i_tree_dynnr     = '8000'
                                            i_tree_repid     = '/BITMYM/SAPLAPPL'
                                            i_tree_extension = 300
                                            io_application   = go_appl   ).

  go_tree_flow->set_property( i_feld = 'GO_RESERVATION' i_value = go_act_reservation ).
ENDMETHOD.


