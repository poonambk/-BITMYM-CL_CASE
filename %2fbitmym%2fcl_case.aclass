  METHOD ui5_bookings_get_list_int.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 012387, VON: MKNAUER, DATUM: 23.07.2018___*
*____HS# 012765, VON: MKNAUER, DATUM: 12.12.2018___*
*____HS# 014038, VON: DENDRES, DATUM: 27.08.2020___*
*____HS# 014112, VON: SSINGH, DATUM: 28.10.2020___*
*____HS# 014979, VON: MKNAUER, DATUM: 23.02.2021___*
*____HS# 015186, VON: SSINGH, DATUM: 13.04.2021___*
*____HS# 015372, VON: SSINGH, DATUM: 18.05.2021___*
*____HS# 015419, VON: SISMAIL, DATUM: 04.06.2021___*
*____HS# 016041, VON: SSINGH, DATUM: 06.10.2021___*
*____HS# 016091, VON: MKNAUER, DATUM: 22.10.2021___*
*____HS# 016487, VON: MKNAUER, DATUM: 04.02.2022___* "SR1-568
*____HS# 016558, VON: SSINGH, DATUM: 27.04.2022___* "SR1-591
*____HS# 017105, VON: MKNAUER, DATUM: 25.07.2022___*
*____HS# 017213, VON: MKNAUER, DATUM: 22.08.2022___*
*____HS# 017238, VON: MKNAUER, DATUM: 26.08.2022___*
*____HS# 017105, VON: MKNAUER, DATUM: 25.07.2022___*
*____HS# 017639, VON: SSAHU, DATUM: 12.12.2022___*
*___ SR1-1234, User: SISMAIL, Date: 16.05.2023___*
*___ SR1-2073, User: SSINGH, Date: 14.12.2023___*
*___ SR1-2144, User: PKUNAL, Date: 10.01.2024___*
*___ SR2-688, User: SCOSAR, Date: 25.07.2024___*
*___ SR2-760, User: PKSHIRSAGAR, Date: 15.08.2024___*
*___ SR2-1037, User: SCOSAR, Date: 25.10.2024___*
*___ SR2-1035, User: SCOSAR, Date: 30.10.2024___*
*___ SR2-1356, User: SSINGH, Date: 09.01.2025___*
*___ SR2-1760, User: XLI, Date: 05.05.2025___*
*___ SR2-2233, User: RJANGA, Date: 26.08.2025___*
*___ SR2-2053, User: SBADUSHA, Date: 04.09.2025___*
*___ SR2-2637, User: SBADUSHA, Date: 22.01.2026___*

    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lt_temp     TYPE STANDARD TABLE OF /bitmym/bookings, "HS# 012765
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          ls_rserv    TYPE /sopromet/zzlrv,
          lt_reserv   TYPE /sopromet/ty_tree_map_tab,
          lo_rstyp    TYPE REF TO /sopromet/cl_l_res_type,  "HS# 012387
          ls_rstypt   TYPE /sopromet/rstypt,                "HS# 012387
          ld_query    TYPE string,                          "HS# 012765
          lr_rstyp    TYPE RANGE OF /sopromet/rstyp,        "SR2-1356
          lt_values   TYPE vrm_values,                      "SR2-1356
*          ls_value    TYPE vrm_value,                       "SR2-1356
          r_vkbur     TYPE RANGE OF vkbur,                  "SR2-2053
          lo_book_ui5 TYPE REF TO /bitmym/cl_ui5_booking.   "HS# 012765

    DATA: lt_vbpa TYPE STANDARD TABLE OF /bitmym/vbpa.
    FIELD-SYMBOLS: <bookings>     TYPE /bitmym/bookings,
                   <bookings_ui5> TYPE LINE OF /bitmym/cl_srep_srv_vr_mpc=>tt_booking,
                   <res>          TYPE /sopromet/ty_tree_map.

    ld_query = /bitmym/if_ui5~go_user->get_parvw_query_string( ). "HS# 12765
    go_salesarea->set_vrm_values_rstyp( IMPORTING et_values = lt_values ). "SR2-1356
    lr_rstyp = VALUE #( FOR ls_value IN lt_values           "SR2-1356
                           sign = 'I'                       "SR2-1356
                            option = 'EQ'                   "SR2-1356
                          (  low = ls_value-key ) ).        "SR2-1356

*____SR2-2053____BEGIN INSERT___*
    IF go_salesarea IS BOUND.
      IF go_salesarea->get_data( )-gs_actual_area-xwerk_so_act IS NOT INITIAL.
        r_vkbur = VALUE #( ( sign = 'I' option = 'EQ' low = go_salesarea->get_data( )-g_actual_vkbur ) ).
      ENDIF.
    ENDIF.
*____SR2-2053____END   INSERT___*

*&*SR1-1234+ Added EHP below
ENHANCEMENT-POINT Z_IC_BOOKING_CAL SPOTS /BITMYM/CL_CASE .

    TRY.
        IF NOT /bitmym/if_ui5~gv_filter_string CS 'KUNNR'.  "HS# 12765
*          begin of changes 17640
          IF /bitmym/if_ui5~gs_paging IS NOT INITIAL.
            SELECT DISTINCT lresn, txt04,
                            objnr,                           "HS# 16488 "SR1-568
                            lrsam, vkorg                    ""SR1-2144
                   FROM  /bitmym/bookings
                   WHERE  vkorg  = @gs_actual_area-vkorg
                   AND    vtweg  = @gs_actual_area-vtweg
                   AND    spart  = @gs_actual_area-spart
                   AND    rstyp  IN @lr_rstyp               "SR2-1356
                   AND    vkbur IN @r_vkbur   "SR2-2053 INS
                   AND    (/bitmym/if_ui5~gv_filter_string)
                   AND    (ld_query)                        "HS# 12765
            ORDER BY lresn DESCENDING
            INTO CORRESPONDING FIELDS OF TABLE @lt_bookings
            UP TO @/bitmym/if_ui5~gs_paging-top ROWS        "HS 17640
            OFFSET @/bitmym/if_ui5~gs_paging-skip.          "HS 17640
          ELSE.
*            end of changes HS 17640
            SELECT DISTINCT lresn, txt04,
                            objnr,                           "HS# 16487 "SR1-568
                            lrsam, vkorg                    ""SR1-2144
                   INTO CORRESPONDING FIELDS OF TABLE @lt_bookings FROM  /bitmym/bookings
                   WHERE  vkorg  = @gs_actual_area-vkorg
                   AND    vtweg  = @gs_actual_area-vtweg
                   AND    spart  = @gs_actual_area-spart
                   AND    rstyp  IN @lr_rstyp               "SR2-1356
                   AND    vkbur IN @r_vkbur   "SR2-2053 INS
                   AND    (/bitmym/if_ui5~gv_filter_string)
                   AND    (ld_query)                        "HS# 12765
            ORDER BY lresn.
          ENDIF.                                            "HS 17640

        ELSE.
*___HS# 12765_____________START_INSERT
*___If KUNNR is in the filter we have to execute first the SQL for the ODATA-Filter and then
*___execute SQL based on partner function
*          begin of changes 17640
          IF /bitmym/if_ui5~gs_paging IS NOT INITIAL.
            SELECT DISTINCT lresn, txt04,
                            objnr,                           "HS# 16488 SR1-568
                            lrsam, vkorg                    ""SR1-2144
                   FROM  /bitmym/bookings
                   WHERE  vkorg  = @gs_actual_area-vkorg
                   AND    vtweg  = @gs_actual_area-vtweg
                   AND    spart  = @gs_actual_area-spart
                   AND    rstyp  IN @lr_rstyp               "SR2-1356
                   AND    vkbur IN @r_vkbur   "SR2-2053 INS
                   AND    (/bitmym/if_ui5~gv_filter_string)
            ORDER BY lresn DESCENDING
            INTO CORRESPONDING FIELDS OF TABLE @lt_bookings
            UP TO @/bitmym/if_ui5~gs_paging-top ROWS        "HS 17640
            OFFSET @/bitmym/if_ui5~gs_paging-skip.
          ELSE.
*            end of chnages HS 17640
            SELECT DISTINCT lresn, txt04,
                            objnr,                           "HS# 16487 "SR1-568
                            lrsam, vkorg                    ""SR1-2144
                   INTO CORRESPONDING FIELDS OF TABLE @lt_bookings FROM  /bitmym/bookings
                   WHERE  vkorg  = @gs_actual_area-vkorg
                   AND    vtweg  = @gs_actual_area-vtweg
                   AND    spart  = @gs_actual_area-spart
                   AND    rstyp  IN @lr_rstyp               "SR2-1356
                   AND    vkbur IN @r_vkbur   "SR2-2053 INS
                   AND    (/bitmym/if_ui5~gv_filter_string).
          ENDIF.                                            "HS 17640
          IF lt_bookings IS NOT INITIAL.

            lt_temp = lt_bookings.
            CLEAR lt_bookings.

            SELECT DISTINCT lresn, txt04,
                            objnr,                           "HS# 16487 "SR1-568
                            lrsam, vkorg                    ""SR1-2144
                  INTO CORRESPONDING FIELDS OF TABLE @lt_bookings FROM  /bitmym/bookings
                  FOR ALL ENTRIES IN @lt_temp
                  WHERE  lresn  = @lt_temp-lresn
                  AND    vkorg  = @gs_actual_area-vkorg
                  AND    vtweg  = @gs_actual_area-vtweg
                  AND    spart  = @gs_actual_area-spart
                  AND    rstyp  IN @lr_rstyp                "SR2-1356
                  AND    vkbur IN @r_vkbur   "SR2-2053 INS
                  AND    (ld_query).
          ENDIF.
*___HS# 12765_____________END_INSERT

        ENDIF.

      CATCH cx_root INTO lo_ex.
    ENDTRY.

    CHECK lt_bookings IS NOT INITIAL.

*___HS# 017213 +ENHP
ENHANCEMENT-POINT FILTER_BOOKINGS SPOTS /BITMYM/CL_CASE .

    DELETE ADJACENT DUPLICATES FROM lt_bookings COMPARING lresn.

    SELECT * FROM /bitmym/i_bookingwithstatus INTO TABLE @DATA(lt_booking_status)
      FOR ALL ENTRIES IN @lt_bookings WHERE zzlresn = @lt_bookings-lresn AND vkorg = @lt_bookings-vkorg. ""SR1-2144

*    SELECT * FROM /bitmym/i_reserv_type_text INTO TABLE @DATA(lt_restype_text). ""SR1-2144

    SELECT * FROM /bitmym/i_partners INTO TABLE @DATA(lt_partner) FOR ALL ENTRIES IN @lt_bookings
      WHERE vkorg = @lt_bookings-vkorg AND zzlrsam = @lt_bookings-lrsam
        AND ( parvw = 'AG' OR parvw = @/bitmym/if_ui5~gv_parvw OR parvw = @/bitmym/if_ui5~gs_callerid-parvw_cid
             OR parvw = @gs_actual_area-parvwcrep ).        "SR2-2233
*____SR2-2637____BEGIN INSERT___*
    "TO get Reservation CR for a booking-> Mobile app needs this fields for Attachment display
*    SELECT DISTINCT * FROM /bitmym/i_reservation FOR ALL ENTRIES IN @lt_bookings
*      WHERE BookingReference = @lt_bookings-lresn INTO TABLE @DATA(lt_reservations).

    SELECT a~salesorg , a~combinedrun , a~refbook FROM /bitmym/i_booking_ref AS a INNER JOIN @lt_bookings AS b
      ON a~refbook = b~lresn
      WHERE a~salesorg = @gs_actual_area-vkorg
      INTO TABLE @DATA(lt_reservations).
*____SR2-2637____END   INSERT___*

*    lt_vbpa = lt_partner.  "SR2-760
    lt_vbpa = CORRESPONDING #( lt_partner ) . "SR2-760

*    ui5_bookings_get_status( it_booking = lt_bookings ).    "HS# 016487  "SR1-568   ""SR1-2144
    ui5_get_mattyp_sql( ).                                  "HS# 017105
    ui5_filter_booking( CHANGING ct_bookings = lt_bookings ). "HS# 017238

    LOOP AT lt_bookings ASSIGNING <bookings> WHERE lresn IS NOT INITIAL.

      CLEAR: ls_vbadr_ag.
      APPEND INITIAL LINE TO et_entityset ASSIGNING <bookings_ui5>.
*_________""SR1-2144____________________START_INSERT

      MOVE-CORRESPONDING <bookings> TO <bookings_ui5>.

      READ TABLE lt_booking_status INTO DATA(ls_booking_status) WITH KEY zzlresn = <bookings>-lresn.
      IF sy-subrc IS INITIAL.

        MOVE-CORRESPONDING ls_booking_status TO <bookings_ui5>.


        <bookings_ui5>-rstyp_text  = ls_booking_status-reservationtypetext.
        <bookings_ui5>-bezei      = ls_booking_status-reservationtypetext.
        <bookings_ui5>-simulation  = ''.
        <bookings_ui5>-txt04  = ls_booking_status-statuscode.
*        <bookings_ui5>-eartx  = ls_booking_status-technicalobjecttypedesc.
*        <bookings_ui5>-eqart  = ls_booking_status-technicalobjecttype.
        <bookings_ui5>-txt30  = ls_booking_status-userstatusname.
        <bookings_ui5>-eqtyp  = ''.
        <bookings_ui5>-sutyp  = ls_booking_status-surgerytype.
*        <bookings_ui5>-sutext  = ''.  "SR2-1760
        <bookings_ui5>-sutext = ui5_get_surgery_text( is_data = <bookings_ui5> ). "SR2-1760
        <bookings_ui5>-vtext  = ''.
        <bookings_ui5>-clini_supp  = ls_booking_status-clinisupp.
        <bookings_ui5>-status = ls_booking_status-userstatusname.
        <bookings_ui5>-color = ls_booking_status-statuscolour.

        <bookings_ui5>-setmaterialqty = ls_booking_status-setmaterialqty. "SR2-1035
        <bookings_ui5>-deliveredsetqty = ls_booking_status-deliveredsetqty. "SR2-1035
        <bookings_ui5>-countuom = ls_booking_status-countuom. "SR2-1035
      ENDIF.

      CLEAR ls_vbadr_ag.
      IF gs_actual_area-parvwcrep IS NOT INITIAL.

*____SR2-2233____BEGIN INSERT___*
        <bookings_ui5>-name1 = VALUE #( lt_partner[ kunnr = ls_booking_status-kunnr parvw = gs_actual_area-parvwcrep ]-name OPTIONAL ).

*        CALL METHOD /bitmym/cl_partner=>read_crep_address_from_kun_ext
*          EXPORTING
*            id_kunnr = ls_booking_status-kunnr
*            id_parvw = gs_actual_area-parvwcrep
*          CHANGING
*            cs_vbadr = ls_vbadr_ag.
*        <bookings_ui5>-name1 = ls_vbadr_ag-name1.
*____SR2-2233____END   INSERT___*

      ENDIF.
*____SR2-2637____BEGIN INSERT___*
      <bookings_ui5>-lsram_res = VALUE #( lt_reservations[ refbook = <bookings>-lresn ]-combinedrun OPTIONAL ).
*____SR2-2637____END   INSERT___*


      READ TABLE lt_partner INTO DATA(ls_partner) WITH KEY zzlrsam = ls_booking_status-zzlrsam vkorg = ls_booking_status-vkorg parvw = 'AG'.
      IF sy-subrc IS INITIAL.
        <bookings_ui5>-name1 = ls_partner-name.
      ENDIF.
      READ TABLE lt_partner INTO ls_partner WITH KEY zzlrsam = ls_booking_status-zzlrsam vkorg = ls_booking_status-vkorg parvw = /bitmym/if_ui5~gv_parvw.
      IF sy-subrc IS INITIAL.
        <bookings_ui5>-nachn = ls_partner-name.
      ENDIF.

      ui5_check_time_format( CHANGING cs_item = <bookings_ui5> ).

      IF /bitmym/if_ui5~g_mobile_call NE 'X'.
        /bitmym/cl_ui5_util=>convert_dates_to_times( CHANGING cs_data = <bookings_ui5> ).
      ENDIF.

      <bookings_ui5>-consumeable = ui5_get_consumption_indicator( is_data = <bookings_ui5> ).
      ui5_get_followup_fields( CHANGING cs_data = <bookings_ui5> ).




      ui5_update_own_booking( EXPORTING it_vbpa =  VALUE /bitmym/vbpa_tab( FOR ls_vbpa IN lt_vbpa WHERE ( zzlrsam = <bookings_ui5>-zzlrsam )  ( ls_vbpa ) )  "lt_vbpa "SR2-760
                               CHANGING cs_data = <bookings_ui5> ).


*_________""SR1-2144____________________END_INSERT
*____SR2-1037____BEGIN COMMENT___*
*____SR2-688____BEGIN INSERT___*
*      calculate_editable_flags( EXPORTING is_booking = CORRESPONDING #( <bookings_ui5> ) IMPORTING ed_edit_booking   = <bookings_ui5>-edit_booking
*                                                                                                   ed_edit_item      = <bookings_ui5>-edit_item
*                                                                                                   ed_dispatch_exist = <bookings_ui5>-dispatch_exist
*                                                                                                   ed_edit_partner   = <bookings_ui5>-edit_partner ).
*____SR2-688____END   INSERT___*
*____SR2-1037____END   COMMENT___*



*_________""SR1-2144____________________START_DELETE

**      CLEAR: ls_vbadr_xx,
**             ls_vbadr_ag.
