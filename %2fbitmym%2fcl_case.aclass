    go_partner->ui5_set_partner( EXPORTING io_ui5 = io_ui5 ).
  ENDMETHOD.


  METHOD manage_ref_book.
*___ SR2-731, User: SCOSAR, Date: 08.08.2024___*
    DATA: lt_ref_ins TYPE /bitmym/ref_book_tt,
          lt_ref_del TYPE /bitmym/ref_book_tt,
          lt_message TYPE bapiret2_t.

    CLEAR: lt_ref_ins, lt_ref_del, lt_message.
    SELECT * FROM /bitmym/book_ref INTO TABLE @DATA(lt_ref_book_yy) WHERE vkorg EQ @gs_comwa-vkorg
                                                                      AND lrsam EQ @gs_comwa-zzlrsam.

    "identify what's new
    LOOP AT it_ref_book INTO DATA(ls_ref_book).
      IF NOT line_exists( lt_ref_book_yy[ ref_book = ls_ref_book-ref_book ] ) .
        APPEND ls_ref_book TO lt_ref_ins.
        DATA(lv_msgv) = conv SYMSGV( |{ ls_ref_book-ref_book ALPHA = OUT }| ).
        APPEND VALUE #( type = 'S' id = '/SOPROMET/ZL' number = '646' message_v1 = lv_msgv ) TO lt_message.
        /bitmym/cl_message=>message( id = 'S646(/SOPROMET/ZL)' v1 = lv_msgv ).
      ENDIF.
    ENDLOOP.

    "identify what's removed
    LOOP AT lt_ref_book_yy INTO DATA(ls_ref_book_yy).
      IF NOT line_exists( it_ref_book[ ref_book = ls_ref_book_yy-ref_book ] ) .
        APPEND CORRESPONDING #( ls_ref_book_yy ) TO lt_ref_del.
        lv_msgv = conv SYMSGV( |{ ls_ref_book_yy-ref_book ALPHA = OUT }| ).
        APPEND VALUE #( type = 'S' id = '/SOPROMET/ZL' number = '645' message_v1 = lv_msgv ) TO lt_message.
        /bitmym/cl_message=>message( id = 'S645(/SOPROMET/ZL)' v1 = lv_msgv ).
      ENDIF.
    ENDLOOP.

    CHECK validate_ref_book( EXPORTING it_ref_del = lt_ref_del it_ref_ins = lt_ref_ins IMPORTING et_message = et_message ) EQ abap_true.
    et_message = lt_message.

    IF lt_ref_ins[] IS NOT INITIAL.
      INSERT /bitmym/book_ref FROM TABLE lt_ref_ins.
    ENDIF.

    IF lt_ref_del[] IS NOT INITIAL.
      DELETE /bitmym/book_ref FROM TABLE lt_ref_del.
    ENDIF.

  ENDMETHOD.


  METHOD validate_ref_book.
*___ SR2-731, User: SCOSAR, Date: 08.08.2024___*
    DATA: lt_ref_org TYPE /bitmym/ref_book_tt.

    rd_return = abap_true.

    CLEAR lt_ref_org.

    "get original booking (initial booking)
    SELECT DISTINCT vkorg, zzlrsam AS lrsam, ref_book, kunnr, kunwe, kunnr_sb, vdate, frdat FROM /sopromet/zzlrv
     WHERE vkorg   EQ @gs_comwa-vkorg
       AND zzlrsam EQ @gs_comwa-zzlrsam
       AND ref_book IS NOT INITIAL
      INTO CORRESPONDING FIELDS OF TABLE @lt_ref_org.
    SORT lt_ref_org BY ref_book.


    "Validate removing
    LOOP AT it_ref_del INTO DATA(ls_ref_del).
      IF line_exists( lt_ref_org[ ref_book = ls_ref_del-ref_book ] ).
        rd_return = abap_false.
        APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '607' ) TO et_message.
        /bitmym/cl_message=>message( id = 'E607(/SOPROMET/ZL)'  ).
        EXIT.
      ENDIF.
    ENDLOOP.

    "validate addition
    IF it_ref_ins[] IS NOT INITIAL.
      DATA(lt_vbpa_r) = go_partner->get_data( )-gt_vbpa.

      SELECT * FROM tpart INTO TABLE @DATA(lt_tpart) WHERE spras EQ @sy-langu AND parvw IN ( @/bitmym/cl_partner=>c_parvw_ag,
                                                                                             @/bitmym/cl_partner=>c_parvw_we,
                                                                                             @/bitmym/cl_partner=>c_parvw_sb ).


      "get booking details for further checks
      SELECT a~* FROM /bitmym/ui5_res AS a INNER JOIN @it_ref_ins AS _ins ON _ins~ref_book EQ a~zzlresn INTO TABLE @DATA(lt_bookings).
      "get combined runs related to bookings
      SELECT a~* FROM /bitmym/book_ref AS a INNER JOIN @it_ref_ins AS _ins ON _ins~ref_book EQ a~ref_book INTO TABLE @DATA(lt_cr).

      SELECT * FROM /bitmym/res_cc INTO TABLE @DATA(lt_rescc) WHERE vkorg EQ @gs_comwa-vkorg AND rstyp_r EQ @gs_comwa-rstyp.

      LOOP AT it_ref_ins INTO DATA(ls_ref_ins).
        DATA(ls_booking) = VALUE #( lt_bookings[ zzlresn = ls_ref_ins-ref_book ] OPTIONAL ).
        DATA(lt_vbpa_b) = /bitmym/cl_case=>create( id_reservation = ls_booking-zzlresn )->get_data( )-go_partner->get_data( )-gt_vbpa.


        IF ls_booking IS INITIAL.
          rd_return = abap_false.
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '604' message_v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E604(/SOPROMET/ZL)' v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.

        IF NOT ( ls_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_angelegt OR
                 ls_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_frei ).
          rd_return = abap_false.
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '612' message_v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E612(/SOPROMET/ZL)' v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.

        IF line_exists( lt_cr[ ref_book = ls_ref_ins-ref_book ] ).
          rd_return = abap_false.
          DATA(lv_msgv) = VALUE symsgv( lt_cr[ ref_book = ls_ref_ins-ref_book ]-lrsam OPTIONAL ).
          lv_msgv = |{ lv_msgv ALPHA = OUT }|.
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '606' message_v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| message_v2 = lv_msgv ) TO et_message.
          /bitmym/cl_message=>message( id = 'E606(/SOPROMET/ZL)' v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| v2 = lv_msgv ).
        ENDIF.

        IF NOT line_exists( lt_rescc[ rstyp_b = ls_booking-rstyp rstyp_r = gs_comwa-rstyp ] ).
          rd_return = abap_false.
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '342' message_v1 = ls_booking-rstyp message_v2 = gs_comwa-rstyp ) TO et_message.
          /bitmym/cl_message=>message( id = 'E342(/SOPROMET/ZL)' v1 = ls_booking-rstyp v2 = gs_comwa-rstyp ).
        ENDIF.

        DATA(ls_vbpa_b) = VALUE #( lt_vbpa_b[ parvw = /bitmym/cl_partner=>c_parvw_ag ] OPTIONAL ).
        DATA(ls_vbpa_r) = VALUE #( lt_vbpa_r[ parvw = /bitmym/cl_partner=>c_parvw_ag ] OPTIONAL ).
        IF ls_vbpa_b-kunnr NE ls_vbpa_r-kunnr.
          rd_return = abap_false.
          DATA(ls_tpart) = VALUE #( lt_tpart[ parvw = /bitmym/cl_partner=>c_parvw_ag ] OPTIONAL ).
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '608' message_v1 = ls_tpart-vtext message_v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E608(/SOPROMET/ZL)' v1 = ls_tpart-vtext v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.
        CLEAR: ls_vbpa_b, ls_vbpa_r, ls_tpart.

        ls_vbpa_b = VALUE #( lt_vbpa_b[ parvw = /bitmym/cl_partner=>c_parvw_we ] OPTIONAL ).
        ls_vbpa_r = VALUE #( lt_vbpa_r[ parvw = /bitmym/cl_partner=>c_parvw_we ] OPTIONAL ).
        IF ls_vbpa_b-kunnr NE ls_vbpa_r-kunnr.
          rd_return = abap_false.
          ls_tpart = VALUE #( lt_tpart[ parvw = /bitmym/cl_partner=>c_parvw_we ] OPTIONAL ).
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '608' message_v1 = ls_tpart-vtext message_v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E608(/SOPROMET/ZL)' v1 = ls_tpart-vtext v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.
        CLEAR: ls_vbpa_b, ls_vbpa_r, ls_tpart.

        ls_vbpa_b = VALUE #( lt_vbpa_b[ parvw = /bitmym/cl_partner=>c_parvw_sb ] OPTIONAL ).
        ls_vbpa_r = VALUE #( lt_vbpa_r[ parvw = /bitmym/cl_partner=>c_parvw_sb ] OPTIONAL ).
        IF ls_vbpa_b-kunnr NE ls_vbpa_r-kunnr.
          rd_return = abap_false.
          ls_tpart = VALUE #( lt_tpart[ parvw = /bitmym/cl_partner=>c_parvw_sb ] OPTIONAL ).
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '608' message_v1 = ls_tpart-vtext message_v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E608(/SOPROMET/ZL)' v1 = ls_tpart-vtext v2 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.
        CLEAR: ls_vbpa_b, ls_vbpa_r, ls_tpart.

        IF NOT ( ls_booking-vdate BETWEEN gs_comwa-vdate AND gs_comwa-frdat AND
                 ls_booking-frdat BETWEEN gs_comwa-vdate AND gs_comwa-frdat ).
          rd_return = abap_false.
          APPEND VALUE #( type = 'E' id = '/SOPROMET/ZL' number = '647' message_v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ) TO et_message.
          /bitmym/cl_message=>message( id = 'E647(/SOPROMET/ZL)' v1 = |{ ls_ref_ins-ref_book ALPHA = OUT }| ).
        ENDIF.

        CLEAR ls_booking.
      ENDLOOP.
    ENDIF.


  ENDMETHOD.


  METHOD consolidate_bitems.
*___ SR2-723, User: SCOSAR, Date: 16.08.2024___*
*___ SR2-3176 User: KSAMY_EXT, Date: 30.04.2026___*
    DATA: ld_posnr TYPE posnr.

    DATA(lt_items) = c_items_tab[].

    CLEAR c_items_tab.

    LOOP AT lt_items INTO DATA(ls_items) WHERE menge GT 0.
      CLEAR ls_items-posnr.
      READ TABLE c_items_tab ASSIGNING FIELD-SYMBOL(<fs_item>) WITH KEY matnr    = ls_items-matnr
                                                                        sernr    = ls_items-sernr
                                                                        meins    = ls_items-meins
                                                                        werks    = ls_items-werks
                                                                        atpswerk = ls_items-atpswerk
                                                                        abgru    = ls_items-abgru
                                                                        updated  = ls_items-updated.
      IF sy-subrc EQ 0.
        ADD ls_items-menge TO <fs_item>-menge.
        UNASSIGN <fs_item>.
      ELSEIF ls_items-sernr IS INITIAL.
        COLLECT ls_items INTO c_items_tab.
      ELSE.
        APPEND ls_items TO c_items_tab.
      ENDIF.

    ENDLOOP.

    CLEAR ld_posnr.

    LOOP AT c_items_tab ASSIGNING <fs_item>.
      ADD 10 TO ld_posnr .
      <fs_item>-posnr = ld_posnr.
    ENDLOOP.

    " SR2-3176 BEGIN OF INSERT
    get_item_cost_price(
      CHANGING
        ct_items = c_items_tab
        ).

    " SR2-3176 END OF INSERT

    CHECK go_act_reservation IS NOT INITIAL.
    DATA(lt_bitems) = CORRESPONDING /bitmym/b_items_st_tab( c_items_tab ).
    set_property go_act_reservation 'GT_BOOKING_ITEMS' lt_bitems.
    set_property go_act_reservation 'GD_POSNR' ld_posnr.
  ENDMETHOD.


  METHOD calculate_editable_flags.
*___ SR2-688, User: SCOSAR, Date: 11.09.2024___*
*___ SR2-892, User: SCOSAR, Date: 02.10.2024___*
*___ SR2-871, User: SCOSAR, Date: 02.10.2024___*
*___ SR2-970, User: SCOSAR, Date: 11.10.2024___*
*___ SR2-1781, User: SCOSAR, Date: 25.06.2025___*

*    check 1 = 2. "SR2-892  "deleted sr2-871


    SELECT t1~salesorg , t1~refbook AS booking, t1~combinedrun, COUNT( t2~dispatchorder ) AS dispatch
      FROM /bitmym/i_booking_ref AS t1
      LEFT OUTER JOIN /bitmym/i_reservation AS t2 ON t2~salesorganization EQ t1~salesorg
                                                 AND t2~combinedrun       EQ t1~combinedrun
                                                 AND t2~dispatchorder     NE @space
     WHERE t1~refbook EQ @is_booking-zzlresn
       AND t1~salesorg EQ @is_booking-vkorg
     GROUP BY t1~salesorg , t1~refbook, t1~combinedrun
      INTO TABLE @DATA(lt_bookingref).

    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = is_booking-vkorg i_rstyp = is_booking-rstyp  ).
      go_rstyp->set_data_vkorg( is_booking-vkorg ).
    ENDIF.
    DATA(ls_res_typ_vko) = go_rstyp->get_data( )-gs_rstypo.
    "if booking status is booking created and released, booking is editable
    "if booking status is material allocated, limited fields are editable depending on the dispatch order
    ed_edit_booking = COND #( WHEN is_booking-xfollowup         EQ abap_true                                  THEN abap_false  "follow-up booking is not editable "SR2-970
                              WHEN /bitmym/if_ui5~g_mobile_call EQ abap_true AND
                                   is_booking-ownbooking_flg    EQ abap_false                                 THEN abap_false

                              WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_angelegt OR
                                   is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_frei     OR
                                   is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_mat_a        THEN abap_true

                                                                                                              ELSE abap_false ).


    "if any of the reservations related to booking has a dispatch order, it's true
    ed_dispatch_exist = COND #( WHEN VALUE #( lt_bookingref[ salesorg = is_booking-vkorg
                                                             booking  = is_booking-zzlresn ]-dispatch OPTIONAL ) > 0 THEN abap_true ELSE abap_false ).
    "if edit booking items functionality is activated for booking type, then;
    "--> if booking status is booking created, item changes can be made
    "--> if booking status is released but combined run is not created yet, item changes can be made
    "--> if booking status is material allocated but dispatch order is not yet created and customizing for automatic reservation creation is on, item changes can be made
    ed_edit_item = COND #( WHEN ed_edit_booking EQ abap_false                                               THEN abap_false

                           WHEN ls_res_typ_vko-edit_booking_items EQ abap_false                             THEN abap_false

                           WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_angelegt      THEN abap_true


                           WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_frei AND
                                NOT line_exists( lt_bookingref[ salesorg = is_booking-vkorg
                                                                booking = is_booking-zzlresn ] )            THEN abap_true

                           WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_mat_a AND
                                is_booking-dispatch_exist EQ abap_false AND
                                ( ls_res_typ_vko-xbook2case EQ gc_b OR ls_res_typ_vko-xbook2case EQ gc_s ) THEN abap_true

                                                                                                           ELSE abap_false ).

    ed_edit_partner = COND #(  WHEN ed_edit_booking EQ abap_false                                               THEN abap_false

                               WHEN ls_res_typ_vko-edit_booking_partners EQ abap_false                          THEN abap_false

                               WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_angelegt OR
                                    is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_frei          THEN abap_true

                               WHEN is_booking-txt04 EQ /sopromet/cl_l_reservation=>c_book_status_mat_a AND
                                    is_booking-dispatch_exist EQ abap_false                                     THEN abap_true

                                                                                                                ELSE abap_false   ).

*____SR2-1781____BEGIN INSERT___*
    IF ed_clnsupreq_ctrl IS REQUESTED AND ls_res_typ_vko-clinic_support GT 0.
      DATA(ld_diff) = /bitmym/cl_mym=>working_days_btw_dates( id_fabkl = ls_res_typ_vko-fabkl
                                                              id_date_from = sy-datum
                                                              id_date_to = is_booking-odate ).
      ed_clnsupreq_ctrl = COND #( WHEN sy-datum GE is_booking-odate                 THEN abap_false
                                  WHEN ls_res_typ_vko-clinic_support <= ld_diff     THEN abap_true
                                                                                    ELSE abap_false ).
    ENDIF.
*____SR2-1781____END   INSERT___*

    CLEAR ls_res_typ_vko.
  ENDMETHOD.


  METHOD get_booking_res_details.
*___ SR2-718,  User: RJANGA,    Date: 01.08.2024___Created*
*___ SR2-1085, User: STEKDEMIR, Date: 14.11.2024___*
*___ SR2-1488, User: SCOSAR, Date: 03.02.2025___*
*___ SR2-3105, User: STEKDEMIR, Date: 15.04.2026___*

    CLEAR: gd_dependent_combinedrun,
           gd_dependent_reservation,
           gd_dependent_rscat.

*____SR2-3105____BEGIN INSERT___*
    get_booking_res_details_int( EXPORTING is_comwa       = gs_comwa
                                 IMPORTING ev_combinedrun = gd_dependent_combinedrun
                                           ev_reservation = gd_dependent_reservation
                                           ev_rscat       = gd_dependent_rscat ).
*____SR2-3105____END   INSERT___*

**____SR2-3105____BEGIN COMMENT___*
**-> GET dependent Object CombinedRun
*    CASE gs_comwa-rscat.
*
*      WHEN /sopromet/cl_l_reservation=>c_rscat_b.       " Booking
**____SR2-1085____BEGIN INSERT___*
** We Sync partner only if we have excatly 1 booking per reservation combined run
*        SELECT DISTINCT _combinedrun~bookingcombinedrun
*          FROM /bitmym/i_bookingnreservation AS _booking
*          INNER JOIN /bitmym/i_bookingnreservation AS _combinedrun
*          ON    _booking~salesorganization = _combinedrun~salesorganization
*          AND   _booking~reservationcombinedrun = _combinedrun~reservationcombinedrun
*          WHERE _booking~salesorganization = @gs_comwa-vkorg
*            AND _booking~booking = @gs_comwa-zzlresn
*          INTO TABLE @DATA(lt_combinedrun).
*        IF sy-dbcnt <> 1.
*          RETURN.
*        ENDIF.
**____SR2-1085____END   INSERT___*
*
*        "To Get the Reservation's CombinedRun
*        SELECT DISTINCT reservationcombinedrun
**          , reservation
*          FROM /bitmym/i_bookingnreservation INTO TABLE @DATA(lt_reservation)
*          WHERE salesorganization = @gs_comwa-vkorg
*            AND booking           = @gs_comwa-zzlresn.
*        IF sy-subrc EQ 0 AND sy-dbcnt EQ 1.
*          gd_dependent_combinedrun = VALUE #( lt_reservation[ 1 ]-reservationcombinedrun OPTIONAL ).
**          gd_dependent_reservation = VALUE #( lt_reservation[ 1 ]-reservation OPTIONAL ).
*        ENDIF.
*
*
*      WHEN space.                                       " Reservation
*        "To Get the Booking's CombinedRun
*        SELECT DISTINCT bookingcombinedrun, booking FROM /bitmym/i_bookingnreservation INTO TABLE @DATA(lt_booking)
*        WHERE salesorganization      = @gs_comwa-vkorg
*          AND reservationcombinedrun = @gs_comwa-zzlrsam
*          AND followupbooking        = @space.              "SR2-1488
**          AND reservation            = @gs_comwa-zzlresn.
*        IF sy-subrc EQ 0 AND sy-dbcnt EQ 1.
*          gd_dependent_combinedrun = VALUE #( lt_booking[ 1 ]-bookingcombinedrun OPTIONAL ).
*          gd_dependent_reservation = VALUE #( lt_booking[ 1 ]-booking OPTIONAL ).
*          gd_dependent_rscat = /sopromet/cl_l_reservation=>c_rscat_b.
*        ENDIF.
*      WHEN OTHERS.
*    ENDCASE.
**____SR2-3105____END   COMMENT___*

  ENDMETHOD.


  METHOD ui5_add_field_inv_ord_records.
*___ SR2-376, User: OOGUR, Date: 01.10.2024___*

*   In case of field inventory model 'A', when invoicing through field inventory bookings, the monitor records used are from the reservations
*   that originally shipped the sets to the distributor/agent, so charge and field replenishment orders are linked to these reservations and their
*   booking references in tables /SOPROMET/ZZLVF for charge orders, /SOPROMET/ZZLNB for replenishment orders, /SOPROMET/ELOG

*   When triggering consumption and replenishment through field inventory booking, this booking number is stored in tables /BITMYM/SDMLINK and
*   /BITMYMMSDLINK as booking usage.
*   So when displaying recent orders for field inventory booking, system must retrieve the orders from these tables, it's the only place where
*   traceability is kept

    CHECK go_application IS BOUND AND go_application->check_field_inv_model( ) = /bitmym/cl_mym=>c_field_inv_model.

*   Replenishment orders are stored in this table
    SELECT DISTINCT sdmlink~vbeln,vb~erdat,vb~auart,vb~gbstk
      FROM /bitmym/sdmlink AS sdmlink
      INNER JOIN vbak AS vb ON vb~vbeln = sdmlink~vbeln
      INTO TABLE @DATA(lt_data)
      WHERE  bookingusage = @gd_reservation             "field inventory booking number
      ORDER BY vb~erdat DESCENDING.

*   Charge orders are stored in this table
    SELECT DISTINCT msdlink~vbeln,vb~erdat,vb~auart,vb~gbstk
      FROM    /bitmym/msdlink AS msdlink
      INNER JOIN vbak AS vb ON vb~vbeln = msdlink~vbeln
      APPENDING TABLE @lt_data
      WHERE  bookingusage = @gd_reservation             "field inventory booking number
      ORDER BY vb~erdat DESCENDING.


    SORT lt_data BY vbeln.
    DELETE ADJACENT DUPLICATES FROM lt_data COMPARING vbeln.

*   Accurate sales order completion status can be retrieved from ELOG table
    IF lt_data IS NOT INITIAL.
      SELECT elog~vbeln,elog~vbeln_vl
        FROM /sopromet/elog  AS elog
        INNER JOIN @lt_data AS data ON data~vbeln EQ elog~vbeln
        INTO TABLE @DATA(lt_elog).
    ENDIF.

    LOOP AT lt_data ASSIGNING FIELD-SYMBOL(<fs_data>).
      APPEND INITIAL LINE TO ct_entityset ASSIGNING FIELD-SYMBOL(<fs_entity>).
      MOVE-CORRESPONDING <fs_data> TO <fs_entity>.
      <fs_entity>-wbstk = <fs_data>-gbstk.

      DATA(ls_elog) = lt_elog[ vbeln = <fs_data>-vbeln ].
      IF sy-subrc EQ 0.
        <fs_entity>-vbeln_vl = ls_elog-vbeln_vl.
      ENDIF.
    ENDLOOP.


  ENDMETHOD.


  METHOD ui5_add_fld_inv_infos.
*___ SR2-900, User: OOGUR, Date: 27.09.2024___*


    rd_success = abap_false.

*   Get the actual reservation of the equipment, to determine if it is a temp field inv set or not
    DATA(lo_reservation) =  io_equi->get_current_reservation( ).
    CHECK lo_reservation IS BOUND.

    DATA(ls_data)  = lo_reservation->get_data( ).

*   If the reservation type of the actual reservation is not relevant for field inventory,
*   then either is a regular loan reservation (e.g. '01'), or a field inventory reservation (e.g. 'A2')
    IF ls_data-g_reservation_type->get_data( )-g_res_type-rstyp_fld IS INITIAL.        "must be field inventory record otherwise continiou with current process
      rd_success = abap_true.
      EXIT.
    ENDIF.

*   Set was shipped to customer through a reservation type that is relevant for field inventory, therefore, it's a temporary field inventory set
*   Ship-to party of the current reservation must be equal to the ship-to of the new booking being created in the mobile
*   Expected collection date of the temp field inv set must be equal or higher than the end of use of the new booking being created in the mobile
    CHECK  gs_comwa-kunwe  = ls_data-g_reservation-kunwe                               "Current reservation ship-to must be equal creation booking ship-to.
      AND  is_dates-vedat <= ls_data-g_reservation-abdat.                              "new booking (comwa) vedat <= actual reservation abdat (collection date)

*   backend sends the expected collection date of the temp field inv set, so frontend can show this extra info to mobile user
    cv_abdat   = ls_data-g_reservation-abdat.
    rd_success = abap_true.

  ENDMETHOD.


  METHOD update_single_parts.
*___ SR2-723, User: SCOSAR, Date: 01.10.2024___*
*___ SR2-1030, User: SCOSAR, Date: 24.10.2024___*

    DATA: ls_comwa     TYPE /sopromet/zzls01.

    e_success = abap_false.

    CHECK gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.

    CHECK gs_comwa-zzlresn IS NOT INITIAL.

    CHECK it_singleitems[] IS NOT INITIAL.

    READ TABLE gt_reservations ASSIGNING FIELD-SYMBOL(<fs_res>) WITH KEY lresrv = gs_comwa-zzlresn.
    CHECK sy-subrc EQ 0.

    go_act_reservation = <fs_res>-objkey .
    DATA(lt_singleitems) = it_singleitems.

    DATA(ls_res_data) = go_act_reservation->get_data( ).
    MOVE-CORRESPONDING ls_res_data-g_reservation TO ls_comwa.

    go_appl->set_data( is_data = VALUE #( gs_comwa = ls_comwa ) it_fields = VALUE #( ( fieldname = 'GS_COMWA' ) ) ).

    ui5_prep_reservation_tree( i_add_res = abap_false ).

    ui5_single_items_atp_check( EXPORTING io_case = me
                                          io_appl = go_appl
                                CHANGING ct_single_items = lt_singleitems ).

    gs_comwa-trtyp_o = ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.

    set_gt_single_items( it_single = lt_singleitems ).

    lt_singleitems = go_act_reservation->get_prop_single_items( EXPORTING io_case = me i_auto_check = abap_true ).

    CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
      EXPORTING
        i_zzls01            = ls_comwa
        i_post_single_items = abap_true
        i_sales_rep         = /bitmym/if_ui5~gs_callerid-kunnr "SR2-1030
      TABLES
        xsingleitems        = lt_singleitems.

    IF i_no_commit EQ abap_false.
      COMMIT WORK AND WAIT.
    ENDIF.

    "set back case comwa
    go_appl->set_data( is_data = VALUE #( gs_comwa = gs_comwa ) it_fields = VALUE #( ( fieldname = 'GS_COMWA' ) ) ).

  ENDMETHOD.


  METHOD prepare_followup_items.
*___ SR2-970, User: SCOSAR, Date: 11.10.2024___*

    CHECK gs_comwa-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.
    CHECK gs_comwa-xfollowup EQ abap_true.
    CHECK gs_comwa-ref_book IS NOT INITIAL.

    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  ).
      go_rstyp->set_data_vkorg( gs_comwa-vkorg ).
    ENDIF.
    CHECK go_rstyp->get_data( )-gs_rstypo-flw_up_bookings_items EQ abap_true.
    CHECK ct_items[] IS INITIAL.

    SELECT * FROM /bitmym/b_items INTO TABLE @DATA(lt_items) WHERE lresn EQ @gs_comwa-ref_book.

    CHECK lt_items[] IS NOT INITIAL.

    ct_items = CORRESPONDING /bitmym/cl_srep_srv_vr_mpc_ext=>tt_bookingitem( lt_items EXCEPT lresn ).

  ENDMETHOD.


  METHOD check_clinical_support_change.
*___ SR2-2120, User: SCOSAR, Date: 25.07.2025___*

    rd_return = abap_true.

    IF gs_case-clini_supp NE gs_case_yy-clini_supp.

      "check status of booking
      IF go_act_reservation IS NOT INITIAL.
        DATA(ld_user_status) = go_act_reservation->get_user_status( i_no_status_refresh = abap_true ).
        IF ld_user_status EQ /sopromet/cl_l_reservation=>c_book_status_abgesagt OR
           ld_user_status EQ /sopromet/cl_l_reservation=>c_book_status_mat_d.
          DATA(ld_user_status_30) = go_act_reservation->get_user_status_30( ).
          /bitmym/cl_message=>message( id = 'E045(/BITMYM/S4)' v1 = ld_user_status_30 ).
          MESSAGE e045(/bitmym/s4) INTO DATA(ld_msg).
          rd_return = abap_false.
        ENDIF.
      ENDIF.
      CHECK rd_return EQ abap_true.

      "check days to surgery and customizing. Don't allow to change if days left is less than allowed.  (calculated as working days)
      SELECT SINGLE FROM /bitmym/i_reservation_types_sa
      FIELDS daysforclinicalsupport, factorycalendar
       WHERE reservationtype EQ @gs_comwa-rstyp
         AND salesorg EQ @gs_comwa-vkorg
        INTO (@DATA(ld_clinic_support),@DATA(ld_fabkl)).

      DATA(ld_diff) = /bitmym/cl_mym=>working_days_btw_dates( id_fabkl = ld_fabkl
                                                              id_date_from = sy-datum
                                                              id_date_to = gs_comwa-odate ).

      IF ld_diff LT ld_clinic_support OR
        sy-datum GE gs_comwa-odate.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E041(/BITMYM/S4)' v1 = ld_clinic_support ).
        MESSAGE e041(/bitmym/s4) INTO ld_msg.
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD check_field_inventory_items.
*___ SR2-1568, User: SCOSAR, Date: 05.03.2025___*

    rd_return = abap_false.

    CHECK go_act_reservation IS BOUND.

    "Check is CR is not created yet
    DATA(lt_case) = go_act_reservation->get_res_case_for_booking( ).
    CHECK lt_case[] IS INITIAL.

    "Check if booking type is field inventory
    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  ).
    ENDIF.
    go_rstyp->set_data_vkorg( gs_comwa-vkorg ).
    DATA(ls_rstype) = go_rstyp->get_data( )-g_res_type.
    CHECK ls_rstype-rstyp_fld IS NOT INITIAL.

    "Check if all the items are field inventory
    DATA(lt_bitems) = go_act_reservation->get_prop_booking_items( ).
    CHECK NOT line_exists( lt_bitems[ sernr = VALUE gernr( ) abgru = VALUE abgru( ) ] ).

    rd_return = abap_true.
  ENDMETHOD.


  METHOD get_boxes_information.
*___ SR2-1593, User: OOGUR, Date: 16.06.2025___*
*___ SR2-2130, User: OOGUR, Date: 28.07.2025___*


    CHECK gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create OR
          gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.

*       Get the expected tray count.
    IF cs_comwa-exp_boxes IS INITIAL .
      cs_comwa-exp_boxes = get_exp_boxes( i_equnr = cs_comwa-equnr ).
    ENDIF.

*    cs_comwa-recvd_boxes = get_exp_boxes( i_equnr = cs_comwa-equnr i_received = abap_true ).                            "SR2-2130
    cs_comwa-recvd_boxes = get_exp_boxes( i_equnr = cs_comwa-equnr i_zzlresn = cs_comwa-zzlresn i_received = abap_true )."SR2-2130

  ENDMETHOD.


  METHOD get_exp_boxes.
*___ SR2-1593, User: OOGUR, Date: 16.06.2025___*
*___ SR2-2130, User: OOGUR, Date: 28.07.2025___*


    IF i_received EQ abap_true.
      SELECT SINGLE Received_Boxes
        INTO @r_boxesno
        FROM /bitmym/i_pgr_temp
        WHERE equipment   = @i_equnr
          AND username    = @sy-uname
          AND reservation = @i_zzlresn.                     "SR2-2130
      IF sy-subrc <> 0.
        CLEAR r_boxesno.
      ENDIF.
    ELSE.
      SELECT  COUNT( DISTINCT EquipmentBox )
         FROM /bitmym/i_equboxes
         INTO @r_boxesno
         WHERE equipment = @i_equnr.
    ENDIF.


  ENDMETHOD.


  METHOD ui5_check_field_inv_records.
*___ SR2-376, User: OOGUR, Date: 22.10.2024___*

*     In the new field inventory model, find the monitor records from the reservation that shipped the field inventory stock to distributor/agent
*     Field inventory reservations don't have monitor records

    CHECK go_ui5         IS BOUND AND /bitmym/if_ui5~g_mobile_call EQ abap_true.
    CHECK go_application IS BOUND AND go_application->check_field_inv_model( ) = /bitmym/cl_mym=>c_field_inv_model.

    SELECT  SINGLE @abap_true
      FROM /bitmym/book_ref         AS ref_book
      INNER JOIN /sopromet/zzlrv    AS zzlrv
              ON zzlrv~zzlrsam   EQ ref_book~lrsam
             AND zzlrv~vkorg     EQ ref_book~vkorg
      INNER JOIN /bitmym/monitor    AS monitor
              ON zzlrv~srcrs     EQ monitor~zzlresn
      INTO @ed_consumable
      WHERE   ref_book~ref_book  = @iv_zzlresn
        AND   zzlrv~field_inv    = @abap_true                              "field inventory reservation
        AND   monitor~status     = @/bitmym/cl_monitor=>c_status_customer. "at customer

  ENDMETHOD.


  METHOD ui5_get_rep_default_address.
*___ SR2-2529, User: OOGUR, Date: 05.12.2025___*

    CHECK go_appl IS BOUND AND go_appl->check_field_inv_model( ) = /bitmym/cl_mym=>c_field_inv_model
                           AND go_rstyp->get_data( )-g_res_type-rstyp_fld IS NOT INITIAL.

    rv_address =  go_rstyp->get_data( )-gs_rstypo-fld_inv_def_repl_addr.


  ENDMETHOD.


  METHOD get_booking_res_details_int.
*___ SR2-3105, User: STEKDEMIR, Date: 15.04.2026___*

*-> GET dependent Object CombinedRun
    CASE is_comwa-rscat.

      WHEN /sopromet/cl_l_reservation=>c_rscat_b.       " Booking
* We Sync partner only if we have excatly 1 booking per reservation combined run
        SELECT DISTINCT _combinedrun~bookingcombinedrun
          FROM /bitmym/i_bookingnreservation AS _booking
          INNER JOIN /bitmym/i_bookingnreservation AS _combinedrun
          ON    _booking~salesorganization = _combinedrun~salesorganization
          AND   _booking~reservationcombinedrun = _combinedrun~reservationcombinedrun
          WHERE _booking~salesorganization = @is_comwa-vkorg
            AND _booking~booking = @is_comwa-zzlresn
          INTO TABLE @DATA(lt_combinedrun).
        IF sy-dbcnt <> 1.
          RETURN.
        ENDIF.

        "To Get the Reservation's CombinedRun
        SELECT DISTINCT reservationcombinedrun
          FROM /bitmym/i_bookingnreservation
          INTO TABLE @DATA(lt_reservation)
          WHERE salesorganization = @is_comwa-vkorg
            AND booking           = @is_comwa-zzlresn.
        IF sy-subrc EQ 0 AND sy-dbcnt EQ 1.
          ev_combinedrun = VALUE #( lt_reservation[ 1 ]-reservationcombinedrun OPTIONAL ).
        ENDIF.

      WHEN space.
        "To Get the Booking's CombinedRun
        SELECT DISTINCT bookingcombinedrun, booking
          FROM /bitmym/i_bookingnreservation
          INTO TABLE @DATA(lt_booking)
        WHERE salesorganization      = @is_comwa-vkorg
          AND reservationcombinedrun = @is_comwa-zzlrsam
          AND followupbooking        = @space.
        IF sy-subrc EQ 0 AND sy-dbcnt EQ 1.
          ev_combinedrun = VALUE #( lt_booking[ 1 ]-bookingcombinedrun OPTIONAL ).
          ev_reservation = VALUE #( lt_booking[ 1 ]-booking OPTIONAL ).
          ev_rscat = /sopromet/cl_l_reservation=>c_rscat_b.
        ENDIF.
      WHEN OTHERS.
    ENDCASE.

  ENDMETHOD.


  METHOD get_item_cost_price.
*___ SR2-3176 User: KSAMY_EXT, Date: 30.04.2026___*

    CHECK ct_items IS NOT INITIAL.

    DATA(ls_sales_area) = go_salesarea->g_salesarea.

    " Fetch the Plant details
    " for the given materials
    SELECT
      FROM i_product AS a
      INNER JOIN @ct_items AS b
      ON a~product = b~matnr
      FIELDS a~product AS material,
             a~\_ESHProductSalesDelivery[ (1) ]-SupplyingPlant AS Plant
      WHERE a~\_ESHProductSalesDelivery[ (1) ]-ProductSalesOrg = @ls_sales_area-vkorg
      AND   a~\_ESHProductSalesDelivery[ (1) ]-ProductDistributionChnl = @ls_sales_area-vtweg
     INTO TABLE @DATA(lt_product).

    IF sy-subrc EQ 0.

      " Fetch the Standard Unit Price
      " for the given material
      " based on the plant
      SELECT
        FROM i_productvaluation AS a
        INNER JOIN @lt_product AS b
          ON a~Product = b~material
          AND a~ValuationArea = b~plant
        FIELDS a~Product,
               b~plant,
               a~InventoryValuationProcedure AS PriceInd,
               CASE  a~InventoryValuationProcedure
                WHEN 'S' " Standard Price
                  THEN a~StandardPrice
                WHEN 'V'  " Moving Price
                  THEN a~MovingAveragePrice
               END AS Unit_Price,
                a~Currency
        INTO TABLE @DATA(lt_mat_price).

      LOOP AT ct_items ASSIGNING FIELD-SYMBOL(<lfs_item>).

        READ TABLE lt_mat_price INTO DATA(ls_mat_price) WHERE Product = <lfs_item>-matnr.
        IF sy-subrc EQ 0.

          " Modify Unit Price , Currency , Total Price
          <lfs_item>-unit_price = ls_mat_price-unit_price.
          <lfs_item>-currency   = ls_mat_price-currency.
          <lfs_item>-total_price  = <lfs_item>-menge * ls_mat_price-unit_price.

        ENDIF.
      ENDLOOP.


    ENDIF.

  ENDMETHOD.
ENDCLASS.