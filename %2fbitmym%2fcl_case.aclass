    create_dispatch_order( ).
*    create_deliv_dispatch_order( ).
*    COMMIT WORK AND WAIT.  "SR1-332
  ENDIF.

*& "HS# 015536+
ENHANCEMENT-POINT refresh_after_save SPOTS /bitmym/case.


ENDMETHOD.


METHOD case_save_all_dark.
*   HS# 9828, VON Oscar Pecharroman Perez, DATUM: 27.02.2014
*   HS# 9842, VON Oscar Pecharroman Perez, DATUM: 03.11.2014
*   HS# 10053 VON Oscar Pecharroman Perez, DATUM: 23.07.2014
*____HS# 10412,VON: T.Kern, DATUM: 19.05.2015 ___*
*____HS# 10548, VON: J.Lopez, DATUM: 14.08.2015 ___*
*____HS# 10710, VON: S.Taori, DATUM: 02.10.2015____*
*____HS# 11699, VON: KSIVARAMAN, DATUM: 08.03.2017____*
*____HS# 12957, VON: RBoyapati,  DATUM: 08.02.2019____*
*____HS# 014300, VON: STAORI, DATUM: 15.07.2020___*
*____HS# 015929, VON: GIVANOV, DATUM: 14.10.2021___*
*___ SR2-675, User: EDFLORENTINO, Date: 16.09.2024___*
*___ SR2-1030, User: SCOSAR, Date: 24.10.2024___*


  DATA: ls_comwa       TYPE /sopromet/zzls01,
        ls_comwa_pai   TYPE /sopromet/zzls01,
        ls_comwa_route LIKE LINE OF gt_comwa_route,
        ls_equi_data   TYPE rihequi,
        lt_single      TYPE /sopromet/ritems_tab,
        l_auto_check   TYPE abap_bool,
        l_res_data     TYPE /sopromet/zzlrv,
        lo_reservation TYPE REF TO /sopromet/cl_l_reservation,
        lo_equi        TYPE REF TO /sopromet/cl_l_equipment.

  FIELD-SYMBOLS <sets> TYPE /sopromet/zzls06.

  IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.
    gs_case-zzlrsam = gs_comwa-zzlrsam.
    gs_case-rscat = gs_comwa-rscat.                         "HS# 11699
    SET PARAMETER ID '/SOPROMET/ZLS' FIELD gs_comwa-zzlrsam.
  ENDIF.

  get_case_calculated_date( ).                              "HS# 9842

  CALL FUNCTION '/BITMYM/CASE_UPDATE' IN UPDATE TASK
    EXPORTING
      i_trtyp     = gs_comwa-trtyp_o
      is_case_new = gs_case
      is_case_old = gs_case_yy
      i_sales_rep = /bitmym/if_ui5~gs_callerid-kunnr. "SR2-1030

*__Daten an altes myM übergeben

  LOOP AT gt_mat_selection ASSIGNING <sets>.

    CLEAR: lt_single, ls_comwa.

*___Neuanlage von Reservierungen
    CREATE OBJECT lo_reservation
      EXPORTING
        i_equnr         = <sets>-equnr
        i_werks         = gs_comwa-werks
        i_vkorg         = gs_comwa-vkorg
        i_vtweg         = gs_comwa-vtweg
        i_spart         = gs_comwa-spart
        i_equnr_enqueue = 'X'.

    CALL METHOD lo_reservation->get_reservation_data
      IMPORTING
        e_equipment   = lo_equi
        e_reservation = l_res_data.

    ls_equi_data = lo_equi->exp_equi_data( ).

    IF ls_equi_data-eqart = gs_actual_area-eqart_single.
      ls_comwa-kzsir = l_res_data-kzsir = 'X'.

      CALL METHOD lo_reservation->set_property
        EXPORTING
          i_feld  = 'KZSIR'
          i_value = 'X'.

      CALL METHOD lo_reservation->set_property
        EXPORTING
          i_feld  = 'GO_APPLICATION'
          i_value = go_appl.

*> Single Items
      lo_reservation->read_single_items( i_no_add = abap_true ). " HS#10053

      lo_reservation->get_property( EXPORTING i_feld = 'GT_SINGLE_ITEMS' IMPORTING e_value = lt_single ).
    ENDIF.

*___COMWA aufbauen
    MOVE-CORRESPONDING ls_equi_data TO ls_comwa.
    MOVE-CORRESPONDING gs_case      TO ls_comwa.

    ls_comwa-xcons     = fill_xcons_flag( ).
    ls_comwa-kzmonitor = fill_kzmonitor( ).
    ls_comwa-hard_allocated = <sets>-hard_allocated.        "HS# 015929

*___Partnerdaten
    new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ).

    ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006
                                                                    id_comwa = gs_comwa ). "HS 12957

    IF go_ui5 IS BOUND.                                                                                                "SR2-675
      /bitmym/cl_message=>message(  EXPORTING id = 'S754(/SOPROMET/ZL)' v1 = ls_equi_data-equnr v2 = ls_comwa-zzlresn  "SR2-675
                                              v3 = ls_equi_data-swerk io_log = go_ui5->get_data( )-go_appl_log ).      "SR2-675
    ENDIF.                                                                                                             "SR2-675

    l_auto_check = abap_true.

    ls_comwa-werks   = ls_equi_data-swerk.
    READ TABLE gt_comwa_route INTO ls_comwa
                    WITH KEY equnr = ls_comwa_pai-equnr.
    IF sy-subrc EQ 0.
      MOVE: ls_comwa-vdate TO ls_comwa_pai-vdate,
            ls_comwa-rdate TO ls_comwa_pai-rdate,
            ls_comwa-abdat TO ls_comwa_pai-abdat,
            ls_comwa-frdat TO ls_comwa_pai-frdat.
    ENDIF.

    set_reference_resnr( CHANGING c_comwa = ls_comwa ).     "HS# 10412

    CALL METHOD /sopromet/ex_handler=>ex_pbo_reservation
      CHANGING
        i_zzls01 = ls_comwa.

    ls_comwa-trtyp_o = ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_create.

    IF it_single IS NOT INITIAL.                            "HS 10710
      lt_single = it_single.                                "HS 10710
    ENDIF.                                                  "HS 10710

*    HS# 10548
ENHANCEMENT-POINT case_reservation_before_save SPOTS /bitmym/cl_case .

*__Begin of Comment_________________________________________HS 14300
    CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
      EXPORTING
        i_zzls01            = ls_comwa
        i_post_single_items = 'X'
        i_sales_rep         = /bitmym/if_ui5~gs_callerid-kunnr "SR2-1030
      TABLES
        xsingleitems        = lt_single.
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*    CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*      EXPORTING
*        i_zzls01            = ls_comwa
*        i_post_single_items = 'X'
*      TABLES
*        xsingleitems        = lt_single.
*__End of Insert____________________________________________HS 14300

*___Transfer starten wenn aktiv
*      transfer_post( id_transfer = ld_transfer is_comwa = ls_comwa ).

  ENDLOOP.

  COMMIT WORK.
  partner_save_data( ).   "Partner
  texte_save_data( ).     "Texte
  message_update( ).      "Nachrichten


*___BADI: Refresh Customer data
  CALL METHOD /sopromet/ex_handler=>ex_refresh_after_save
    EXPORTING
      i_master = go_main_2006.

  COMMIT WORK.
ENDMETHOD.


METHOD case_save_final_check.
*____HS# 11141, VON: MKnauer,       DATUM: 05.04.2016 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM: 17.02.2017 ___*
*____HS# 11988, VON: O.Pecharroman, DATUM: 27.07.2017 ___*
*____HS# 12717, VON: STAORI,        DATUM: 10.10.2018___*
*____HS# 014376, VON: OPECHARROMAN, DATUM: 19.01.2021___*
*____HS# 014453, VON: STAORI,       DATUM: 12.10.2020___*
*____HS# 017346, VON: SCOSAR,       DATUM: 18.01.2023___*

  ed_success = abap_true.

  ed_success = check_before_save( ).                        "HS 017346
  check ed_success EQ abap_true.                            "HS 017346

  IF gs_comwa-kunnr IS INITIAL.
    MESSAGE i112(vp)  INTO gd_dummy_message.                "HS# 11637
    call_message.                                           "HS# 11637
    ed_success = abap_false.
    EXIT.
  ENDIF.

  IF single_item_check_before_save( ) EQ abap_true.         "HS 14453
    ed_success = abap_false.                                "HS 14453
    EXIT.                                                   "HS 14453
  ENDIF.                                                    "HS 14453

  ed_success = reallocation_exit_handling( ).               "HS 12717

  check_booking_items_empty(  ).                            "HS# 014376

* New enhancement HS# 11988
ENHANCEMENT-POINT case_save_final_check SPOTS /bitmym/cl_case .

ENDMETHOD.


  method case_save_iconnect.
*____HS# 11248, VON: DEndres,     DATUM: 22.06.2016___*
*____HS# 11328, VON: DENDRES,     DATUM: 16.08.2015___*
*____HS# 11699, VON: KSIVARAMAN,  DATUM: 08.03.2017___*
*____HS# 11467, VON: DENDRES,     DATUM: 02.05.2017___*
*____HS# 14300, VON: STAORI,      DATUM: 15.07.2020___*

    data: ls_comwa       type /sopromet/zzls01,
          ls_comwa_pai   type /sopromet/zzls01,
          ls_comwa_route like line of gt_comwa_route,
          ls_equi_data   type rihequi,
          lt_single      type /sopromet/ritems_tab,
          l_auto_check   type abap_bool,
          l_res_data     type /sopromet/zzlrv,
          lo_reservation type ref to /sopromet/cl_l_reservation,
          lo_equi        type ref to /sopromet/cl_l_equipment.

    field-symbols <sets> type /sopromet/zzls06.

    if gs_comwa-trtyp_o eq /bitmym/cl_mym=>c_trtyp_create.
      gs_case-rscat = gs_comwa-rscat.      "HS# 11699
      gs_case-zzlrsam = gs_comwa-zzlrsam.
      set parameter id '/SOPROMET/ZLS' field gs_comwa-zzlrsam.
    endif.
    move-corresponding gs_comwa to ls_comwa.
    get_case_calculated_date( ).                            "HS# 9842

    data: ls_comwa_appl like ls_comwa.
    go_appl->get_property(
      exporting
        i_feld  = 'GS_COMWA'
      importing
        e_value = ls_comwa_appl ).
*    ls_comwa_appl =
    gs_comwa-rscat = ls_comwa-rscat =  /sopromet/cl_l_reservation=>c_rscat_b.
    ls_comwa-kunnr = gs_comwa-kunnr.
    ls_comwa-odate = gs_case-odate = gs_comwa-odate = ls_comwa_appl-odate.
    ls_comwa-vdate = gs_case-vdate = gs_comwa-vdate = ls_comwa_appl-vdate.
    ls_comwa-frdat = gs_case-frdat = gs_comwa-frdat = ls_comwa_appl-frdat.
    ls_comwa-rdate = gs_case-rdate = gs_comwa-rdate = ls_comwa_appl-rdate.
    ls_comwa-abdat = gs_case-abdat = gs_comwa-abdat = ls_comwa_appl-abdat.
    ls_comwa-vedat = gs_case-vedat = gs_comwa-vedat = ls_comwa_appl-vedat.

    if gs_comwa-kunnr is not initial.
      go_appl->pai_kunnr_input( is_comwa = gs_comwa id_no_dialog = abap_true ).
    endif.

    call function '/BITMYM/CASE_UPDATE' in update task
      exporting
        i_trtyp     = gs_comwa-trtyp_o
        is_case_new = gs_case
        is_case_old = gs_case_yy.

    loop at gt_mat_selection assigning <sets>.

      clear: lt_single, ls_comwa.

*___Neuanlage von Reservierungen
      create object lo_reservation
        exporting
          i_zzlresn       = ls_comwa-zzlresn
          i_equnr         = <sets>-equnr
          i_werks         = gs_comwa-werks
          i_vkorg         = gs_comwa-vkorg
          i_vtweg         = gs_comwa-vtweg
          i_spart         = gs_comwa-spart
          i_equnr_enqueue = 'X'.

      call method lo_reservation->get_reservation_data
        importing
          e_equipment   = lo_equi
          e_reservation = l_res_data.

      ls_equi_data = lo_equi->exp_equi_data( ).

      if ls_equi_data-eqart = gs_actual_area-eqart_single.
        ls_comwa-kzsir = l_res_data-kzsir = 'X'.

        call method lo_reservation->set_property
          exporting
            i_feld  = 'KZSIR'
            i_value = 'X'.

        call method lo_reservation->set_property
          exporting
            i_feld  = 'GO_APPLICATION'
            i_value = go_appl.

*> Single Items
        lo_reservation->read_single_items( i_no_add = abap_true ). " HS#10053

        lo_reservation->get_property( exporting i_feld = 'GT_SINGLE_ITEMS' importing e_value = lt_single ).
      endif.

*___COMWA aufbauen
      move-corresponding ls_equi_data to ls_comwa.
      move-corresponding gs_case      to ls_comwa.

      ls_comwa-xcons     = fill_xcons_flag( ).
      ls_comwa-kzmonitor = fill_kzmonitor( ).

*___Partnerdaten

      me->set_property( i_feld = 'GS_COMWA-KUNNR'  i_value = gs_comwa-kunnr ).
      me->set_property( i_feld = 'GS_COMWA-KUNWE'  i_value = gs_comwa-kunwe ).
      ls_comwa-kunnr = gs_comwa-kunnr.
      ls_comwa-kunwe = gs_comwa-kunwe.
      new_reservation_fill_partner_d( changing cs_comwa = ls_comwa ).
      ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 id_comwa = gs_comwa ).
      l_auto_check = abap_true.

      ls_comwa-werks   = ls_equi_data-swerk.
      read table gt_comwa_route into ls_comwa
                      with key equnr = ls_comwa_pai-equnr.
      if sy-subrc eq 0.
        move: ls_comwa-vdate to ls_comwa_pai-vdate,
              ls_comwa-rdate to ls_comwa_pai-rdate,
              ls_comwa-abdat to ls_comwa_pai-abdat,
              ls_comwa-frdat to ls_comwa_pai-frdat.
      endif.

      set_reference_resnr( changing c_comwa = ls_comwa ).   "HS# 10412

      call method /sopromet/ex_handler=>ex_pbo_reservation
        changing
          i_zzls01 = ls_comwa.

      ls_comwa-trtyp_o = ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_create.

      if it_single is not initial.                          "HS 10710
        lt_single = it_single.                              "HS 10710
      endif.                                                "HS 10710
      if it_bookings is not initial.
        ls_comwa-kunnr = gs_comwa-kunnr.
        ls_comwa-opkra = gs_comwa-opkra.
        ls_comwa-opman = gs_comwa-opman.
        ls_comwa-vkorg = gs_comwa-vkorg."'0001'. "HS 11248
        ls_comwa-vtweg = gs_comwa-vtweg."'01'.   "HS 11248
        ls_comwa-spart = gs_comwa-spart."'01'.   "HS 11248
        ls_comwa-rscat = /sopromet/cl_l_reservation=>C_RSCAT_B."'B'. "HS 11248

        ls_comwa-vedat_ts = gs_comwa-vedat_ts. "HS 11467
        ls_comwa-odate_ts = gs_comwa-odate_ts. "HS 11467

        data: lt_bookings like it_bookings,
              lv_posnr    type posnr value 0.
*        lt_bookings = go_act_reservation->get_prop_booking_items( ).
        field-symbols: <booking> like line of it_bookings.

        lt_bookings = it_bookings.

        loop at lt_bookings assigning <booking>.
          lv_posnr = lv_posnr + 10.
          <booking>-posnr = lv_posnr.
          <booking>-lresn = ls_comwa-zzlresn.
        endloop.
      endif.

*__Begin of Comment_________________________________________HS 14300
      call function '/SOPROMET/RESERVATION_SAVE' in update task
        exporting
          i_zzls01            = ls_comwa
          i_post_single_items = 'X'
        tables
          xsingleitems        = lt_single
          xbookings           = lt_bookings.
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*      call function '/BITMYM/RESERVATION_SAVE' in update task
*        exporting
*          i_zzls01            = ls_comwa
*          i_post_single_items = 'X'
*        tables
*          xsingleitems        = lt_single
*          xbookings           = lt_bookings.
*__End of Insert____________________________________________HS 14300

    endloop.
    rv_lresn = ls_comwa-zzlresn.
*    commit work.
    partner_save_data( ).   "Partner
    texte_save_data( ).     "Texte
    message_update( ).      "Nachrichten

**___BADI: Refresh Customer data "HS 11248
*    call method /sopromet/ex_handler=>ex_refresh_after_save "HS 11248
*      exporting "HS 11248
*        i_master = go_main_2006. "HS 11248

    commit work.


  endmethod.


  METHOD convert_atp_icon.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*

    DATA: l_icon TYPE char30.

    CASE id_status.
      WHEN '3'.
        l_icon    = /sopromet/cl_l_reservation=>c_icon_green.

      WHEN '2'.
        l_icon = /sopromet/cl_l_reservation=>c_icon_yellow.

      WHEN '1'.
        l_icon = /sopromet/cl_l_reservation=>c_icon_red.

      WHEN '0'.
        " single items (No ATP)
        l_icon = /sopromet/cl_l_reservation=>c_icon_inactive.

    ENDCASE.

    CALL FUNCTION 'ICON_CREATE'
      EXPORTING
        name                  = l_icon
        add_stdinf            = space
      IMPORTING
        result                = e_icon
      EXCEPTIONS
        icon_not_found        = 1
        outputfield_too_short = 2
        OTHERS                = 3.

  ENDMETHOD.


METHOD case_save_reservations.
*    HS# 9842,   VON O.Pecharroman,   DATUM: 03.11.2014 ___*
*____HS# 9882,   VON:MKnauer,         DATUM: 28.03.2014 ___*
*____HS# 10059,  VON: ireddies,       DATUM: 12.08.2014 ___*
