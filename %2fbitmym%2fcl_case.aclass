  METHOD ui5_s4h_create_quotation.
*___ SR1-1987, User: PKSHIRSAGAR, Date: 01.12.2023___*


    DATA: lo_case     TYPE REF TO /bitmym/cl_case,
          lv_released TYPE abap_bool.
  DATA: ls_data_ui5        TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.
    SELECT SINGLE zzlrsam
      FROM /sopromet/zzlrv
      WHERE zzlresn = @i_zzlresn
      INTO @DATA(lv_zzlrsam).
    CHECK sy-subrc = 0.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = lv_zzlrsam id_reservation = i_zzlresn io_ui5 = io_ui5 ).

*___create Quotation
    IF lo_case IS NOT INITIAL.
      lo_case->create_quotation(
*        EXPORTING
*          i_no_display    =
*        RECEIVING
*          e_order_created =
      ).
    ENDIF.



    IO_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    IF ls_data_ui5 IS NOT INITIAL.
      lo_case->ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).
    ENDIF.

  ENDMETHOD.


  METHOD prepare_booking_ship_to.
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*

    DATA: lt_rstyp_vkorg TYPE TABLE OF  /sopromet/rstypo,
          ls_knvv        TYPE knvv.

    IF lines( gt_vbpa ) = 0.
      IF lines( it_ui5_vbpa ) > 0.
        LOOP AT it_ui5_vbpa INTO DATA(ls_ui5_vbpa).
          APPEND INITIAL LINE TO gt_vbpa ASSIGNING FIELD-SYMBOL(<gt_vbpa>).
          MOVE-CORRESPONDING ls_ui5_vbpa TO <gt_vbpa>.
        ENDLOOP.
      ELSEIF lines( it_partner ) > 0.
        LOOP AT it_partner INTO DATA(ls_partner).
          APPEND INITIAL LINE TO gt_vbpa ASSIGNING <gt_vbpa>.
          MOVE-CORRESPONDING ls_partner TO <gt_vbpa>.
        ENDLOOP.
      ENDIF.

      IF go_partner IS BOUND.
        set_property go_partner 'GT_VBPA' gt_vbpa.
      ENDIF.
    ENDIF.

    IF cs_comwa-kunwe IS INITIAL.
      READ TABLE it_ui5_vbpa INTO DATA(ls_vbpa) WITH KEY parvw = /bitmym/cl_partner=>c_parvw_we.
      IF sy-subrc = 0.
        cs_comwa-kunwe = ls_vbpa-kunnr.
      ENDIF.
    ENDIF.

  ENDMETHOD.


