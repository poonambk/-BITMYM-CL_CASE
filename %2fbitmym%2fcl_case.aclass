METHOD partner_selection.
*____HS# 10710, VON: S.Taori, DATUM: 02.10.2015____*
*____HS# 12461, VON: SSingh,  DATUM: 17.04.2018____*
*___ SR2-259, User: STEKDEMIR, Date: 15.03.2024___*

  ed_success = abap_true.
  ed_success = go_partner->partner_selection( id_no_dialog     = id_no_dialog
                                              id_suppress_mess = id_suppress_mess "HS 10710  HS # 12461
                                              id_changed       = id_changed        "SR2-259
                                              id_new_partner   = id_new_partner ). "SR2-259

  CHECK ed_success EQ abap_true.                            "HS 12461
  go_appl->set_property( i_feld = 'GS_COMWA-KUNWE'  i_value = gs_comwa-kunwe ).
  go_appl->set_property( i_feld = 'GS_COMWA-KUNNR'  i_value = gs_comwa-kunnr ).

ENDMETHOD.


METHOD perpare_single_item.
  DATA: ls_area    TYPE /sopromet/zzl01,
        ls_equi    TYPE v_equi.

*> HS#9770; T.Kern - 30.01.2014

  FIELD-SYMBOLS: <selection> TYPE /sopromet/zzls06.

  e_single_found = abap_false.

  IF gd_mixed IS INITIAL.
    CLEAR gt_mat_selection.
  ENDIF.

  get_property go_salesarea 'GS_ACTUAL_AREA' ls_area.

  CALL FUNCTION '/SOPROMET/SINGLE_GET_EQUNR'
    EXPORTING
      i_vkorg = ls_area-vkorg
      i_vtweg = ls_area-vtweg
      i_spart = ls_area-spart
    IMPORTING
      e_vequi = ls_equi.

  IF ls_equi IS NOT INITIAL.
    APPEND INITIAL LINE TO gt_mat_selection ASSIGNING <selection>.
    <selection>-equnr = ls_equi-equnr.
    e_single_found = abap_true.
  ENDIF.

ENDMETHOD.


  METHOD populate_equi_status_find_set.
*____HS# 12469, VON: STAORI,  DATUM: 19.07.2018___*
*____HS# 13852, VON: MKNAUER, DATUM: 11.03.2020___*

    DATA: lo_rstyp       TYPE REF TO  /sopromet/cl_l_res_type,
          ld_read_status TYPE abap_bool,
          ls_res_type    TYPE /sopromet/rstype.


    IF io_case IS BOUND.
      IF io_case->check_rstyp_rental_relevant( ) EQ abap_false.
        ld_read_status = abap_true.
      ELSE.
        ed_txt04 = /sopromet/cl_l_equipment=>c_set_status_frei.
ENHANCEMENT-POINT populate_equi_status_find_set SPOTS /bitmym/cl_case .
      ENDIF.
    ELSE.
      ld_read_status = abap_true.
    ENDIF.

    CHECK ld_read_status = abap_true.

    data(lt_jest) = FILTER #( /sopromet/cl_l_equipment=>gt_jest_all USING KEY objnr WHERE objnr = id_objnr ). "HS# 13852


    CALL FUNCTION '/SOPROMET/STATUS_READ'
      EXPORTING
        i_objnr             = id_objnr
        it_jest             = lt_jest "HS# 13852
        i_no_status_refresh = abap_true "HS# 13852
      IMPORTING
        e_txt30             = ed_txt30
        e_txt04             = ed_txt04
        e_stat              = ed_stat
      EXCEPTIONS
        OTHERS              = 1.

  ENDMETHOD.


method POPUP_RELEASE_METHOD.
  data: lt_par    type STANDARD TABLE OF spar,
        ls_comwa  type /sopromet/zzls01.

  FIELD-SYMBOLS: <par> type spar.

  get_property( exporting i_feld = 'GS_COMWA' importing e_value = ls_comwa ).
  APPEND INITIAL LINE TO lt_par ASSIGNING <par>.
  <par>-param = 'V1'.
  <par>-value = ls_comwa-zzlresn.

 call function 'POPUP_TO_CONFIRM'
    exporting
      titlebar        = text-004
      diagnose_object = '/SOPROMET/EQUIPMENT_RELEASE'
      text_question   = text-frg
      text_button_1   = text-wfl
      icon_button_1   = 'ICON_FINAL_DATE'
      text_button_2   = text-imm
      icon_button_2   = 'ICON_ACTIVATE'
      default_button  = '1'
    importing
      answer          = e_method
    tables
      parameter       = lt_par
    exceptions
      text_not_found  = 1
      others          = 2.
endmethod.


  METHOD we_res_text_dialog.
*____HS# 12960, VON: R.Boyapati, DATUM: 04.02.2019 ___*

    DATA: lv_fcode TYPE sy-ucomm,
          lv_trtyp TYPE trtyp.

    CHECK go_act_reservation IS BOUND.
    go_act_reservation->get_reservation_data( IMPORTING e_trtyp = lv_trtyp ).

    CALL FUNCTION '/BITMYM/APPL_RES_TEXT'
      EXPORTING
        io_case  = me
        id_trtyp = lv_trtyp
      IMPORTING
        e_ucomm  = lv_fcode.

    CHECK lv_fcode EQ 'SAVE'.

    we_refresh_locks_after_save( abap_false ).
  ENDMETHOD.


  METHOD post_gi_dispatch_order.
*____HS# 10648, VON: S.Taori, DATUM: 17.09.2015 ___*
*____HS# 11417, VON: GIvanov, DATUM: 07.10.2016 ___*

    DATA: ls_tvak TYPE tvak,
          ls_likp TYPE likpvb,
          lt_vbfa TYPE STANDARD TABLE OF vbfa,
          ls_vbfa TYPE vbfa,
          lt_work TYPE STANDARD TABLE OF lipov,
          ls_work TYPE lipov,
          lt_succ TYPE STANDARD TABLE OF lipov,
          lt_err  TYPE STANDARD TABLE OF lipov,
          l_wadat TYPE likp-wadat,
          l_vbak  TYPE vbak,
          l_l01   TYPE /sopromet/zzl01,
          l_arbgb	TYPE cmimsg-arbgb,
          l_msgnr TYPE cmimsg-msgnr,
          l_msgty TYPE cmimsg-msgty.

    DATA: ls_log      TYPE bal_s_lgnm,                "HS# 11417 GND
          lo_applog   TYPE REF TO /bitmym/cl_appllog, "HS# 11417 GND
          lv_log_save TYPE abap_bool,                 "HS# 11417 GND
          ls_balmi    TYPE bal_s_msg,                 "HS# 11417 GND
          l_datum(10),                                "HS# 11417 GND
          l_uzeit(8).                                 "HS# 11417 GND

    FIELD-SYMBOLS <vbfa> TYPE vbfa.

    CHECK NOT i_vbeln IS INITIAL.

*> document data
    CALL FUNCTION 'SD_VBAK_SINGLE_READ'
      EXPORTING
        i_vbeln          = i_vbeln
      IMPORTING
        e_vbak           = l_vbak
      EXCEPTIONS
        record_not_found = 1
        OTHERS           = 2.

*> myMEDISET configuration
    CALL FUNCTION '/SOPROMET/READ_ZZL01'
      EXPORTING
        i_vkorg        = l_vbak-vkorg
        i_vtweg        = l_vbak-vtweg
        i_spart        = l_vbak-spart
      IMPORTING
        e_zzl01        = l_l01
      EXCEPTIONS
        no_entry_found = 1
        OTHERS         = 2.

*> order configuration
    SELECT SINGLE * INTO ls_tvak FROM tvak
      WHERE auart = l_vbak-auart.

*begin HS# 11417 GND
*> create application log
    ls_log-extnumber = l_vbak-vkorg.
    lo_applog = /bitmym/cl_appllog=>create( id_subobj = /bitmym/cl_appllog=>c_subobj_goods_movement
                                              is_log    = ls_log ).
*__Einzelnachrichten
    WRITE sy-datum TO l_datum DD/MM/YYYY.
    WRITE sy-uzeit TO l_uzeit USING EDIT MASK '__:__:__'.
    CLEAR ls_balmi.
    ls_balmi-msgid = '/SOPROMET/ZL'.
    ls_balmi-msgno = '431'.
    ls_balmi-msgty = 'I'.
    ls_balmi-msgv1 = i_vbeln.
    ls_balmi-msgv2 = gs_case-zzlrsam.
    ls_balmi-msgv3 = sy-uname.
    CONCATENATE l_datum l_uzeit INTO ls_balmi-msgv4 SEPARATED BY '-'.
    ls_balmi-detlevel = '1'.
    lo_applog->add_single_message( ls_bal_s_msg = ls_balmi ).
*end HS# 11417 GND

*begin HS# 11417 GND
ENHANCEMENT-SECTION post_gi_dispatch_order_001 SPOTS /bitmym/cl_case .
*> document flow
    CALL FUNCTION '/SOPROMET/READ_ORDER_FLOW'
      EXPORTING
        i_vbeln = i_vbeln
      TABLES
        xvbfa   = lt_vbfa.

*> delivery in document flow?
    READ TABLE lt_vbfa ASSIGNING <vbfa> WITH KEY vbelv   = i_vbeln
                                                 vbtyp_n = 'J'.
END-ENHANCEMENT-SECTION.
*end  HS# 11417 GND

*    IF sy-subrc <> 0.                                            *commented by  HS# 11417 GND
    IF <vbfa> IS NOT ASSIGNED.                                                  "HS# 11417 GND
      IF NOT ls_tvak-lisof IS INITIAL.
        CALL METHOD /sopromet/cl_l_message_collect=>add_bapi_error
          EXPORTING
            i_arbgb = 'V1'
            i_msgnr = '262'
            i_msgty = 'E'
            i_msgv1 = i_vbeln.
*begin HS# 11417 GND
*__Einzelnachrichten
        lv_log_save = abap_true.
        CLEAR ls_balmi.
        ls_balmi-msgid = '/SOPROMET/ZL'.
        ls_balmi-msgno = '432'.
        ls_balmi-msgty = 'E'.
        ls_balmi-msgv1 = i_vbeln.
        ls_balmi-detlevel = '2'.
        lo_applog->add_single_message( ls_bal_s_msg = ls_balmi ).
*end HS# 11417 GND

      ENDIF.
    ELSE.

      CALL FUNCTION 'SHP_LIKP_GET_SINGLE'
        EXPORTING
          if_vbeln        = <vbfa>-vbeln
        CHANGING
          cs_likp         = ls_likp
        EXCEPTIONS
          no_record_found = 1
          OTHERS          = 2.

      ls_work-vbeln = <vbfa>-vbeln.
      ls_work-vstel = ls_likp-vstel.
      APPEND ls_work TO lt_work.

*____Prüfen ob breits gebucht: Helpstar #1096
      READ TABLE lt_vbfa ASSIGNING <vbfa> WITH KEY vbelv   = i_vbeln
                                                   vbtyp_n = 'R'.        "Materialbeleg
      CHECK sy-subrc NE 0.


    call function 'WS_LM_GOODS_MOVEMENT'
      exporting
        if_wadat_ist  = l_wadat
        if_bitype     = if_bitype
      tables
        ct_worktab    = lt_work
        et_success    = lt_succ
        et_error      = lt_err
        et_vbfs       = et_vbfs
      exceptions
        no_permission = 1
        others        = 2.

    if sy-subrc <> 0 and if_bitype eq 'E'.
      l_arbgb = sy-msgid.
      l_msgnr = sy-msgno.
      l_msgty = 'E'.
      call method /sopromet/cl_l_message_collect=>add_bapi_error
        exporting
          i_arbgb = l_arbgb
          i_msgnr = l_msgnr
          i_msgty = l_msgty
          i_msgv1 = sy-msgv1
          i_msgv2 = sy-msgv2
          i_msgv3 = sy-msgv3
          i_msgv4 = sy-msgv4.

    endif.

    IF lt_succ IS NOT INITIAL.
        CLEAR ls_balmi.
        ls_balmi-msgid = '/SOPROMET/ZL'.
        ls_balmi-msgno = '433'.           "PGI successful
        ls_balmi-msgty = 'S'.
        ls_balmi-msgv1 = <vbfa>-vbeln.
        ls_balmi-detlevel = '2'.
        lo_applog->add_single_message( ls_bal_s_msg = ls_balmi ).
     ELSE.
        CLEAR ls_balmi.
        ls_balmi-msgid = '/SOPROMET/ZL'.
        ls_balmi-msgno = '437'.           "PGI failed
        ls_balmi-msgty = 'E'.
        ls_balmi-msgv1 = <vbfa>-vbeln.
        ls_balmi-detlevel = '2'.
        lo_applog->add_single_message( ls_bal_s_msg = ls_balmi ).
    ENDIF.

  endif.

*begin HS# 11417 GND
    call method /sopromet/cl_l_message_collect=>add_vbfs
      exporting
        it_vbfs = et_vbfs
        io_appl_log = lo_applog.                                   "HS# 11417 GND added parameter

      lv_log_save = abap_true.                                      "HS# 11417 GND

    IF lv_log_save EQ abap_true.
      lo_applog->log_write_db( ).
    ELSE.
      lo_applog->refresh( ).
    ENDIF.
*end HS# 11417 GND

  ENDMETHOD.


METHOD prepare_single_item.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*

  DATA: ls_equi TYPE v_equi.

  FIELD-SYMBOLS: <equi>  TYPE /sopromet/zzls06..

  e_single_equi_found = abap_false.

  IF i_mixed IS INITIAL.                                    "HS 14145
    CLEAR gt_mat_selection.
  ENDIF.                                                    "HS 14145

  CALL FUNCTION '/SOPROMET/SINGLE_GET_EQUNR'
    EXPORTING
      i_vkorg = gs_actual_area-vkorg
      i_vtweg = gs_actual_area-vtweg
      i_spart = gs_actual_area-spart
    IMPORTING
      e_vequi = ls_equi.

ENHANCEMENT-POINT prepare_single_item SPOTS /bitmym/case.

  IF NOT ls_equi IS INITIAL.
    APPEND INITIAL LINE TO gt_mat_selection ASSIGNING <equi>.
    <equi>-equnr = ls_equi-equnr.
    e_single_equi_found = abap_true.
  ENDIF.

ENDMETHOD.


