  ENDMETHOD.


  METHOD ui5_s4h_simulate_res_int.
*___ SR1-1309, User: STEKDEMIR, Date: 19.09.2023___*

    DATA: ls_data_ui5 TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
          lo_screen   TYPE REF TO /bitmym/cl_screen.


    DATA(lo_appl) = NEW /bitmym/cl_mym(  io_ui5 = io_ui5 ).

    io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    MOVE-CORRESPONDING ls_data_ui5 TO gs_case.

    LOOP AT ls_data_ui5-casetoreservation ASSIGNING FIELD-SYMBOL(<reservation>).

      CLEAR gs_comwa.
      MOVE-CORRESPONDING <reservation> TO gs_comwa.

      /bitmym/cl_screen=>create(
        EXPORTING
          io_case   = me
          is_comwa  = gs_comwa
          is_case   = gs_case
          id_dynnr  = '8001'
          id_method = 'PAI_8001_DATES'
        RECEIVING
          eo_screen = lo_screen ).

      CHECK lo_screen IS NOT INITIAL.
      lo_screen->dispatch( ).

      MOVE-CORRESPONDING gs_comwa TO <reservation>.

    ENDLOOP.

    IF ls_data_ui5 IS NOT INITIAL.
      CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.
      /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                        CHANGING cr_data = cr_data ).
    ENDIF.

  ENDMETHOD.


