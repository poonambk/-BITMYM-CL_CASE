  METHOD order_process_fill_consumption.
*___ SR2-84, User: OOGUR, Date: 10.04.2024___*

    DATA: ls_consumption  LIKE LINE OF gt_consumption.

    CHECK 1 = 2 ."After this development canceled this line added.

    CHECK is_tree IS NOT INITIAL.

    DATA(ls_data)         = is_tree-objkey->get_data( ).
    DATA(lt_items_ret)    = ls_data-g_reservation_items_ret.       "keep after change data from screen
    DATA(lt_items_ret_yy) = ls_data-g_reservation_items_ret_yy.    "keep before data from screen



    REFRESH gt_consumption.
    LOOP AT lt_items_ret INTO DATA(ls_items).

      CLEAR ls_consumption.
      ls_consumption-reservation         = ls_items-zzlresn.
      ls_consumption-material            = ls_items-matnr.
      ls_consumption-batch               = ls_items-charg.
      ls_consumption-serial              = ls_items-sernr.
      ls_consumption-tray                = ls_items-tray.
      ls_consumption-uom                 = ls_items-meins.

      IF ls_items-menge_dm IS NOT INITIAL. "Damaged item quantity
        ls_consumption-consumption_type = /bitmym/cl_order_process=>c_consumption_damaged.
        ls_consumption-order_status     = /bitmym/cl_order_process=>c_status_damaged.
        ls_consumption-quantity         = ls_items-menge_dm.
        APPEND ls_consumption TO gt_consumption.
      ENDIF.

      IF ls_items-menge_mi IS NOT INITIAL. "Missing item quantity
        ls_consumption-consumption_type = /bitmym/cl_order_process=>c_consumption_missing.
        ls_consumption-order_status     = /bitmym/cl_order_process=>c_status_missing.
        ls_consumption-quantity         = ls_items-menge_mi.
        APPEND ls_consumption TO gt_consumption.
      ENDIF.

      IF ls_items-menge_we IS NOT INITIAL. "Invoiced quantity
        ls_consumption-consumption_type = /bitmym/cl_order_process=>c_consumption_returned.
        ls_consumption-order_status     = /bitmym/cl_order_process=>c_status_return.
        ls_consumption-quantity         = ls_items-menge_we.
        APPEND ls_consumption TO gt_consumption.
      ENDIF.

    ENDLOOP.


  ENDMETHOD.


