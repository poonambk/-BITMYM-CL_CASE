  METHOD GET_BOOKING_ITEMS_ALLOCATION.
*____HS# 012900, VON: RBOYAPATI, DATUM: 02.04.2019___*

    FIELD-SYMBOLS: <b_item>   TYPE /bitmym/b_items_st,
                   <res>      TYPE /sopromet/zzlrv.

    DATA: lt_res TYPE TABLE OF /sopromet/zzlrv.

    CHECK gs_case-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.

    get_gt_booking_items( IMPORTING et_booking_items = et_booking_items ).

    get_booking_reservations( IMPORTING et_zzlrv = lt_res ).


    LOOP AT et_booking_items ASSIGNING <b_item>.
      <b_item>-asqty = 0.
      <b_item>-openqty = <b_item>-menge.

      " For now ignoring the single items
      "   Look up the reservations created against booking
      LOOP AT lt_res ASSIGNING <res> WHERE matnr = <b_item>-matnr.

        CHECK <b_item>-menge GT <b_item>-asqty.

        ADD 1 TO <b_item>-asqty.
        SUBTRACT 1 FROM <b_item>-openqty.

        DELETE lt_res INDEX sy-tabix.
      ENDLOOP.
    ENDLOOP.

  ENDMETHOD.


  METHOD process_reference.
*____HS# 11017, VON: KSIVARAMAN, DATUM: 01.02.2016____*
*Add/ delete Refrenece

    DATA : lo_case  TYPE REF TO /bitmym/cl_case,
           ls_comwa TYPE /sopromet/zzls01.
    go_appl->get_property( EXPORTING i_feld = 'GO_CASE' IMPORTING e_value = lo_case  ).

    CALL FUNCTION '/BITMYM/APPL_MANAGE_BOOK_REF'
      EXPORTING
        is_comwa    = gs_comwa
        id_del_mode = iv_dis_mode. " If abap_true del mode -> Hide Add Ref button in Pop up.

  ENDMETHOD       .


METHOD read_case.
*____HS# 11004, VON: S.Taori, DATUM: 26.01.2016 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM:  11.04.2017 ___*
*____HS# 12469, VON: MKNAUER, DATUM: 29.06.2018___*
*____HS# 012798, VON: OPECHARROMAN, DATUM: 19.11.2018___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*
*___ SR2-258, User: GIVANOV, Date: 15.03.2024___*

  DATA: ls_res         TYPE /sopromet/zzlrv,
        ls_comwa       TYPE /sopromet/zzls01,
        ld_vkorg       TYPE vkorg,
        lo_area        TYPE REF TO /sopromet/cl_l_salesarea,
        ld_linked      TYPE abap_bool,                      "SR1-545+
        lr_vkorg       TYPE RANGE OF vkorg,                 "SR1-545+
        ls_equi_reser  TYPE /bitmym/s_equi_reserv_list,     "SR1-545+
        ls_actual_area TYPE /sopromet/zzl01.                "SR1-545+

  e_success = abap_false.

  IF go_appl IS NOT INITIAL.
    go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
    go_appl->get_property( EXPORTING i_feld = 'GO_AREA'  IMPORTING e_value = lo_area ).
    IF lo_area      IS BOUND AND
       go_salesarea IS NOT BOUND.
      go_salesarea = lo_area.
      get_property go_salesarea 'GS_ACTUAL_AREA' gs_actual_area.
    ENDIF.
  ENDIF.

  IF gs_comwa-zzlrsam IS NOT INITIAL.
    gd_case = gs_comwa-zzlrsam.
  ENDIF.

  IF ls_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.
*___Anlagemodus => Hier gibt es nix zu lesen
    e_success = abap_true.
    EXIT.
  ENDIF.

  IF gd_case IS INITIAL AND gs_comwa-zzlresn IS NOT INITIAL.
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = gs_comwa-zzlresn
        i_no_buff     = 'X'
      IMPORTING
        e_reservation = ls_res.

    gd_case        = ls_res-zzlrsam.
    gd_reservation = ls_res-zzlresn.
    ld_vkorg       = ls_res-vkorg.

    IF gd_case IS INITIAL.
      MESSAGE i100(/sopromet/zl) WITH gs_comwa-zzlresn INTO gd_dummy_message. "HS# 11637
      call_message.                                         "HS# 11637
    ENDIF.

  ENDIF.

  CHECK gd_case IS NOT INITIAL.

  IF ld_vkorg IS INITIAL.
    ld_vkorg = gs_actual_area-vkorg.
  ENDIF.

* Begin of SR1-545
  IF go_salesarea IS BOUND.
    DATA(lt_linked_areas) = go_salesarea->get_linked_areas( EXPORTING iv_user_only   = abap_true
                                                                      is_actual_area = gs_actual_area
                                                            CHANGING  cv_is_linked   = ld_linked ).
    IF lt_linked_areas IS INITIAL.
      go_salesarea->set_property( EXPORTING i_feld = 'GT_LINKED_AREAS' i_value = lt_linked_areas ).
    ENDIF.

    IF gs_actual_area-umbrella_vkorg = abap_true.
      IF ls_res-vkorg IS INITIAL AND NOT gs_comwa-zzlresn IS INITIAL.
        CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
          EXPORTING
            i_reserv      = gs_comwa-zzlresn
            i_no_buff     = 'X'
          IMPORTING
            e_reservation = ls_res.
        ld_vkorg = ls_res-vkorg.
        APPEND VALUE #( sign = 'I' option = 'EQ' low = ls_res-vkorg ) TO lr_vkorg.
      ELSE.
        get_property go_salesarea 'GR_VKORG' lr_vkorg.
        ld_linked = abap_true.
      ENDIF.
    ELSE.
      APPEND VALUE #( sign = 'I' option = 'EQ' low = gs_actual_area-vkorg ) TO lr_vkorg.
    ENDIF.
  ENDIF.
* End of SR1-545+

*____SR2-258____BEGIN INSERT___*
*___lr_vkorg cannot be empty. If it couldn't determine sales organization on other criterias use what we already have
  IF lr_vkorg IS INITIAL AND ld_vkorg IS NOT INITIAL.
    APPEND VALUE #( sign = 'I' option = 'EQ' low = ld_vkorg ) TO lr_vkorg.
  ENDIF.
*____SR2-258____END   INSERT___*


* Check : - ld_vkorg is the same to the sales area vkorg
*         - ld_vkorg is part of a sales area link                                         "SR1-545
*         - the sales area vkorg is initial.
  CHECK ld_vkorg EQ gs_actual_area-vkorg OR
      ( gs_actual_area-umbrella_vkorg EQ abap_true AND ld_linked = abap_true ) OR "SR1-545
      ( ld_vkorg IS NOT INITIAL AND gs_actual_area-vkorg IS INITIAL ). "HS# 012798

*___CASE lesen
  SELECT SINGLE * INTO gs_case
          FROM  /bitmym/case
*         WHERE  vkorg    = ld_vkorg                                  "SR1-545
         WHERE  vkorg    IN lr_vkorg                        "SR1-545
         AND    zzlrsam  = gd_case.

  IF sy-subrc EQ 0.
    e_success = abap_true.

    MOVE-CORRESPONDING gs_case TO gs_comwa.
    MOVE-CORRESPONDING gs_case TO gs_case_yy.

    IF go_salesarea IS NOT BOUND.
      CREATE OBJECT go_salesarea
        EXPORTING
          i_vkorg = gs_case-vkorg
          i_vtweg = gs_case-vtweg
          i_spart = gs_case-spart.

      get_property go_salesarea 'GS_ACTUAL_AREA' gs_actual_area.
    ENDIF.

* Begin of SR1-545
*    if gs_actual_area-umbrella_vkorg = abap_true.
*      gs_actual_area-vkorg = gs_case-vkorg.
*      gs_actual_area-vtweg = gs_case-vtweg.
*      gs_actual_area-spart = gs_case-spart.
*    endif.
* End of SR1-545

*&* Begin of adding "SR1-545+

    ls_actual_area-vkorg = gs_case-vkorg.
    ls_actual_area-vtweg = gs_case-vtweg.
    ls_actual_area-spart = gs_case-spart.

*    ls_equi_reser-equnr  = ls_res-equnr.
*    ls_equi_reser-lresn  = gd_reservation.
    DATA(ls_area_to_consider) = /bitmym/cl_mym=>get_sales_area_to_consider_ext(
      EXPORTING
        is_sales_area     = ls_actual_area
        id_login_umbrella = gs_actual_area-umbrella_vkorg
        is_equi_reserv    = ls_equi_reser
      CHANGING
        co_appl           = go_appl ).
    IF ls_area_to_consider IS NOT INITIAL.
      gs_actual_area = ls_area_to_consider.
    ENDIF.
*&* End of adding "SR1-545+

    read_partner( ).
*___Reservierungen lesen
    IF id_with_reservations EQ abap_true.
      read_reservations( id_no_status_refresh = id_no_status_refresh ). "HS 11004
    ENDIF.

    go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_case-vkorg i_rstyp = gs_case-rstyp ). "HS# 12469
  ENDIF.

ENDMETHOD.


  METHOD reallocation_exit_handling.
*____HS# 12717, VON: STAORI, DATUM: 09.10.2018___*
*____HS# 12922, VON: STAORI, DATUM: 19.08.2019___*

    DATA: ld_answer,
          ld_hard_stop_res TYPE abap_bool.

    FIELD-SYMBOLS: <fs_res> TYPE /sopromet/ty_tree_map.

    e_check = abap_true.

    CHECK gs_comwa-rscat IS INITIAL.

*__Check if any of the reservation has HARD_STOP flagged due to unsolved intersection
    LOOP AT gt_reservations ASSIGNING <fs_res>.
      get_property <fs_res>-objkey 'GD_INTERSECTION_HARD_STOP' ld_hard_stop_res.
      CHECK ld_hard_stop_res IS NOT INITIAL.
      EXIT.
    ENDLOOP.

    CHECK ld_hard_stop_res IS NOT INITIAL.

*__Only exit possible. Check if user wants to stay in change mode or go out without saving

    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        titlebar              = TEXT-r06
        text_question         = TEXT-r01
        text_button_1         = 'Yes'(r02)
        text_button_2         = 'No'(r03)
        default_button        = '1'
        display_cancel_button = abap_false
        popup_type            = 'ICON_CANCEL'
        iv_quickinfo_button_1 = TEXT-r04 "'Exits the reservation screen'
        iv_quickinfo_button_2 = TEXT-r05 "'Remain on the reservation screen'
      IMPORTING
        answer                = ld_answer
      EXCEPTIONS
        text_not_found        = 1.

    IF ld_answer EQ 1.
      REFRESH: gt_realloc_final.                            "HS 12922
      LEAVE TO SCREEN 0.
    ELSE.
      e_check = abap_false.
    ENDIF.
  ENDMETHOD.


METHOD read_partner.
*
*
*
*___ SR1-1105, User: SCOSAR, Date: 25.01.2024___*
*___ SR2-2880, User: SCOSAR, Date: 10.03.2026___*


  CALL FUNCTION '/BITMYM/DB_READ_CASE_PARTNER'
    EXPORTING
      id_vkorg   = gs_comwa-vkorg
      id_case    = gd_case
      id_no_buff = 'X'
    IMPORTING
      et_partner = gt_partner.

*____SR1-1105____BEGIN INSERT___*
  IF gs_comwa-kunnr IS INITIAL.
    gs_comwa-kunnr = VALUE #( gt_partner[ parvw = /bitmym/cl_partner=>c_parvw_ag ]-kunnr OPTIONAL ).
  ENDIF.
  IF gs_comwa-kunwe IS INITIAL.
    gs_comwa-kunwe = VALUE #( gt_partner[ parvw = /bitmym/cl_partner=>c_parvw_we ]-kunnr OPTIONAL ).
  ENDIF.
*____SR1-1105____END   INSERT___*
*____SR2-2880____BEGIN INSERT___*
  IF gs_comwa-kunnr_sb IS INITIAL.
    gs_comwa-kunnr_sb = VALUE #( gt_partner[ parvw = /bitmym/cl_partner=>c_parvw_sb ]-kunnr OPTIONAL ).
  ENDIF.
*____SR2-2880____END   INSERT___*

ENDMETHOD.


METHOD read_reservations.
*____HS# 9990,  VON: MKnauer, DATUM: 24.06.2014 ___*
*____HS# 11004, VON: S.Taori, DATUM: 26.01.2016 ___*
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*

  DATA: lt_reserv TYPE STANDARD TABLE OF /sopromet/zzlrv,
        lo_res    TYPE REF TO /sopromet/cl_l_reservation,
        ls_res    TYPE /sopromet/zzlrv,
        ls_equi   TYPE rihequi,
        lo_equi   TYPE REF TO  /sopromet/cl_l_equipment.

  FIELD-SYMBOLS: <res>  TYPE /sopromet/zzlrv,
                 <data> TYPE /sopromet/ty_tree_map.

  SELECT * INTO TABLE lt_reserv FROM  /sopromet/zzlrv
         WHERE  vkorg    = gs_actual_area-vkorg
         AND    zzlrsam  = gd_case
         ORDER BY zzlresn.                                  "HS# 9990

*___"HS# 9990___New Enhancement
ENHANCEMENT-POINT read_reservations_sort SPOTS /bitmym/cl_case .


  CHECK sy-subrc EQ 0.

  LOOP AT lt_reserv ASSIGNING <res>.

    lo_res = /sopromet/cl_l_reservation=>create_pending( id_pending           = <res>-kzper
                                                         id_no_status_refresh = id_no_status_refresh "HS 11004
                                                         io_ui5               = go_ui5               "HS 12493
                                                         id_reservation       = <res>-zzlresn ).

*    CREATE OBJECT lo_res
*      EXPORTING
*        i_zzlresn = <res>-zzlresn.

    CALL METHOD lo_res->get_reservation_data
      IMPORTING
        e_reservation = ls_res
        e_equipment   = lo_equi.

    ls_equi = lo_equi->exp_equi_data( ).
    APPEND INITIAL LINE TO gt_reservations ASSIGNING <data>.

    MOVE-CORRESPONDING ls_res  TO <data>.
    MOVE-CORRESPONDING ls_equi TO <data>.
    <data>-objkey = lo_res.
    <data>-lresrv = ls_res-zzlresn.
    <data>-lrsam  = gd_case.

  ENDLOOP.

  gt_reservations_yy = gt_reservations.

ENDMETHOD.


METHOD read_reservation_type.
*____HS# 014629, VON: MKNAUER, DATUM: 30.10.2020___*

  DATA: ls_type  TYPE /sopromet/rstype,
        ls_typeo TYPE /sopromet/rstypo.

  CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
    EXPORTING
      i_rstyp = gs_comwa-rstyp
    IMPORTING
      e_data  = ls_type.

  CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
    EXPORTING
      i_rstyp = gs_comwa-rstyp
      i_vkorg = gs_comwa-vkorg
    IMPORTING
      e_data  = ls_typeo.

  gs_comwa-kzdus     = ls_type-kzdus.
  gs_comwa-bcategory = ls_type-bcategory.                   "HS# 014629

ENDMETHOD.


  METHOD reallocation_get_entries.
*____HS# 12717, VON: STAORI, DATUM: 18.10.2018___*

    et_realloc = gt_realloc_final.
  ENDMETHOD.


  METHOD reallocation_log_display.
*____HS# 12717, VON: STAORI, DATUM: 10.10.2018___*
*____HS# 13053, VON: STAORI, DATUM: 08.05.2019___*
*___ SR2-618, User: PKSHIRSAGAR, Date: 06.08.2024___*

    DATA: lt_map                TYPE /sopromet/ty_tree_map_tab,
          ls_reservation        TYPE /sopromet/zzlrv,
          ld_reallocation_error TYPE abap_bool,
          ld_hard_stop_res      TYPE abap_bool,
          lo_log                TYPE REF TO /bitmym/cl_appllog,
          ls_log                TYPE bal_s_msg.

    FIELD-SYMBOLS: <fs_map> TYPE /sopromet/ty_tree_map.

    get_property go_tree_case 'GT_NODE_MAP'  lt_map.
*____SR2-618____BEGIN INSERT___*
    IF go_ui5 IS NOT BOUND.
      /bitmym/cl_appllog=>init( ).
      lo_log = /bitmym/cl_appllog=>create( id_subobj = /bitmym/cl_appllog=>c_subobj_reservation
                                           io_appl   = go_appl ).
    ELSE.
      lo_log = go_ui5->get_data( )-go_appl_log.
    ENDIF.
*____SR2-618____END   INSERT___*

    LOOP AT lt_map ASSIGNING <fs_map>.

      get_property <fs_map>-objkey 'GD_INTERSECTION_HARD_STOP' ld_hard_stop_res.
      CHECK ld_hard_stop_res IS NOT INITIAL.

      ld_reallocation_error = abap_true.        "SR2-618

      get_property <fs_map>-objkey 'G_RESERVATION'  ls_reservation.

*____SR2-618____BEGIN COMMENT___*
*      IF ld_reallocation_error IS INITIAL.
*        /bitmym/cl_appllog=>init( ).
*        lo_log = /bitmym/cl_appllog=>create( id_subobj = /bitmym/cl_appllog=>c_subobj_reservation
*                                             io_appl   = go_appl ).
*        ld_reallocation_error = abap_true.
*      ENDIF.
*
*      CHECK ld_reallocation_error = abap_true.
*____SR2-618____END   COMMENT___*


*      /bitmym/cl_message=>message( id = 'E483(/SOPROMET/ZL)'  io_log = lo_log v1 = ls_reservation-zzlresn v2 = ls_reservation-equnr v3 = ls_reservation-matnr ). "HS 13053
      /bitmym/cl_message=>message( id     = 'E483(/SOPROMET/ZL)'
                                   io_log = lo_log
                                   v1     = ls_reservation-zzlresn
                                   v2     = ls_reservation-equnr
                                   v3     = ls_reservation-matnr
                                   v4     = ls_reservation-sernr ). "HS 13053


    ENDLOOP.

    CHECK ld_reallocation_error IS NOT INITIAL.
    CHECK go_ui5 IS NOT BOUND. "SR2-618

    lo_log->log_display( ).
    lo_log->refresh( ).

  ENDMETHOD.


  METHOD reallocation_reservations_updt.
*____HS# 12717, VON: STAORI, DATUM: 09.10.2018___*
*____HS# 012768, VON: OPECHARROMAN, DATUM: 26.10.2018___*
*____HS# 014145, VON: GIVANOV, DATUM: 29.10.2020___*

    DATA: lo_res     TYPE REF TO /sopromet/cl_l_reservation,
          ls_act_res TYPE /sopromet/zzlrv,
          ls_rstypo	 TYPE /sopromet/rstypo,
          ls_res_pbo TYPE /sopromet/zzlrv,
          ls_res_pai TYPE /sopromet/zzlrv,
          ls_equi    TYPE equi.

    FIELD-SYMBOLS: <res_upd> TYPE /bitmym/realloc_repl_equi_info.

    CHECK go_rstyp IS BOUND.
    get_property go_rstyp           'GS_RSTYPO'     ls_rstypo.

    CHECK go_act_reservation  IS BOUND.                     "HS 12768

    get_property go_act_reservation 'G_RESERVATION' ls_act_res.

*__Check if reallocation at intersection is activated
    CHECK ls_rstypo-alloc_xsctn IS NOT INITIAL.

    LOOP AT gt_realloc_final ASSIGNING <res_upd>.
      IF <res_upd>-res NE ls_act_res-zzlresn.
        CREATE OBJECT lo_res
          EXPORTING
            i_zzlresn = <res_upd>-res.

        lo_res->get_reservation_data( IMPORTING e_reservation = ls_res_pbo ).
        ls_res_pai       = ls_res_pbo.
      ELSE.
        ls_res_pai       = ls_act_res.
      ENDIF.
      ls_res_pai-equnr = <res_upd>-equi_repl.

      SELECT SINGLE *
        FROM equi
        INTO ls_equi
       WHERE equnr = <res_upd>-equi_repl.

      ls_res_pai-sernr = ls_equi-sernr.

*____HS# 014145
ENHANCEMENT-POINT REALLOCATION_RESERVATIONS_UPDT SPOTS /BITMYM/CL_CASE .

      CALL FUNCTION '/SOPROMET/POST_ZZLRV' IN UPDATE TASK
        EXPORTING
          n_zzlrv = ls_res_pai
          y_zzlrv = ls_res_pbo.

      CALL FUNCTION '/BITMYM/REALLOC_RESTAT_UPD_EQU' IN UPDATE TASK
        EXPORTING
          id_reservation = <res_upd>-res
          id_new_equnr   = <res_upd>-equi_repl.

    ENDLOOP.

    REFRESH: gt_realloc_final.
  ENDMETHOD.


  METHOD reallocation_set_entries.
*____HS# 12717, VON: STAORI, DATUM: 18.10.2018___*

    gt_realloc_final = it_realloc.
  ENDMETHOD.


method SET_BOOK_DATA_FROM_REF.
**____HS# 012705, VON: OPECHARROMAN, DATUM: 08.10.2018___*
    data:  ls_common_res_to_book TYPE /bitmym/common_res_to_book,
           ls_common_case_to_book TYPE /bitmym/common_case_to_book.

*___Step 1: Fill CASE COMWA + APPL COMWA and create mode
    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_b.
    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.

*   Move common fields from reservation case to booking case
    MOVE-CORRESPONDING is_data-casedata to ls_common_case_to_book.
    MOVE-CORRESPONDING ls_common_case_to_book to gs_comwa.

*   Move common fields from reservation to booking
    MOVE-CORRESPONDING is_data to ls_common_res_to_book.
    MOVE-CORRESPONDING ls_common_res_to_book to gs_comwa.

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize to application

endmethod.


METHOD reference_booking_calc_dates.
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 16.09.2015____*
*____HS# 11446, VON: O.Pecharroman Perez, DATUM: - 25.10.2016
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 12445, VON: O.Pecharroman, DATUM:  10.04.2018 ___*
*____HS# 013137, VON: OPECHARROMAN, DATUM: 17.05.2019___*
*____HS# 012765, VON: DENDRES, DATUM: 03.09.2019___*
*____HS# 016825, VON: BGUNAWAN, DATUM: 01.06.2022___*
*___ SR2-912, User: STEKDEMIR, Date: 11.10.2024___*

  DATA: lo_res    TYPE REF TO /sopromet/cl_l_reservation,
        ls_comwa  TYPE /sopromet/zzls01,
        lds_res   TYPE /sopromet/zzlrv,
        ls_common TYPE /bitmym/case_common_date,            "HS# 013137
        ls_route  TYPE /bitmym/routes_calculated_tab.

  CHECK gs_comwa-ref_book IS NOT INITIAL.

  CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
    EXPORTING
      i_reserv      = gs_comwa-ref_book
*     I_NO_BUFF     =
    IMPORTING
      e_reservation = lds_res.

  gs_comwa-odate = lds_res-odate.
  gs_comwa-vsbeb = lds_res-vsbeb.
  gs_comwa-vdate = lds_res-vdate.
  gs_comwa-vedat = lds_res-vedat.                           "HS# 11446
  gs_comwa-vtime = lds_res-vtime.                           "HS# 012765
  gs_comwa-prsdt = lds_res-prsdt.                           "HS# 016825
  gs_comwa-edatu = lds_res-edatu.                           "SR2-912

  go_partner = /bitmym/cl_partner=>create( io_case = me ).  "HS# 12445
  go_partner->set_book_partner_comwa( CHANGING c_comwa = gs_comwa ). "HS# 12445

ENHANCEMENT-POINT reference_booking_calc_dates SPOTS /bitmym/case .
  IF id_without_selection IS INITIAL AND
     gs_comwa-vedat LT sy-datlo.
    MESSAGE i322(/sopromet/zl) WITH gs_comwa-vedat INTO gd_dummy_message. "HS# 11637
    call_message.                                           "HS# 11637
    ed_success = abap_true.
  ENDIF.

  go_appl->set_property( i_feld = 'GS_COMWA' i_value = gs_comwa ).

  CREATE OBJECT lo_res
    EXPORTING
      i_no_status_read = 'X'
      id_no_equi_read  = abap_true.

  CHECK lo_res IS BOUND.

  lo_res->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).
  lo_res->set_property( i_feld = 'GT_ROUTE' i_value = ls_route ).
  ls_comwa = lo_res->day_compute_days_70( ).
  lo_res->get_property( EXPORTING i_feld = 'GT_ROUTE' IMPORTING e_value = ls_route ).

* Start HS# 013137  Comment -->
* Field vedat is now also recalculated, it has to be return back. Use structure instead of field by field
*  gs_comwa-vdate = ls_comwa-vdate.
*  gs_comwa-abdat = ls_comwa-abdat.
*  gs_comwa-rdate = ls_comwa-rdate.
*  gs_comwa-frdat = ls_comwa-frdat.
* End HS# 013137  Comment -->
  MOVE-CORRESPONDING ls_comwa TO ls_common.                 "HS# 013137
  MOVE-CORRESPONDING ls_common TO gs_comwa.                 "HS# 013137

ENHANCEMENT-POINT ref_booking_calc_dates_02 SPOTS /bitmym/case .

  go_appl->set_property( i_feld = 'GS_COMWA' i_value = gs_comwa ).

ENDMETHOD.


METHOD reference_booking_copy_data.
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 09.10.2015____*
*____HS# 12421, VON: O.PECHARROMAN  DATUM: 22.03.2018____*
*____HS# 12445, VON: O.PECHARROMAN  DATUM: 10.04.2018____*
*____HS# 12452, VON: G.Ivanov  DATUM: 12.04.2018____*
*____HS# 12482, VON: O.PECHARROMAN  DATUM: 26.04.2018____*
*____HS# 12387, VON: MKNAUER, DATUM: 21.08.2018___*
*____HS# 014889, VON: SISMAIL, DATUM: 16.02.2021___*

  DATA: lds_ref       TYPE /bitmym/ref_book,
        lds_res       TYPE /sopromet/zzlrv,
        ld_copy       TYPE /bitmym/fields_copy_from_book,
        ld_copy_comwa TYPE /bitmym/fields_copy_from_book,
        lds_case      TYPE /bitmym/case.

  CHECK check_reference_booking( ) EQ abap_true.

  go_appl->get_property( EXPORTING i_feld = 'GD_REF_BOOKING' IMPORTING e_value = lds_ref ).

  CHECK lds_ref IS NOT INITIAL.
  gs_comwa-ref_book = lds_ref.

  CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
    EXPORTING
      i_reserv      = gs_comwa-ref_book
*     I_NO_BUFF     =
    IMPORTING
      e_reservation = lds_res.

  CALL FUNCTION '/BITMYM/DB_READ_CASE_SINGLE'
    EXPORTING
      id_vkorg = lds_res-vkorg
      id_case  = lds_res-zzlrsam
*     ID_NO_BUFF       =
    IMPORTING
      es_case  = lds_case.

* Init of  HS 12482
* Pass the values through an strucure.
  MOVE-CORRESPONDING lds_case TO ld_copy.
  MOVE-CORRESPONDING lds_case TO ld_copy_comwa.
  MOVE-CORRESPONDING ld_copy TO gs_case.
  MOVE-CORRESPONDING ld_copy_comwa TO gs_comwa.
  gs_case-vkgrp = gs_comwa-vkgrp  = lds_case-vkgrp. "HS# 014889
*  gs_case-bstnk = gs_comwa-bstnk  = lds_case-bstnk.
*  gs_case-opman = gs_comwa-opman = lds_case-opman.
*  gs_case-inco1 = gs_comwa-inco1 = lds_case-inco1. "HS# 12421 "HS 12482
*  gs_case-inco2 = gs_comwa-inco2 = lds_case-inco2. "HS# 12421 "HS 12482
*  gs_case-vsbeb = gs_comwa-vsbeb = lds_case-vsbeb.          "HS 12482
*  gs_case-telf1 = gs_comwa-telf1 = lds_case-telf1.
* End HS 12482

* Init HS# 12421
* Call partner constructor, it will take partners from the booking
*  go_partner = /bitmym/cl_partner=>create( io_case = me ). HS 12445
  partner_put_data( ).
  partner_get_data( ).
* End HS# 12421

* Patient and time come from the reservation
  gs_comwa-opkra = lds_res-opkra.
  gs_case-opkra  = lds_res-opkra.                           "HS# 12452
  gs_comwa-optim = lds_res-optim.
  gs_comwa-asmnt = lds_res-asmnt.                           "HS# 12387
* Init of  HS 12482
*  gs_case-ihrez = gs_comwa-ihrez = lds_case-ihrez.
*  gs_case-vkbur = lds_case-vkbur.
*  gs_case-frdat = lds_case-frdat.
*  gs_case-rdate = lds_case-rdate.
*  gs_case-abdat = lds_case-abdat.
*  gs_case-vedat = lds_case-vedat.
*  gs_case-odate = lds_case-odate.
*  gs_case-vdate = lds_case-vdate.
* Init of  HS 12482
  CHECK gs_comwa-kunnr IS NOT INITIAL.

  go_appl->set_property( i_feld = 'GS_COMWA'  i_value = gs_comwa ).
ENHANCEMENT-POINT reference_booking_copy_data SPOTS /bitmym/cl_case .

ENDMETHOD.


