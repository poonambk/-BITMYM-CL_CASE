METHOD exit_handling_case.
*____HS# 10559, VON: O.Pecharroman, DATUM: 20.08.2015 ___*
*____HS# 11383, VON: G.Ivanov,      DATUM: 16.09.2016 ___*
*____HS# 11922, VON: S.Taori,       DATUM: 05.07.2017 ___*
*____HS# 12717, VON: S.Taori,       DATUM: 10.10.2018 ___*
*____HS# 13077, VON: STAORI,        DATUM: 19.05.2019___*

  DATA: ld_change,
        ld_answer.
  DATA: lt_map TYPE /sopromet/ty_tree_map_tab,  "HS# 11383 GND
        ls_map TYPE /sopromet/ty_tree_map.      "HS# 11383 GND

  ed_exit = abap_false.

  IF gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_display.
    ed_exit = abap_true.
    EXIT.
  ENDIF.

  CHECK reallocation_exit_handling( ) EQ abap_true.         "HS 12717

*____HS# 10559
ENHANCEMENT-POINT exit_handling_case SPOTS /bitmym/cl_case .


  IF gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
    IF ld_change IS INITIAL.
      go_texte->get_data( ).
      get_property go_texte 'GD_CHANGE_FLAG' ld_change.
    ENDIF.

    IF ld_change IS INITIAL.
      get_property go_partner 'GD_CHANGE_FLAG' ld_change.
    ENDIF.

    IF gs_case NE gs_case_yy.
      ld_change = 'X'.
    ENDIF.

*begin of "HS# 11383 GND
*    CHECK for changes in reservations
    IF ld_change IS INITIAL.
      go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).

      LOOP AT lt_map INTO ls_map.
        IF ls_map-objkey->check_reservation_changed( ) EQ abap_true.
          ld_change = 'X'.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
*end of "HS# 11383 GND
  ENDIF.

  IF ld_change IS NOT INITIAL OR gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
    CALL FUNCTION 'POPUP_TO_CONFIRM_DATA_LOSS'
      EXPORTING
        titel  = TEXT-mym
      IMPORTING
        answer = ld_answer.

    CASE ld_answer.
      WHEN 'J' OR 'Y'.           "Vorher speichern, dann exit
        CHECK case_save_final_check( ) EQ abap_true.        "HS 13077
        case_save_all( ).
        ed_exit = abap_true.
      WHEN 'N'.                  "Exit ohne Speichern
        ed_exit = abap_true.
    ENDCASE.

  ELSE.
    ed_exit = abap_true.
  ENDIF.

  CHECK ed_exit EQ abap_true AND go_gos_manager IS BOUND.
  CHECK iv_no_unpublish EQ abap_false.                       "HS# 11383 GND

  go_gos_manager->unpublish( ).

*____HS# 11922
ENHANCEMENT-POINT exit_handling_case_02 SPOTS /bitmym/cl_case .

ENDMETHOD.


METHOD exit_handling_we_screen.
*  HS#9836 Dequeue bei verlassen des Retouren-Dynpros J.Lopez
*____HS# 016674, VON: SSINGH, DATUM: 20.10.2022___*
  DATA: ls_spop         TYPE spop,
        ld_popup_answer TYPE c.

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.
*  HS 16674
ENHANCEMENT-POINT EXIT_HANDLING_INSP SPOTS /BITMYM/CL_CASE .
  IF get_we_reservations_changed( ) IS NOT INITIAL.

    ls_spop-textline1  = text-002.
    ls_spop-titel      = text-005.
##FM_OLDED
    CALL FUNCTION 'POPUP_TO_CONFIRM_LOSS_OF_DATA'
      EXPORTING
        textline1 = ls_spop-textline1
        titel     = ls_spop-titel
      IMPORTING
        answer    = ld_popup_answer
      EXCEPTIONS
        OTHERS    = 1.

    IF ld_popup_answer  EQ 'J' OR ld_popup_answer EQ 'Y'.
*      Begin HS#9836
      CALL FUNCTION 'DEQUEUE_ALL'.
*      *end HS#9836
      SET SCREEN 0. LEAVE SCREEN.
    ENDIF.
  ELSE.
*___Es wurde nichts geändert
*      Begin HS#9836
    CALL FUNCTION 'DEQUEUE_ALL'.
*      *end HS#9836
    SET SCREEN 0. LEAVE SCREEN.
  ENDIF.

ENDMETHOD.


  METHOD read_copy_case_date_customizin.
*____HS# 12704, VON: STAORI, DATUM: 16.10.2018___*

*__1. Look for VKORG/RSTYP/STATUS filled
    SELECT *
      FROM /bitmym/csdcopy2
      INTO TABLE et_csdcopy2
     WHERE vkorg = gs_case-vkorg
       AND rstyp = gs_case-rstyp
       AND txt04 = id_status.

    IF sy-subrc NE 0.
*__2. Look for RSTYP/STATUS filled and VKORG empty
      SELECT *
        FROM /bitmym/csdcopy2
        INTO TABLE et_csdcopy2
       WHERE vkorg EQ space
         AND rstyp = gs_case-rstyp
         AND txt04 = id_status.

      IF sy-subrc NE 0.
*__3. Look for VKORG/STATUS filled and RSTYP empty
        SELECT *
          FROM /bitmym/csdcopy2
          INTO TABLE et_csdcopy2
         WHERE vkorg = gs_case-vkorg
           AND rstyp EQ space
           AND txt04 = id_status.

        IF sy-subrc NE 0.
*__4. Look for STATUS filled and VKORG/RSTYP empty
          SELECT *
            FROM /bitmym/csdcopy2
            INTO TABLE et_csdcopy2
           WHERE vkorg EQ space
             AND rstyp EQ space
             AND txt04 = id_status.

        ENDIF.
      ENDIF.
    ENDIF.
  ENDMETHOD.


METHOD fill_go_main_2006.
  data:  ls_l02       type  /sopromet/zzls02,
          ls_l01       type  /sopromet/zzl01,
          ld_fabkl     type  fabkl,
          lo_tree_case type ref to /bitmym/cl_tree,
          lt_map       type /sopromet/ty_tree_map_tab.

  FIELD-SYMBOLS: <sel> TYPE /sopromet/zzls07.

  go_salesarea->get_property( EXPORTING i_feld = 'GS_ACTUAL_AREA' IMPORTING e_value = ls_l01 ).
  go_salesarea->get_property( EXPORTING i_feld = 'GD_CALENDER'    IMPORTING e_value = ld_fabkl ).

*___Kalender
  go_main_2006->set_property( i_feld = 'G_FABKL' i_value = ld_fabkl ).

*___G_VERTRIEBSBEREICH
  MOVE-CORRESPONDING ls_l01 TO ls_l02.
  go_main_2006->set_property( i_feld = 'G_VERTRIEBSBEREICH' i_value = ls_l02 ).

*___G_L01
  go_main_2006->set_property( i_feld = 'G_L01' i_value = ls_l01 ).

*___COMWA
  CALL METHOD go_main_2006->g_screen->set_prop_commwa( gs_comwa ).
  go_main_2006->set_property( i_feld = 'G_SALESAREA' i_value = go_salesarea ).

  IF go_tree_case IS NOT INITIAL.
    go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).
    go_main_2006->g_screen->set_property( i_feld = 'G_TREE_MAP' i_value = lt_map ).
  ENDIF.



ENDMETHOD.


METHOD fill_kzmonitor.
  DATA: ls_rstype TYPE /sopromet/rstype,
        ls_l01    TYPE /sopromet/zzl01.

  e_active = abap_false.

  CALL FUNCTION '/SOPROMET/READ_ZZL01'
    EXPORTING
      i_vkorg        = gs_case-vkorg
      i_vtweg        = gs_case-vtweg
      i_spart        = gs_case-spart
    IMPORTING
      e_zzl01        = ls_l01
    EXCEPTIONS
      no_entry_found = 1
      OTHERS         = 2.

  CHECK ls_l01-monitor_aktiv EQ abap_true.

  CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
    EXPORTING
      i_rstyp = gs_case-rstyp
    IMPORTING
      e_data  = ls_rstype.

  CHECK ls_rstype-monitor_aktiv EQ abap_true.

  e_active = abap_true.
ENDMETHOD.


  METHOD update_transfer_request_ext.
*____HS# 013526, VON: RBoyapati, DATUM: 07.11.2019___*

    DATA: lo_case    TYPE REF TO /bitmym/cl_case,
          lo_appl    TYPE REF TO /bitmym/cl_mym,
          lo_area    TYPE REF TO /sopromet/cl_l_salesarea,
          lo_partner TYPE REF TO /bitmym/cl_partner,
          ls_comwa   TYPE /sopromet/zzls01,
          ls_res     TYPE /sopromet/zzlrv,
          lt_vbpa    TYPE /sopromet/vbpav_tab,
          ls_vbpa    TYPE vbpav,
          lt_res     TYPE /sopromet/ty_tree_map_tab.

    FIELD-SYMBOLS: <lfs_res> TYPE /sopromet/ty_tree_map.

    IF io_ui5 IS INITIAL.

      CREATE OBJECT lo_appl.
      lo_appl->start_sales_area_direct( id_vkorg = is_ftr_res-vkorg
                                        id_vtweg = is_ftr_res-vtweg
                                        id_spart = is_ftr_res-spart
                                        id_vkbur = is_ftr_res-vkbur ).

    ELSE.
      " Get appl from UI5
    ENDIF.

    get_property lo_appl  'GS_COMWA' ls_comwa.
    get_property lo_appl  'GO_AREA' lo_area.
    ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
    set_property lo_appl  'GS_COMWA' ls_comwa.

*-- Create case instance
    lo_case = /bitmym/cl_case=>create( io_appl  = lo_appl io_ui5 = io_ui5 io_area = lo_area
                                       id_case  = is_ftr_res-zzlrsam
                                       id_reservation = is_ftr_res-zzlresn ).

    set_property lo_appl  'GO_CASE' lo_case.

    lo_case->start_tree_case( i_tree_dynnr = space i_tree_repid = space id_dark = abap_true ).

*-- Set Data for Transfer Request
    get_property lo_case  'GS_COMWA' ls_comwa.
    MOVE-CORRESPONDING is_ftr_res TO ls_comwa.
    set_property lo_case 'GS_COMWA' ls_comwa.

*-- Set actual reservation
    get_property lo_case  'GT_RESERVATIONS' lt_res.
    READ TABLE lt_res ASSIGNING <lfs_res> INDEX 1.
    CHECK sy-subrc EQ 0 AND <lfs_res>-objkey IS BOUND.
    set_property lo_case 'GO_ACT_RESERVATION' <lfs_res>-objkey.

*-- Fill reservation structure
    <lfs_res>-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
    MOVE-CORRESPONDING is_ftr_res TO ls_res.
    set_property <lfs_res>-objkey  'G_RESERVATION' ls_res.

    get_property lo_case  'GO_PARTNER' lo_partner.
    CHECK lo_partner IS BOUND..
*-- Update partners - partners are changed when source reservation is identified or changed
    lt_vbpa = it_vbpa.
    ls_vbpa-updkz = 'U'.
    MODIFY lt_vbpa FROM ls_vbpa TRANSPORTING updkz WHERE updkz EQ space.
    set_property lo_partner 'GT_VBPA' lt_vbpa.
    set_property lo_partner 'GD_CHANGE_FLAG' abap_true .
    lo_case->partner_put_data( ).

    CHECK lo_case->case_save_final_check( ) EQ abap_true.
*-- Save FTR

    lo_case->case_save_all( ).

    e_check = abap_true.

  ENDMETHOD.


METHOD fill_xcons_flag.
  DATA: ls_rstype TYPE /sopromet/rstype.

  CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
    EXPORTING
      i_rstyp = gs_case-rstyp
    IMPORTING
      e_data  = ls_rstype.

  CHECK ls_rstype-sobkz EQ 'W'.

  ed_xcons = 'X'.
ENDMETHOD.


METHOD ft_get_single_items.

  DATA: lt_items TYPE /bitmym/alv_transfer_sets_tab.

  FIELD-SYMBOLS: <item>   TYPE /bitmym/alv_transfer_sets_alv,
                 <result> TYPE /bitmym/alv_transfer_sets.

  CLEAR et_items.

  CHECK go_transfer IS BOUND.

  get_property go_transfer 'GT_TRANSFER_SEL' lt_items.

  LOOP AT lt_items ASSIGNING <item>
                   WHERE lresn = id_source
                     AND kzsir = abap_true.

    APPEND INITIAL LINE TO et_items ASSIGNING <result>.

    MOVE-CORRESPONDING <item> TO <result>.

  ENDLOOP.


ENDMETHOD.


  METHOD get_additional_itm_res.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 18.06.2018 ___*

    DATA: lv_add_res TYPE /sopromet/zzlresn,
          lo_res     TYPE REF TO /sopromet/cl_l_reservation.

    SELECT zzlresn FROM /sopromet/zzlrv INTO lv_add_res UP TO 1 ROWS WHERE vkorg = i_vkorg
       AND zzlrsam = i_lrsam AND kzper = /sopromet/cl_l_reservation=>c_pend_type_additional.

      lo_res = /sopromet/cl_l_reservation=>create_pending( id_pending           = /sopromet/cl_l_reservation=>c_pend_type_additional
                                                           id_reservation       = lv_add_res ).

      IF lo_res->get_user_status( ) NE /sopromet/cl_l_reservation=>c_res_status_geprueft.
        eo_add_res = lo_res.
        EXIT.
      ENDIF.

    ENDSELECT.
  ENDMETHOD.


  METHOD ui5_bookingsearch_getlist_int.
*____HS# 012765, VON: SSINGH, DATUM: 05.02.2020___*


    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lt_temp     TYPE STANDARD TABLE OF /bitmym/bookings, "HS# 012765
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          ls_rserv    TYPE /sopromet/zzlrv,
          lt_reserv   TYPE /sopromet/ty_tree_map_tab,
          lo_rstyp    TYPE REF TO /sopromet/cl_l_res_type,  "HS# 012387
          ls_rstypt   TYPE /sopromet/rstypt,                "HS# 012387
          ld_query    TYPE string,                          "HS# 012765
          ld_query1   TYPE string,                          "HS# 012765
          lo_book_ui5 TYPE REF TO /bitmym/cl_ui5_booking.   "HS# 012765
    DATA: l_objnr     TYPE equi-objnr.
    DATA: lt_obj   TYPE STANDARD TABLE OF jsto_pre.
    FIELD-SYMBOLS: <bookings>     TYPE /bitmym/bookings,
                   <bookings_ui5> TYPE LINE OF /bitmym/cl_srep_srv_vr_mpc=>tt_bookingsearch,
                   <obj>          TYPE jsto_pre,
                   <res>          TYPE /sopromet/ty_tree_map.

    ld_query  = /bitmym/if_ui5~go_user->get_parvw_query_string( ). "HS# 12765
    ld_query1 = get_bookingsearch_query_string( ).
    CHECK ld_query1 IS NOT INITIAL.
    TRY.

        SELECT DISTINCT lresn
                INTO CORRESPONDING FIELDS OF TABLE lt_bookings FROM  /bitmym/bookings
                WHERE  vkorg  = gs_actual_area-vkorg
                AND    vtweg  = gs_actual_area-vtweg
                AND    spart  = gs_actual_area-spart
                AND    (ld_query).
        IF lt_bookings IS NOT INITIAL.

          lt_temp = lt_bookings.
          CLEAR lt_bookings.

          SELECT DISTINCT lrsam vtime vdate odate rdate lresn bstnk vedat name1 opman opkra kunnr
                INTO CORRESPONDING FIELDS OF TABLE lt_bookings FROM  /bitmym/bookings
                UP TO 100 ROWS
                FOR ALL ENTRIES IN lt_temp
                WHERE  lresn  = lt_temp-lresn
                AND    vkorg  = gs_actual_area-vkorg
                AND    vtweg  = gs_actual_area-vtweg
                AND    spart  = gs_actual_area-spart
                AND    (ld_query1).

        ENDIF.

      CATCH cx_root INTO lo_ex.
    ENDTRY.

    CHECK lt_bookings IS NOT INITIAL.

    DELETE ADJACENT DUPLICATES FROM lt_bookings COMPARING lresn.
    LOOP AT lt_bookings ASSIGNING <bookings> WHERE lresn IS NOT INITIAL.
      APPEND INITIAL LINE TO lt_obj ASSIGNING <obj>.
      CONCATENATE /sopromet/cl_l_reservation=>c_status_typ_res <bookings>-lresn INTO <obj>-objnr.
    ENDLOOP.
    /sopromet/cl_l_reservation=>status_multi_read( it_objnr = lt_obj ).

    LOOP AT lt_bookings ASSIGNING <bookings> WHERE lresn IS NOT INITIAL.

      APPEND INITIAL LINE TO et_entityset ASSIGNING <bookings_ui5>.

      MOVE-CORRESPONDING <bookings> TO <bookings_ui5>.
      <bookings_ui5>-zzlresn = <bookings>-lresn.
      /sopromet/cl_l_reservation=>get_status_txt_from_buf( EXPORTING id_lresn = <bookings>-lresn
                                                     IMPORTING e_txt30  = <bookings_ui5>-status ).
*                                                                     e_txt04  = r_txt04 ).
      IF <bookings_ui5>-status IS  INITIAL.
        CONCATENATE /sopromet/cl_l_reservation=>c_status_typ_res <bookings>-lresn INTO l_objnr.
*--> Lesen Status der Reservierung
        CALL FUNCTION '/SOPROMET/STATUS_READ'
          EXPORTING
            i_objnr             = l_objnr
            i_no_status_refresh = abap_true
            i_only_active       = 'X'
          IMPORTING
            e_txt30             = <bookings_ui5>-status
          EXCEPTIONS
            OTHERS              = 1.
      ENDIF.


    ENDLOOP.



  ENDMETHOD.


METHOD get_gt_booking_items.
*____HS# 012900, VON: RBOYAPATI, DATUM: 08.02.2019___*

  FIELD-SYMBOLS: <res> LIKE LINE OF gt_reservations.

  IF go_act_reservation IS INITIAL.
    READ TABLE gt_reservations ASSIGNING <res> INDEX 1.
    CHECK sy-subrc EQ 0.
    go_act_reservation = <res>-objkey.
  ENDIF.

  et_booking_items = go_act_reservation->get_prop_booking_items( ).

ENDMETHOD.


  METHOD get_reservations.
*____HS# 012900, VON: RBOYAPATI, DATUM: 08.02.2019___*

    DATA: ls_zzlrv    TYPE /sopromet/zzlrv.

    FIELD-SYMBOLS: <lfs_res> LIKE LINE OF gt_reservations.

    et_o_res = gt_reservations.

    CHECK et_zzlrv IS SUPPLIED.

    LOOP AT gt_reservations ASSIGNING <lfs_res>.
      CALL METHOD <lfs_res>-objkey->get_reservation_data
        IMPORTING
          e_reservation = ls_zzlrv.

      APPEND ls_zzlrv TO et_zzlrv.
    ENDLOOP.

  ENDMETHOD.


  METHOD get_calendar.
*____HS# 12094, VON: MKnauer, DATUM: 06.10.2017 ___*

    DATA: lo_calender TYPE REF TO /bitmym/cl_calender.

    get_property go_appl id_calendar eo_calendar.

    check eo_calendar is BOUND.

    eo_calendar->get_property( EXPORTING i_feld = 'GO_CALENDER' IMPORTING e_value = eo_control ).

  ENDMETHOD.


METHOD get_case_calculated_date.
*   HS# 9842, VON Oscar Pecharroman Perez, DATUM: 03.11.2014
*___HS# 11538, VON: O.Pecharroman - 10.02.2017

  DATA: ls_comwa       TYPE /sopromet/zzls01,               "HS# 11538
        ls_comwa_route TYPE /sopromet/zzls01,
        ls_route       TYPE /bitmym/res_route_date.         "HS# 11538

  CHECK gt_comwa_route IS NOT INITIAL.                      "HS# 11538

  CLEAR: gs_case-vdate, gs_case-abdat,                      "HS# 11538
         gs_case-rdate, gs_case-frdat.                      "HS# 11538

  LOOP AT gt_comwa_route INTO ls_comwa_route.

    IF gs_case-rdate LT ls_comwa_route-rdate.
      gs_case-rdate = ls_comwa_route-rdate.
    ENDIF.

    IF gs_case-vdate GT ls_comwa_route-vdate OR
      gs_case-vdate IS INITIAL.                             "HS# 11538
      gs_case-vdate = ls_comwa_route-vdate.
    ENDIF.

    IF gs_case-abdat GT ls_comwa_route-abdat OR
      gs_case-abdat IS INITIAL.                             "HS# 11538
      gs_case-abdat = ls_comwa_route-abdat.
    ENDIF.

    IF gs_case-frdat LT ls_comwa_route-frdat.
      gs_case-frdat = ls_comwa_route-frdat.
    ENDIF.

  ENDLOOP.

  CHECK go_appl IS NOT INITIAL.                             "HS# 11538

  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ). "HS# 11538

  MOVE-CORRESPONDING gs_case TO ls_route.                   "HS# 11538

  MOVE-CORRESPONDING ls_route TO ls_comwa.                  "HS# 11538


  go_appl->set_property( EXPORTING i_feld = 'GS_COMWA' i_value = ls_comwa ). "HS# 11538

ENDMETHOD.


  METHOD get_customer_number_ptp.
*____HS# 10412,VON: T.Kern, DATUM: 12.05.2015 ___*

    SELECT SINGLE kunag FROM /bitmym/cus2 INTO gs_comwa-kunnr
      WHERE vkorg = gs_comwa-vkorg
      AND   werks = gs_comwa-r_werk
      AND   eqart = ''.


  ENDMETHOD.


  METHOD get_customer_number_repair.
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 015730, VON: PKUNAL, DATUM: 22.07.2021___*

    DATA: l_ihpa         TYPE ihpa,
          ls_reservation TYPE /sopromet/zzlrv,
          lo_equi        TYPE REF TO /sopromet/cl_l_equipment,
          lv_refequi     TYPE equnr,
          ls_rstype      TYPE /sopromet/rstype,
          ls_rstype_rep  TYPE /sopromet/rstype,
          ls_refequi     TYPE rihequi,
          ls_equi        TYPE rihequi,
          lv_obj         LIKE ls_refequi-objnr,
          lo_ref_equi    TYPE REF TO /sopromet/cl_l_equipment,
          ls_ref         TYPE /sopromet/refstl.


    io_reservation->get_reservation_data(
      IMPORTING
        e_reservation = ls_reservation ).


    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp = ls_reservation-rstyp
      IMPORTING
        e_data  = ls_rstype.

    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp = ls_rstype-rstyp
      IMPORTING
        e_data  = ls_rstype_rep.


*    SELECT SINGLE * FROM /sopromet/rstype INTO ls_rstype_rep WHERE rstyp = ls_rstype-rstyp_rep.
*    CHECK sy-subrc EQ 0.

    io_reservation->get_property(
      EXPORTING
        i_feld  = 'G_EQUIPMENT'
      IMPORTING
        e_value = lo_equi ).

    CHECK lo_equi IS BOUND.
    ls_equi = lo_equi->exp_equi_data( ).

* Start of Change - "____HS# 015730
*    CALL FUNCTION '/SOPROMET/REFILL_GET_REF_EQUNR'
*      EXPORTING
*        i_matnr     = ls_equi-matnr
*        i_werks     = ls_equi-swerk
*      IMPORTING
*        e_reference = ls_ref.

    ls_ref = /bitmym/cl_refstl=>create( EXPORTING io_appl = go_appl )->get_ref_equnr( EXPORTING i_matnr = ls_equi-matnr   ""____HS# 015730_INSERTED
                                                                                                i_werks = ls_equi-swerk
                                                                                                i_eqart = ls_equi-eqart ).

* End of Change - "____HS# 015730

    lv_refequi = lo_equi->get_reference_equnr( ).
    CHECK lv_refequi IS NOT INITIAL.

    CREATE OBJECT lo_ref_equi
      EXPORTING
        i_equnr = ls_ref-equnr.

    ls_refequi = lo_ref_equi->exp_equi_data( ).


    CONCATENATE 'IE03' lv_refequi INTO lv_obj.
    SELECT SINGLE parnr INTO gs_comwa-kunnr FROM ihpa
       WHERE  objnr   = ls_refequi-objnr
        AND    parvw  = ls_rstype-parvw_rep.

    IF sy-subrc = 0.
      e_check = abap_true.
    ELSE.
      MESSAGE e450(/sopromet/zl) WITH ls_refequi-equnr INTO gd_dummy_message. "HS# 11637
      call_message.                                         "HS# 11637
      e_check = abap_false.
*      MESSAGE 'No Customer Record for Reference Equipment' TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.

  ENDMETHOD.


  METHOD get_cust_text_into_res_text.
*____HS# 11951, VON: S.Taori, DATUM: 04.07.2017 ___*

    DATA: lt_cust_text_customizing TYPE /bitmym/cust_txt_tab.

    DATA: ld_tdname              TYPE thead-tdname,
          ld_tabix(6)            TYPE n,
          ld_head                TYPE thead,
          ls_head                TYPE thead,
          ls_tvkos               TYPE tvkos,
          lt_vbpa	               TYPE /sopromet/vbpav_tab,
          ld_change_flag_partner TYPE abap_bool,
          ld_change_flag_text    TYPE abap_bool,
          lt_text_case           TYPE lv70t_ty_xthead_table,
          memory_id(20).

    DATA: lt_lines_pn TYPE STANDARD TABLE OF tline,
          catalog     TYPE STANDARD TABLE OF tcatalog.

    FIELD-SYMBOLS: <vbpa>      TYPE vbpav,
                   <cust_text> TYPE	/bitmym/cust_txt,
                   <text_case> TYPE theadvb,
                   <catalog>   TYPE tcatalog.

    CHECK go_texte IS BOUND.
    CHECK gs_comwa-zzlrsam IS NOT INITIAL.

*__Read customizing
    lt_cust_text_customizing = go_texte->get_customer_text_customizing( gs_comwa ).

    CHECK lt_cust_text_customizing IS NOT INITIAL AND go_partner IS BOUND.

    go_partner->get_property( EXPORTING i_feld = 'GT_VBPA'                IMPORTING e_value = lt_vbpa ).
    go_partner->get_property( EXPORTING i_feld = 'GD_CHANGE_FLAG_CURRENT' IMPORTING e_value = ld_change_flag_partner ).
    go_texte->get_property(   EXPORTING i_feld = 'GD_CHANGE_FLAG'         IMPORTING e_value = ld_change_flag_text ).

    CHECK gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create OR                                    "Copy when in create mode
        ( gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change AND ld_change_flag_partner IS NOT INITIAL ). "Or when partner data was changed

    IF ld_change_flag_partner IS NOT INITIAL.   "Redetermine text if partner was changed
      CLEAR ld_change_flag_text.
    ENDIF.

    CHECK ld_change_flag_text IS INITIAL.

    CALL FUNCTION 'SD_ORGDATA_CHECK'
      EXPORTING
        fi_vkorg                   = gs_comwa-vkorg
        fi_vtweg                   = gs_comwa-vtweg
        fi_spart                   = gs_comwa-spart
      IMPORTING
        fe_tvkos                   = ls_tvkos
      EXCEPTIONS
        vkorg_does_not_exist       = 1
        vtweg_does_not_exist       = 2
        spart_does_not_exist       = 3
        vkorg_vtweg_does_not_exist = 4
        vkorg_spart_does_not_exist = 5
        vtber_does_not_exist       = 6
        vkbur_does_not_exist       = 7
        vkgrp_does_not_exist       = 8
        vtber_vkbur_does_not_exist = 9
        vkbur_vkgrp_does_not_exist = 10
        vkbur_vkorg_does_not_exist = 11
        no_authority               = 12
        OTHERS                     = 13.

    CHECK sy-subrc EQ 0.

*__Get case text
*    texte_put_data( ).
*    get_property  go_texte  'GT_HEAD'   lt_text_case.

    LOOP AT lt_cust_text_customizing ASSIGNING <cust_text>.
      ld_tabix = sy-tabix.
      READ TABLE lt_vbpa ASSIGNING <vbpa> WITH KEY parvw = <cust_text>-parvw.
      CHECK sy-subrc EQ 0.

*__Build the TDID
      IF <cust_text>-tdobject EQ /bitmym/cl_texte=>c_tdobj_kna1.
        ld_tdname = <vbpa>-kunnr.
      ELSEIF <cust_text>-tdobject EQ /bitmym/cl_texte=>c_tdobj_knvv.
        CONCATENATE <vbpa>-kunnr gs_comwa-vkorg gs_comwa-vtweg ls_tvkos-spaku INTO ld_tdname.
      ENDIF.

      CLEAR lt_lines_pn.

*__Read the customer text
      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          id                      = <cust_text>-tdid
          language                = sy-langu
          name                    = ld_tdname
          object                  = <cust_text>-tdobject
        IMPORTING
          header                  = ld_head
        TABLES
          lines                   = lt_lines_pn
        EXCEPTIONS
          id                      = 1
          language                = 2
          name                    = 3
          not_found               = 4
          object                  = 5
          reference_check         = 6
          wrong_access_to_archive = 7
          OTHERS                  = 8.

      CHECK lt_lines_pn[] IS NOT INITIAL.

      IF lt_text_case IS INITIAL.
*__Get case text
        texte_put_data( ).
        get_property  go_texte  'GT_HEAD'   lt_text_case.
      ENDIF.

*__Write text to corresponding partner text in Case Memory
      READ TABLE lt_text_case ASSIGNING <text_case> WITH KEY tdid = <cust_text>-tdid_mym.

      IF sy-subrc EQ 0.
*__Build the catalog
        <text_case>-updkz = 'I'.
        APPEND INITIAL LINE TO catalog ASSIGNING <catalog>.
        MOVE-CORRESPONDING <text_case> TO <catalog>.
        <catalog>-function = 'U'.
        <catalog>-id       = ld_tabix.
        <catalog>-tdspras  = sy-langu.

        MOVE-CORRESPONDING <text_case> TO ls_head.
        ls_head-tdspras  = sy-langu.
        CONCATENATE 'SAPLSTXD' ld_tabix INTO memory_id.

*__Exposrting the text to the corresponding memory ID. This text will appear when text editor in reservation will be opened
        EXPORT thead FROM ls_head
               tline FROM lt_lines_pn
             TO MEMORY ID memory_id.

      ENDIF.

    ENDLOOP.

    go_texte->set_cust_txt_into_res_txt_init( ).

    set_property  go_texte  'GT_HEAD'         lt_text_case.
    set_property  go_texte  'GD_CHANGE_FLAG'  abap_true.

    EXPORT catalog FROM catalog TO MEMORY ID 'SAPLSTXD'.
  ENDMETHOD.


METHOD get_day_texts.
*____HS# 013576, VON: MKNAUER, DATUM: 30.11.2019___*
*____HS# 016825, VON: BGUNAWAN, DATUM: 01.06.2022___*

  CLEAR: gs_comwa-odate_tx,
         gs_comwa-rdate_tx,
         gs_comwa-vdate_tx,
         gs_comwa-abdat_tx,
         gs_comwa-frdat_tx,
         gs_comwa-vedat_tx,
         gs_comwa-prsdt_tx. "HS# 016826.

  CHECK id_level IS NOT INITIAL.

  CASE id_level.
    WHEN '1'. "Case
*_____HS# 13576_________START_INSERT
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-edatu
        IMPORTING
          daytxt              = gs_comwa-edatu_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
*_____HS# 13576_________START_INSERT
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-odate
        IMPORTING
          daytxt              = gs_comwa-odate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-rdate
        IMPORTING
          daytxt              = gs_comwa-rdate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-vdate
        IMPORTING
          daytxt              = gs_comwa-vdate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-abdat
        IMPORTING
          daytxt              = gs_comwa-abdat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-frdat
        IMPORTING
          daytxt              = gs_comwa-frdat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-vedat
        IMPORTING
          daytxt              = gs_comwa-vedat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
* Begin of HS# 016825
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-prsdt
        IMPORTING
          daytxt              = gs_comwa-prsdt_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
* End of HS# 016825
    WHEN '2'. "Reservation
*_____HS# 13576_________START_INSERT
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-edatu
        IMPORTING
          daytxt              = gs_comwa-edatu_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
*_____HS# 13576_________START_INSERT

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-odate
        IMPORTING
          daytxt              = gs_comwa-odate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-rdate
        IMPORTING
          daytxt              = gs_comwa-rdate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-vdate
        IMPORTING
          daytxt              = gs_comwa-vdate_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-abdat
        IMPORTING
          daytxt              = gs_comwa-abdat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-frdat
        IMPORTING
          daytxt              = gs_comwa-frdat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-vedat
        IMPORTING
          daytxt              = gs_comwa-vedat_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

* Start of HS# 016825
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = is_reservation-prsdt
        IMPORTING
          daytxt              = gs_comwa-prsdt_tx
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
* End of HS# 016825

*-->> Start                                                 HS 12469
    WHEN '3'. "Rental dates
      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-rsdat
        IMPORTING
          daytxt              = gs_comwa-rsdat_txt
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.

      CALL FUNCTION 'RH_GET_DATE_DAYNAME'
        EXPORTING
          langu               = sy-langu
          date                = gs_case-redat
        IMPORTING
          daytxt              = gs_comwa-redat_txt
        EXCEPTIONS
          no_langu            = 1
          no_date             = 2
          no_daytxt_for_langu = 3
          invalid_date        = 4
          OTHERS              = 5.
*-->> End                                                   HS 12469
  ENDCASE.

  es_comwa-vdate_tx = gs_comwa-vdate_tx.
  es_comwa-rdate_tx = gs_comwa-rdate_tx.
  es_comwa-odate_tx = gs_comwa-odate_tx.
  es_comwa-abdat_tx = gs_comwa-abdat_tx.
  es_comwa-frdat_tx = gs_comwa-frdat_tx.
  es_comwa-vedat_tx = gs_comwa-vedat_tx.
  es_comwa-rsdat_txt = gs_comwa-rsdat_txt.                  "HS 12469
  es_comwa-redat_txt = gs_comwa-redat_txt.                  "HS 12469
  es_comwa-edatu_tx  = gs_comwa-edatu_tx.                  "HS 13576
  es_comwa-prsdt_tx = gs_comwa-prsdt_tx.                   "HS 016825
ENDMETHOD.


  METHOD get_equipment_list.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___*

*Get equipments from reservations belonging to a case

    DATA: lo_case        TYPE REF TO /bitmym/cl_case.

    IF io_case IS INITIAL.

      CHECK is_selection-lrsam IS NOT INITIAL AND
            is_selection-application IS NOT INITIAL.

      CREATE OBJECT lo_case
        EXPORTING
          id_case = is_selection-lrsam
          io_appl = is_selection-application.

    ELSE.

      lo_case = io_case.

    ENDIF.

    lo_case->get_equipment_list_int( CHANGING is_selection = is_selection ).

  ENDMETHOD.


  METHOD get_equipment_list_check.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___Created*
*____HS# 012775, VON: G.Ivanov, DATUM: 31.10.2018___*

    ev_success = abap_false. "initialize

    CASE iv_fcode.
      WHEN /bitmym/cl_panel=>c_stripdown.
        ev_success = get_equipment_list_check_strip( iv_lresn = iv_lresn ).
      WHEN /bitmym/cl_panel=>c_transfer_items.
        ev_success = get_equipment_list_check_trans( iv_lresn = iv_lresn ).
      WHEN /bitmym/cl_panel=>c_transfer_single_items.                                                   "HS #012775
        ev_success = get_equipment_list_check_si( iv_lresn = iv_lresn ).                                "HS #012775
      WHEN OTHERS.
*       ev_success = get_equipment_list_check_gen( iv_lresn = iv_lresn ).                               "HS #012775
        ev_success = get_equipment_list_check_gen( iv_lresn = iv_lresn iv_fcode = iv_fcode ). "HS #012775
    ENDCASE.


  ENDMETHOD.


  METHOD get_equipment_list_check_gen.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___Created*
*____HS# 012775, VON: G.Ivanov, DATUM: 30.10.2018___* "Enhancement Point Added

*Get equipments from reservations belonging to a case

    DATA: ls_reservation TYPE /sopromet/zzlrv.

    FIELD-SYMBOLS: <fs_reservation> TYPE /sopromet/ty_tree_map.

    ev_success = abap_false.

    READ TABLE gt_reservations ASSIGNING <fs_reservation> WITH KEY lresrv = iv_lresn.
    CHECK sy-subrc IS INITIAL.

    <fs_reservation>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

*____HS# 012775
ENHANCEMENT-POINT GET_EQUIPMENT_LIST_CHECK_GEN SPOTS /BITMYM/CL_CASE .

    ev_success = abap_true.

  ENDMETHOD.


  METHOD UI5_BOOKING_ST_OVERVIEW.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

    lo_case->ui5_booking_st_overview_int( IMPORTING es_response_context = es_response_context et_entityset = et_entityset ).
  ENDMETHOD.


  METHOD GET_EQUIPMENT_LIST_CHECK_STRIP.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___Created*

*Get equipments from reservations belonging to a case

    DATA: ls_reservation TYPE /sopromet/zzlrv.

    FIELD-SYMBOLS: <fs_reservation> TYPE /sopromet/ty_tree_map.

    ev_success = abap_false.

    READ TABLE gt_reservations ASSIGNING <fs_reservation> WITH KEY lresrv = iv_lresn.
    CHECK sy-subrc IS INITIAL.

    <fs_reservation>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

    CHECK: <fs_reservation>-abgru IS INITIAL,
           ls_reservation-kzsir IS INITIAL.

    ev_success = abap_true.

  ENDMETHOD.


  METHOD get_equipment_list_check_trans.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___Created*

*   Get equipments from reservations belonging to a case

    DATA: ls_reservation TYPE /sopromet/zzlrv,
          lv_user_status TYPE tj30t-txt04.

    FIELD-SYMBOLS: <fs_reservation> TYPE /sopromet/ty_tree_map.

    ev_success = abap_false.

    READ TABLE gt_reservations ASSIGNING <fs_reservation> WITH KEY lresrv = iv_lresn.
    CHECK sy-subrc IS INITIAL.

    <fs_reservation>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

    CHECK: <fs_reservation>-abgru IS INITIAL,
           ls_reservation-kzsir IS INITIAL.
*    check status
    lv_user_status = <fs_reservation>-objkey->get_user_status( ).

    CHECK: lv_user_status EQ /sopromet/cl_l_reservation=>c_res_status_ausgeliefert.

    ev_success = abap_true.

  ENDMETHOD.


  METHOD get_equipment_list_int.
*____HS# 12038, VON: G.Ivanov, DATUM: 04.09.2017 ___*
*___ SR2-2383, User: SCOSAR, Date: 16.10.2025___*

*Get equipments from reservations belonging to a case

    DATA: ls_reserv       TYPE /sopromet/zzlrv,
          lt_reservations TYPE /sopromet/ty_tree_map_tab,
          ls_reservation  TYPE /sopromet/ty_tree_map,
          lv_reser_dest   TYPE /sopromet/zzlresn,
          lv_dest_eqart   TYPE eqart.

    DATA: lo_transfer TYPE REF TO /bitmym/cl_field_transfer,
          lo_case_dst TYPE REF TO /bitmym/cl_case.

    FIELD-SYMBOLS: <fs_reservation> TYPE /sopromet/ty_tree_map,
                   <fs_equi_res>    TYPE /bitmym/s_equi_reserv_list.

    DATA(lr_equnr) = VALUE range_t_equnr( FOR ls_equnr IN is_selection-equnr_t ( sign = 'I' option =  'EQ' low = ls_equnr-equnr ) ). "SR2-2383

*   Get Equipment Type at destination
    /bitmym/cl_bom_processing=>gv_dest_eqart = /bitmym/cl_bom_processing=>get_dest_eqart( io_application = is_selection-application ).

    LOOP AT gt_reservations ASSIGNING <fs_reservation> .

*     Check Reservation for some conditions
      CHECK get_equipment_list_check( iv_fcode = is_selection-fcode
                                      iv_lresn = <fs_reservation>-lresrv ) EQ abap_true.

*     Read Equipment
      CLEAR ls_reserv.
      <fs_reservation>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reserv ).
      CHECK ls_reserv-equnr IS NOT INITIAL .
      CHECK ls_reserv-equnr IN lr_equnr.                    "SR2-2383

*      Add equipment
      APPEND INITIAL LINE TO is_selection-equnr_t ASSIGNING <fs_equi_res>.
      <fs_equi_res>-equnr = ls_reserv-equnr.
      <fs_equi_res>-eqtyp = <fs_reservation>-eqtyp.
      <fs_equi_res>-eqart = <fs_reservation>-eqart.
      <fs_equi_res>-lresn = ls_reserv-zzlresn.

    ENDLOOP.

  ENDMETHOD.


  METHOD get_reservations_unallocated.
*____HS# 012900, VON: RBOYAPATI, DATUM: 08.02.2019___*

    DATA: ls_zzlrv TYPE /sopromet/zzlrv,
          lt_o_res TYPE TABLE OF /sopromet/ty_tree_map.

    FIELD-SYMBOLS: <lfs_o_res> TYPE /sopromet/ty_tree_map.

    lt_o_res = gt_reservations.
    " Unallocated => Reservations assigned to refrence equipment and Not single item reservations
    DELETE lt_o_res  WHERE eqtyp NE /sopromet/cl_l_equipment=>c_equi_typ_ref.
    et_o_res = lt_o_res.

    CHECK et_zzlrv IS SUPPLIED.

    LOOP AT lt_o_res ASSIGNING <lfs_o_res>.
      CALL METHOD <lfs_o_res>-objkey->get_reservation_data
        IMPORTING
          e_reservation = ls_zzlrv.

      APPEND ls_zzlrv TO et_zzlrv.
    ENDLOOP.

  ENDMETHOD.


METHOD get_missing_reservation.
*____HS# 10358, VON: DEndres, DATUM: 10.04.2015 ___*
*____HS# 11632, VON: DEndres, DATUM: 10.04.2015 ___*
*____HS# 017424, VON: OPECHARROMAN, DATUM: 14.10.2022___*

  DATA: ls_restat TYPE /sopromet/restat.

*  CHECK gs_actual_area-xpemod NE 'S'.                      "HS# 017424

  SELECT SINGLE * INTO ls_restat
    FROM /sopromet/restat
    WHERE zzlrsam = gs_case-zzlrsam
      AND vkorg   = gs_actual_area-vkorg                    "HS# 11632
      AND kzper   = /sopromet/cl_l_reservation=>c_pend_type_missing
      AND txt04   = /sopromet/cl_l_reservation=>c_res_status_zurueck.

  IF sy-subrc = 0.
    CREATE OBJECT e_reservation
      EXPORTING
        i_zzlresn = ls_restat-zzlresn.
  ENDIF.

ENDMETHOD.


METHOD get_new_case_number.
*____HS# 10467, VON: K.Uday, DATUM: 24.07.2015 ___*
*____HS# 013526, VON: RBoyapati, DATUM: 07.11.2019___*
*____HS# 016474, VON: SISMAIL, DATUM: 14.02.2022___*
*____HS# 017405, VON: SISMAIL, DATUM: 11.10.2022___*
*___ SR1-890, User: GIVANOV, Date: 23.10.2023___*

  DATA: ld_nr_range      TYPE inri-nrrangenr,
        ld_nr_case_vkorg TYPE /bitmym/nr_case_vkorg.  "HS# 017405+

ENHANCEMENT-POINT get_new_case_number SPOTS /bitmym/case .

*___ SR1-890 Begin INS
*Reading the customzing for combined run number range
  SELECT SINGLE vkorg_map, nr_range
    FROM /bitmym/case_nr
    INTO (@ld_nr_case_vkorg, @ld_nr_range)
    WHERE vkorg = @gs_actual_area-vkorg
      AND vtweg = @gs_actual_area-vtweg
      AND spart = @gs_actual_area-spart
      AND rscat = @gs_comwa-rscat.
*___ SR1-890 End INS

  IF ld_nr_case_vkorg IS INITIAL OR ld_nr_range IS INITIAL.         "SR1-890
    IF gs_comwa-rscat = ''                                  "HS# 10467
        OR gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_c.    "HS# 016474+
      ld_nr_range = '01'.                                   "HS# 10467
    ELSEIF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 10467
      ld_nr_range = '02'.                                   "HS# 10467
    ELSEIF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_r. "HS 13526
      ld_nr_range = '03'.                                   "HS 13526
    ENDIF.

    IF gs_actual_area-nr_case_vkorg IS NOT INITIAL.       "HS# 017405+
      ld_nr_case_vkorg = gs_actual_area-nr_case_vkorg.   "HS# 017405+
    ELSE.                                                 "HS# 017405+
      ld_nr_case_vkorg = gs_actual_area-vkorg.           "HS# 017405+
    ENDIF.                                                "HS# 017405+

  ENDIF. "SR1-890


  CALL FUNCTION 'NUMBER_GET_NEXT'
    EXPORTING
      nr_range_nr             = ld_nr_range "'01'       "HS# 10467
      object                  = 'ZZLRES_SAM'
*     subobject               = gs_actual_area-vkorg   "HS# 017405-
      subobject               = ld_nr_case_vkorg   "HS# 017405+
    IMPORTING
      number                  = gd_case
    EXCEPTIONS
      interval_not_found      = 1
      number_range_not_intern = 2
      object_not_found        = 3
      quantity_is_0           = 4
      quantity_is_not_1       = 5
      interval_overflow       = 6
      OTHERS                  = 7.

  IF sy-subrc EQ 0.
    gs_comwa-zzlrsam = gd_case.
  ENDIF.

ENDMETHOD.


METHOD get_next_reservation_nr.
  DATA: l_range TYPE inri-nrrangenr.

  l_range = gs_actual_area-nrrangenr.

  IF l_range IS INITIAL.
    l_range = '01'.
  ENDIF.

  CALL FUNCTION 'NUMBER_GET_NEXT'
    EXPORTING
      nr_range_nr             = l_range
      object                  = 'ZZ_LEIHSET'
    IMPORTING
      number                  = e_reservation
    EXCEPTIONS
      interval_not_found      = 1
      number_range_not_intern = 2
      object_not_found        = 3
      quantity_is_0           = 4
      quantity_is_not_1       = 5
      interval_overflow       = 6
      OTHERS                  = 7.
ENDMETHOD.


METHOD get_open_orders_cust.
*____HS# 10058, VON: S.Taori, DATUM: 07.08.2014 ___*

  DATA: ls_area TYPE /sopromet/zzl01.

  FIELD-SYMBOLS: <fs_oo_cust>   TYPE /bitmym/check_oo,
                 <fs_vgart_chk> TYPE /sopromet/zzlvgart.

  e_return = abap_false.

  IF i_area IS INITIAL.
    ls_area = gs_actual_area.
  ELSE.
    ls_area = i_area.
  ENDIF.

  CHECK i_vgart_ex IS NOT INITIAL.
  SELECT *
    FROM /bitmym/check_oo
    INTO TABLE gt_oo_cust
   WHERE vkorg    = ls_area-vkorg
     AND vtweg    = ls_area-vtweg
     AND spart    = ls_area-spart
     AND vgart_ex = i_vgart_ex.

  IF sy-subrc EQ 0.
    e_return = abap_true.
    LOOP AT gt_oo_cust ASSIGNING <fs_oo_cust>.
      APPEND INITIAL LINE TO gt_vgart_chk ASSIGNING <fs_vgart_chk>.
      <fs_vgart_chk> = <fs_oo_cust>-vgart_chk.
    ENDLOOP.
  ELSE.
    e_return = abap_false.
  ENDIF.

ENDMETHOD.


  METHOD new_case_simulate.
*____HS# 013410, VON: RBOYAPATI, DATUM: 10.09.2019___*

    DATA: ls_comwa TYPE /sopromet/zzls01.

    get_property io_appl  'GS_COMWA' ls_comwa.
    ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
    set_property io_appl  'GS_COMWA' ls_comwa.

*-- Create case instance
    eo_case = /bitmym/cl_case=>create( io_appl = io_appl ).

    get_property eo_case 'GS_COMWA' ls_comwa.

*-- Fill Import paremeters into case instance
    ls_comwa-rscat = is_comwa-rscat.
    ls_comwa-kunnr = is_comwa-kunnr.
    ls_comwa-rstyp = is_comwa-rstyp.
    ls_comwa-odate = is_comwa-odate.
    ls_comwa-vedat = is_comwa-vedat.
    ls_comwa-numbsets = is_comwa-numbsets.
    ls_comwa-matnr    = is_comwa-matnr.

    set_property io_appl  'GS_COMWA' ls_comwa.
    set_property eo_case 'GS_COMWA' ls_comwa.

  ENDMETHOD.


  METHOD ui5_get_entity.
*____HS# 012900, VON: RBOYAPATI, DATUM: 22.01.2019___*
*____HS# 015081, VON: OPECHARROMAN, DATUM: 21.09.2021___*
*____HS# 016193, VON: GIVANOV, DATUM: 05.04.2022___*
*___ SR1-1309, User: STEKDEMIR, Date: 14.09.2023___*


    DATA: lo_case     TYPE REF TO /bitmym/cl_case,
          ls_comwa    TYPE        /sopromet/zzls01,
          ls_vbadr_ag TYPE vbadr,                           "HS# 015081
          lt_partner  TYPE /bitmym/vbpa_tab,                "HS# 015081
          ls_case     TYPE        /bitmym/case.

    io_ui5->ui5_keytab2struct( CHANGING cs_struct = ls_comwa ).
    io_ui5->ui5_filter2struct( CHANGING cs_struct = ls_comwa ).

    lo_case = /bitmym/cl_case=>create( io_ui5               = io_ui5
                                       id_case              = ls_comwa-zzlrsam
                                       id_with_reservations = abap_false ).

    lo_case->get_property( EXPORTING i_feld = 'GS_CASE'  IMPORTING e_value = ls_case  ).
    lo_case->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

    MOVE-CORRESPONDING ls_comwa TO es_entity.
    MOVE-CORRESPONDING ls_case  TO es_entity.

* START OF "HS# 015081-> add partner data and dates in time stamp format
    lo_case->get_property( EXPORTING i_feld = 'GT_PARTNER' IMPORTING e_value = lt_partner ).
    READ TABLE lt_partner ASSIGNING FIELD-SYMBOL(<fs_partner>) WITH KEY parvw = /bitmym/cl_partner=>c_parvw_ag.
    IF sy-subrc EQ 0.
      es_entity-kunnr = <fs_partner>-kunnr.
    ENDIF.
    /bitmym/cl_partner=>read_address_partner_info_ext(
      EXPORTING
        id_vkorg = ls_case-vkorg
        id_case  = ls_case-zzlrsam
        id_parvw = /bitmym/cl_partner=>c_parvw_ag
      CHANGING
        cs_vbadr = ls_vbadr_ag ).

    es_entity-name1 = ls_vbadr_ag-name1.
    /bitmym/cl_ui5_util=>convert_dates_to_times( CHANGING cs_data = es_entity ).
* End OF "HS# 015081

*Begin of HS# 016193
    io_ui5->ui5_get_context( IMPORTING ed_language = DATA(lv_spras) ).
*    populating sales group description
    IF ls_case-vkgrp IS NOT INITIAL.
      SELECT SINGLE bezei
        INTO es_entity-vkgrp_descr
        FROM tvgrt
        WHERE spras = lv_spras
          AND vkgrp = ls_case-vkgrp.
    ENDIF.
    IF ls_case-vkbur IS NOT INITIAL.
      SELECT SINGLE bezei
        INTO es_entity-vkbur_descr
        FROM tvkbt
        WHERE spras = lv_spras
          AND vkbur = ls_case-vkbur.
    ENDIF.
*End of HS# 016193

*Begin of SR1-1309
    CALL FUNCTION 'CSO_O_SD_TVSB_GET'
      EXPORTING
        pi_vsbed       = es_entity-vsbeb
        pi_spras       = lv_spras
      IMPORTING
        pe_vsbed_vtext = es_entity-vtext.
* End OF SR1-1309

  ENDMETHOD.


METHOD get_reservation_reference.
*____HS# 016561, VON: GIVANOV, DATUM: 23.02.2022___*

  FIELD-SYMBOLS: <res> TYPE /sopromet/ty_tree_map.

  READ TABLE gt_reservations ASSIGNING <res> WITH KEY lresrv = id_reservation.
*  CHECK sy-subrc EQ 0.                                     "HS# 016561 DEL
  IF sy-subrc IS INITIAL.                                   "HS# 016561
    eo_reservation = <res>-objkey.
  ELSE.                                                     "HS# 016561
    CHECK id_reservation IS NOT INITIAL.                    "HS# 016561
    CREATE OBJECT eo_reservation                            "HS# 016561
      EXPORTING                                             "HS# 016561
        i_zzlresn = id_reservation.                         "HS# 016561
  ENDIF.                                                    "HS# 016561
ENDMETHOD.


  METHOD get_r_werk_ptp.
*____HS# 10412,VON: T.Kern, DATUM: 03.09.2015 ___*

    SELECT SINGLE werks FROM /bitmym/cus2 INTO gs_comwa-r_werk
      WHERE vkorg = gs_comwa-vkorg
      AND   kunag = gs_comwa-kunnr
      AND   eqart = ''.

  ENDMETHOD.


METHOD get_screen_data.
*____HS# 9893, VON: T.Kern, DATUM: 06.04.2014 ___*
*____HS# 10020, VON: MKnauer, DATUM: 09.07.2014 ___*
*____HS# 10240, VON: MKnauer, DATUM: 15.12.2014 ___*
*____HS# 10880, VON: T.Kern, DATUM: 20.11.2015 ___*
*____HS# 11538, VON: O.Pecharroman - 10.02.2017
*____HS# 12469, VON: STAORI, DATUM: 14.06.2018___*
*____HS# 014095, VON: TKERN, DATUM: 13.05.2020___*
*____HS# 014748, VON: SISMAIL, DATUM: 16.12.2020___*
*____HS# 016287, VON: SBADUSHA, DATUM: 14.03.2022___*
*____HS# 017034, VON: SBADUSHA, DATUM: 06.07.2022___*
*____HS# 017384, VON: SBADUSHA, DATUM: 19.12.2022___*
*___ SR1-883, User: SBADUSHA, Date: 07.11.2023___*


  DATA: ls_res        TYPE /sopromet/zzlrv,
        lo_equi       TYPE REF TO /sopromet/cl_l_equipment,
        ls_dates      TYPE /bitmym/case_common_date,
        ls_comwa_equi TYPE /bitmym/case_common_equi.

  DATA: ls_eqbs        TYPE eqbs.                           "HS# 10240
  get_surgeon_name( ).  " HS# 014748

*&* Begin of HS# 17384
*  if gs_case-vkbur is initial. "SR1-883
*    data(r_vkbur) = read_sales_office( ). "SR1-883
*    gs_case-vkbur = r_vkbur. "SR1-883
*  endif.  "SR1-883
*&* End of HS# 17384

*> HS#9796, T.Kern - 05.02.2014
  e_comwa  = gs_comwa.
  e_case   = gs_case.

  CLEAR e_comwa-bwerk.                                      "HS# 10240

  CHECK  go_act_reservation IS NOT INITIAL.

  go_act_reservation->get_reservation_data(
     IMPORTING
       e_reservation              = ls_res
       e_equipment                = lo_equi ).

  IF ls_res-zzlresn IS INITIAL AND gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 016287

    MOVE-CORRESPONDING gs_case TO ls_res.

    set_property go_act_reservation 'G_RESERVATION' ls_res.

  ENDIF.

  IF ls_res-rscat = /sopromet/cl_l_reservation=>c_rscat_b AND ls_res-werks IS INITIAL. "HS# 016287

    ls_res-werks = go_act_reservation->booking_plant_determination( ). "HS# 016287

  ENDIF.                                                    "HS# 016287

  IF lo_equi IS NOT INITIAL.
    e_equi_data = lo_equi->exp_equi_data( ).

    IF ls_res-kzsir IS INITIAL.                             "HS# 10240
      ls_eqbs       = lo_equi->get_eqbs( ).                 "HS# 10240
      e_comwa-bwerk = ls_eqbs-b_werk.                       "HS# 10240

    ELSE.                                                   "HS#10880

      IF e_equi_data-swerk IS INITIAL.                      "HS#10880

        single_item_get_plant( ).                           "HS#10880

        go_act_reservation->get_property( EXPORTING i_feld = 'G_RESERVATION-WERKS' IMPORTING e_value = e_equi_data-swerk ). "HS#10880

      ENDIF.
                                                            "HS#10880
    ENDIF.                                                  "HS#10880

  ENDIF.

  IF e_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create.              "Reservierungsdaten sind noch leer
    MOVE-CORRESPONDING ls_res TO e_comwa.
*___Status + Komplettkennzeichen
    e_comwa-txt30 = go_act_reservation->get_user_status_30( ).
    e_comwa-txt04 = go_act_reservation->get_user_status( ).
    e_comwa-bezei = go_act_reservation->get_del_priority_text( i_lprio = e_comwa-lprio ). "HS# 17034
  ELSE.
    e_comwa-txt30 = TEXT-ini.
*    MOVE-CORRESPONDING gs_case  TO ls_dates. " HS# 11538
*    MOVE-CORRESPONDING ls_dates TO gs_comwa. " HS# 11538
    go_act_reservation->set_init_dates_from_routes( EXPORTING it_route = gt_comwa_route " HS# 11538
                                                    CHANGING cs_dates = e_comwa ).



  ENDIF.

  check_field_inventory( ).                                 "HS#14095

  gs_comwa = e_comwa.

  IF e_comwa-r_werk IS INITIAL.                             "HS# 9893

    go_act_reservation->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).

    e_comwa-r_werk = go_act_reservation->get_default_plant_we( ). "HS# 9893

  ENDIF.                                                    "HS# 9893

  get_day_texts( EXPORTING id_level = id_level is_reservation = ls_res "HS# 10020
                 CHANGING es_comwa = e_comwa ).             "HS# 10020

ENHANCEMENT-POINT get_screen_data_01 SPOTS /bitmym/case .

*__Populate rental business related data (8009)
  rental_get_screen_data( CHANGING cs_rental_fields = e_comwa ). "HS 12469

  CHECK e_comwa-equnr IS INITIAL OR e_comwa-equnr NE e_equi_data-equnr. "HS#9796
  MOVE-CORRESPONDING e_equi_data   TO ls_comwa_equi.
  MOVE-CORRESPONDING ls_comwa_equi TO e_comwa.
*&* Begin of HS# 017034
  IF ls_res-kzsir IS  INITIAL.
    check_del_prio_from_refbook( EXPORTING i_equnr = ls_res-equnr i_matnr = e_comwa-matnr CHANGING c_lprio = e_comwa-lprio c_bezei = e_comwa-bezei ).
  ENDIF.
*&* End of HS# 017034
  IF e_comwa-r_werk IS INITIAL.                             "HS# 9893

    go_act_reservation->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).

    e_comwa-r_werk = go_act_reservation->get_default_plant_we( ). "HS# 9893

  ENDIF.                                                    "HS# 9893

ENHANCEMENT-POINT get_screen_data SPOTS /bitmym/case .

  gs_comwa = e_comwa.




ENDMETHOD.


  METHOD reject_reservation_v2.
*____HS# 014533, VON: PKUNAL, DATUM: 30.09.2020___*

ENHANCEMENT-POINT REJECT_RESERVATION_V2_01 SPOTS /BITMYM/CL_CASE .

    exe_reject_reservation( ).

    go_appl->set_property( i_feld = 'GS_RESTART_INFO-ZZLRSAM' i_value = gs_comwa-zzlrsam ).

  ENDMETHOD.


METHOD get_user_subscreen.
  DATA: ls_area   TYPE /sopromet/zzl01.


  CHECK go_salesarea IS NOT INITIAL.

  go_salesarea->get_property( EXPORTING i_feld = 'GS_ACTUAL_AREA' IMPORTING e_value = ls_area ).

  IF ls_area-exitprg IS NOT INITIAL AND
     ls_area-exitdyn IS NOT INITIAL.
*__Userexit ist aktiv
    e_tab-subscreen = ls_area-exitdyn.
    e_tab-prog      = ls_area-exitprg.

*__Daten können nur noch ühber Objektreferenz und deren Methode zurückgeschrieben werden
    CALL METHOD /sopromet/ex_handler=>ex_pbo_user_screen
      EXPORTING
        i_ls01  = gs_comwa
        io_case = me.

*__Userdaten an Funktionsgruppe übergeben
enhancement-point pbo_user_screen spots /bitmym/case.

  ENDIF.
ENDMETHOD.


METHOD get_we_reservations_changed.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*

  DATA: lt_tree TYPE /sopromet/ty_tree_map_tab,
        lo_tree TYPE REF TO /bitmym/cl_tree_case.

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

  CHECK go_tree_case IS BOUND.                                "HS 12493

  lo_tree ?= go_tree_case.

  get_property lo_tree 'GT_NODE_MAP' lt_tree.

  IF io_reservation IS BOUND.
*___Nur eine Reservierung zurückgeben
    et_tree = lt_tree.
    DELETE et_tree WHERE objkey NE io_reservation.
    EXIT.
  ENDIF.

  LOOP AT lt_tree ASSIGNING <tree> WHERE objkey IS BOUND.
    IF <tree>-objkey->we_check_changes_made( ) EQ abap_false.
      DELETE lt_tree.
    ENDIF.
  ENDLOOP.

*___Was jetzt noch in der ITAB ist muss gesichert werden
  et_tree = lt_tree.

ENDMETHOD.


METHOD gos_manager.
*____HS# 014600, VON: GIVANOV, DATUM: 27.10.2020___*
*___ SR2-335, User: STEKDEMIR, Date: 17.04.2024___*
*___ SR2-2606, User: PKSHIRSAGAR, Date: 17.12.2025___*

  DATA: ls_res TYPE /sopromet/zzlrv,
        ls_id  TYPE borident.

  CHECK go_act_reservation IS BOUND.

  go_act_reservation->get_reservation_data( IMPORTING e_reservation = ls_res ).
  CHECK ls_res-zzlresn IS NOT INITIAL.

  ls_id-objkey  = ls_res-zzlresn.
*  ls_id-objtype = 'ZZLRESERV'. "SR2-335
*  ls_id-objtype = /sopromet/cl_l_reservation=>c_objtype_reservation. "SR2-335  "SR2-2606, commented
   ls_id-objtype = /bitmym/cl_mym=>get_object_attachment( /bitmym/cl_mym=>c_objtype_reservation ). "SR2-335  "SR2-2606

  CREATE OBJECT go_gos_manager
    EXPORTING
*     io_container     =
*     is_bc_object     =
      is_object        = ls_id
*     it_service_selection =
*     io_callback      =
*     ip_start_direct  = space
*     ip_no_instance   = space
      ip_no_commit     = 'R'  "HS# 014600
*     ip_mode          = 'e'
    EXCEPTIONS
      object_invalid   = 1
      callback_invalid = 2
      OTHERS           = 3.



ENDMETHOD.


  METHOD init_linked_objects.
*____HS# 12094, VON: MKANUER, DATUM: 10.10.2017 ___*

    IF gs_case IS INITIAL.
      go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = gs_comwa ).
    ENDIF.

*___Init Texte
    IF go_texte IS NOT BOUND.
      go_texte = /bitmym/cl_texte=>create( me ).
    ENDIF.

*___Init Partner
    IF go_partner IS NOT BOUND.
      go_partner = /bitmym/cl_partner=>create( me ).
    ENDIF.

*___Init Nachrichtenfindung
    IF go_messaging IS NOT BOUND.
      go_messaging = /bitmym/cl_messaging=>create( me ).
    ENDIF.

  ENDMETHOD.


METHOD link_objects.
*____HS# 12010, VON: MKnauer,       DATUM:  15.08.2017 ___*

  IF g_iconnect EQ abap_false.                              "HS# 12010
    IF gs_case IS INITIAL.
      go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = gs_comwa ).
    ENDIF.
  ENDIF.                                                    "HS# 12010

*___Init Texte
  go_texte = /bitmym/cl_texte=>create( me ).

*___Init Partner
  go_partner = /bitmym/cl_partner=>create( me ).

*___Init Nachrichtenfindung
  go_messaging = /bitmym/cl_messaging=>create( me ).

ENDMETHOD.


METHOD maintain_existing_case.
*___#9798 Harald Wagener (HW) Erweiterung Faktura Monitor für Leap Projekt
*____HS# 10151, VON: MKnauer, DATUM: 10.10.2014 ___*
*____HS# 10512, VON: S.Taori, DATUM: 20.08.2015 ___*
*____HS# 10467, VON: O.PECHARROMAN, DATUM: 08.10.2015____*
*____HS# 10888, VON: O.PECHARROMAN, DATUM: 23.11.2015____*
*____HS# 11600, VON: S.Taori, DATUM: 02.02.2017 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 11933, VON: G.Ivanov, DATUM:  27.06.2017 ___*
*____HS# 11944, VON: O.pecharroman, DATUM:  04.07.2017 ___*
*____HS# 12314, VON: O.Pecharroman, DATUM: 10.09.2018 ___*
*____HS# 012798, VON: OPECHARROMAN, DATUM: 19.11.2018___*
*____HS# 014154, VON: GIVANOV, DATUM: 27.05.2020___*
*____HS# 014706, VON: STAORI,  DATUM: 15.12.2020___*
*____HS# 015114, VON: STAORI,  DATUM: 30.03.2021___*
*____HS# 016751, VON: SISMAIL, DATUM: 01.03.2022___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*

  DATA: ls_res TYPE /sopromet/zzlrv.
  DATA: lo_res TYPE REF TO /sopromet/cl_l_reservation.      " #9798
  DATA: ld_rscat TYPE /bitmym/rscat.                        "HS# 11944
  DATA: ls_map TYPE  /sopromet/ty_tree_map.                 "HS# 10467
  DATA: lo_area  TYPE REF TO /sopromet/cl_l_salesarea,      "SR1-545
        ld_linked TYPE abap_bool.                           "SR1-545

  e_success = abap_false.

*__New EHP                                                  "HS 14706
ENHANCEMENT-POINT maintain_existing_case_01 SPOTS /bitmym/cl_case .

  IF gs_comwa-zzlresn IS NOT INITIAL AND
     gs_comwa-zzlrsam IS NOT INITIAL.     "Sammelgang wird auch im Konstruktor gesetzt

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = gs_comwa-zzlresn
      IMPORTING
        e_reservation = ls_res.

* -> Begin of SR1-545
    get_property go_appl 'GO_AREA' lo_area.
    IF lo_area IS BOUND.
      DATA(lt_linked_areas) = lo_area->get_linked_areas( EXPORTING iv_user_only = abap_true is_res = ls_res CHANGING cv_is_linked = ld_linked ).
    ELSE.
      IF go_salesarea IS BOUND.
        lt_linked_areas = go_salesarea->get_linked_areas( EXPORTING iv_user_only = abap_true is_res = ls_res CHANGING cv_is_linked = ld_linked ).
      ENDIF.
    ENDIF.
* -> End of SR1-545

*    IF ls_res-zzlrsam NE gs_comwa-zzlrsam.                   "HS# 11933
    IF ls_res-zzlrsam IS NOT INITIAL AND                    "HS# 11944
       ls_res-zzlrsam NE gs_comwa-zzlrsam OR
*       ls_res-vkorg   NE gs_comwa-vkorg.                   "HS# 11933  "SR1-545
      ( ld_linked EQ abap_false AND ls_res-vkorg   NE gs_comwa-vkorg ). "SR1-545
      MESSAGE i434(/sopromet/zl) WITH ls_res-zzlresn        "HS# 11944
                                      gs_comwa-vkorg        "HS# 11944
                                      gs_comwa-zzlrsam      "HS# 11944
            INTO gd_dummy_message.                          "HS# 11933
*      MESSAGE i249(/sopromet/zl) INTO gd_dummy_message.     ""HS# 11933 HS# 11637
      call_message.                                         " HS# 11637
      EXIT.
    ENDIF.

  ENDIF.

* CHECK gs_case IS NOT INITIAL.                             "HS# 11944

  CHECK gs_comwa-zzlresn IS NOT INITIAL OR
        gs_comwa-zzlrsam IS NOT INITIAL.

* Init HS# 10467
* Check that the selected reservation has the correct reservation type
  IF gs_comwa-zzlresn IS NOT INITIAL.
    IF ls_res IS INITIAL.
      CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
        EXPORTING
          i_reserv      = gs_comwa-zzlresn
        IMPORTING
          e_reservation = ls_res.
    ENDIF.

  ELSEIF gs_comwa-zzlrsam IS NOT INITIAL.
    READ TABLE gt_reservations INTO ls_map INDEX 1.
    IF sy-subrc = 0.
      CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
        EXPORTING
          i_reserv      = ls_map-lresrv
        IMPORTING
          e_reservation = ls_res.
    ELSE.                                                   "HS# 11944
      MESSAGE i263(/sopromet/zl) INTO gd_dummy_message..    "HS# 11944
      call_message.                                         "HS# 11944
      EXIT.                                                 "HS# 11944
    ENDIF.
  ENDIF.

  IF ls_res-zzlrsam IS NOT INITIAL                          "HS# 11944
    AND go_appl IS NOT INITIAL.                             "HS# 11944
    get_property go_appl 'GS_COMWA-RSCAT' ld_rscat.         "HS# 11944
    IF ls_res-rscat NE ld_rscat                            "HS# 11944
              AND ls_res-rscat NE /sopromet/cl_l_reservation=>c_rscat_c. "HS# 016751+
*     We are trying to open a booking on the reservation screen, show error
      MESSAGE i617(/sopromet/zl) INTO gd_dummy_message.     "HS# 11944
      call_message.                                         "HS# 11944
    ENDIF.                                                  "HS# 11944
    CHECK ls_res-rscat = ld_rscat                          "HS# 11944
            OR  ls_res-rscat = /sopromet/cl_l_reservation=>c_rscat_c. "HS# 016751+

    IF gs_case IS INITIAL.                                  "HS# 11944
*      MESSAGE i434(/sopromet/zl) WITH ls_res-zzlresn        "HS# 11944  "HS# 012798
*                                      gs_comwa-vkorg        "HS# 11944  "HS# 012798
      CHECK res_open_linked_sales_area( is_res = ls_res ) EQ abap_false. "HS# 015114
      MESSAGE i263(/sopromet/zl)                            "HS# 012798
      INTO gd_dummy_message.                                "HS# 11933
      call_message.                                         "HS# 11944
    ENDIF.                                                  "HS# 11944
  ENDIF.

* End HS# 10467


  CHECK gs_case IS NOT INITIAL.                             "HS# 11944

  IF go_salesarea IS BOUND.
*    CHECK go_salesarea->check_sales_area( io_case = me ) IS INITIAL.                           "HS 11600
    CHECK go_salesarea->check_sales_area( io_case = me i_trtyp = gs_comwa-trtyp_o ) IS INITIAL. "HS 11600
  ENDIF.


  CASE gs_comwa-trtyp_o.
    WHEN /bitmym/cl_mym=>c_trtyp_change.
*____HS# 014154 Start insert
*__Berechtigungsprüfung
      IF id_no_authori = abap_false.                        " HS# 10151
        CHECK go_user->check_auth_with_txt(  /bitmym/cl_user=>c_auth_res_aendern ) EQ abap_true.
      ENDIF.                                                " HS# 10151
*____HS# 014154 End insert


*__Sperre auf CASE
      CHECK enqueue( ) EQ abap_true.

*___#9798 HW begin
*__Sperre nun setzen
      IF ls_res-zzlresn IS NOT INITIAL.                     "HS# 11944
        IF lo_res IS NOT BOUND.
          CREATE OBJECT lo_res
            EXPORTING
              i_zzlresn = ls_res-zzlresn.                     "HS# 11944
        ENDIF. " lo_res
        lo_res->enqueue( i_dialog = 'I').                   "HS# 10888
        IF lo_res->g_enqueue NE abap_true.                  "HS# 10888
          CALL FUNCTION 'DEQUEUE_/BITMYM/ECASE'               "HS# 10888
            EXPORTING                                         "HS# 10888
              vkorg   = gs_comwa-vkorg                        "HS# 10888
              zzlrsam = gs_comwa-zzlrsam.                     "HS# 10888
          EXIT.                                             "HS# 10888
        ENDIF.                                              "HS# 10888
      ENDIF. " gs_comwa-zzlresn
*__#9798 end

*____HS# 014154 Start deletion. Moved up in the code
**__Berechtigungsprüfung
*      IF id_no_authori = abap_false.                        " HS# 10151
*        CHECK go_user->check_auth_with_txt(  /bitmym/cl_user=>c_auth_res_aendern ) EQ abap_true.
*      ENDIF.                                                " HS# 10151
*____HS# 014154 End deletion

      e_success = abap_true.

*Init HS# 12314. Before entering, refresh memory text.
      CALL FUNCTION 'FREE_TEXT_MEMORY'
*    EXPORTING
*     LOCAL_CAT       = ' '
        EXCEPTIONS
          not_found = 1
          OTHERS    = 2.
*End HS# 12314

*__New EHP                                                  "HS 14706
ENHANCEMENT-POINT maintain_existing_case_02 SPOTS /bitmym/cl_case .

    WHEN /bitmym/cl_mym=>c_trtyp_display.


*__Berechtigungsprüfung
      CHECK go_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_anzeigen ) EQ abap_true.

*___#9798 HW begin
*__Sperre beim Wechsel auf Display aufheben
      IF gs_comwa-zzlresn IS NOT INITIAL.
        IF lo_res IS NOT BOUND.
          CREATE OBJECT lo_res
            EXPORTING
              i_zzlresn = gs_comwa-zzlresn.
        ENDIF. " lo_res
        lo_res->dequeue( ).
      ENDIF. " gs_comwa-zzlresn
*__#9798 end
      e_success = abap_true.

  ENDCASE.

*__New EHP                                                  "HS 14706
ENHANCEMENT-POINT maintain_existing_case_03 SPOTS /bitmym/cl_case .

ENDMETHOD.


METHOD message_dialog.
  go_messaging->message_dialog( ).
ENDMETHOD.


METHOD message_maintenance.
  go_messaging->message_maintenance( ).
ENDMETHOD.


METHOD message_update.
  CHECK go_messaging IS BOUND.
  go_messaging->message_update( ).
ENDMETHOD.


method MESSAGING.
  go_messaging->MESSAGING( ).
endmethod.


  METHOD get_booking_reservations.
*____HS# 012900, VON: RBOYAPATI, DATUM: 02.04.2019___*

    FIELD-SYMBOLS: <res> LIKE LINE OF gt_reservations.

    CHECK gs_case-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.

    READ TABLE gt_reservations ASSIGNING <res> INDEX 1.

    CHECK sy-subrc EQ 0.

    SELECT * FROM /sopromet/zzlrv AS a INNER JOIN /sopromet/restat AS b
      ON b~zzlresn = a~zzlresn AND b~vkorg = a~vkorg
      INTO CORRESPONDING FIELDS OF TABLE et_zzlrv
      WHERE ref_book =  <res>-lresrv
        AND txt04    <> /sopromet/cl_l_reservation=>c_res_status_cancelled
      ORDER BY a~zzlresn.

  ENDMETHOD.


METHOD mig_case_result.
*____HS# 013195, VON: OPECHARROMAN, DATUM: 12.06.2019___*
  DATA: ls_res      TYPE /sopromet/zzlrv,
        lt_node_map TYPE /sopromet/ty_tree_map_tab.

  FIELD-SYMBOLS: <fds_mat>  TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_materialselection,
                 <fds_node> TYPE /sopromet/ty_tree_map.

  CHECK go_tree_case IS BOUND.

  get_property go_tree_case 'GT_NODE_MAP' lt_node_map.

  LOOP AT lt_node_map ASSIGNING <fds_node>.
    CHECK <fds_node>-objkey IS  BOUND.
    <fds_node>-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
    READ TABLE es_data-casetomaterialselection ASSIGNING <fds_mat> WITH KEY equnr = ls_res-equnr.
    IF sy-subrc EQ 0.
      <fds_mat>-lresn = <fds_node>-lresrv.
      <fds_mat>-lrsam = gs_comwa-zzlrsam.
    ENDIF.
  ENDLOOP.

ENDMETHOD.


METHOD check_booking_items_empty.
*____HS# 014376, VON: OPECHARROMAN, DATUM: 19.01.2021___*
*____HS# 014970, VON: STAORI,       DATUM: 22.02.2021___*
*___ SR2-970, User: SCOSAR, Date: 18.10.2024___*

  DATA: lt_tree     TYPE /sopromet/tree_collect_tab,
        ls_map      TYPE /sopromet/ty_tree_map,
        lt_bookings TYPE /bitmym/b_items_st_tab.

  FIELD-SYMBOLS: <tree>   TYPE /sopromet/tree_collect.
  CHECK gs_comwa-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.


  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE'     IMPORTING e_value = lt_tree ).
  LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.
    ls_map = go_tree_case->get_map_of_node( <tree>-node_key ).
    check ls_map-objkey->get_data( )-g_reservation-xfollowup eq abap_false. "SR2-970
    lt_bookings = ls_map-objkey->get_prop_booking_items(  ).
    CHECK lt_bookings IS INITIAL.

    IF ls_map-lresrv IS INITIAL.                            "HS 14971
      /bitmym/cl_message=>message( id = 'I726(/SOPROMET/ZL)' ). "HS 14971
    ELSE.                                                   "HS 14971
      /bitmym/cl_message=>message( id = 'I719(/SOPROMET/ZL)' v1 =  ls_map-lresrv ).
    ENDIF.                                                  "HS 14971

    EXIT.
  ENDLOOP.

ENDMETHOD.


  METHOD ui5_new_case_simulate.
*____HS# 012900, VON: RBOYAPATI, DATUM: 22.01.2019___*
*____HS# 014618, VON: TKERN, DATUM: 03.11.2020___*

    DATA: lo_mym  TYPE REF TO /bitmym/cl_mym,
          lo_case TYPE REF TO /bitmym/cl_case.

    DATA: ls_comwa TYPE /sopromet/zzls01,
          ls_input TYPE /sopromet/zzls01.

    CHECK io_ui5 IS BOUND.

    io_ui5->ui5_keytab2struct( CHANGING cs_struct = ls_input ).
    io_ui5->ui5_filter2struct( CHANGING cs_struct = ls_input ).

    get_property io_ui5  'GO_MYM'   lo_mym.
    get_property lo_mym  'GS_COMWA' ls_comwa.
*___Set application to "CREATE MODE"
    ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
    set_property lo_mym 'GS_COMWA' ls_comwa.


*___Step 1: Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).
    get_property lo_case 'GS_COMWA' ls_comwa.

*___Step 2: Fill CASE & APPL COMWA
    ls_comwa-rscat = ls_input-rscat.
    ls_comwa-kunnr = ls_input-kunnr.
    ls_comwa-rstyp = ls_input-rstyp.
    ls_comwa-odate = ls_input-odate.
    ls_comwa-vedat = ls_input-vedat.

    set_property lo_mym  'GS_COMWA' ls_comwa.
    set_property lo_case 'GS_COMWA' ls_comwa.


*___Step 3: Partner determination
    IF lo_case->ui5_prep_case_partner( ) EQ abap_true.
      " May be this check has to be mandatory and EXIT
      "  - but partner selection may not be working properly in all cases at the moment
    ENDIF.

    IF lo_case->go_partner IS NOT INITIAL.                  "HS# 14618
      lo_case->go_partner->set_fld_inv_cust_range( ).       "HS# 14618
    ENDIF.                                                  "HS# 14618

*___Step 4: Date calculation
    lo_case->compute_dates( CHANGING cs_comwa = ls_comwa ).

*___Synchronize COMWA from Case to application
    set_property lo_mym 'GS_COMWA' ls_comwa.

    eo_case = lo_case.

  ENDMETHOD.


METHOD new_reservation_fill_partner_d.
*____HS# 8113, VON: IREDDIES, DATUM: 26.11.2013 ___*
*___ SR2-721, User: SCOSAR, Date: 21.10.2024___*

  DATA: lt_vbpa      TYPE /sopromet/vbpav_tab.

  FIELD-SYMBOLS: <kunag> TYPE vbpav,
                 <kunwe> TYPE vbpav,
                 <kunsb> TYPE vbpav.                        "HS#8113
*____SR2-721____BEGIN INSERT___*
  IF go_partner IS NOT BOUND.
    read_partner( ).
    MOVE-CORRESPONDING gt_partner TO lt_vbpa.
  ELSE.
*____SR2-721____END   INSERT___*
    go_partner->get_property( EXPORTING i_feld = 'GT_VBPA' IMPORTING e_value = lt_vbpa ).
  ENDIF. "SR2-970

ENHANCEMENT-POINT NEW_RESERVATION_FILL_PART01 SPOTS /BITMYM/CASE.

  IF lt_vbpa IS NOT INITIAL.
    READ TABLE lt_vbpa ASSIGNING <kunag> WITH KEY parvw = 'AG'.
    READ TABLE lt_vbpa ASSIGNING <kunwe> WITH KEY parvw = 'WE'.
    READ TABLE lt_vbpa ASSIGNING <kunsb> WITH KEY parvw = 'SB'. "HS#8113
  ENDIF.

  IF <kunag> IS ASSIGNED.
    cs_comwa-kunnr = <kunag>-kunnr.
  ENDIF.
  IF <kunwe> IS ASSIGNED.
    cs_comwa-kunwe = <kunwe>-kunnr.
  ENDIF.
  IF <kunsb> IS ASSIGNED.                                   "HS#8113
    cs_comwa-kunnr_sb = <kunsb>-kunnr.                      "HS#8113
  ENDIF.                                                    "HS#8113

ENHANCEMENT-POINT NEW_RESERVATION_FILL_PART02 SPOTS /BITMYM/CASE.

ENDMETHOD.


