  METHOD ui5_we_add_items_post.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*
*____HS# 015083, VON: SSINGH, DATUM: 14.10.2021___*
*___ SR2-1924, User: PKSHIRSAGAR, Date: 16.06.2025___*


    DATA:
      lt_add_ret TYPE /sopromet/res_items,
      lt_ret     TYPE /bitmym/ui5_inspection_tt,
      lv_idx     TYPE sy-index,
      ls_item    LIKE LINE OF lt_add_ret,
      ls_res     TYPE /sopromet/zzlrv,
      lv_error   TYPE abap_bool,
      lo_add_res TYPE REF TO /sopromet/cl_l_reservation.

    FIELD-SYMBOLS: <lfs_add_ret> LIKE LINE OF lt_add_ret,
                   <lfs_ret>     LIKE LINE OF ct_ret.

    lt_ret = ct_ret.
    CLEAR ct_ret.

    DELETE lt_ret WHERE additional IS INITIAL.      " Additional
    CHECK lt_ret IS NOT INITIAL.

*    CHECK go_ui5->go_panel IS BOUND.
*    set_property go_ui5->go_panel 'GO_CASE' me.
*    CHECK go_ui5->go_panel->check_function_active( 'WE_ADD_ITEMS' ) EQ abap_true.
*
*    ui5_prep_reservation_tree( i_add_res = abap_false ).


    IF go_act_reservation->get_data( )-g_reservation-kzper = /sopromet/cl_l_reservation=>c_pend_type_cons_additional. "SR2-1924
      lo_add_res  =  go_act_reservation.
    ELSE.                                                   "SR2-1924
      lo_add_res = we_add_reservation_exists( ).
    ENDIF.                                                  "SR2-1924

    IF lo_add_res IS NOT BOUND.
      lo_add_res = we_add_itm_reserv_add( ).
      CHECK lo_add_res IS BOUND.
    ENDIF.

    get_property lo_add_res 'G_RESERVATION_ITEMS_RET' lt_add_ret.
    get_property lo_add_res 'G_RESERVATION' ls_res.

    DELETE lt_ret WHERE zzlresn = ls_res-zzlresn. "New additional
    CHECK lt_ret IS NOT INITIAL.

    go_act_reservation = lo_add_res.
    set_property lo_add_res 'GT_UI5_RET' lt_ret.
    set_property lo_add_res 'GO_APPLICATION' go_appl.
    CHECK lo_add_res->ui5_we_validate( ) EQ abap_true.

    DESCRIBE TABLE lt_add_ret LINES lv_idx.
    SORT lt_add_ret BY posnr ASCENDING.                     "HS 15083
    READ TABLE lt_add_ret INTO ls_item INDEX lv_idx.

    LOOP AT lt_ret ASSIGNING <lfs_ret>.

      CHECK <lfs_ret>-zzlresn NE ls_res-zzlresn.

      <lfs_ret>-zzlresn = ls_res-zzlresn.
      <lfs_ret>-swerk   = ls_res-werks.
      <lfs_ret>-posnr   = ls_item-posnr = ls_item-posnr + 10.

      APPEND INITIAL LINE TO lt_add_ret ASSIGNING <lfs_add_ret>.
      MOVE-CORRESPONDING <lfs_ret> TO <lfs_add_ret>.
    ENDLOOP.

    set_property lo_add_res 'G_RESERVATION_ITEMS_RET' lt_add_ret.

    lo_add_res->single_items_post( abap_false ).

    get_property lo_add_res 'G_ERROR_MM_POSTING' lv_error.
    CHECK lv_error IS INITIAL.

    ct_ret = lt_ret.
    eo_res = lo_add_res.

  ENDMETHOD.


  METHOD ui5_we_post_ret_data.
*____HS# 12493,  VON:  RBOYAPATI,   DATUM: 21.05.2018 ___*
*____HS# 12729,  VON:  STAORI,      DATUM: 11.10.2018___*
*____HS# 012765, VON:  SSINGH,      DATUM: 06.03.2020___*
*____HS# 014038, VON:  SSINGH,      DATUM: 16.04.2020___*
*____HS# 014112, VON:  SSINGH,      DATUM: 03.07.2020___*
*____HS# 016751, VON:  SISMAIL,     DATUM: 26.07.2022___*
*___ SR2-224,    User: SCOSAR,      Date:  03.05.2024___*
*___ SR2-1312,   User: OOGUR,       Date:  31.01.2025___*
*___ SR2-1621,   User: SBADUSHA,    Date:  25.03.2025___*
*___ SR2-1684,   User: XLI,         Date:  16.04.2025___*
*___ SR2-1924,   User: PKSHIRSAGAR, Date:  18.06.2025___*
*___ SR2-2064,   User: XLI,         Date:  14.07.2025___*
*___ SR2-2093,   User: PKSHIRSAGAR, Date:  30.07.2025___*
*___ SR2-2243,   User: XLI,         Date:  21.10.2025___*
*___ SR2-2565,   User: STEKDEMIR,   Date:  04.12.2025___*
*___ SR2-2520,   User: XLI,         Date:  09.01.2026___*



    DATA:
      ls_ui5_comwa  TYPE /bitmym/ui5_comwa,
      lo_case       TYPE REF TO /bitmym/cl_case,
      lo_appl       TYPE REF TO /bitmym/cl_mym,
      lo_equipment  TYPE REF TO /sopromet/cl_l_equipment,
      lt_res_ret    TYPE /sopromet/res_items,
      lt_ret        TYPE /bitmym/ui5_inspection_tt,
      lt_add_ret    TYPE /bitmym/ui5_inspection_tt,
      lv_error      TYPE abap_bool,
      ls_res        TYPE /sopromet/zzlrv,
      lo_uid        TYPE REF TO /bitmym/cl_rfid_uid,
      lt_alv        TYPE /bitmym/retitems_alv_tab,
      lv_idx        TYPE sy-index,                          "SR2-2093
      ls_item       LIKE LINE OF lt_add_ret,                "SR2-2093
      lt_res_ret_yy TYPE /sopromet/res_items,               "SR2-2243
      lo_badi_s     TYPE REF TO /bitmym/bd_case_ui5_we_post "SR2-2565
      .

    FIELD-SYMBOLS: <lfs_res>     TYPE /sopromet/ty_tree_map,
                   <lfs_ret>     TYPE /bitmym/ui5_inspection_s, "HS 12729
                   <lfs_res_ret> TYPE /sopromet/zzls04,     "HS 12729
                   <lfs_alv>     TYPE /bitmym/retitems_alv. "HS 12729


    CHECK io_ui5 IS BOUND.

    /sopromet/cl_l_message_collect=>init( io_ui5 = io_ui5 ).

    get_property io_ui5 'GS_UI5_COMWA' ls_ui5_comwa.

    CHECK ls_ui5_comwa-lresn IS NOT INITIAL.

*__ 1. Create case instance
    lo_case = /bitmym/cl_case=>create( id_reservation     = ls_ui5_comwa-lresn
*                                       id_no_link_objects = abap_true  "SR2-1621 COM
                                       io_ui5             = io_ui5 ).


*__ 2. Get reservation and check authorization
    READ TABLE lo_case->gt_reservations ASSIGNING <lfs_res> WITH KEY lresrv = ls_ui5_comwa-lresn.
    CHECK sy-subrc EQ 0.

    get_property io_ui5  'GO_MYM'  lo_appl.
    set_property lo_appl 'GO_CASE' lo_case.
    set_property lo_case 'GO_ACT_RESERVATION' <lfs_res>-objkey.

    CHECK io_ui5->go_panel IS BOUND.
    set_property io_ui5->go_panel 'GO_RESERVATION' <lfs_res>-objkey.
    IF io_ui5->go_panel->check_function_active( ls_ui5_comwa-fcode ) EQ abap_false.
      /bitmym/cl_message=>message( id = 'E145(/BITMYM/ICONNECT)' ).
      EXIT.
    ENDIF.

    lo_case->ui5_prep_reservation_tree( i_add_res = abap_false ).

*____SR2-224____BEGIN INSERT___*
    "pass sterilization date
    get_property <lfs_res>-objkey  'G_EQUIPMENT'  lo_equipment.
    set_property lo_equipment 'GS_UI5_EQUIPASS_DATA-STZDAT' ls_ui5_comwa-stzdat.
*____SR2-224____END   INSERT___*

    IF ls_ui5_comwa-fcode EQ 'WE_ADD_ITEMS'.

*__ 3A. Save Additional Items
      lt_add_ret = it_ret.
      lo_case->ui5_we_add_items_post( CHANGING ct_ret = lt_add_ret ).

      " Update UID for RFID
      CREATE OBJECT lo_uid EXPORTING io_ui5 = io_ui5.
      lo_uid->tag_update_additional_we( it_ret = lt_add_ret ).
      /bitmym/cl_rfid_process_mng=>delete_uid_temp( i_device = ls_ui5_comwa-device ).

      CHECK lt_add_ret IS NOT INITIAL.
      COMMIT WORK AND WAIT.
      e_success = abap_true.

    ELSE.

*__ 3B. Set return items
      lt_ret = it_ret.
      DELETE lt_ret WHERE zzlresn NE ls_ui5_comwa-lresn OR additional IS NOT INITIAL.
*      CHECK lt_ret IS NOT INITIAL.                         "SR2-1924 DEL

      get_property <lfs_res>-objkey  'G_RESERVATION'  ls_res.

*      MOVE-CORRESPONDING lt_ret TO lt_res_ret.              "HS 12729
*      MOVE-CORRESPONDING lt_ret TO lt_alv.                  "HS 12729


*____SR2-2093____BEGIN INSERT___*
      lt_add_ret = it_ret.
      DESCRIBE TABLE  lt_add_ret  LINES lv_idx.
      SORT  lt_add_ret  BY posnr ASCENDING.
      READ TABLE  lt_add_ret INTO ls_item INDEX lv_idx.
*____SR2-2093____END   INSERT___*



*__Begin of HS 12729
      LOOP AT lt_ret ASSIGNING <lfs_ret>.
        APPEND INITIAL LINE TO lt_res_ret ASSIGNING <lfs_res_ret>.

*____SR2-2093____BEGIN INSERT___*
        IF <lfs_ret>-posnr IS INITIAL .
          <lfs_ret>-zzlresn = ls_res-zzlresn.
          <lfs_ret>-swerk   = ls_res-werks.
          <lfs_ret>-posnr   = ls_item-posnr = ls_item-posnr + 10.
        ENDIF.
*____SR2-2093____END   INSERT___*

        MOVE-CORRESPONDING <lfs_ret> TO <lfs_res_ret>.
        APPEND INITIAL LINE TO lt_alv ASSIGNING <lfs_alv>.
        MOVE-CORRESPONDING <lfs_ret> TO <lfs_alv>.
      ENDLOOP.
*__End of HS 12729

*      <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ).         "HS# 12765
      <lfs_res>-objkey->set_property( i_feld = 'GT_RETITEMS_ALV' i_value = lt_alv ).
      <lfs_res>-objkey->set_property( i_feld = 'GT_UI5_RET' i_value = lt_ret ).
      <lfs_res>-objkey->set_property( i_feld = 'GD_WE_DATA_CHANGED' i_value = abap_true ).


*__ 4. Validate return items

      set_property <lfs_res>-objkey 'GO_APPLICATION-GD_TRTYP_WE' /bitmym/cl_mym=>c_trtyp_change.          "HS# 016751+
      CHECK <lfs_res>-objkey->ui5_we_validate( ) EQ abap_true.


*__ 5. Update the return of additional items (if any) - possible with RFID only
      lo_case->rfid_we_add_items_consume( ).


*__ 6. Update RFID Tags
      IF ls_ui5_comwa-device IS NOT INITIAL.
        lo_uid = /bitmym/cl_rfid_uid=>create_with_equnr( iv_equnr = ls_res-equnr io_ui5 = io_ui5 ).
        IF lo_uid IS BOUND.
          lo_uid->tag_sync_we( it_ret = lt_ret ).
        ENDIF.
        /bitmym/cl_rfid_process_mng=>delete_uid_temp( i_device = ls_ui5_comwa-device ).
      ENDIF.


*__ 7. Execute Function
      CASE ls_ui5_comwa-fcode.
        WHEN 'WE_CHECK'.
*____SR2-1684____BEGIN INSERT___*
          IF  ls_res-kzsir IS NOT INITIAL.
            <lfs_res>-objkey->get_property( EXPORTING i_feld = 'GT_UI5_RET' IMPORTING e_value = lt_res_ret ).
            "if any of the dcode is empty, single item post, else checked.
            LOOP AT lt_res_ret ASSIGNING FIELD-SYMBOL(<res_ret>).
              CASE ls_res-kzper.
                WHEN /sopromet/cl_l_reservation=>c_pend_type_cons_additional.
*____SR2-2520____BEGIN COMMENT___*
*                  IF <res_ret>-menge_we IS INITIAL.
*                    DATA(lv_post) = abap_true.
*                    EXIT.
*                  ENDIF.
*____SR2-2520____END   COMMENT___*
                WHEN /sopromet/cl_l_reservation=>c_pend_type_additional.
*____SR2-2520____BEGIN COMMENT___*
*                  IF ( ( <res_ret>-dcode IS INITIAL AND <res_ret>-usagecode IS INITIAL )
*                        OR  <res_ret>-menge_we IS INITIAL  ).
*
*                    lv_post = abap_true.
*                    EXIT.
*                  ENDIF.
*____SR2-2520____END   COMMENT___*
                WHEN OTHERS.
                  IF <res_ret>-dcode IS INITIAL.
                    DATA(lv_post) = abap_true.
                    EXIT.
                  ENDIF.
              ENDCASE.
            ENDLOOP.
            <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ). "SR2-2520
            <lfs_res>-objkey->ui5_return_items_save( ).     "SR2-2520
            IF lv_post = abap_true.
*              IF <lfs_res>-objkey->we_auto_set_quantity( ) EQ abap_true.
              <lfs_res>-objkey->return_items_post( IMPORTING e_mm_posting_error = lv_error ).
              IF lv_error IS INITIAL.
                e_success = abap_true.
              ENDIF.
*              ENDIF.
              <lfs_res>-objkey->dequeue( ).
            ELSE.
              IF ls_res-kzper =  /sopromet/cl_l_reservation=>c_pend_type_cons_additional OR ls_res-kzper =  /sopromet/cl_l_reservation=>c_pend_type_additional. "SR2-1924.
                lo_case->we_add_items_closed( ).            "SR2-1924.
              ELSE.                                         "SR2-1924.
                e_success = lo_case->we_set_checked( ).
              ENDIF.                                        "SR2-1924.
              lo_case->dequeue( ).
            ENDIF.
          ELSE.
*____SR2-1684____END   INSERT___*
            "            <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_ret ). "SR2-1684 "SR2-2243 Del
            <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ). "SR2-2243
            e_success = lo_case->we_set_checked( ).
            lo_case->dequeue( ).
          ENDIF.                                            "SR2-1684

        WHEN 'WEER'.
*        lo_case->we_save( id_leave_screen = abap_true ).
          <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ). "SR2-1312
          <lfs_res>-objkey->ui5_return_items_save( IMPORTING e_mm_posting_error = lv_error ).
          IF lv_error IS INITIAL.
            e_success = abap_true.
          ENDIF.
          <lfs_res>-objkey->dequeue( ).                     "HS 14038

        WHEN 'WE_CLEAN'.
*____SR2-2243____BEGIN DELETE___*
*            <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ).
*            <lfs_res>-objkey->return_items_post( IMPORTING e_mm_posting_error = lv_error ).
*            CHECK lv_error IS INITIAL.
*____SR2-2243____END   DELETE___*
          e_success = lo_case->we_set_cleaned( ).
          lo_case->dequeue( ).                              "HS 14038

        WHEN 'WE_UNUSED'.
          e_success = lo_case->we_unused( ).
          lo_case->dequeue( ).                              "HS 14038

        WHEN 'SCRAPPING'.
          lo_case->we_scrapping( ).                         "HS#14038 HS# 14112
          lo_case->dequeue( ).                              "HS 14038 HS# 14112
        WHEN 'WE_MALL'.                                     "HS#14112
          <lfs_res>-objkey->set_property( i_feld = 'G_RESERVATION_ITEMS_RET' i_value = lt_res_ret ). "SR2-2064
          lo_case->we_mall( ).                              "HS#14112
          <lfs_res>-objkey->ui5_save_all_return( ).         "HS#14112
          COMMIT WORK AND WAIT.                             "HS#14112
          lo_case->dequeue( ).                              "HS#14112

*____SR2-1621____BEGIN INSERT___*
        WHEN 'RUEK'.
          lo_case->get_data( RECEIVING e_data = DATA(ls_case_data) ).
          CHECK ls_case_data-go_salesarea IS BOUND.
          ls_case_data-go_salesarea->get_data( RECEIVING es_data = DATA(ls_area) ).
          ls_area-go_user->get_plant_we( RECEIVING ed_werks = DATA(ld_werks_we) ).
          ls_case_data-gs_comwa-r_werk = ld_werks_we.
          lo_case->set_data( is_data = ls_case_data ).
          lo_case->return_equipments_list( ).

*____SR2-1621____END   INSERT___*

*____SR2-2565____BEGIN INSERT___*
        WHEN OTHERS.
          GET BADI lo_badi_s.
          CALL BADI lo_badi_s->ui5_we_post_ret_data
            EXPORTING
              is_ui5_comwa = ls_ui5_comwa.
*____SR2-2565____END   INSERT___*
      ENDCASE.
    ENDIF.

  ENDMETHOD.


  METHOD ui5_single_item_atp_booking.
*____HS# 015031, VON: SSINGH, DATUM: 09.03.2021___*
*____HS# 015080, VON: SSINGH, DATUM: 19.11.2021___*
*___ SR1-1347, User: SSINGH, Date: 20.06.2023___*
*___ SR1-515, User: SBADUSHA, Date: 21.11.2023___*
*___ SR2-3080, User: SCOSAR, Date: 22.04.2026___*


    DATA: lt_materials TYPE /sopromet/ritems_tab,
          l_werks      TYPE werks_d,
          lo_appl      TYPE REF TO /bitmym/cl_mym,
          lo_case      TYPE REF TO /bitmym/cl_case,         "HS 1347
          lo_res       TYPE REF TO /sopromet/cl_l_reservation.
    FIELD-SYMBOLS : <item>   TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
                    <fs_mat> TYPE /sopromet/ritems_wa.
*    IF /bitmym/if_ui5~g_mobile_call = 'X'.                "HS 15080
    l_werks = ui5_get_sales_rep_atpplant( ).
*    ENDIF.                                                  "HS 15080
    LOOP AT ct_items ASSIGNING <item> WHERE mattyp = /bitmym/cl_assortment=>c_type_single.

      READ TABLE lt_materials ASSIGNING <fs_mat> WITH KEY matnr = <item>-matnr.
      IF sy-subrc NE 0.
        APPEND INITIAL LINE TO lt_materials ASSIGNING <fs_mat>.
        MOVE-CORRESPONDING <item> TO <fs_mat>.
        <fs_mat>-atpswerk = l_werks.
      ELSE.
        ADD <item>-menge TO <fs_mat>-menge.
      ENDIF.

    ENDLOOP.
    CREATE OBJECT lo_res EXPORTING i_vkorg = gs_comwa-vkorg i_vtweg = gs_comwa-vtweg i_spart = gs_comwa-spart.
    CHECK lo_res IS BOUND.
    CHECK lt_materials IS NOT INITIAL.                      "HS 15080
    set_property lo_res 'GT_SINGLE_ITEMS' lt_materials.
    CHECK go_appl IS BOUND.
    lo_appl = go_appl.
    set_property lo_appl 'GS_COMWA' gs_comwa.
    set_property lo_appl 'GO_CASE' me.
    set_property lo_res 'GO_APPLICATION' lo_appl.
    set_property lo_res 'G_RESERVATION-KZSIR'  'X'.
    lo_res->check_single_items_atp( i_comwa = gs_comwa io_case = me ).
    REFRESH lt_materials.
    set_property lo_appl 'GO_CASE' lo_case.                 "HS 1347
    get_property lo_res 'GT_SINGLE_ITEMS' lt_materials.

*____SR2-3080____BEGIN INSERT___*

    SELECT DISTINCT t1~material, t1~qablock, t1~\_qablock[ ]-qablocktext
      FROM /bitmym/i_mhdsingleitemcheck( activitytype = '',
                                         bookingtype  = @gs_comwa-rstyp ) AS t1
     INNER JOIN @lt_materials AS t2 ON t2~matnr EQ t1~material
     WHERE t1~salesorg EQ @gs_comwa-vkorg
       AND t1~distributionchannel EQ @gs_comwa-vtweg
       AND t1~division EQ @gs_comwa-spart
       AND t1~plant EQ @gs_comwa-werks
       AND t1~qablock IS NOT INITIAL
      INTO TABLE @DATA(lt_mhdcheck).
*____SR2-3080____END   INSERT___*


    LOOP AT ct_items ASSIGNING <item> WHERE mattyp = /bitmym/cl_assortment=>c_type_single.

      READ TABLE lt_materials ASSIGNING <fs_mat> WITH KEY matnr = <item>-matnr.
      IF sy-subrc EQ 0.
        CHECK <fs_mat>-kbmeng IS NOT INITIAL.
        CHECK NOT line_exists( lt_mhdcheck[ material = <fs_mat>-matnr ] ). "SR2-3080
        <item>-available = abap_true.
        <item>-vmeng = <fs_mat>-kbmeng.
        <item>-werks    = <fs_mat>-werks.       "SR1-515
        <item>-lgort    = <fs_mat>-lgort.       "SR1-515
        <item>-atpswerk = <fs_mat>-atpswerk.    "SR1-515


      ENDIF.


    ENDLOOP.

  ENDMETHOD.


  METHOD get_bookingsearch_query_string.
*____HS# 012765, VON: SSINGH, DATUM: 05.02.2020___*
    DATA: ls_booking TYPE /bitmym/ic_bookingsearch,
          lv_bstnk   TYPE bstkd,
          lv_kunnr   TYPE kunnr,
          lv_opman   TYPE /sopromet/zzopman,
          lv_opkra   TYPE /bitmym/kranke,
          ld_string  TYPE string,
          lv_name1   TYPE name1_gp.
    CHECK go_ui5 IS BOUND.
    go_ui5->ui5_filter2struct( CHANGING cs_struct = ls_booking ).
    CHECK ls_booking-searchtext IS NOT INITIAL.
    TRANSLATE ls_booking-searchtext TO UPPER CASE.
    CONCATENATE '%' ls_booking-searchtext '%' INTO ls_booking-searchtext.

    ld_string = '( BSTNK_MC LIKE ''&1'' OR KUNNR LIKE ''&1'' OR OPMAN_MC LIKE ''&1'' OR OPKRA_MC LIKE ''&1'' OR MCOD1 LIKE ''&1'' OR LRESN LIKE ''&1'' )'.
    REPLACE ALL OCCURRENCES OF '&1' IN ld_string WITH ls_booking-searchtext.
    ed_query = ld_string.

  ENDMETHOD.


  method UI5_GET_SURGERY_TEXT.
*____HS# 015455, VON: SSINGH, DATUM: 15.06.2021___*
    SELECT SINGLE text FROM /bitmym/sutyp_tt INTO ed_text
      WHERE spras = /bitmym/if_ui5~gd_language
        AND sutyp = is_data-sutyp.
  endmethod.


METHOD we_add_assign.

  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.

*___Zuerst alle Daten Sichern
  lt_changes = we_save( id_leave_screen = abap_false ).

*___Zuordnen
  CHECK we_add_assigned( ) EQ abap_true.

*___Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).

ENDMETHOD.


METHOD we_add_assigned.

  CHECK go_act_reservation IS BOUND.

  ed_success = go_act_reservation->we_add_items_assigned( ).

ENDMETHOD.


METHOD we_add_items.

  DATA: lo_add_res TYPE REF TO /sopromet/cl_l_reservation.

  lo_add_res = we_add_reservation_exists( ).

  IF lo_add_res IS BOUND.
    lo_add_res->add_additional_item( ).
  ELSE.
    create_additional_item_reserva( ).
  ENDIF.


ENDMETHOD.


METHOD we_add_items_close.

  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.

*___Zuerst alle Daten Sichern
  lt_changes = we_save( id_leave_screen = abap_false ).

*___Status setzen
  CHECK we_add_items_closed( ) EQ abap_true.

*__Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).

ENDMETHOD.


METHOD we_add_items_closed.

  CHECK go_act_reservation IS BOUND.

  ed_success = go_act_reservation->we_add_items_closed( ).
ENDMETHOD.


METHOD we_add_items_confirmation.

  DATA: ld_answer.

  IF gd_conf_popup_add = abap_true.
    ed_create = abap_false.

*__PopUp zur Bestätigung
    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        text_question = text-add
      IMPORTING
        answer        = ld_answer.

    CHECK ld_answer = '1'.

    ed_create = abap_true.
  ELSE.
*__PopUp überspringen und Reservierung gleich anlegen
    ed_create = abap_true.
  ENDIF.

ENDMETHOD.


method we_add_itm_reserv_add.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*
*____HS# 016752, VON: SISMAIL, DATUM: 27.04.2022___*


  data: lo_add_res type ref to /sopromet/cl_l_reservation,
        lo_source  type ref to /sopromet/cl_l_reservation.

  data: lt_tree   type /sopromet/ty_tree_map_tab,
        lo_tree   type ref to /bitmym/cl_tree_case,
        ld_status type tj30t-txt04.


  field-symbols: <tree> type line of /sopromet/ty_tree_map_tab.

  lo_add_res = /sopromet/cl_l_reservation=>create_pending( id_pending = /sopromet/cl_l_reservation=>c_pend_type_additional
                                                           io_ui5     = go_ui5 ). "HS 12493

  lo_tree ?= go_tree_case.

  get_property lo_tree 'GT_NODE_MAP' lt_tree.

  loop at lt_tree assigning <tree>
          where objkey is bound
*            AND kzper  IS INITIAL. "HS# 016752-
          and ( kzper  is initial or kzper = /sopromet/cl_l_reservation=>c_pend_type_cyclecount ). "HS# 016752+

    ld_status = <tree>-objkey->get_user_status( ).

    if <tree>-kzper = /sopromet/cl_l_reservation=>c_pend_type_cyclecount. "HS# 016752+
      check ld_status = /sopromet/cl_l_reservation=>c_res_status_zurueck or "HS# 016752+
      ld_status = /sopromet/cl_l_reservation=>c_res_status_cleaned or ld_status = /sopromet/cl_l_reservation=>c_res_status_geprueft.  "HS# 016752+
    else. "HS# 016752+
      check ld_status = /sopromet/cl_l_reservation=>c_res_status_zurueck or
            ld_status = /sopromet/cl_l_reservation=>c_res_status_cleaned.
    endif.  "HS# 016752+
    lo_source = <tree>-objkey.
    exit.

  endloop.

*___Reservierung anlegen -> Redefinition
  lo_add_res->create_pending_int( io_source_reservation = lo_source ).

  eo_add_res = lo_add_res.                                  "HS 12493

endmethod.


METHOD we_add_reservation_exists.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*

  DATA: lt_tree TYPE /sopromet/ty_tree_map_tab,
        lo_tree TYPE REF TO /bitmym/cl_tree_case,
        ld_answer.

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

  lo_tree ?= go_tree_case.

  get_property lo_tree 'GT_NODE_MAP' lt_tree.

  gd_conf_popup_add = abap_true.

  LOOP AT lt_tree ASSIGNING <tree>
          WHERE objkey IS BOUND
            AND kzper  EQ /sopromet/cl_l_reservation=>c_pend_type_additional.

    IF <tree>-objkey->get_user_status( ) NE /sopromet/cl_l_reservation=>c_res_status_geprueft.
      eo_add_res = <tree>-objkey.  "Additional item Reservierung
      EXIT.
    ENDIF.
  ENDLOOP.

  IF eo_add_res IS BOUND AND
     go_ui5     IS NOT BOUND.                                      "HS 12493

    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        titlebar              = text-add
        text_question         = text-ad1
        text_button_1         = text-ad2
        icon_button_1         = 'ICON_CREATE'
        text_button_2         = text-ad3
        ICON_BUTTON_2         = 'ICON_REJECT'
        default_button        = '2'
        display_cancel_button = 'X'
        start_column          = 25
        start_row             = 6
*       POPUP_TYPE            =
*       IV_QUICKINFO_BUTTON_1 = ' '
*       IV_QUICKINFO_BUTTON_2 = ' '
      IMPORTING
        answer                = ld_answer
      EXCEPTIONS
        text_not_found        = 1
        OTHERS                = 2.

    CHECK ld_answer EQ '1'.  "Neu anlegen
    CLEAR eo_add_res.

    gd_conf_popup_add = abap_false.

  ENDIF.
ENDMETHOD.


METHOD we_check.
  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.

*___Zuerst alle Daten Sichern
  lt_changes = we_save( id_leave_screen   = abap_false
                        id_complete_check = abap_true ).

*___Status setzen
  CHECK we_set_checked( ) EQ abap_true.

*___Prüfen ob aktuelle Reservierung ob CHANGE-Tabelle ist
  READ TABLE lt_changes TRANSPORTING NO FIELDS
       WITH KEY objkey = go_act_reservation.

  IF sy-subrc NE 0.
    lt_changes = get_we_reservations_changed( go_act_reservation ).
  ENDIF.

*__Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).

ENHANCEMENT-POINT WE_CHECK SPOTS /BITMYM/CL_CASE .

ENDMETHOD.


  METHOD ui5_s4h_bookings_get_list_int.
*____HS# 015080, VON: OPECHARROMAN, DATUM: 10.12.2021___*
    DATA: lt_table TYPE /bitmym/s4h_booking_tab.

    /bitmym/if_ui5~gv_filter_string = /bitmym/if_ui5~go_tech_request_context->/iwbep/if_mgw_req_entityset~get_osql_where_clause_convert( ).

    ui5_s4h_booking_list_select( CHANGING ct_table = lt_table ).

    et_entityset[] = lt_table[].
  ENDMETHOD.


METHOD we_clean.
*____HS# 016500, VON: GIVANOV, DATUM: 09.02.2022___*


  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.
  DATA: lo_panel TYPE REF TO /bitmym/cl_panel.              "HS# 016798

*___Zuerst alle Daten Sichern
  lt_changes = we_save( id_leave_screen = abap_false ).

*___Status setzen
  CHECK we_set_cleaned( ) EQ abap_true.

*____HS# 016500
ENHANCEMENT-POINT WE_CLEAN SPOTS /BITMYM/CL_CASE .

*__Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).


ENDMETHOD.


method WE_MALL.
  check go_act_reservation is bound.
  go_act_reservation->we_mall( ).
endmethod.


  METHOD we_reset_after_save.
*____HS# 013188, VON: RBOYAPATI,    DATUM: 22.05.2019___*

    DATA: lt_tree TYPE /sopromet/ty_tree_map_tab,
          lo_tree TYPE REF TO /bitmym/cl_tree_case.

    FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

    CHECK go_tree_case IS BOUND.

    lo_tree ?= go_tree_case.

    get_property lo_tree 'GT_NODE_MAP' lt_tree.

    LOOP AT lt_tree ASSIGNING <tree> WHERE objkey IS BOUND.

      " Indicator to skip current reservation
      IF i_skip_act_res IS NOT INITIAL.
        CHECK go_act_reservation NE <tree>-objkey.
      ENDIF.

      <tree>-objkey->we_reset_after_save( ).

    ENDLOOP.

  ENDMETHOD.


METHOD we_refresh_after_save.
  DATA: lo_tree TYPE REF TO /bitmym/cl_tree_case.

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

*___ALV-Neu aufbauen
  LOOP AT it_changes ASSIGNING <tree>.
    <tree>-objkey->we_refresh_after_save( ).
  ENDLOOP.

*___Neue Icons setzen
  IF go_tree_case IS BOUND.
    lo_tree ?= go_tree_case.
    lo_tree->set_new_icons( ).
  ENDIF.

ENDMETHOD.


METHOD we_refresh_locks_after_save.
*____HS# 12321, VON: Opecharroman,  DATUM: 06.02.2018 ___*

* Method to be run after method we_save.
* It cleans the g_queue variable for each reservation saved and locks the current reservation that is still in change mode
* The reason to run this method is because after the commit work the queue is automatically dequeued by the system.
  DATA: lt_tree TYPE /sopromet/ty_tree_map_tab,
        lo_tree TYPE REF TO /bitmym/cl_tree_case.

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

* No need to run this method when id_leave_screeen = abap_true.
  CHECK id_leave_screen = abap_false.

  lo_tree ?= go_tree_case.

  get_property lo_tree 'GT_NODE_MAP' lt_tree.

  LOOP AT lt_tree ASSIGNING <tree>.

    IF <tree>-objkey NE go_act_reservation.
*     Init queue flag
      <tree>-objkey->init_g_enqueue(  ).
    ELSE.
*     lock current reservation
      <tree>-objkey->enqueue( ).
    ENDIF.
  ENDLOOP.
ENDMETHOD.


METHOD we_refresh_tree_case.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*

  DATA: lo_tree  TYPE REF TO /bitmym/cl_tree_case,
        ld_first TYPE tv_nodekey,
        ld_map   TYPE /sopromet/ty_tree_map.

  CHECK append_reservations( ) EQ abap_true.
*___Es wurden neue (Missing/Pending) Reservierungen hinzugefügt
*___Tree für CASE muss neu aufgebaut werden

  lo_tree ?= go_tree_case.
  lo_tree->create_tree_x( ).

  CHECK go_ui5 IS NOT BOUND.                                "HS 12493

  go_tree_case->add_nodes( ).
  go_tree_case->expand_root_nodes( ).

  ld_first = lo_tree->get_node_of_reservation( go_act_reservation ).
  CHECK ld_first IS NOT INITIAL.
  go_tree_case->set_selected_node( ld_first ).


ENDMETHOD.


METHOD set_mig_dates_user_exit.
*____HS# 013194, VON: OPECHARROMAN, DATUM: 28.05.2019___*

  FIELD-SYMBOLS <fds_res_st> TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_reservation.

* If dates are provided in the file, overwrite calculation
  IF is_case-vdate IS NOT INITIAL.
    cs_comwa-vdate = is_case-vdate.
  ENDIF.

  IF is_case-rdate IS NOT INITIAL.
    cs_comwa-rdate = is_case-rdate.
  ENDIF.

  IF is_case-vedat IS NOT INITIAL.
    cs_comwa-vedat = is_case-vedat.
  ENDIF.

  IF is_case-abdat IS NOT INITIAL.
    cs_comwa-abdat = is_case-abdat.
  ENDIF.

  IF is_case-frdat IS NOT INITIAL.
    cs_comwa-frdat = is_case-frdat.
  ENDIF.

* Read operation time. Initially all dates should have the same date
  READ TABLE is_data-casetoreservation ASSIGNING <fds_res_st> INDEX 1.
  IF sy-subrc EQ 0 AND
    <fds_res_st>-optim IS NOT INITIAL.
    cs_comwa-optim = <fds_res_st>-optim.
  ENDIF.

ENHANCEMENT-POINT set_mig_dates_user_exit_01 SPOTS /bitmym/case .

ENDMETHOD.


  method MODIFY_SURG_COMB_RUN.

    data : ls_kna1 type kna1,
           ls_vbpav type vbpav,
           lv_count type i.

    CHECK gs_actual_area-parvwsurg IS NOT INITIAL.

    call method go_partner->read_customer_address
      exporting
        id_kunnr  = gd_surg_comb_run
        i_no_addr = ''
      importing
        es_kna1   = ls_kna1.

     DELETE ct_vbpa WHERE parvw = gs_actual_area-parvwsurg.
     DESCRIBE TABLE ct_vbpa LINES lv_count.
     lv_count = lv_count + 1.

     CLEAR ls_vbpav.
     ls_vbpav-mandt = sy-mandt.
     ls_vbpav-kunnr = gd_surg_comb_run.
     ls_vbpav-parvw = gs_actual_area-parvwsurg.
     ls_vbpav-adrnr = ls_kna1-adrnr.
     INSERT ls_vbpav INTO ct_vbpa INDEX lv_count.

  endmethod.


METHOD we_save.
* HS#9836 DEQUEUE bei verlassen des Retouren-Dynpros J.Lopez
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 12321, VON: Opecharroman,  DATUM:  06.02.2018 ___*
*____HS# 12493, VON: RBOYAPATI,     DATUM:  24.05.2018 ___*
*____HS# 013188, VON: RBOYAPATI,    DATUM: 22.05.2019___*
*____HS# 014293, VON: GIVANOV, DATUM: 10.07.2020___*
*____HS# 016475, VON: SISMAIL, DATUM: 18.03.2022___*
*____HS# 016751, VON: SISMAIL, DATUM: 18.03.2022___*
*___ SR2-84, User: OOGUR, Date: 05.04.2024___*


  DATA: lt_tree          TYPE /sopromet/ty_tree_map_tab,
        ld_posting_error TYPE c,
        ls_input         TYPE /bitmym/order_process_input.   "SR2-84


  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

*___Was wurde geändert
  et_changes = lt_tree = get_we_reservations_changed( ).

*&"HS# 016475 Enhancement Point Below
enhancement-point wa_save_00 spots /bitmym/cl_case .

*check the consistency of the lines
* The check has to run only for the changed reservations. Moved call to method here and add parameter
  CHECK we_check_on_save( EXPORTING it_tree = lt_tree ) EQ abap_true. "HS# 014293

  LOOP AT lt_tree ASSIGNING <tree>.

    IF id_complete_check EQ abap_true.
      CHECK <tree>-objkey NE go_act_reservation.
    ENDIF.


    CALL METHOD <tree>-objkey->return_items_post
      EXPORTING
        i_debit_note       = space
        i_no_reset         = abap_true        "HS 13188
      IMPORTING
        e_mm_posting_error = ld_posting_error.



*____SR2-84____BEGIN INSERT___*
*    order_process_fill_consumption( is_tree = <tree> ).
*    CLEAR ls_input.
*    ls_input-process     = /bitmym/cl_order_process=>c_reservation.
*    ls_input-reservation = <tree>-lresrv.
*    ls_input-order_event = '_SAVE'.
*    DATA(lo_order)       = /bitmym/cl_order_process=>create( ls_input ).
*
*    IF lo_order->gs_global-invoice_v2 = space OR lo_order->gs_global-invoice_v2 = 2.
*
*      CALL METHOD <tree>-objkey->return_items_post
*        EXPORTING
*          i_debit_note       = space
*          i_no_reset         = abap_true        "HS 13188
*        IMPORTING
*          e_mm_posting_error = ld_posting_error.
*
*      lo_order->set_property( EXPORTING i_feld = 'GT_CONSUMPTION' i_value = gt_consumption ).
*      lo_order->start_inspection_process( ).
*
*    ENDIF.
*____SR2-84____END   INSERT___*

    CHECK ld_posting_error IS NOT INITIAL.
    EXIT.
  ENDLOOP.

  CHECK ld_posting_error IS INITIAL.

  IF id_nocommit EQ abap_false. "HS# 016751+
    COMMIT WORK AND WAIT.
  ENDIF.                        "HS# 016751+
*-- Clear data change indicator / differences after all postings are successful
  we_reset_after_save( id_complete_check ).                 "HS  13188

* Refresh the lock variable value and the lock after save in case we don't leave the screen.
* HS 13188 - No longer needed as locking scope was changed to '1'
*  we_refresh_locks_after_save( id_leave_screen ).            "HS# 12321  "HS 13188

*  MESSAGE s085(/sopromet/zl)  INTO gd_dummy_message.        "HS# 11637  "HS 12493
*  call_message.                                             "HS# 11637  "HS 12493
  /bitmym/cl_message=>message( id = 'S085(/SOPROMET/ZL)' ). "HS 12493


  CHECK id_leave_screen = abap_true.
*  Begin HS#9836
  CALL FUNCTION 'DEQUEUE_ALL'.
*  End HS#9836

  CHECK go_ui5 IS INITIAL.                                  "HS 12493

  SET SCREEN 0. LEAVE SCREEN.

ENDMETHOD.


METHOD we_scanner_on_off.
  TRANSLATE gs_comwa-scanx USING ' XX '.
ENDMETHOD.


METHOD we_scrapping.
*____HS# 10089, VON: T.Kern, DATUM: 28.08.2014 ___*
*____HS# 11266, VON: KannanU, DATUM: 04.07.2015 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 014112, VON: SSINGH, DATUM: 06.07.2020___*
*___ SR2-2243, User: XLI, Date: 27.10.2025___*


  DATA: lt_tree TYPE /sopromet/ty_tree_map_tab,
        l_check TYPE abap_bool.
  DATA: lt_res_items     TYPE /sopromet/res_items,          "HS# 11266
        ld_posting_error TYPE char1.                        "HS# 11266

  FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

  lt_tree = get_we_reservations_changed( ).

  LOOP AT lt_tree ASSIGNING <tree>.

*> Derzeit Verarbeitung scrapping nur in der aktuellen Reservierung
    IF <tree>-objkey EQ go_act_reservation.

      CLEAR lt_res_items.                                   "HS# 11266
      CALL METHOD <tree>-objkey->get_reservation_data                 "HS# 11266
        IMPORTING
          e_reservation_items_ret = lt_res_items.
*____SR2-2243____BEGIN INSERT___*
      LOOP AT lt_res_items ASSIGNING FIELD-SYMBOL(<item>) WHERE menge_re IS NOT INITIAL.
        <item>-menge_we = <item>-menge_we + <item>-menge_re.
        <item>-menge_re = 0.
        <item>-mandt = sy-mandt.
      ENDLOOP.
*____SR2-2243____END   INSERT___*

      CALL FUNCTION '/SOPROMET/SINGLE_ITM_UPDATE_VB' IN UPDATE TASK "HS# 11266
        TABLES
          xitems = lt_res_items.

      l_check = <tree>-objkey->we_scrapping( ).

      IF l_check NE abap_true.

        EXIT.

      ENDIF.

    ENDIF.

  ENDLOOP.


  CHECK l_check EQ abap_true.

  COMMIT WORK AND WAIT.

  MESSAGE s085(/sopromet/zl) INTO gd_dummy_message.         "HS# 11637
  call_message.                                             "HS# 11637

  CALL FUNCTION 'DEQUEUE_ALL'.
  CHECK go_ui5 IS NOT BOUND.                                "HS# 14112

  SET SCREEN 0. LEAVE SCREEN.
                                                        "#EC STMNT_EXIT
ENHANCEMENT-POINT we_scrapping SPOTS /bitmym/cl_case .

ENDMETHOD.


METHOD we_set_checked.
*____HS# 12481, VON: S.Taori,   DATUM: 26.04.2018 ___*
*____HS# 12493, VON: RBOYAPATI, DATUM: 24.05.2018 ___*
*___ SR1-1418, User: EFLORENTINO, Date: 18.07.2023___*

  CHECK go_act_reservation IS BOUND.

*___Updates buchen / Pending erzeugen usw.
  ed_success = go_act_reservation->we_set_checked( id_silent = id_silent ). "SR1-1418
*  ed_success = go_act_reservation->we_set_checked( ).                      "SR1-1418
  check ed_success = abap_true.

*__If current reservation is the last one being checked and is complete and all other
*  reservations of the case are complete, then we set the flag 'UNUSED' in case table
  check_if_case_is_unused( ).                               "HS 12481

*___ Skip for UI5
  CHECK go_ui5 IS NOT BOUND.                              "HS 12493

*___Case Tree muss neu aufgebaut werden
  we_refresh_tree_case( ).

ENDMETHOD.


METHOD we_set_checked_trunk.
*____HS# 12029, VON: T.Kern, DATUM: 23.08.2017 ___*
*____HS# 12481, VON: S.Taori, DATUM: 26.04.2018 ___*

  CHECK go_act_reservation IS BOUND.

*___Updates buchen / Pending erzeugen usw.
  ed_success = go_act_reservation->we_set_checked_trunk( ).
  CHECK ed_success = abap_true.

*__If current reservation is the last one being checked and is complete and all other
*  reservations of the case are complete, then we set the flag 'UNUSED' in case table
  check_if_case_is_unused( ).                               "HS 12481

*___Case Tree muss neu aufgebaut werden
  we_refresh_tree_case( ).

ENDMETHOD.


METHOD we_set_cleaned.
  CHECK go_act_reservation IS BOUND.

  ed_success = go_act_reservation->we_set_cleaned( ).
ENDMETHOD.


METHOD WE_TRUNK.
*____HS# 12029, VON: T.Kern, DATUM: 23.08.2017 ___*

  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.

*___Zuerst alle Daten Sichern
  lt_changes = we_save( id_leave_screen   = abap_false
                        id_complete_check = abap_true ).

*___Status setzen
  CHECK we_set_checked_trunk( ) EQ abap_true.

*___Prüfen ob aktuelle Reservierung ob CHANGE-Tabelle ist
  READ TABLE lt_changes TRANSPORTING NO FIELDS
       WITH KEY objkey = go_act_reservation.

  IF sy-subrc NE 0.
    lt_changes = get_we_reservations_changed( go_act_reservation ).
  ENDIF.

*__Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).

*ENHANCEMENT-POINT WE_CHECK SPOTS /BITMYM/CL_CASE .

ENDMETHOD.


METHOD we_unused.
*____HS# 12481, VON: S.Taori,    DATUM: 26.04.2018 ___*
*____HS# 12493, VON: R.Boyapati, DATUM: 21.06.2018 ___*
*____HS# 016312, VON: GIVANOV, DATUM: 20.12.2021___*

  DATA: lt_changes TYPE /sopromet/ty_tree_map_tab.

  CHECK go_act_reservation IS BOUND.

*__Änderungstabelle aufbauen für REFRESH
  lt_changes = get_we_reservations_changed( go_act_reservation ).

*  CHECK go_act_reservation->we_unused( ) EQ abap_true.      "HS# 016313 DEL
  CHECK go_act_reservation->we_unused( iv_user_confirmation = iv_user_confirmation ) EQ abap_true.        "HS# 016312 INS

  e_success = abap_true.                                    "HS 12493

*__If current reservation is the last one being checked and is complete and all other
*  reservations of the case are complete, then we set the flag 'UNUSED' in case table
  check_if_case_is_unused( ).                               "HS 12481

  CHECK go_ui5 IS NOT BOUND.                                "HS 12493

*> HS#7905
*__Refresh nach Sichern (ALV + TREE)
  we_refresh_after_save( lt_changes ).

*___Case Tree muss neu aufgebaut werden
  we_refresh_tree_case( ).
*> HS#7905 Ende
ENDMETHOD.


  METHOD ui5_s4h_cancel_booking_int.
*____HS# 015080, VON: MTOMITA, DATUM: 23.08.2021___*
*___ SR2-721, User: SCOSAR, Date: 19.09.2024___*
*___ SR2-1435, User: SCOSAR, Date: 24.01.2025___*

    DATA: ls_data_ui5        TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
          lo_data_provider   TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_reservation_old TYPE /sopromet/zzlrv,
          ls_res_ui5         TYPE /sopromet/zzlrv,
          ls_reservation     TYPE /sopromet/zzlrv,
          l_stsma            TYPE tj30-stsma.

    lo_data_provider = io_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    MOVE-CORRESPONDING ls_data_ui5 TO ls_res_ui5.

    LOOP AT gt_reservations ASSIGNING FIELD-SYMBOL(<res>).
      <res>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

      IF NOT ls_reservation IS INITIAL.
        l_stsma = <res>-objkey->get_status_schema( i_rscat = ls_reservation-rscat ).

        CALL FUNCTION '/SOPROMET/SET_STATUS_EXTERN' IN UPDATE TASK
          EXPORTING
            i_objnr = ls_reservation-objnr
            i_txt04 = /sopromet/cl_l_reservation=>c_book_status_abgesagt
            i_stsma = l_stsma
          EXCEPTIONS
            OTHERS  = 1.

        ls_reservation_old = ls_reservation.
        ls_reservation-abgru = ls_res_ui5-abgru.

        CALL FUNCTION '/SOPROMET/POST_ZZLRV' IN UPDATE TASK
          EXPORTING
            n_zzlrv = ls_reservation
            y_zzlrv = ls_reservation_old
          EXCEPTIONS
            OTHERS  = 1.
*____SR2-721____BEGIN INSERT___*
        <res>-objkey->set_data( EXPORTING is_data = VALUE #( g_user_status = /sopromet/cl_l_reservation=>c_book_status_abgesagt
                                                             g_reservation-abgru = ls_res_ui5-abgru )
                                          it_fields = VALUE #( ( fieldname = 'G_USER_STATUS' )
                                                               ( fieldname = 'G_RESERVATION-ABGRU' ) ) ).
        CHECK /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true.
*____SR2-721____END   INSERT___*

*____SR2-1435____BEGIN INSERT___*
        DATA(lt_bookings) = CORRESPONDING /bitmym/b_items_tab( <res>-objkey->get_prop_booking_items(  ) ).
        CALL FUNCTION '/BITMYM/BITEMS_POST' IN UPDATE TASK
          EXPORTING
            id_zzlresn    = ls_reservation-zzlresn
          TABLES
            it_bitems_mod = lt_bookings.
*____SR2-1435____END   INSERT___*

        COMMIT WORK.
      ENDIF.

      CLEAR: ls_reservation, l_stsma, ls_reservation_old.
    ENDLOOP.

    io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    IF ls_data_ui5 IS NOT INITIAL.
      ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).
    ENDIF.

  ENDMETHOD.


  METHOD ui5_s4h_release_booking.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*

    DATA: lo_case     TYPE REF TO /bitmym/cl_case,
          lv_released TYPE abap_bool.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_reservation = i_zzlresn io_ui5 = io_ui5 ).

*___Start processing
    IF lo_case IS NOT INITIAL.
      lo_case->ui5_s4h_release_booking_int( EXPORTING io_data_provider = io_data_provider
                                                      gc_case          = lo_case
                                             CHANGING es_data          = es_data ).
    ENDIF.

  ENDMETHOD.


  method UI5_S4H_RELEASE_BOOKING_INT.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*

    DATA: lv_released TYPE abap_bool,
          ls_data_ui5 TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
          ls_tree_map TYPE /sopromet/ty_tree_map,
          ls_zzlrv    TYPE /sopromet/zzlrv.

*   Set the partner
    LOOP AT gt_reservations INTO ls_tree_map.
      ls_tree_map-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_zzlrv ).
      gs_comwa-kunnr = ls_zzlrv-kunnr.
      ls_tree_map-objkey->release_reservation( ).
    ENDLOOP.

    messaging( ).
    message_update( ).
    lv_released = abap_true.
    COMMIT WORK AND WAIT.

*   Initialize the tree
*    go_appl->set_property( EXPORTING i_feld  = 'GO_CASE' i_value = ME ).
*    go_tree_case = /bitmym/cl_tree=>create( id_tree        = /bitmym/cl_tree=>c_tree_case
*                                            io_application = go_appl ).
*    go_tree_case->set_property( EXPORTING i_feld  = 'GT_NODE_MAP' i_value = gt_reservations ).
*    go_tree_case->create_tree( id_dark = abap_true ).

*    lv_released = gc_case->release_reservation( ).
    IF lv_released EQ abap_true.
      io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
      IF ls_data_ui5 IS NOT INITIAL.
        ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).
      ENDIF.
    ENDIF.

  endmethod.


METHOD ui5_s4h_update_booking.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*

  DATA: lo_case          TYPE REF TO /bitmym/cl_case.

  SELECT SINGLE zzlrsam
    FROM /sopromet/zzlrv
    WHERE zzlresn = @i_zzlresn
    INTO @DATA(lv_zzlrsam).
  CHECK sy-subrc = 0.

*___Create CASE Object
  lo_case = /bitmym/cl_case=>create( id_case = lv_zzlrsam id_reservation = i_zzlresn io_ui5 = io_ui5 ).

*___Start processing
  lo_case->ui5_s4h_update_booking_int( EXPORTING io_data_provider = io_data_provider IMPORTING es_data = es_data ).

ENDMETHOD.


METHOD ui5_s4h_update_booking_int.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*
*____HS# 015080, VON: OPECHARROMAN, DATUM: 14.09.2021___*
*____HS# 017086, VON: SSINGH, DATUM: 27.09.2022___*
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*
*___ SR2-723, User: SCOSAR, Date: 21.08.2024___*
*___ SR2-803, User: STEKDEMIR, Date: 03.09.2024___*
*___ SR2-721, User: SCOSAR, Date: 17.09.2024___*
*___ SR2-935, User: PKSHIRSAGAR, Date: 04.10.2024___*
*___ SR2-1082, User: PKSHIRSAGAR, Date: 11.11.2024___*
*___ SR2-1656, User: RJANGA, Date: 01.04.2025___*


  DATA: ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
        ls_data_mobile   TYPE /bitmym/s_update_booking, "SR2-803
        lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
        ld_check         TYPE abap_bool,
        ls_res           TYPE /sopromet/zzlrv,              "HS 17086
        ls_copy_fields   TYPE /bitmym/ic_book_create_fields,
        ls_date          TYPE /bitmym/s4h_convert_dates_st. "_ SR2-935,

*___Step 1: Get ODATA Context from data provider object
  get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.

  CHECK lo_data_provider IS BOUND.

  lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

*___Step 2: Fill CASE COMWA + APPL COMWA
*   begin of changes HS 17086
  IF /bitmym/if_ui5~g_mobile_call = abap_true.
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_data_ui5-zzlresn
        i_no_buff     = 'X'
      IMPORTING
        e_reservation = ls_res.
    CHECK enqueue( ) = abap_true.
    MOVE-CORRESPONDING  ls_res TO gs_comwa.

    MOVE-CORRESPONDING ls_data_ui5 TO ls_date.    "SR2-935 copy dates
    MOVE-CORRESPONDING ls_date TO gs_comwa.       "SR2-935 copy dates

    MOVE-CORRESPONDING ls_data_ui5 TO ls_copy_fields.  "SR2-935
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.   "SR2-935

*____SR2-1656____BEGIN INSERT___*
    "Restore your reference value from case
    /bitmym/cl_selection=>move_source_target_field_value( EXPORTING is_source           = gs_case
                                                                    iv_only_with_values = abap_true
                                                                    it_fields           = VALUE ttfieldname(
                                                                                                ( 'IHREZ'    )        " Your reference
                                                                                                ( 'BSARK'    )        " Purchase Order Type
                                                                                                ( 'ESTVALUE' ) )      " Estimated Value
                                                          CHANGING  cs_target           = gs_comwa ).
*____SR2-1656____END   INSERT___*

  ELSE.
    gd_simulate = ls_data_ui5-simulation.
    MOVE-CORRESPONDING ls_data_ui5 TO ls_copy_fields.
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.
  ENDIF.

*   end of changes HS 17086

  gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_b.
  gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.


  set_property go_appl 'GO_CASE' me.
  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 2.1: Consolidate items  "SR2-723
  "this is required especially for mobile  "SR2-723
  consolidate_bitems( CHANGING c_items_tab = ls_data_ui5-bookingtobookingitem ). "SR2-723


*___Step 3: Partner determination
  CHECK ui5_prep_booking_partner( id_no_add_srep = abap_true ) EQ abap_true.

*___Step 4: Create tree
  ui5_prep_reservation_tree( ).

*   Step 5: Pass odata info into reservation table list and  add booking items
  IF /bitmym/if_ui5~g_mobile_call = abap_true.              "HS 17086
*____SR2-803____BEGIN INSERT___*
    MOVE-CORRESPONDING gs_comwa TO ls_data_mobile.
    ls_data_mobile-bookingtobookingitem = ls_data_ui5-bookingtobookingitem.
    ls_data_mobile-bookingtonotes       = ls_data_ui5-bookingtonotes.
    ls_data_mobile-bookingtopartner     = ls_data_ui5-bookingtopartner.
    ls_data_mobile-bookingtoassortment  = ls_data_ui5-bookingtoassortment.
    ui5_prep_book_info_to_gt_res( CHANGING cs_data = ls_data_mobile ).
*____SR2-803____END   INSERT___*

*    ui5_prep_book_info_to_gt_res( CHANGING cs_data = gs_comwa ). "HS 17086 "SR2-803 Commented
  ELSE.                                                     "HS 17086
    ui5_prep_book_info_to_gt_res( CHANGING cs_data = ls_data_ui5 ). "HS 17086
  ENDIF.                                                    "HS 17086

*___Step 6: Prepare Text
  ui5_prep_booking_notes( it_notes = ls_data_ui5-bookingtonotes ).

*___Step 7- Fill contract details for booking
  rental_get_contract_book( ).


  gs_case = CORRESPONDING #( BASE ( gs_case ) gs_comwa ).   "SR2-1082

*___Step 7.9:- sync. reservations "SR2-721
  CHECK /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true. "SR2-721

*___Step 8: Post Booking (Simulation considered)
  CHECK ui5_post_booking( ) EQ abap_true.

  ui5_get_shipping_condition_txt( CHANGING cs_data_deep = ls_data_ui5 ). "SR1-2098

*___Step 0: Fill Return Data
  ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).

ENDMETHOD.


  METHOD ui5_s4h_cancel_booking.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*

    DATA: lo_case     TYPE REF TO /bitmym/cl_case,
          lv_released TYPE abap_bool.

    SELECT SINGLE zzlrsam
      FROM /sopromet/zzlrv
      WHERE zzlresn = @i_zzlresn
      INTO @DATA(lv_zzlrsam).
    CHECK sy-subrc = 0.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = lv_zzlrsam id_reservation = i_zzlresn io_ui5 = io_ui5 ).

*___Start processing
    IF lo_case IS NOT INITIAL.
      lo_case->ui5_s4h_cancel_booking_int( EXPORTING io_data_provider = io_data_provider
                                            CHANGING eo_case          = lo_case
                                                     es_data          = es_data ).
    ENDIF.

  ENDMETHOD.


  method CHECK_SINGLE_ITEMS_ATP_BOOKING.
*____HS# 015031, VON: SSINGH, DATUM: 08.03.2021___*
*____HS# 016287, VON: SBADUSHA, DATUM: 24.05.2022___*
*___ SR1-880, User: SBADUSHA, Date: 29.05.2023___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*
*___ SR1-848, User: SBADUSHA, Date: 06.07.2023___*

    DATA: lt_materials TYPE /sopromet/ritems_tab,
          l_o_mat      TYPE REF TO /sopromet/cl_l_material,
          l_kzsir      TYPE char1,
          lo_appl      TYPE REF TO /bitmym/cl_mym,
          lo_psd       TYPE REF TO /bitmym/cl_psd.
    FIELD-SYMBOLS : <item>   TYPE /bitmym/b_items_st,
                    <fs_mat> TYPE /sopromet/ritems_wa.

* SR1-545
ENHANCEMENT-POINT BOOKING_ITEM SPOTS /BITMYM/CASE .

*&* Begin of HS 16287
*    LOOP AT ct_items ASSIGNING FIELD-SYMBOL(<item_werks>) WHERE werks IS INITIAL..
*      l_o_mat = /sopromet/cl_l_material=>get_ref( <item_werks>-matnr ).
*      set_property l_o_mat 'GO_AREA' go_salesarea.
*      CHECK l_o_mat->check_set_material( ) EQ abap_true.
*      IF <item_werks>-werks IS INITIAL.
*        <item_werks>-werks = go_act_reservation->booking_plant_determination( ).
*      ENDIF.
*    ENDLOOP.
*&* End of HS 16287

    LOOP AT ct_items ASSIGNING <item> .
      l_o_mat = /sopromet/cl_l_material=>get_ref( <item>-matnr ).
      set_property l_o_mat 'GO_AREA' go_salesarea.
      CHECK l_o_mat->check_set_material( ) EQ abap_false.
      CHECK <item>-icon_avail IS INITIAL.
      READ TABLE lt_materials ASSIGNING <fs_mat> WITH KEY matnr = <item>-matnr.
      IF sy-subrc NE 0.
        APPEND INITIAL LINE TO lt_materials ASSIGNING <fs_mat>.
        MOVE-CORRESPONDING <item> TO <fs_mat>.
      ELSE.
        ADD <item>-menge TO <fs_mat>-menge.
      ENDIF.

    ENDLOOP.
    CHECK lt_materials IS NOT INITIAL.
    CHECK go_act_reservation IS BOUND.
    set_property go_act_reservation 'GT_SINGLE_ITEMS' lt_materials.
    get_property go_act_reservation 'G_RESERVATION-KZSIR'  l_kzsir.
    set_property go_act_reservation 'G_RESERVATION-KZSIR'  'X'.
    get_property go_act_reservation 'G_REF_PSD' lo_psd.
    get_property go_act_reservation 'GO_APPLICATION' lo_appl.
    IF lo_appl IS NOT BOUND.
      lo_appl = go_appl.
      set_property go_act_reservation 'GO_APPLICATION' lo_appl.
    ENDIF.
    IF lo_psd IS BOUND.
      set_property lo_psd 'G_VGART' /sopromet/cl_l_reservation=>c_vgart_wa.
    ENDIF.
    single_items_atp( gs_comwa ).
    CLEAR lt_materials.
    get_property go_act_reservation 'GT_SINGLE_ITEMS' lt_materials.
    set_property go_act_reservation 'G_RESERVATION-KZSIR' l_kzsir.
    LOOP AT ct_items ASSIGNING <item>.
      READ TABLE lt_materials ASSIGNING <fs_mat> WITH KEY matnr = <item>-matnr.
      IF sy-subrc EQ 0.
        IF <fs_mat>-kbmeng IS NOT INITIAL.
          <item>-icon_avail = convert_atp_icon( '3' ).
          <item>-kbmeng = <fs_mat>-kbmeng.   "SR1-848+
        ELSE.
*          <item>-icon_avail = convert_atp_icon( '0' ). "SR1-880-
           <item>-icon_avail = convert_atp_icon( '1' ). "SR1-880+
           CLEAR <item>-kbmeng.             "SR1-848+
        ENDIF.

        <item>-werks    = <fs_mat>-werks.       ""HS# 016287
        <item>-lgort    = <fs_mat>-lgort.       ""HS# 016287
        <item>-atpswerk = <fs_mat>-atpswerk.    ""HS# 016287
      ENDIF.
    ENDLOOP.
  endmethod.


  METHOD ui5_get_followup_fields.
*____HS# 015186, VON:  SSINGH,     DATUM:13.04.2021___*

    CHECK cs_data-ref_book IS INITIAL.
*     check if the booking is in status delivered or invoiced
    CHECK  cs_data-txt04 = /sopromet/cl_l_reservation=>c_book_status_mat_d OR
           cs_data-txt04 = /sopromet/cl_l_reservation=>c_book_status_inv_created.

    cs_data-followupallow = abap_true.
    cs_data-maxodate  = cs_data-vedat.

  ENDMETHOD.


  method UI5_UPDATE_FOLLOWUP_BOOKING.
*____HS# 015186, VON: SSINGH, DATUM: 13.04.2021___*
*____HS# 015336, VON: OPECHARROMAN, DATUM: 17.05.2021___*

    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          lo_res           TYPE REF TO /sopromet/cl_l_reservation,
          lt_link_to_res   TYPE /bitmym/zzlrsen_tab,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.

*___Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
*   check that its the followup reservation
    CHECK ls_data_ui5-xfollowup EQ abap_true.
    CHECK ls_data_ui5-ref_book IS NOT INITIAL.

* Start of HS# 015336
    CREATE OBJECT lo_res
      EXPORTING
        i_zzlresn = gs_comwa-zzlresn.

*   Set status to material delivered
    lo_res->update_status_ref_book( EXPORTING i_res = ls_data_ui5-ref_book id_update = abap_true ).
* end of HS# 015336

**   get related reservations
*    ui5_get_reserv_from_booking( EXPORTING i_ref_book = ls_data_ui5-ref_book IMPORTING et_zzlresn = lt_link_to_res ). "HS 15186
*
*    CHECK gs_comwa-zzlresn IS NOT INITIAL.
*    CHECK lt_link_to_res IS NOT INITIAL.
**   update the link to reservation
*    ui5_link_book_to_res_followup( it_link = lt_link_to_res ).
*
**   update the status of the booking
*    ui5_booking_status_update( i_status = /sopromet/cl_l_reservation=>c_book_status_mat_d ).

    COMMIT WORK AND WAIT.
  endmethod.


METHOD call_screen_booking_from_case.
*____HS# 012705, VON: OPECHARROMAN, DATUM: 01.10.2018___*
*____HS# 013077, VON: STAORI,       DATUM: 19.03.2019___*

  DATA ld_fcode TYPE sy-ucomm.

  CHECK case_save_final_check( ) EQ abap_true.              "HS 13077

* Save open reservations.
  case_save_all( ).

* Enqueu case and reservation after database save.
  CHECK enqueue( ) EQ abap_true.

  IF go_act_reservation IS BOUND.
    go_act_reservation->enqueue( ).
    CHECK go_act_reservation->g_enqueue = abap_true.
  ENDIF.

  set_property go_act_reservation 'G_RESERVATION-EQUNR' space.

  CALL FUNCTION '/BITMYM/CALL_BOOK_FROM_CASE'
    IMPORTING
      ed_fcode = ld_fcode.

  CHECK ld_fcode = 'EXECUTE'.

  e_success = abap_true.

ENDMETHOD.


  method UI5_UPDATE_REF_BOOKING_FOLLOW.
*____HS# 015186, VON: SSINGH, DATUM: 20.04.2021___*
*___ SR2-1415, User: SCOSAR, Date: 24.01.2025___*

*    CHECK go_ui5 IS BOUND. "SR2-1415 - commented - follow up bookings can be created from bakend as well
    CHECK gs_comwa-ref_book IS NOT INITIAL.
    cs_comwa-ref_book = gs_comwa-ref_book.
    cs_comwa-xfollowup = gs_comwa-xfollowup.
  endmethod.


METHOD mig_create_case.
*____HS# 013195, VON: OPECHARROMAN, DATUM: 27.05.2019___*
*____HS# 014696, VON: SISMAIL, DATUM: 01.02.2021___*
*____HS# 015814, VON: STAORI,  DATUM: 11.08.2021___*
*___ SR1-1871, User: SBADUSHA, Date: 24.10.2023___*
*___ SR2-3008, User: XLI, Date: 31.03.2026___*



  DATA: ls_data       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep.

  DATA: ls_case       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case,
        ls_comwa_appl TYPE /sopromet/zzls01.

*___Step 1: Get ODATA Context from data provider object
  CHECK io_provider IS BOUND.

  io_provider->read_entry_data( IMPORTING es_data = ls_data ).

  MOVE-CORRESPONDING ls_data TO ls_case.

*___Step 2: Fill CASE COMWA + APPL COMWA
  get_property go_appl 'GS_COMWA' ls_comwa_appl .

ENHANCEMENT-POINT fill_comwa_cust_field SPOTS /bitmym/cl_case .

  gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.

  gs_comwa-ihrez = ls_case-ihrez.
  gs_comwa-kunnr = ls_case-kunnr.
  gs_comwa-rstyp = ls_case-rstyp.
  gs_comwa-odate = ls_case-odate.
  gs_comwa-bstnk = ls_case-bstnk.
  gs_comwa-ref_book = ls_data-ref_book.                     "SR1-1871+
  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
  CHECK prep_case_partner_generic( it_partners = ls_data-casetopartner ) EQ abap_true.

*___Step 4: Date calculation
  compute_dates( CHANGING cs_comwa = gs_comwa ).

* To be able to set dates from structure in case of customer requirements to take existing dates instead of calculating.
* Call external static method so no access to case object is provided in user exit
  set_mig_dates_user_exit( EXPORTING is_case = ls_case
                                     is_data = ls_data
                           CHANGING cs_comwa = gs_comwa ).

  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 5: Add Equipment Selection
*____SR2-3008____BEGIN INSERT___*
*  CHECK ui5_prep_equi_sel( it_matsel = ls_data-casetomaterialselection ) EQ abap_true.
  IF NOT ui5_prep_equi_sel( it_matsel = ls_data-casetomaterialselection ) EQ abap_true.
    IF NOT ls_data-casetosingleitem IS INITIAL.
      prepare_single_item( ).
    ELSE.
      RETURN.
    ENDIF.
  ENDIF.
*____SR2-3008____END   INSERT___*

*___Step 6: Overwrite determined Shipping Information
  ui5_overwrite_values( i_case = ls_case ).

*___Step 7: Init sequence for a new case
*  create_new_case( ). "HS# 014696-
  create_new_case( id_no_atp = abap_true ). "HS# 014696+

*___Step 8: Build Tree
  ui5_prep_reservation_tree( ).

*___Step 9: Prepare Single Items
  ui5_prep_single_items( CHANGING ct_items   = ls_data-casetosingleitem ).

*___Step 10: Prepare Text. Call standard text routines used in booking creation
  ui5_prep_booking_notes( it_notes = ls_data-casetonotes ).

  set_property go_appl 'GD_REF_BOOKING' ls_data-ref_book.   "SR1-1871+

*__New EHP                                                  "HS 015814
ENHANCEMENT-POINT FILL_COMWA_CUST_FIELD_01 SPOTS /BITMYM/CL_CASE .

*___Step 11: Post Reservation
  CHECK ui5_post_case( ) EQ abap_true.

  es_data = ls_data.

*___Step 12: Fill Return Data
  mig_case_result( CHANGING es_data = es_data ).

ENDMETHOD.


  method RES_OPEN_LINKED_SALES_AREA.
*____HS# 015113, VON: STAORI, DATUM: 30.03.2021___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*

    DATA: ld_tryp	TYPE trtyp VALUE 'A'. "Default value display

    ld_tryp = gs_comwa-trtyp_o.       "SR1-545

    CHECK go_salesarea IS BOUND.

*__Check if the sales area from reservation is linked to login sales area

    CHECK go_salesarea->check_area_is_linked( iv_spart = is_res-spart iv_vkorg = is_res-vkorg iv_vtweg = is_res-vtweg ) EQ abap_true.

    ed_return = abap_true.

    /bitmym/cl_message=>message( id = 'I948(/SOPROMET/ZL)' ).

*__ LD_TRYP value can be manipulated in below EHP
ENHANCEMENT-POINT RES_OPEN_LINKED_SALES_AREA SPOTS /BITMYM/CL_CASE .

    IF ld_tryp EQ /bitmym/cl_mym=>c_trtyp_display.

      CALL FUNCTION '/BITMYM/APPL_RES_CALL_DISPLAY'
        EXPORTING
          id_lresn = is_res-zzlresn.

    ELSEIF ld_tryp EQ /bitmym/cl_mym=>c_trtyp_change.

      CALL FUNCTION '/BITMYM/APPL_RES_CALL_CHANGE'
        EXPORTING
          id_lresn = is_res-zzlresn.

    ENDIF.
  endmethod.


METHOD ui5_prep_res_info_to_gt_res.
*____HS# 015081, VON: OPECHARROMAN, DATUM: 14.09.2021___*
*___ SR2-1565, User: SCOSAR, Date: 04.03.2025___*

  DATA: ls_res  TYPE /sopromet/zzlrv,
        lt_tree TYPE /sopromet/tree_collect_tab,
        ls_date TYPE /bitmym/s4h_convert_dates_st.

  CHECK go_tree_case IS NOT INITIAL.

  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE'     IMPORTING e_value = lt_tree ).

* Move case data to reservation table data.
  LOOP AT lt_tree ASSIGNING FIELD-SYMBOL(<fs_res>) WHERE isfolder EQ abap_false.

    DATA(ls_map) = go_tree_case->get_map_of_node( <fs_res>-node_key ).

    CHECK ls_map IS NOT INITIAL.

    ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
    IF ls_res-zzlresn IS INITIAL.
      READ TABLE is_data ASSIGNING FIELD-SYMBOL(<fs_data>) WITH KEY equnr = ls_res-equnr.
    ELSE.
      READ TABLE is_data ASSIGNING <fs_data> WITH KEY zzlresn = ls_res-zzlresn.
    ENDIF.
*    CHECK sy-subrc EQ 0. "SR2-1565
    IF sy-subrc EQ 0.                                       "SR2-1565
* move odata service dates to common date structure
      MOVE-CORRESPONDING <fs_data> TO ls_date.
      IF ls_date IS NOT INITIAL.
        /bitmym/cl_ui5_util=>convert_times_to_stamps( CHANGING cs_data = ls_date ).
      ELSE.
        MOVE-CORRESPONDING gs_comwa TO ls_date.
      ENDIF.
      MOVE-CORRESPONDING ls_date TO ls_res.
    ENDIF.                                                  "SR2-1565
    ls_res-asmnt = VALUE #( it_matsel[ equnr = ls_res-equnr ]-asmnt OPTIONAL ). "SR2-1565

    set_property ls_map-objkey 'G_RESERVATION' ls_res.
  ENDLOOP.

  set_property go_appl 'GO_CASE' me.
ENDMETHOD.


METHOD ui5_s4h_update_reservation.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*
*____HS# 015081, VON: STEKDEMIR, DATUM: 16.08.2022___*
*___ SR1-1309, User: PKUNAL, Date: 13.09.2023___*


  DATA: ls_data_ui5 TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep, "015081
        lo_case     TYPE REF TO /bitmym/cl_case.

  SELECT SINGLE zzlrsam
    FROM /sopromet/zzlrv
*    WHERE zzlresn = @i_zzlresn
    WHERE zzlrsam = @i_case
    INTO @DATA(lv_zzlrsam).

*  CHECK sy-subrc = 0.                                                            "___ SR1-1309
  IF sy-subrc IS NOT INITIAL.                                                     "___ SR1-1309
    /bitmym/cl_message=>message( id = 'E008(/BITMYM/S4)' v1 = i_case ).           "___ SR1-1309
    EXIT.                                                                         "___ SR1-1309
  ELSE.                                                                           "___ SR1-1309

*___Create CASE Object
*    lo_case = /bitmym/cl_case=>create( id_case = lv_zzlrsam id_reservation = i_zzlresn io_ui5 = io_ui5 ).      "___ SR1-1309
    lo_case = /bitmym/cl_case=>create( id_case = lv_zzlrsam io_ui5 = io_ui5 ).

    io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

*___Start processing
    lo_case->ui5_s4h_update_reservation_int( EXPORTING is_data_ui5 = ls_data_ui5 "015081
                                             IMPORTING es_data = es_data ).

  ENDIF.                                                                          "___ SR1-1309

ENDMETHOD.


  METHOD ui5_s4h_create_reservation.
*____HS# 015081, VON: STAORI, DATUM: 03.09.2021___*

    DATA: lo_case  TYPE REF TO /bitmym/cl_case,
          ls_comwa TYPE /sopromet/zzls01.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_s4h_create_reservation_int( IMPORTING es_data = es_data ).


  ENDMETHOD.


  METHOD ui5_s4h_create_reservation_int.
*____HS# 015081, VON: STAORI, DATUM: 03.09.2021___*
*____HS# 015081, VON: OPECHARROMAN, DATUM: 14.09.2021___*
*____HS# 015801, VON: SSINGH, DATUM: 08.02.2022___*
*____HS# 016491, VON: OPECHARROMAN, DATUM: 08.02.2022___*
*___ SR2-721, User: SCOSAR, Date: 31.10.2024___*
*___ SR2-1565, User: SCOSAR, Date: 04.03.2025___*


    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_date          TYPE /bitmym/s4h_convert_dates_st,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
          ls_copy_fields   TYPE /bitmym/ic_book_create_fields,
          ls_case          TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case,
          ls_res           TYPE /sopromet/zzlrv,
          ls_comwa_appl    TYPE /sopromet/zzls01.

*   Start of HS# 016491 -->
*   To be able to have an external provider
    IF io_provider IS NOT INITIAL.
      lo_data_provider = io_provider.
    ELSE.
*   End of HS# 016491 <--
*___Step 1: Get ODATA Context from data provider object
      get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    ENDIF.                                                  "HS# 016491

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    MOVE-CORRESPONDING ls_data_ui5 TO ls_case.

*___Step 2: Fill CASE COMWA + APPL COMWA
    get_property go_appl 'GS_COMWA' ls_comwa_appl .
    gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.
*   Creation fields
    MOVE-CORRESPONDING ls_data_ui5  TO ls_copy_fields.
    MOVE-CORRESPONDING ls_copy_fields TO ls_case.
*   Dates
    MOVE-CORRESPONDING ls_data_ui5  TO ls_date.
    ls_date-kunnr = ls_copy_fields-kunnr.                   "HS 15801
    /bitmym/cl_ui5_util=>convert_times_to_stamps( CHANGING cs_data = ls_date ).
    MOVE-CORRESPONDING ls_date TO ls_case.
*   Move back to comunnication structure
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.
    MOVE-CORRESPONDING ls_date TO gs_comwa.

    set_property go_appl        'GS_COMWA'     gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
    CHECK prep_case_partner_generic( it_partners = ls_data_ui5-casetopartner ) EQ abap_true.

*___Step 5: Add Equipment Selection
*    CHECK ui5_prep_equi_sel( it_matsel = ls_data_ui5-casetomaterialselection ) EQ abap_true.
*    IF ls_data_ui5-casetomaterialselection IS INITIAL AND ls_data_ui5-casetoreservation IS NOT INITIAL.
*      ls_data_ui5-casetomaterialselection = CORRESPONDING #( ls_data_ui5-casetoreservation ).
*    ENDIF.

    ui5_get_equip_single_items( it_single_items = ls_data_ui5-casetosingleitem ).

    CHECK ui5_prep_equi_sel( it_matsel = ls_data_ui5-casetomaterialselection ).

*___Step 5: Overwrite determined Shipping Information
    ui5_overwrite_values( i_case = ls_case ).

*___Step 6: Init sequence for a new case
    create_new_case( id_no_atp = abap_true ).

*___Step 7: Build Tree
    ui5_prep_reservation_tree( ).

*   Step 8: Pass odata info into reservation table list
    ui5_prep_res_info_to_gt_res( is_data   = ls_data_ui5-casetoreservation
                                 it_matsel = ls_data_ui5-casetomaterialselection ). "SR2-1565

*___Step 9: Prepare Single Items
    ui5_prep_single_items( CHANGING ct_items   = ls_data_ui5-casetosingleitem ).

*___Step 10: Prepare Text
    ui5_prep_booking_notes( it_notes = ls_data_ui5-casetonotes ).

*___Step 10: Post Reservation
    CHECK ui5_post_case( ) EQ abap_true.

*___Step 11: Fill Return Data
    ui5_case_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).

*___Step 12: Sync. with reference bookings                              "SR2-721
    read_reservations( ).                                               "SR2-721
    /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ). "SR2-721
    COMMIT WORK AND WAIT.
  ENDMETHOD.


METHOD ui5_s4h_update_reservation_int.
*____HS# 015080, VON: MTOMITA, DATUM: 06.08.2021___*
*____HS# 015080, VON: OPECHARROMAN, DATUM: 14.09.2021___*
*____HS# 015081, VON: STEKDEMIR, DATUM: 16.08.2022___*


  DATA: ls_data_ui5    TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
*        lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider, "HS 015081
        ld_check       TYPE abap_bool,
        ls_copy_fields TYPE /bitmym/ic_book_create_fields.

  ls_data_ui5 = is_data_ui5.                                "015081

  "Delete begin of HS 015081
**___Step 1: Get ODATA Context from data provider object
*  get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
*
*  CHECK lo_data_provider IS BOUND.
*
*  lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
  "Delete end of HS 015081

*___Step 2: Fill CASE COMWA + APPL COMWA
*  gd_simulate = ls_data_ui5-simulation.
  MOVE-CORRESPONDING ls_data_ui5 TO ls_copy_fields.
  MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.
  gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
  gs_comwa-rstyp = |{ gs_comwa-rstyp ALPHA = IN }|.         "015081
  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
  CHECK ui5_prep_case_partner( it_partners = ls_data_ui5-casetopartner ) EQ abap_true.

*   Step 5: Pass odata info into reservation table list
  ui5_prep_res_info_to_gt_res( is_data = ls_data_ui5-casetoreservation ).

*___Step 6: Create tree
  ui5_prep_reservation_tree( ).

*___Step 7: Prepare Text
  ui5_prep_booking_notes( it_notes = ls_data_ui5-casetonotes ).

*___Step 9: Prepare Single Items  "HS 015081
  ui5_prep_single_items( CHANGING ct_items   = ls_data_ui5-casetosingleitem ).  "HS 015081

*___Step 11: Post Reservation
  CHECK ui5_post_case( ) EQ abap_true.

*___Step 12: Fill Return Data
  ui5_case_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).

ENDMETHOD.


  METHOD ui5_dequeue.
*____HS# 015083, VON: SSINGH, DATUM: 11.10.2021___*
*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___*
*____HS# 017708, VON: BGUNAWAN, DATUM: 23.12.2022___*
*___ SR2-54, User: PKSHIRSAGAR, Date: 26.06.2024___*
*___ SR2-1121, User: PKSHIRSAGAR, Date: 19.11.2024___*

    FIELD-SYMBOLS : <fs_entity> TYPE /bitmym/ic_dequeue_locks.
    DATA : lo_case     TYPE REF TO /bitmym/cl_case,
           ls_data     TYPE /bitmym/ic_dequeue_locks,
           lt_enq      TYPE TABLE OF seqg3,
           lt_enq_del  TYPE TABLE OF seqg3,
           l_key       TYPE char50,
           l_key_case  TYPE char50,
           l_key_bcase TYPE char50,
           l_vkorg     TYPE vkorg,
           lo_res      TYPE REF TO /sopromet/cl_l_reservation.
    FIELD-SYMBOLS : <fs_enq>     TYPE seqg3,
                    <fs_enq_del> TYPE seqg3.
    io_ui5->ui5_filter2struct( CHANGING cs_struct = ls_data ).
    IF ls_data IS INITIAL.                                  "HS# 017708
      io_ui5->ui5_parameter2struct( CHANGING cs_struct = ls_data ). "HS# 017708
    ENDIF.                                                  "HS# 017708
    IF ls_data-lresn IS NOT INITIAL.
      CREATE OBJECT lo_res
        EXPORTING
          i_zzlresn = ls_data-lresn
          io_ui5    = io_ui5.


      IF lo_res IS BOUND.
        CALL FUNCTION 'DEQUEUE_ALL'
          EXPORTING
            _synchron = 'X'.   "SR2-1121
      ENDIF.
    ENDIF.

    IF ls_data-matnr IS NOT INITIAL.
      CALL FUNCTION 'ENQUE_READ'
        EXPORTING
          gclient = sy-mandt
          guname  = sy-uname
        TABLES
          enq     = lt_enq.

      CONCATENATE  sy-mandt ls_data-matnr INTO l_key.
      READ TABLE lt_enq ASSIGNING <fs_enq> WITH KEY gtarg = l_key.
      IF sy-subrc = 0.
        APPEND INITIAL LINE TO lt_enq_del ASSIGNING <fs_enq_del>.
        <fs_enq_del> = <fs_enq>.
      ENDIF.

      CALL FUNCTION 'ENQUE_DELETE'
        TABLES
          enq = lt_enq_del.

    ENDIF.

*    CALL FUNCTION 'DEQUEUE_ALL'. "HS# 015080 DEL

*____SR2-1121____BEGIN INSERT___*
    IF ls_data-dequeue_all = abap_true.
      CALL FUNCTION 'DEQUEUE_ALL'.
    ENDIF.
*____SR2-1121____END   INSERT___*



    IF ls_data-onexit = 'X'.

      CALL FUNCTION 'ENQUE_READ'
        EXPORTING
          gclient = sy-mandt
*         GNAME   = ' '
*         GARG    = ' '
          guname  = sy-uname
        TABLES
          enq     = lt_enq.
      IF ls_data-lresn IS NOT INITIAL.
        CONCATENATE  sy-mandt ls_data-lresn INTO l_key.
        SELECT SINGLE vkorg zzlrsam INTO (l_vkorg, l_key_case) FROM
          /sopromet/zzlrv
          WHERE zzlresn = ls_data-lresn.
        CONCATENATE  sy-mandt l_vkorg l_key_case INTO l_key_case.

*____sr2-1121____begin insert___*
        lo_case = /bitmym/cl_case=>create( EXPORTING id_reservation = ls_data-lresn  id_no_link_objects = abap_true  id_no_status_refresh = abap_true ).

        lo_case->get_booking_res_details( ).

        DATA(lv_bcase) = lo_case->get_data( )-gd_dependent_combinedrun.

        CONCATENATE  sy-mandt l_vkorg  lv_bcase  INTO l_key_bcase.
        READ TABLE lt_enq ASSIGNING <fs_enq> WITH KEY gtarg = l_key_bcase.
        IF sy-subrc = 0.
          APPEND INITIAL LINE TO lt_enq_del ASSIGNING <fs_enq_del>.
          <fs_enq_del> = <fs_enq>.
        ENDIF.
*____SR2-1121____END   INSERT___*
      ENDIF.

**SOA #SR2-54 unlock all reservations under combinedrun
      IF ls_data-lrsam IS NOT INITIAL.
        CONCATENATE sy-mandt ls_data-vkorg ls_data-lrsam INTO l_key_case.
        SELECT *  FROM /sopromet/zzlrv INTO TABLE @DATA(lt_reservations) WHERE zzlrsam = @ls_data-lrsam AND vkorg = @ls_data-vkorg.
        LOOP AT lt_reservations INTO DATA(ls_reservation).
          CONCATENATE  sy-mandt ls_reservation-zzlresn INTO l_key.
          READ TABLE lt_enq ASSIGNING <fs_enq> WITH KEY gtarg = l_key.
          IF sy-subrc = 0.
            APPEND INITIAL LINE TO lt_enq_del ASSIGNING <fs_enq_del>.
            <fs_enq_del> = <fs_enq>.
          ENDIF.
          CLEAR : l_key, ls_reservation.
        ENDLOOP.
      ENDIF.
**EOA #SR2-54


      READ TABLE lt_enq ASSIGNING <fs_enq> WITH KEY gtarg = l_key.
      IF sy-subrc = 0.
        APPEND INITIAL LINE TO lt_enq_del ASSIGNING <fs_enq_del>.
        <fs_enq_del> = <fs_enq>.
      ENDIF.
      READ TABLE lt_enq ASSIGNING <fs_enq> WITH KEY gtarg = l_key_case.
      IF sy-subrc = 0.
        APPEND INITIAL LINE TO lt_enq_del ASSIGNING <fs_enq_del>.
        <fs_enq_del> = <fs_enq>.
      ENDIF.

      CALL FUNCTION 'ENQUE_DELETE'
        TABLES
          enq = lt_enq_del.

    ENDIF.

**SOA #SR2-54
    IF ls_data-lrsam IS NOT INITIAL.
      lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_case = ls_data-lrsam ).
      IF lo_case  IS BOUND.
        CALL FUNCTION 'DEQUEUE_ALL'.
      ENDIF.
    ENDIF.
**EOA #SR2-54


*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___Begin INS*
    IF /bitmym/cl_monitor=>ui5_mass_lock_ext( io_ui5 = io_ui5 is_lock_str = ls_data ) NE abap_true.
      /bitmym/cl_message=>message( id = 'E618(/SOPROMET/ZL)' ).
    ENDIF.
*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___End INS*

    APPEND INITIAL LINE TO et_entityset ASSIGNING <fs_entity>.

  ENDMETHOD.


  METHOD create_deliv_dispatch_order.
*____HS# 015536, VON: SBADUSHA, DATUM: 07.03.2022___*
*___ SR1-332, User: SBADUSHA, Date: 15.11.2023___*

*&* As this method is not used anywhere. Commenting out
*&* Begin of Comment SR1-332
*   data: ls_res  type /sopromet/zzlrv,
*          ls_vbak type vbak.
*    field-symbols: <fds_item>    type bapisditm.
*
*    ls_vbak-vkorg = gs_bapi_ord_head-sales_org.
*    ls_vbak-vtweg = gs_bapi_ord_head-distr_chan.
*    ls_vbak-auart = gs_bapi_ord_head-doc_type.
*    ls_vbak-spart = gs_bapi_ord_head-division.
*    ls_vbak-vbeln = gd_vbeln.
*
** Get first equi to enqueue the delivery PGI RFC to that equi queue
*    read table gt_bapi_item index 1 assigning <fds_item>.
*    check sy-subrc eq 0.
*    call function '/SOPROMET/RESERV_SINGLE_READ'
*      exporting
*        i_reserv      = <fds_item>-/sopromet/lresn
*      importing
*        e_reservation = ls_res.
*    check ls_res-equnr is not initial.
*    ls_vbak-/sopromet/equnr = ls_res-equnr.
*
** Automatically deliver in case the rush order failed due to missing stock
*    /bitmym/cl_order=>automatic_del_ext( is_vbak = ls_vbak ).
*
*** Automatically PGI
**    /bitmym/cl_order=>automatic_pgi_ext( is_vbak = ls_vbak ).
*
*    commit work.
*&* End of comment SR1-332
  ENDMETHOD.


  method UI5_UPDATE_BOOKING.
*____HS# 016572, VON: SSINGH, DATUM: 01.03.2022___*

    DATA: ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider.
*___Step 1: Get ODATA Context from data provider object
    get_property io_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    CHECK lo_data_provider IS BOUND.
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam id_reservation = ls_data_ui5-zzlresn io_ui5 = io_ui5 ).
*___Start processing
  lo_case->ui5_update_booking_int( IMPORTING es_data = es_data ).
  endmethod.


  method UI5_UPDATE_BOOKING_INT.
*____HS# 016572, VON: SSINGH, DATUM: 01.03.2022___*
*____HS# 017087, VON: SSINGH, DATUM: 11.10.2022___*
    DATA: ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          ls_res           TYPE /sopromet/zzlrv,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider.
*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    CHECK lo_data_provider IS BOUND.
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_b.
    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_data_ui5-zzlresn
        i_no_buff     = 'X'
      IMPORTING
        e_reservation = ls_res.

    MOVE-CORRESPONDING  ls_res TO gs_comwa.
    IF ls_data_ui5-opkra IS NOT INITIAL.
      gs_comwa-opkra = ls_data_ui5-opkra.
    ENDIF.
*    begin of changes HS 17087
    IF ls_data_ui5-bstnk IS NOT INITIAL.
      gs_comwa-bstnk = ls_data_ui5-bstnk.
    ENDIF.
*    end of changes HS 17087
    set_property go_appl 'GO_CASE' me.
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
    CHECK ui5_prep_booking_partner( id_no_add_srep = abap_true ) EQ abap_true.

*___Step 4: Create tree
    ui5_prep_reservation_tree( ).

*___Step 8: Post Booking (Simulation considered)
    CHECK ui5_post_booking( ) EQ abap_true.

*___Step 0: Fill Return Data
    ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).
  endmethod.


  method UI5_GET_RECENT_ORDERS.
*____HS# 016152, VON: SSINGH, DATUM: 16.11.2021___*
*____HS# 016842, VON: SSINGH, DATUM: 10.06.2022___*

    DATA : lo_case       TYPE REF TO /bitmym/cl_case,
           l_text_1      TYPE string,
           ls_order_type TYPE /sopromet/zzlaa,
           l_text_2      TYPE string,
           l_text_3      TYPE string,
           l_text_4      TYPE string,
           lt_entityset  TYPE TABLE OF /bitmym/ui5_recent_orders.

    FIELD-SYMBOLS : <fs_entity> TYPE /bitmym/ui5_recent_orders.

    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_no_link_objects = abap_true id_reservation = i_lresn id_with_reservations = abap_false ).
    lo_case->ui5_get_recent_orders_int( CHANGING ct_entityset = lt_entityset ).

    LOOP AT lt_entityset ASSIGNING <fs_entity>.
      CLEAR : ls_order_type, l_text_1, l_text_2, l_text_3, l_text_4.
      ls_order_type-auart = <fs_entity>-auart.
      /sopromet/cl_l_order_type=>get_text_doc_flow_ot(
        EXPORTING
          is_order_type    = ls_order_type
        IMPORTING
          e_text_auart     = l_text_1
          e_text_lfart     = l_text_2
          e_text_fkart     = l_text_3
          e_text_auart_alt = l_text_4 ).

      <fs_entity>-name = l_text_1.

    ENDLOOP.
*    16842
ENHANCEMENT-POINT UPDATE_ENTITYSET SPOTS /BITMYM/CL_CASE .
    et_entityset = lt_entityset.
  endmethod.


  METHOD ui5_get_recent_orders_int.
*____HS# 016152, VON: SSINGH, DATUM: 29.11.2021___*
*___ SR2-233, User: SBADUSHA, Date: 15.03.2024___*
*___ SR2-743, User: SSAHU, Date: 14.08.2024___*
*___ SR2-580, User: MKNAUER, Date: 02.09.2024___*
*___ SR2-870, User: OKIMENCE, Date: 17.09.2024___*
*___ SR2-376, User: OOGUR, Date: 01.10.2024___*
*___ SR2-950, User: OOGUR, Date: 08.10.2024___*
*___ SR2-1366, User: SSAHU, Date: 10.01.2025___*


    DATA : lt_zzlnb     TYPE TABLE OF /sopromet/zzlnb,
           lt_zzlvf     TYPE TABLE OF /sopromet/zzlvf,
           lt_zzlrv     TYPE TABLE OF /sopromet/zzlrv,
           lt_vbuk_vf   TYPE TABLE OF vbuk,
*           lt_vbakuk    TYPE TABLE OF vbakuk,              "SR2-1366 Del
           lt_vbakuk    TYPE TABLE OF vbak,                 "SR2-1366
           lt_elog      TYPE TABLE OF /sopromet/elog,
           lt_entityset TYPE TABLE OF /bitmym/ui5_recent_orders,
           ls_zzlrv     TYPE /sopromet/zzlrv,
           lt_vbak      TYPE TABLE OF vbak,
           ls_typeo     TYPE /sopromet/rstypo,
           lt_book_ref  TYPE TABLE OF /bitmym/book_ref.

    FIELD-SYMBOLS : <fs_entity> TYPE /bitmym/ui5_recent_orders,
                    <fs_vbuk>   TYPE vbuk,
                    <fs_zzlvf>  TYPE /sopromet/zzlvf,
*                    <fs_vbakuk> TYPE vbakuk,               "SR2-1366 Del
                    <fs_vbakuk> TYPE vbak,                  "SR2-1366
                    <fs_zzlnb>  TYPE /sopromet/zzlnb.

    SELECT SINGLE * FROM /sopromet/zzlrv INTO ls_zzlrv
      WHERE  zzlresn = gd_reservation.

    CHECK sy-subrc = 0.
    CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
      EXPORTING
        i_rstyp = ls_zzlrv-rstyp
        i_vkorg = ls_zzlrv-vkorg
      IMPORTING
        e_data  = ls_typeo.


*    SELECT *                                                                                        "SR2-870 Del
    SELECT zzlnb~*                                                                                   "SR2-870
       FROM /sopromet/zzlnb AS zzlnb
       INNER JOIN vbak AS vb ON vb~vbeln = zzlnb~vbeln                                               "SR2-870
       WHERE zzlresn = @gd_reservation
       ORDER BY zzlnb~erdat DESCENDING
      INTO TABLE @lt_zzlnb
       UP TO @ls_typeo-ic_ordernos ROWS .


*____SR2-870____BEGIN COMMENT___* Moved to below
*    IF lt_zzlnb IS NOT INITIAL.
*      SELECT * FROM vbakuk INTO TABLE lt_vbakuk
*        FOR ALL ENTRIES IN lt_zzlnb
*        WHERE vbeln = lt_zzlnb-vbeln.
*    ENDIF.
*____SR2-870____END   COMMENT___*


*    SELECT *                                                                                      "SR2-870 Del
    SELECT zzlvf~*                                                                                 "SR2-870
      FROM /sopromet/zzlvf AS zzlvf
      INNER JOIN vbak AS vb ON vb~vbeln = zzlvf~vbeln                                              "SR2-870
      WHERE zzlresn = @gd_reservation
      ORDER BY zzlvf~erdat DESCENDING
      INTO TABLE @lt_zzlvf
      UP TO @ls_typeo-ic_ordernos ROWS
      .

*____SR2-870____BEGIN COMMENT___* Moved to below
*    IF lt_zzlvf IS NOT INITIAL.
*     SELECT * FROM vbuk INTO TABLE @lt_vbuk_vf
*        FOR ALL ENTRIES IN @lt_zzlvf
*        WHERE vbeln = @lt_zzlvf-vbeln.
*    ENDIF.
*____SR2-870____END   COMMENT___*

    SELECT * FROM /bitmym/book_ref INTO TABLE lt_book_ref
      WHERE ref_book = gd_reservation.

    IF lt_book_ref IS NOT INITIAL.
      SELECT * FROM /sopromet/zzlrv INTO TABLE lt_zzlrv
        FOR ALL ENTRIES IN lt_book_ref
        WHERE vkorg = lt_book_ref-vkorg AND
              zzlrsam = lt_book_ref-lrsam.
*____SR2- 743____BEGIN INSERT___*
    ELSE.
      IF ls_zzlrv-vbelnkb IS NOT INITIAL.
        APPEND INITIAL LINE TO lt_entityset ASSIGNING <fs_entity>.
        MOVE-CORRESPONDING ls_zzlrv TO <fs_entity>.
        <fs_entity>-lresn = ls_zzlrv-zzlresn.
        <fs_entity>-vbeln = ls_zzlrv-vbelnkb.

        SELECT SINGLE auart, gbstk FROM vbak
                      INTO ( @<fs_entity>-auart, @<fs_entity>-wbstk )
                      WHERE vbeln = @ls_zzlrv-vbelnkb.
        IF sy-subrc <> 0.
          REFRESH lt_entityset.
        ENDIF.
      ENDIF.
*____SR2- 743____end   insert___*
    ENDIF.


    IF lt_zzlrv IS NOT INITIAL.
      SELECT * FROM /sopromet/elog INTO TABLE lt_elog
        FOR ALL ENTRIES IN lt_zzlrv
        WHERE lresn = lt_zzlrv-zzlresn.
    ENDIF.
    SORT lt_elog BY vbeln DESCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_elog COMPARING vbeln.
    DELETE lt_elog WHERE auart IS INITIAL.
    SORT lt_elog BY erdat DESCENDING.

*____SR2-580____BEGIN INSERT___*
    LOOP AT lt_elog ASSIGNING FIELD-SYMBOL(<elog>) WHERE vbeln IS NOT INITIAL.
      SELECT SINGLE vbeln INTO @DATA(ld_vbeln) FROM vbak WHERE vbeln = @<elog>-vbeln.
      CHECK sy-subrc NE 0.
      DELETE lt_elog.
    ENDLOOP.
*____SR2-580____END   INSERT___*


*____SR2-870____BEGIN INSERT___*
    IF lt_zzlrv[] IS NOT INITIAL AND lt_zzlnb[] IS INITIAL.

      SELECT zzlnb~*
        FROM /sopromet/zzlnb AS zzlnb
        INNER JOIN vbak AS vb ON vb~vbeln = zzlnb~vbeln
        FOR ALL ENTRIES IN @lt_zzlrv
        WHERE zzlresn = @lt_zzlrv-zzlresn
        INTO TABLE @lt_zzlnb.

      IF lt_zzlnb[] IS NOT INITIAL.

        SORT lt_zzlnb BY erdat DESCENDING.
        IF ls_typeo-ic_ordernos IS NOT INITIAL.
          DELETE lt_zzlnb FROM ( ls_typeo-ic_ordernos + 1 ).
        ENDIF.
      ENDIF.

    ENDIF.


    IF lt_zzlrv[] IS NOT INITIAL AND lt_zzlvf[] IS INITIAL.

      SELECT zzlvf~*
        FROM /sopromet/zzlvf AS zzlvf
        INNER JOIN vbak AS vb ON vb~vbeln = zzlvf~vbeln
        FOR ALL ENTRIES IN @lt_zzlrv
        WHERE zzlresn = @lt_zzlrv-zzlresn
        INTO TABLE @lt_zzlvf.

      IF lt_zzlvf[] IS NOT INITIAL.

        SORT lt_zzlvf BY erdat DESCENDING.
        IF ls_typeo-ic_ordernos IS NOT INITIAL.
          DELETE lt_zzlvf FROM ( ls_typeo-ic_ordernos + 1 ).
        ENDIF.
      ENDIF.

    ENDIF.


    IF lt_zzlnb IS NOT INITIAL.
*      SELECT * FROM vbakuk  "SR2-1366 Del
      SELECT vbeln, auart, gbstk FROM vbak                  "SR2-1366
        INTO
        CORRESPONDING FIELDS OF                             "SR2-1366
        TABLE @lt_vbakuk
        FOR ALL ENTRIES IN @lt_zzlnb
        WHERE vbeln = @lt_zzlnb-vbeln.
    ENDIF.

    IF lt_zzlvf IS NOT INITIAL.

*____SR2-950____BEGIN COMMENT___*
*     SELECT * FROM vbuk INTO TABLE @lt_vbuk_vf
*        FOR ALL ENTRIES IN @lt_zzlvf
*        WHERE vbeln = @lt_zzlvf-vbeln.
*____SR2-950____END   COMMENT___*

*____SR2-950____BEGIN INSERT___*
      SELECT  vbak~vbeln,vbak~gbstk
        FROM vbak
        INNER JOIN @lt_zzlvf AS zzlvf ON zzlvf~vbeln EQ vbak~vbeln
        INTO TABLE @DATA(lt_vbak_vf).
*____SR2-950____END   INSERT___*

    ENDIF.
*____SR2-870____END   INSERT___*


    ui5_restrict_orders( EXPORTING is_zzlrv = ls_zzlrv CHANGING ct_table = lt_elog ).
    LOOP AT lt_zzlvf ASSIGNING <fs_zzlvf>.
      APPEND INITIAL LINE TO lt_entityset ASSIGNING <fs_entity>.
      MOVE-CORRESPONDING <fs_zzlvf> TO <fs_entity>.
*      READ TABLE lt_vbuk_vf ASSIGNING <fs_vbuk> WITH KEY vbeln = <fs_zzlvf>-vbeln.                      "SR2-950 Del
      READ TABLE lt_vbak_vf ASSIGNING FIELD-SYMBOL(<fs_vbak_vf>) WITH KEY vbeln = <fs_zzlvf>-vbeln.      "SR2-950
      IF sy-subrc = 0.
*        <fs_entity>-wbstk = <fs_vbuk>-gbstk.                                                            "SR2-950 Del
        <fs_entity>-wbstk = <fs_vbak_vf>-gbstk.                                                          "SR2-950
      ENDIF.
    ENDLOOP.

    LOOP AT lt_zzlnb ASSIGNING <fs_zzlnb>.
      APPEND INITIAL LINE TO lt_entityset ASSIGNING <fs_entity>.
      MOVE-CORRESPONDING <fs_zzlnb> TO <fs_entity>.
      READ TABLE lt_vbakuk ASSIGNING <fs_vbakuk> WITH KEY vbeln = <fs_zzlnb>-vbeln.
      IF sy-subrc = 0.
        <fs_entity>-auart = <fs_vbakuk>-auart.
        <fs_entity>-wbstk = <fs_vbakuk>-gbstk.
      ENDIF.
    ENDLOOP.
    APPEND LINES OF lt_elog TO lt_entityset.


    ui5_add_field_inv_ord_records( CHANGING ct_entityset = lt_entityset ).                              "SR2-376


    SORT lt_entityset BY vbeln DESCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_entityset COMPARING vbeln.
    CHECK lt_entityset IS NOT INITIAL.
    SORT lt_entityset BY erdat DESCENDING.
    ui5_get_dispatch_pgi_data( CHANGING ct_entity = lt_entityset ).                                    "SR2-233
    ui5_restrict_orders( EXPORTING is_zzlrv = ls_zzlrv CHANGING ct_table = lt_entityset ).
    ct_entityset = lt_entityset.
  ENDMETHOD.


  METHOD ui5_time_name_cust.
*____HS# 016239, VON: SSINGH, DATUM: 18.01.2022___*
*___ SR2-2431, User: KSAMY_EXT, Date: 12.11.2025___*

    DATA : ls_address TYPE sdpartner_address,
           l_time     TYPE sy-uzeit,
           l_odate    TYPE sy-datum,
           l_date     TYPE char10,
           ls_kna1    TYPE kna1.

    DATA l_stamp TYPE tzonref-tstamps.

*____SR2-2431____BEGIN INSERT___*
*- Local Data Declaration(s)
    DATA:
      lt_description TYPE TABLE OF string,
      lv_crlf        TYPE string VALUE '\n'.

*- Local Constant(s)
    CONSTANTS :
      lc_book_url  TYPE string VALUE 'https://mymediset.net/booking/',
      lc_cust_name TYPE string VALUE 'Hospital : ',
      lc_surg_dt   TYPE string VALUE 'Surgery Date : ',
      lc_surg_nme  TYPE string VALUE 'Surgeon : ',
      lc_surg_typ  TYPE string VALUE 'Surgery Type : ',
      lc_booking   TYPE string VALUE 'Booking URL : '.
*____SR2-2431____END   INSERT___*


    CALL METHOD /bitmym/cl_partner=>read_customer_address
      EXPORTING
        id_kunnr   = gs_comwa-kunnr
      IMPORTING
        es_address = ls_address
        es_kna1    = ls_kna1.

    CLEAR gs_soli.
    IF ls_address-time_zone IS INITIAL.
      ls_address-time_zone = sy-zonlo.
    ENDIF.

*____SR2-2431____BEGIN COMMENT___*
*    CONVERT DATE gs_comwa-odate TIME gs_comwa-optim
*        INTO TIME STAMP l_stamp TIME ZONE ls_address-time_zone.
*    CONVERT TIME STAMP l_stamp TIME ZONE 'UTC'
*    INTO DATE gs_comwa-odate TIME l_time.
*    CONCATENATE c_dtstart gs_comwa-odate 'T' l_time 'Z' INTO gs_soli-line.
*____SR2-2431____END   COMMENT___*

*____SR2-2431____BEGIN INSERT___*
    " If the start time is initial
    " then modify to '8 AM' , keep this as common irrespective of Timezones.
    " If not, store the start time
    " provided from frontend
    IF gs_comwa-optim IS INITIAL.
      l_time = '080000'.
    ELSE.
      l_time = gs_comwa-optim.
    ENDIF.

**- Removed 'Z' after the time , to avoid auto conversion
*   of time according to the User Timezone
*   when displayed in the calender.
    CONCATENATE c_dtstart gs_comwa-odate 'T' l_time INTO gs_soli-line.
*____SR2-2431____END   INSERT___*

    l_time = l_time + 7200.
    IF l_time LT 020000.
      l_odate = gs_comwa-odate + 1.
    ELSE.
      l_odate = gs_comwa-odate.
    ENDIF.
    APPEND gs_soli TO gt_soli.
    CLEAR gs_soli.

*    CONCATENATE c_end l_odate 'T' l_time 'Z' INTO gs_soli-line. "SR2-2431 DEL
    CONCATENATE c_end l_odate 'T' l_time INTO gs_soli-line. "SR2-2431 INS ,'Z' is removed to avoid auto time conversion
    APPEND gs_soli TO gt_soli.

    CLEAR gs_soli.
    WRITE gs_comwa-odate TO l_date.
    SELECT SINGLE * FROM /bitmym/sutyp_tt INTO gs_sutyp_txt
      WHERE sutyp  = gs_comwa-sutyp AND
            spras  = sy-langu.

*    CONCATENATE c_desc TEXT-029 ls_kna1-name1 ';' TEXT-026 l_date ';' TEXT-027 gs_comwa-opman ';' TEXT-028 gs_sutyp_txt-text INTO gs_soli-line SEPARATED BY space."'DESCRIPTION: Course Participation'. "SR2-2431 DEL

*____SR2-2431____BEGIN INSERT___*
    " Prepare Attachment Description
    CLEAR gs_soli.

    " Prepare Booking URL
    DATA(lv_url) = lc_book_url && gs_comwa-zzlresn.

    " Store the description into a string table.
    APPEND |{ lc_cust_name } { ls_kna1-name1 }| TO lt_description. " Hospital Name :
    APPEND |{ lc_surg_dt } { l_date }| TO lt_description.          " Surgery Date :
    APPEND |{ lc_surg_nme } { gs_comwa-opman }| TO lt_description. " Surgeon Name :
    APPEND |{ lc_surg_typ } { gs_sutyp_txt-text }| TO lt_description. " Surgery Type :
    APPEND |{ lc_booking } { lv_url }| TO lt_description.  " Booking URL :

    " Add Attachment description to the
    " VCARD
    LOOP AT lt_description INTO DATA(lv_line).
      IF sy-tabix = 1.
        "First line: normal DESCRIPTION
        gs_soli-line =  gs_soli-line && c_desc && lv_line && lv_crlf.
      ELSE.
        "Continuation lines: prepend space
        gs_soli-line =  gs_soli-line && ' ' && lv_line && lv_crlf.
      ENDIF.
    ENDLOOP.

    APPEND gs_soli TO gt_soli.
*____SR2-2431____END   INSERT___*

  ENDMETHOD.


  METHOD ui5_s4h_release_reserv_int.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*
*___ SR1-1700, User: OOGUR, Date: 19.09.2023___*This ticket is canceled because of redesign UI5.

    DATA: ls_data_ui5 TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
          ls_tree_map TYPE /sopromet/ty_tree_map,
*          lt_zzlrsen  TYPE  /sopromet/res_tab,              "SR1-1700
*          ls_case     TYPE  /bitmym/case,                   "SR1-1700
          ls_zzlrv    TYPE /sopromet/zzlrv.



    io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    CLEAR gt_reservations.
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetoreservation MAPPING lresrv = zzlresn ).
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetosingleitem  MAPPING lresrv = lresn ).

    LOOP AT gt_reservations INTO ls_tree_map.
      CREATE OBJECT ls_tree_map-objkey EXPORTING i_zzlresn = ls_tree_map-lresrv.
      ls_tree_map-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_zzlrv ).
      gs_comwa-kunnr = ls_zzlrv-kunnr.
      ls_tree_map-objkey->release_reservation( ).
*      APPEND ls_zzlrv TO lt_zzlrsen.                        "SR1-1700
    ENDLOOP.
    IF sy-subrc = 0.
      messaging( ).
      message_update( ).
      COMMIT WORK AND WAIT.
*__Begin of inserted_______________________________________JIRA#SR1-1700
*      DATA(lo_appl) = NEW /bitmym/cl_mym(  io_ui5 = io_ui5 ).
*      set_property lo_appl 'GT_ZZLRSEN' lt_zzlrsen.
*      set_property gc_case 'GO_APPL'    lo_appl.
*      get_property gc_case 'GS_CASE'    ls_case.
**      gc_case->create_dispatch_order( EXPORTING io_ui5 = io_ui5 i_no_display = abap_true ).
*      TRY.
*          DATA(lv_vbeln) = /bitmym/cl_order=>create_dispatch_order( id_case           = ls_case-zzlrsam
*                                                                    id_vkorg          = ls_case-vkorg
*                                                                    id_no_commit      = abap_false
*                                                                    io_case           = gc_case
*                                                                    io_ui5            = io_ui5
*                                                                    i_no_display      = abap_true
*                                                                    id_suppress_popup = abap_true ).
*        CATCH cx_root.
*      ENDTRY.
*__End of inserted_________________________________________JIRA#SR1-1700
      IF ls_data_ui5 IS NOT INITIAL.
        CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.
        /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                          CHANGING cr_data = es_data ).
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD ui5_s4h_cancel_reserv_int.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*

    DATA: ls_data_ui5        TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
          lo_data_provider   TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_reservation_old TYPE /sopromet/zzlrv,
          ls_reservation     TYPE /sopromet/zzlrv,
          l_stsma            TYPE tj30-stsma.

    lo_data_provider = io_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    CLEAR gt_reservations.
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetoreservation MAPPING lresrv = zzlresn ).
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetosingleitem  MAPPING lresrv = lresn ).

    LOOP AT gt_reservations ASSIGNING FIELD-SYMBOL(<res>).
      CREATE OBJECT <res>-objkey EXPORTING i_zzlresn = <res>-lresrv.
      <res>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

      IF ls_reservation IS NOT INITIAL.
        l_stsma = <res>-objkey->get_status_schema( i_rscat = ls_reservation-rscat ).

        CALL FUNCTION '/SOPROMET/SET_STATUS_EXTERN' IN UPDATE TASK
          EXPORTING
            i_objnr = ls_reservation-objnr
            i_txt04 = /sopromet/cl_l_reservation=>c_res_status_cancelled "c_book_status_abgesagt
            i_stsma = l_stsma
          EXCEPTIONS
            OTHERS  = 1.

        ls_reservation_old   = ls_reservation.
        ls_reservation-abgru = ls_data_ui5-abgru.

        CALL FUNCTION '/SOPROMET/POST_ZZLRV' IN UPDATE TASK
          EXPORTING
            n_zzlrv = ls_reservation
            y_zzlrv = ls_reservation_old
          EXCEPTIONS
            OTHERS  = 1.

        COMMIT WORK.
      ENDIF.

      CLEAR: ls_reservation, l_stsma, ls_reservation_old.
    ENDLOOP.
    IF sy-subrc = 0 AND ls_data_ui5 IS NOT INITIAL.
      CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.
      /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                        CHANGING cr_data = es_data ).
    ENDIF.

  ENDMETHOD.


  METHOD ui5_get_consumption_ind_sb.
*____HS# 016091, VON: MKNAUER, DATUM: 24.10.2021___*
*____HS# 017105, VON: MKNAUER, DATUM: 25.07.2022___*
*___ SR1-2144, User: PKUNAL, Date: 11.01.2024___*


    DATA: ls_partner TYPE /bitmym/vbpa,
          ls_case    TYPE /bitmym/case,
          ls_monitor TYPE /bitmym/monitor.


*    CHECK io_case IS BOUND.                      "*___ SR1-2144
*    get_property io_case 'GS_CASE'   ls_case.    "*___ SR1-2144
    IF io_case IS BOUND.                          "*___ SR1-2144
      get_property io_case 'GS_CASE'   ls_case.   "*___ SR1-2144
    ELSE.                                         "*___ SR1-2144
      ls_case-vkorg = is_data-vkorg.              "*___ SR1-2144
      ls_case-zzlrsam = is_data-zzlrsam.          "*___ SR1-2144
    ENDIF.                                        "*___ SR1-2144


    CALL FUNCTION '/BITMYM/DB_READ_CASE_PARTNER'
      EXPORTING
        id_vkorg   = ls_case-vkorg
        id_case    = ls_case-zzlrsam
        id_parvw   = 'SB'
      IMPORTING
        es_partner = ls_partner.

    CHECK ls_partner IS NOT INITIAL.
*___SB Bestand vorhanden

*    SELECT * INTO ls_monitor UP TO 1 ROWS FROM  /bitmym/monitor  "HS# 17106 DEL
    SELECT SINGLE moninr  INTO ls_monitor FROM  /bitmym/monitor   "HS# 17106 INS
*      FOR ALL ENTRIES IN gt_aacl
          WHERE  status    = /bitmym/cl_monitor=>c_status_customer
          AND    kunag     = ls_partner-kunnr
*          AND    mattyp    = gt_aacl-mset_group           "HS# 17106 DEL
          AND    vkorg     = is_data-vkorg
          AND    lifnr     IN gt_range_lifnr
          AND    kzper     EQ space                        "HS# 17106 MOD
          AND    (gw_mattyp_sql).                          "HS# 17106 INS
*    ENDSELECT.                                            "HS# 17106 DEL

    CHECK sy-subrc EQ 0.

    ed_consumable = abap_true.


  ENDMETHOD.


METHOD ui5_s4h_bookings_post_list_int.
*____HS# 015080, VON: SISMAIL, DATUM: 23.03.2021___*
*____HS# 015884, VON: OPECHARROMAN, DATUM: 26.08.2021___*
*____HS# 016193, VON: GIVANOV, DATUM: 24.11.2021___*

*____HS# 015080, VON: OPECHARROMAN, DATUM: 09.12.2021___*

  DATA: lt_table TYPE /bitmym/s4h_booking_tab,
        ls_book  TYPE /bitmym/s4h_booking_st.

  CHECK go_ui5 IS NOT INITIAL.


* Get filter data from front end post call
  /bitmym/if_ui5~gv_filter_string = /bitmym/if_ui5~go_tech_request_context->/iwbep/if_mgw_req_entityset~get_osql_where_clause_convert( ).
  /bitmym/if_ui5~gv_filter_string = /bitmym/cl_ui5_filter=>filter_with_post( io_ui5 = go_ui5 ).

  ui5_s4h_booking_list_select( CHANGING ct_table = lt_table ).

* Return values
  CLEAR ls_book-filter.

  ls_book-data_value  = /ui2/cl_json=>serialize( EXPORTING data = lt_table ).


* Copy back the structre to the odataservice
  /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_book
                                                    CHANGING cr_data = er_entity ).
ENDMETHOD.


  METHOD ui5_get_mattyp_sql.
*____HS# 017105, VON: MKNAUER, DATUM: 25.07.2022___*

    DATA:  lt_range TYPE rs_t_rscedst.

    SELECT * INTO TABLE @DATA(lt_aacl) FROM /bitmym/aacl WHERE consumable = 'X'.

    LOOP AT lt_aacl ASSIGNING FIELD-SYMBOL(<wa>).
      APPEND INITIAL LINE TO lt_range  ASSIGNING FIELD-SYMBOL(<range>).
      <range>-fnam      = 'MATTYP'.
      <range>-sign      = 'I'.
      <range>-option    = 'EQ'.
      <range>-low       = <wa>-mset_group.
    ENDLOOP.

    CALL FUNCTION 'RSDS_RANGE_TO_WHERE'
      EXPORTING
        i_t_range      = lt_range
      IMPORTING
        e_where        = gw_mattyp_sql
      EXCEPTIONS
        internal_error = 1
        OTHERS         = 2.

  ENDMETHOD.


  METHOD ui5_reservation_result.
*____HS# 015081, VON: STEKDEMIR, DATUM: 15.08.2022___*


    DATA: ls_data TYPE /bitmym/cl_inspecti_mpc_ext=>ts_reservation_deep.

    CHECK /bitmym/if_ui5~go_ui5_runtime IS BOUND.           "HS 12387

    ls_data = is_data_ui5.

    ls_data-zzlresn                = gs_comwa-zzlresn.

    IF gd_simulate EQ abap_true.
      MOVE-CORRESPONDING gs_comwa TO ls_data.
*     convert dates from comwa to front end format if required.
      /bitmym/cl_ui5_util=>convert_dates_to_times( CHANGING cs_data = ls_data ).
    ENDIF.

    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data
                                                      CHANGING cr_data = es_data ).

  ENDMETHOD.


  method UI5_GET_SERIAL_NOS.
*____HS# 016199, VON: SSINGH, DATUM: 29.11.2021___*
          DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

    lo_case->ui5_bookings_get_serialno( CHANGING ct_entityset = ct_entityset ).
  endmethod.


  method UI5_RESTRICT_ORDERS.
*____HS# 016152, VON: SSINGH, DATUM: 17.11.2021___*
    DATA : ls_typeo TYPE /sopromet/rstypo,
           l_tfill  TYPE sy-tfill.
    FIELD-SYMBOLS : <ft> TYPE ANY TABLE.
    CHECK ct_table IS NOT INITIAL.
    CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
      EXPORTING
        i_rstyp = is_zzlrv-rstyp
        i_vkorg = is_zzlrv-vkorg
      IMPORTING
        e_data  = ls_typeo.
    IF ls_typeo-ic_ordernos IS NOT INITIAL.
      ls_typeo-ic_ordernos = ls_typeo-ic_ordernos + 1.
      DESCRIBE TABLE ct_table LINES l_tfill.
      IF l_tfill GT ls_typeo-ic_ordernos.
        LOOP AT ct_table ASSIGNING FIELD-SYMBOL(<fs>).
          CHECK sy-tabix GE ls_typeo-ic_ordernos.
            DELETE TABLE ct_table FROM <fs>.
        ENDLOOP.
      ENDIF.
    ENDIF.
  endmethod.


  METHOD ui5_bookings_get_serialno.
*____HS# 016200, VON: SSINGH, DATUM: 01.01.2022___*
*____HS# 017013, VON: SSINGH, DATUM: 23.06.2022___*
*___ SR2-365, User: RJANGA, Date: 11.04.2024___*
*___ SR2-900, User: OOGUR, Date: 26.09.2024___*

    DATA : ls_data   TYPE /bitmym/cl_srep_srv_vr_mpc=>ts_serialno_sh,
           ls_caller TYPE /bitmym/ui5p,
           lo_equi   TYPE REF TO /sopromet/cl_l_equipment,
           ls_equi   TYPE rihequi,
           l_parvw   TYPE parvw VALUE 'YS'.

    DATA : lt_atp_materials TYPE /sopromet/zzls07_tab,
           lo_barc          TYPE REF TO /bitmym/cl_bar_chart,
           lo_mym           TYPE REF TO /bitmym/cl_mym,
           lt_atp_item      TYPE /sopromet/lsatp_alv_item_tab,
           ls_comwa         TYPE /sopromet/zzls01.
    IF go_ui5 IS BOUND.
      go_ui5->ui5_filter2struct( CHANGING cs_struct = ls_data ).
      get_property go_ui5 'GS_CALLER' ls_caller.
    ENDIF.

ENHANCEMENT-POINT GET_SERIAL_NOS SPOTS /BITMYM/CL_CASE .
    CHECK ls_data-mattyp = /bitmym/cl_assortment=>c_type_set.
    APPEND INITIAL LINE TO lt_atp_materials ASSIGNING FIELD-SYMBOL(<fs_mat>).
    <fs_mat>-matnr = ls_data-matnr.
    get_property go_appl 'GS_COMWA' ls_comwa.
    MOVE-CORRESPONDING ls_data TO ls_comwa.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = ls_comwa-kunnr
      IMPORTING
        output = ls_comwa-kunnr.
    set_property go_appl 'GS_COMWA' ls_comwa.
    gs_comwa-kunnr = ls_comwa-kunnr. "New Sold To
    gs_comwa-kunwe = space.
    go_partner = /bitmym/cl_partner=>create( io_case = me ).
    CHECK ui5_prep_booking_partner( ) EQ abap_true.
*   HS 17013
ENHANCEMENT-POINT UPDATE_PARTNER SPOTS /BITMYM/CL_CASE .
    go_partner->set_fld_inv_cust_range( ).

    compute_dates( CHANGING cs_comwa = ls_comwa ).
    set_property go_appl 'GO_CASE' me.
    set_property go_appl 'GS_COMWA' ls_comwa.

    /bitmym/cl_bar_chart=>display_atp_from_case( EXPORTING io_case          = me
                                                           i_fieldinv       = 'X'
                                                           i_view_type      = /bitmym/cl_bar_chart=>c_view_alv
                                                           io_ui5           = go_ui5
                                                           it_atp_materials = lt_atp_materials ).

    CHECK go_ui5 IS BOUND.
    get_property go_ui5 'GO_MYM'       lo_mym.
    CHECK lo_mym IS BOUND.
    get_property lo_mym 'GO_BARC'      lo_barc.
    CHECK lo_barc IS BOUND.
    get_property lo_barc 'GT_ATP_ITEM' lt_atp_item.

*___Get SalesRep ID

    IF lt_atp_item IS NOT INITIAL.                                           "SR2-365
      SELECT * INTO TABLE @DATA(lt_ihpa) FROM
            /bitmym/ihpa FOR ALL ENTRIES IN @lt_atp_item
           WHERE parvw = @/bitmym/if_ui5~gv_parvw
             AND objnr = @lt_atp_item-objnr.
    ENDIF.                                                                  "SR2-365

    DATA(lv_field_inv_model) =  go_application->check_field_inv_model( ) .  "SR2-900

    LOOP AT lt_atp_item ASSIGNING FIELD-SYMBOL(<fs_atp>).
      APPEND INITIAL LINE TO ct_entityset ASSIGNING FIELD-SYMBOL(<fs_entity>).
      MOVE-CORRESPONDING <fs_atp> TO <fs_entity>.
*___Add SalesRep Name
      READ TABLE lt_ihpa ASSIGNING FIELD-SYMBOL(<ihpa>) WITH KEY objnr = <fs_atp>-objnr.
      IF sy-subrc EQ 0.
        <fs_entity>-srep_name = <ihpa>-name1.
      ENDIF.
*     add object type
      lo_equi = /sopromet/cl_l_equipment=>create( i_equi = <fs_atp>-equnr io_ui5 = go_ui5 ).
      get_property lo_equi 'G_EQUI_DATA' ls_equi.
      <fs_entity>-eqart = ls_equi-eqart.
      <fs_entity>-eartx = lo_equi->get_eartx( ).

*____SR2-900____BEGIN INSERT___*
*     If the new field inventory model 'A' is active, system must check if there's any temporary field inventory set in the list sent to frontend.
*     Temporary field inv sets are warehouse sets, shipped to hospitals to support surgeries managed by the distributor / agent.
*     These temporary sets should be back to warehouse after a short time, so it's important to display extra information in the frontend mobile,
*     to make mobile user aware that those sets are not their own permanent field inventory stock, they're just temporary
      IF lv_field_inv_model = /bitmym/cl_mym=>c_field_inv_model.
        IF ui5_add_fld_inv_infos( EXPORTING io_equi = lo_equi is_dates = <fs_atp>-dates CHANGING cv_abdat = <fs_entity>-abdat ) EQ abap_false.
*         If the ship-to of the new booking being created in the mobile, is different than the ship-to where the temp field inv set is located
*         then system won't display this set as available for the new booking
          DELETE TABLE ct_entityset FROM <fs_entity>.
        ENDIF.
      ENDIF.
*____SR2-900____END   INSERT___*

    ENDLOOP.

  ENDMETHOD.


  METHOD UI5_POST_RESERVATION.
*____HS# 015081, VON: STEKDEMIR, DATUM: 15.08.2022___*

    ed_success = abap_false.

    MOVE-CORRESPONDING gs_comwa TO gs_case.   "Fill CASE Structure
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    CHECK case_save_final_check( ) EQ abap_true.

    IF gd_simulate EQ abap_false.
      messaging( ).
      case_save_all( ).
    ENDIF.

    ed_success = abap_true.

  ENDMETHOD.


  METHOD ui5_cancel_booking.
*____HS# 015953, VON: SSINGH, DATUM: 16.09.2021___*
*___ SR2-877, User: SCOSAR, Date: 18.09.2024___*
*___ SR2-721, User: SCOSAR, Date: 19.09.2024___*

    DATA : lo_case TYPE REF TO /bitmym/cl_case,
           ls_res  TYPE /sopromet/ty_tree_map,
           lo_res  TYPE REF TO /sopromet/cl_l_reservation.


    lo_case = /bitmym/cl_case=>create( id_reservation = i_lresn io_ui5 = io_ui5 ).
    READ TABLE lo_case->gt_reservations INTO ls_res WITH KEY lresrv = i_lresn.
    CHECK sy-subrc = 0.
    lo_res = ls_res-objkey.
    CHECK lo_res IS BOUND.
*____SR2-877____BEGIN INSERT___*
    IF i_abgru IS NOT INITIAL.
      set_property lo_res 'G_ABGRU' i_abgru.
    ENDIF.
*____SR2-877____END   INSERT___*

    set_property lo_res 'GO_CASE' lo_case. "SR2-721


    IF lo_res->cancel_booking( ) EQ abap_false.
      /bitmym/cl_message=>message( id = 'E005(/SOPROMET/ZL)' v1 = TEXT-010 ).
    ENDIF.
  ENDMETHOD.


  METHOD stz_prepare_res_data_h.
*____HS# 015932, VON: STAORI, DATUM: 24.11.2021___*

    DATA: ls_res       TYPE /sopromet/zzlrv,
          ls_comwa     TYPE /sopromet/zzls01,
          ls_comwa_sav TYPE /sopromet/zzls01,
          ls_rstype    TYPE /sopromet/rstype,
          lo_rstyp     TYPE REF TO /sopromet/cl_l_res_type.

    FIELD-SYMBOLS: <mat> LIKE LINE OF gt_mat_selection.


    CHECK  go_act_reservation IS NOT INITIAL AND gs_comwa-rscat = '' AND
           gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.

    go_act_reservation->get_reservation_data(
       IMPORTING
         e_reservation = ls_res ).

    CHECK ls_res-stz_source IS NOT INITIAL.

    MOVE-CORRESPONDING ls_res TO cs_comwa.

  ENDMETHOD.


  method UI5_SET_DELE_FLAG.
*____HS# 015953, VON: SSINGH, DATUM: 16.09.2021___*

    CHECK  cs_data-txt04 = /sopromet/cl_l_reservation=>c_book_status_angelegt.
    cs_data-dele_flag = abap_true.
  endmethod.


  METHOD ui5_trigger_outlook_notif.
**____HS# 016239, VON: SSINGH, DATUM: 06.12.2021___*
*___ SR2-2431, User: KSAMY_EXT, Date: 11.11.2025___*

*    DATA : l_name TYPE name1. "SR2-2431 DEL
    DATA : l_name TYPE i_customer-organizationbpname1. "SR2-2431 INS
    DATA: bcs_exception      TYPE REF TO cx_bcs.
    DATA: sent_to_all        TYPE os_boolean.
    DATA: it_content TYPE soli_tab,
          l_date     TYPE char10,
          l_booking  TYPE /sopromet/zzlresn.
    DATA: lt_soli_new        TYPE soli_tab.
    DATA: it_attach          TYPE soli_tab.
    DATA: document           TYPE REF TO cl_document_bcs.
    DATA: sender TYPE REF TO cl_sapuser_bcs,
          l_sub  TYPE sood-objdes.
    DATA: l_subject          TYPE sodocchgi1-obj_descr.

    CHECK go_ui5 IS BOUND.
    CHECK gs_comwa-rscat = 'B'.
    CHECK gs_comwa-clini_supp = 'X'.
    CHECK gd_simulate = abap_false.
    ui5_populate_calender( ).

** Call this function module to convert data created for calendar entry
**
    CALL FUNCTION 'SO_RAW_TO_RTF'
      TABLES
        objcont_old = gt_soli[]
        objcont_new = lt_soli_new[].
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        input  = gs_comwa-zzlresn
      IMPORTING
        output = l_booking.

*____SR2-2431____BEGIN COMMENT___*
*    CONCATENATE TEXT-022 l_booking INTO l_subject SEPARATED BY space."'Course Participation'.
*    CLEAR gs_soli.
*    SELECT SINGLE name1 INTO (l_name) FROM kna1 WHERE kunnr = gs_comwa-kunnr.
*____SR2-2431____END   COMMENT___*

*____SR2-2431____BEGIN INSERT___*
    SELECT SINGLE OrganizationBPName1 INTO @l_name FROM i_customer WHERE Customer = @gs_comwa-kunnr.
    CONCATENATE TEXT-022 l_booking ' - ' l_name INTO l_subject SEPARATED BY space."'Course Participation'.
    CLEAR gs_soli.
*____SR2-2431____END   INSERT___*

    CONCATENATE TEXT-023 l_booking TEXT-024 l_name TEXT-025 INTO gs_soli-line SEPARATED BY space.
    APPEND gs_soli TO it_content.
    CLEAR gs_soli.
    APPEND gs_soli TO it_content.
    WRITE gs_comwa-odate TO l_date.
    CONCATENATE TEXT-026 l_date INTO gs_soli-line SEPARATED BY space.
    APPEND gs_soli TO it_content.
    CLEAR gs_soli.
    CONCATENATE TEXT-027 gs_comwa-opman INTO gs_soli-line SEPARATED BY space.
    APPEND gs_soli TO it_content.
    CLEAR gs_soli.
    CONCATENATE TEXT-028 gs_sutyp_txt-text INTO gs_soli-line SEPARATED BY space.
    APPEND gs_soli TO it_content.

    TRY.
        go_request = cl_bcs=>create_persistent( ).
        CHECK ui5_get_email_ids( ) EQ abap_true.
        document = cl_document_bcs=>create_document(
                                      i_type    = 'RAW'
                                      i_text = it_content[]
                                      i_subject = l_subject ).
        DESCRIBE TABLE gt_soli.
        l_sub = gs_comwa-zzlresn.
        CALL METHOD document->add_attachment
          EXPORTING
            i_attachment_type    = 'VCS'
            i_attachment_subject = l_sub
            i_att_content_text   = lt_soli_new[].
* Add document to send request
        CALL METHOD go_request->set_document( document ).
* Get sender object
        sender = cl_sapuser_bcs=>create( sy-uname ).
* Add sender
        CALL METHOD go_request->set_sender
          EXPORTING
            i_sender = sender.

        go_request->set_send_immediately( 'X' ).
        CALL METHOD go_request->send(
          EXPORTING
            i_with_error_screen = 'X'
          RECEIVING
            result              = sent_to_all ).
        IF sent_to_all = 'X'.
          /bitmym/cl_message=>message( id = 'S692(/SOPROMET/ZL)'  ).
        ENDIF.
        COMMIT WORK.
      CATCH cx_document_bcs INTO bcs_exception.
        /bitmym/cl_message=>message( id = 'E693(/SOPROMET/ZL)'  ).
        EXIT.
    ENDTRY.
  ENDMETHOD.


method cc_create_case.
*____HS# 016475, VON: SISMAIL, DATUM: 14.02.2022___*

  data: ls_data       type /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep.

  data: ls_case       type /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case,
        ls_comwa_appl type /sopromet/zzls01.

*___Step 1: Get ODATA Context from data provider object
  check io_provider is bound.

  io_provider->read_entry_data( importing es_data = ls_data ).

  move-corresponding ls_data to ls_case.
  move-corresponding ls_case to gs_comwa.

  gs_comwa-kzper = /sopromet/cl_l_reservation=>c_pend_type_cyclecount.

*___Step 2: Fill CASE COMWA + APPL COMWA
  get_property go_appl 'GS_COMWA' ls_comwa_appl .

*ENHANCEMENT-POINT fill_comwa_cust_field SPOTS /bitmym/cl_case .

  gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.

  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
  CHECK prep_case_partner_generic( ) EQ abap_true.  "it_partners = ls_data-casetopartner

  set_mig_dates_user_exit( exporting is_case = ls_case
                                     is_data = ls_data
                           changing cs_comwa = gs_comwa ).

  set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 5: Add Equipment Selection
  check ui5_prep_equi_sel( it_matsel = ls_data-casetomaterialselection ) eq abap_true.

*___Step 6: Overwrite determined Shipping Information
  ui5_overwrite_values( i_case = ls_case ).

*___Step 7: Init sequence for a new case
  if  gs_comwa-zzlrsam is initial.
    create_new_case( id_no_atp = abap_true ).
  endif.

*___Step 8: Build Tree
  ui5_prep_reservation_tree( ).

*___Step 9: Prepare Single Items
  ui5_prep_single_items( changing ct_items   = ls_data-casetosingleitem ).

*___Step 10: Prepare Text. Call standard text routines used in booking creation
  ui5_prep_booking_notes( it_notes = ls_data-casetonotes ).

*___Step 11: Post Reservation
  check ui5_post_case( ) eq abap_true.

  es_data = ls_data.

*___Step 12: Fill Return Data
  mig_case_result( changing es_data = es_data ).

endmethod.


  method cc_set_checked.
*____HS# 016475, VON: SISMAIL, DATUM: 18.04.2022___*


    data: lt_ret_items type /bitmym/retitems_alv_tab,
          lo_appl      type ref to /bitmym/cl_mym,
          lv_error     type abap_bool,
          ld_success   type abap_bool.

    rd_success = abap_false.

    read table gt_reservations assigning field-symbol(<lfs_res>) with key lresrv = id_lresn.

    check sy-subrc = 0.

    set_property go_appl 'GO_CASE' me.
    go_act_reservation = <lfs_res>-objkey.



    loop at ct_ret assigning field-symbol(<fs_ret>).
      append initial line to lt_ret_items assigning field-symbol(<fs_ret_items>).
      move-corresponding <fs_ret> to <fs_ret_items>.

      <fs_ret>-menge_mi = <fs_ret>-menge_wa
        - <fs_ret>-menge_we.
      <fs_ret_items>-menge_mi = <fs_ret_items>-menge_wa
        - <fs_ret_items>-menge_we.

    endloop.

    go_act_reservation->set_property(
  exporting
    i_feld  =  'GO_APPLICATION'               " Zu änderndes Feld
    i_value =  go_appl                " Neuer Feldwert
).

    go_act_reservation->set_property(
      exporting
        i_feld  =  'G_RESERVATION_ITEMS_RET'               " Zu änderndes Feld
        i_value =  ct_ret                " Neuer Feldwert
    ).

    go_act_reservation->set_property(
      exporting
        i_feld  =  'GT_RETITEMS_ALV'               " Zu änderndes Feld
        i_value =  lt_ret_items                " Neuer Feldwert
    ).

    go_act_reservation->set_property(
      exporting
        i_feld  =  'GD_WE_DATA_CHANGED'               " Zu änderndes Feld
        i_value =  abap_true                " Neuer Feldwert
    ).

    we_save( exporting id_leave_screen = abap_false id_nocommit = abap_true ).
    go_act_reservation->return_items_post( importing e_mm_posting_error = lv_error ).
    check lv_error is initial.

*____Prüfungsvorgang beenden (Setzt commit work ab)
    call function '/SOPROMET/COMPLETE_CHECK'
      exporting
        i_reservierung = id_lresn
        o_reservation  = go_act_reservation
        io_mym         = go_appl
        iv_no_commit   = abap_true
*    changing
*       c_complete     = g_reservation-kompl
      exceptions
        others         = 1.

*    go_act_reservation->set_status( i_status = /sopromet/cl_l_reservation=>c_res_status_cleaned ).
*    go_act_reservation->set_status( i_status = /sopromet/cl_l_reservation=>c_res_status_geprueft ).

enhancement-point cc_set_checked_01 spots /bitmym/cl_case .

    rd_success = abap_true.

  endmethod.


  METHOD ui5_s4h_cancel_reservation.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*

    DATA: lo_case     TYPE REF TO /bitmym/cl_case.

    SELECT SINGLE COUNT( * )
      FROM /sopromet/zzlrv
      WHERE zzlrsam = @i_zzlrsam.
    CHECK sy-subrc = 0.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = i_zzlrsam io_ui5 = io_ui5 ).

*___Start processing
    IF lo_case IS NOT INITIAL.
      lo_case->ui5_s4h_cancel_reserv_int( EXPORTING io_data_provider = io_data_provider
                                           CHANGING eo_case          = lo_case
                                                    es_data          = es_data ).
    ENDIF.

  ENDMETHOD.


  METHOD booking_plant_determination.
*____HS# 016287, VON: SBADUSHA, DATUM: 14.03.2022___*

    DATA : lt_werks_so   TYPE STANDARD TABLE OF /bitmym/xwerk_so,
           lt_all_plants TYPE  /sopromet/plants.

    CHECK gs_case-rscat = /sopromet/cl_l_reservation=>c_rscat_b.
    IF gs_case-vkbur IS NOT INITIAL.
      go_salesarea->set_property( EXPORTING i_feld  = 'G_ACTUAL_VKBUR' i_value =  gs_case-vkbur ).

      go_salesarea->get_assigned_plants_sales_ofc( ).
      go_salesarea->get_property( EXPORTING i_feld  = 'GT_XWERK_SO' IMPORTING e_value = lt_werks_so ).
    ELSE.
      go_salesarea->get_property( EXPORTING i_feld  = 'G_PLANTS' IMPORTING e_value = lt_all_plants ).
      SORT lt_all_plants ASCENDING.
    ENDIF.

    CALL FUNCTION '/BITMYM/UPDATE_BOOKING_PLANTS' IN UPDATE TASK
      EXPORTING
        i_zzls01     = ls_comwa_pai
        a_zzls01     = ls_comwa_pbo
      TABLES
        it_werks_so  = lt_werks_so
        it_all_werks = lt_all_plants.
  ENDMETHOD.


  METHOD ui5_bookings_get_status.
*____HS# 016487, VON: MKNAUER, DATUM: 04.02.2022___* "SR1-568

    DATA: lt_jest  TYPE STANDARD TABLE OF jest,
          lt_jest2 TYPE /bitmym/jest_tt,
          lt_jest3 TYPE /bitmym/jest_tt,
          lt_obj   TYPE STANDARD TABLE OF jsto_pre,
          lt_tj02t TYPE STANDARD TABLE OF tj02t,
          lt_tj30t TYPE STANDARD TABLE OF tj30t,
          ls_jest  TYPE /bitmym/jest.

    FIELD-SYMBOLS: <text1> TYPE tj02t,
                   <text2> TYPE tj30t.

    check it_booking is NOT INITIAL.

    /bitmym/cl_ui5=>move_corresponding(
      EXPORTING
        id_source_data = it_booking
       IMPORTING
         ed_target_data = lt_obj ).

*___Read All Status at once
    CALL FUNCTION 'STATUS_READ_MULTI'
      EXPORTING
        only_active    = abap_true
        no_buffer_fill = abap_false
      TABLES
        objnr_tab      = lt_obj
        status         = lt_jest.

    /bitmym/cl_ui5=>move_corresponding(
       EXPORTING
         id_source_data = lt_jest
        IMPORTING
          ed_target_data = lt_jest2 ).

*___Get all status texts
    lt_jest3 = lt_jest2.

    SORT lt_jest2 BY stat.
    DELETE ADJACENT DUPLICATES FROM lt_jest2 COMPARING stat.

*___External Status Text
    SELECT * INTO TABLE lt_tj30t FROM tj30t
         FOR ALL ENTRIES IN lt_jest2
        WHERE estat = lt_jest2-stat
          AND spras = 'E'
          AND stsma = /sopromet/cl_l_reservation=>c_status_schema_book.

    LOOP AT lt_tj30t ASSIGNING <text2>.
      MOVE-CORRESPONDING <text2> TO ls_jest.
      MODIFY lt_jest3 FROM ls_jest TRANSPORTING txt04 txt30 WHERE stat = <text2>-estat.
    ENDLOOP.



    SORT lt_jest3 BY objnr.

    gt_jest_bookings = lt_jest3.



  ENDMETHOD.


  method SET_USE_PREFERRED_PLANTS.
*____HS# 015929, VON: GIVANOV, DATUM: 27.09.2021___*

    gv_use_preferred_plants = iv_preferred.

  endmethod.


  method UI5_GET_SHIPPING_CONDITION.
*____HS# 016177, VON: SSINGH, DATUM: 18.11.2021___*
*____HS# 016790, VON: SSINGH, DATUM: 29.04.2022___*
*    begin of changes HS 16790
    DATA : lt_vkvsbed   TYPE TABLE OF /bitmym/vkvsbed,
           lt_entityset TYPE /bitmym/cl_srep_srv_vr_mpc=>tt_shippingcondition.
    SELECT * FROM /bitmym/vkvsbed INTO TABLE lt_vkvsbed
      WHERE vkorg = is_rstypo-vkorg.
*    end of changes HS 16790
    SELECT * FROM tvsbt INTO CORRESPONDING FIELDS OF TABLE lt_entityset
      WHERE spras = i_langu.
*    begin of changes HS 16769
    LOOP AT lt_entityset ASSIGNING FIELD-SYMBOL(<fs_entity>).
      IF lt_vkvsbed IS NOT INITIAL.
        READ TABLE lt_vkvsbed ASSIGNING FIELD-SYMBOL(<fs_vkvsbed>) WITH KEY vsbed = <fs_entity>-vsbed.
        CHECK sy-subrc = 0.
      ENDIF.
      APPEND INITIAL LINE TO ct_entityset  ASSIGNING FIELD-SYMBOL(<entity>).
      MOVE-CORRESPONDING <fs_entity> TO <entity>.
      IF <fs_entity>-vsbed EQ is_rstypo-vsbed.
        <entity>-default = 'X'.
      ENDIF.
    ENDLOOP.
*    end of changes HS 16769
  endmethod.


  METHOD ui5_get_shipping_condition_txt.
*____HS# 016177, VON: SSINGH, DATUM: 19.11.2021___*
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*

    IF cs_data IS SUPPLIED. "SR1-2098
      SELECT SINGLE vtext FROM tvsbt INTO CORRESPONDING FIELDS OF cs_data
        WHERE spras = /bitmym/if_ui5~gd_language AND
          vsbed = cs_data-vsbeb.
* Begin of SR1-2098
    ELSE.
      SELECT SINGLE vtext FROM tvsbt INTO CORRESPONDING FIELDS OF cs_data_deep
        WHERE spras = /bitmym/if_ui5~gd_language AND
          vsbed = cs_data_deep-vsbeb.
    ENDIF.
* End of SR1-2098

  ENDMETHOD.


  METHOD ui5_add_single_items_new_res.
* .
* .
* .
*--------------------------------------------------------------------*
*___ SR2-723, User: SCOSAR, Date: 02.09.2024___*



    DATA:
      ld_check                 TYPE abap_bool,
      ls_copy_fields           TYPE /bitmym/ic_book_create_fields,
      lt_singleitems           TYPE /sopromet/ritems_tab,
      lv_add_singleitem_return TYPE abap_bool,
      lt_created_res           TYPE /sopromet/zzls03_tab,
      ls_resv_detail           TYPE /bitmym/ic_srep_reservation_st.

    DATA : lo_reservation  TYPE REF TO /sopromet/cl_l_reservation,
           lt_single_items TYPE /sopromet/ritems_tab.

    "Prepare case and appl comwa
    MOVE-CORRESPONDING is_data_ui5 TO ls_copy_fields.
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.
    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
    gs_comwa-rstyp = |{ gs_comwa-rstyp ALPHA = IN }|.
    gs_comwa-kunwe = is_data_ui5-kunwe.
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    "create tree
    ui5_prep_reservation_tree( ).

    LOOP AT is_data_ui5-reservationtosingleitems ASSIGNING FIELD-SYMBOL(<ls_singleitems>).
      APPEND INITIAL LINE TO lt_singleitems ASSIGNING FIELD-SYMBOL(<ls_singleitem_input>).
      MOVE-CORRESPONDING <ls_singleitems> TO <ls_singleitem_input>.
      IF <ls_singleitem_input>-menge IS INITIAL.
        <ls_singleitem_input>-menge = 1.
      ENDIF.
      IF <ls_singleitem_input>-meins IS INITIAL.
        DATA(l_o_mat) = /sopromet/cl_l_material=>get_ref( <ls_singleitems>-matnr ).
        DATA(l_mara)  = l_o_mat->get_mara( ).
        DATA(l_mvke) = l_o_mat->get_mvke( iv_vkorg = gs_comwa-vkorg iv_vtweg = gs_comwa-vtweg iv_spart = gs_comwa-spart ).
        <ls_singleitem_input>-meins = l_mara-meins.
        IF l_mvke-vrkme IS NOT INITIAL.
          <ls_singleitem_input>-meins = l_mvke-vrkme.
        ENDIF.
      ENDIF.

    ENDLOOP.

    "ATP before submitting
    ui5_single_items_atp_check( EXPORTING io_case = me
                                          io_appl = go_appl
                                CHANGING ct_single_items = lt_singleitems ).

    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.

    CLEAR: lv_add_singleitem_return, lt_created_res.
    lv_add_singleitem_return = add_single_parts(
      EXPORTING
        i_skip_popup        = abap_true
        i_post_single_items = abap_true
        it_singleitems      = lt_singleitems
      IMPORTING
        et_created_res      = lt_created_res
    ).
    READ TABLE lt_created_res INTO DATA(ls_created_res) INDEX 1.
    IF sy-subrc = 0.
      DATA(ls_entity) = is_data_ui5.
      ls_resv_detail = /sopromet/cl_l_reservation=>ui5_get_entity( i_lresn = ls_created_res-zzlresn
                                                                   io_ui5 = go_ui5 ).
      MOVE-CORRESPONDING ls_resv_detail TO ls_entity.

      CREATE OBJECT lo_reservation
        EXPORTING
          i_zzlresn = ls_created_res-zzlresn.
      lo_reservation->set_property( EXPORTING i_feld  = 'GO_CASE' i_value = me ).
      lo_reservation->set_property( EXPORTING i_feld  = 'GO_APPLICATION' i_value = go_appl ).

*____SR2-723____BEGIN INSERT___*
      IF NOT line_exists( gt_reservations[ lresrv = ls_created_res-zzlresn ] ).
        APPEND INITIAL LINE TO gt_reservations ASSIGNING FIELD-SYMBOL(<fs_reservation>).
        <fs_reservation> = CORRESPONDING #( ls_created_res MAPPING lresrv = zzlresn lrsam = zzlrsam ).
        <fs_reservation>-objkey = lo_reservation.
      ENDIF.
      IF /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true.
        COMMIT WORK.
      ENDIF.
*____SR2-723____END   INSERT___*


      lt_single_items = lo_reservation->get_prop_single_items( EXPORTING io_case = me i_auto_check = abap_true ).
      CLEAR ls_entity-reservationtosingleitems[].
      LOOP AT lt_single_items INTO DATA(ls_single_item).
        APPEND INITIAL LINE TO ls_entity-reservationtosingleitems ASSIGNING FIELD-SYMBOL(<ls_res_single_item>).
        MOVE-CORRESPONDING ls_single_item TO <ls_res_single_item>.
      ENDLOOP.
    ENDIF.
    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_entity
                                                     CHANGING cr_data = es_data ).
  ENDMETHOD.


  METHOD read_booking_data.
*____HS# 016372, VON: PKUNAL, DATUM: 13.01.2022___*
*____HS# 016705, VON: SBADUSHA, DATUM: 25.04.2022___*
*____HS# 017034, VON: SBADUSHA, DATUM: 06.07.2022___*
*___ SR1-1987, User: SBADUSHA, Date: 05.12.2023___*

    DATA: ls_comwa   TYPE /sopromet/zzls01,
          ls_zzlrv   TYPE /sopromet/zzlrv,
          ls_case    TYPE /bitmym/case,
          lv_no_data TYPE abap_bool.

    go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

    CHECK gs_comwa-ref_book IS NOT INITIAL.

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = gs_comwa-ref_book
      IMPORTING
        e_reservation = ls_zzlrv
        e_no_data     = lv_no_data.

    CHECK lv_no_data IS INITIAL.

    CALL FUNCTION '/BITMYM/DB_READ_CASE_SINGLE'
      EXPORTING
        id_vkorg = ls_zzlrv-vkorg
        id_case  = ls_zzlrv-zzlrsam
      IMPORTING
        es_case  = ls_case.

    ls_comwa-sutyp = ls_case-sutyp.
    ls_comwa-autlf = ls_case-autlf.   "HS# 016705.
    go_appl->set_property( EXPORTING i_feld = 'GS_COMWA' i_value = ls_comwa ).
*&* Begin of adding "SR1-1987
*   IF ls_case-contract IS NOT INITIAL.
      gs_case-contract = ls_case-contract.
      gs_case-redat = ls_case-redat.
      gs_case-rsdat = ls_case-rsdat.
      gs_case-vlaufz = ls_case-vlaufz.
      gs_case-vlauez = ls_case-vlauez.
*   ENDIF.
*&* End of Adding "SR1-1987

*&* Begin of HS HS# 017034
    derive_book_res_link( ).
*&* End of HS# 017034

  ENDMETHOD.


  METHOD ui5_s4h_bookings_get_list_text.
*____HS# 015080, VON: PKUNAL, DATUM: 14.10.2021___*
*____HS# 015080, VON: OPECHARROMAN DATUM 15.12.2021
*____HS# 017900, VON: SBADUSHA, DATUM: 23.03.2023___*

* Change method to improve perfomormance and to be able to use different entity sets

    IF et_entityset IS NOT INITIAL.

*     Sort and read with binary search to improve performance
*     Read Text for BSARK
      DATA(cond_syntax) = 'spras = @sy-langu AND bsark = @et_entityset-bsark'.
      TRY.
          SELECT * FROM t176t INTO TABLE @DATA(lt_t176t) FOR ALL ENTRIES IN @et_entityset WHERE (cond_syntax)  ORDER BY PRIMARY KEY.
        CATCH cx_sy_dynamic_osql_error.
      ENDTRY.


      cond_syntax = 'spras = @sy-langu AND abgru = @et_entityset-abgru'.
      TRY.
*     Read Text for Rejecttion Reason
          SELECT * FROM tvagt INTO TABLE @DATA(lt_tvagt) FOR ALL ENTRIES IN @et_entityset WHERE (cond_syntax) ORDER BY PRIMARY KEY.
        CATCH cx_sy_dynamic_osql_error.
      ENDTRY.

      cond_syntax = 'spras = @sy-langu AND vkgrp = @et_entityset-vkgrp'.
      TRY.
*     Read Text for Sales Group VKGRP
          SELECT * FROM tvgrt INTO TABLE @DATA(lt_tvgrt) FOR ALL ENTRIES IN @et_entityset WHERE (cond_syntax) ORDER BY PRIMARY KEY.
        CATCH cx_sy_dynamic_osql_error.
      ENDTRY.

      cond_syntax = 'spras = @sy-langu AND vkbur = @et_entityset-vkbur'.
      TRY.
*     Read Text for Sales Office
          SELECT * FROM tvkbt INTO TABLE @DATA(lt_tvkbt) FOR ALL ENTRIES IN @et_entityset WHERE (cond_syntax) ORDER BY PRIMARY KEY.
        CATCH cx_sy_dynamic_osql_error.
      ENDTRY.


      LOOP AT et_entityset ASSIGNING FIELD-SYMBOL(<bookings_ui5>).


        ASSIGN COMPONENT 'bsark' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_bsark>).
        IF sy-subrc EQ 0.
          ASSIGN COMPONENT 'bsarkdescr' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_bsarkdescr>).
          IF sy-subrc EQ 0.
*       Use field symbol assignment instead of variables to improve use of memory and performance
            READ TABLE lt_t176t ASSIGNING FIELD-SYMBOL(<fs_t176t>) WITH KEY spras = sy-langu bsark = <fs_bsark> BINARY SEARCH.
            IF sy-subrc IS INITIAL.
              <fs_bsarkdescr> = <fs_t176t>-vtext.
            ENDIF.
          ENDIF.
        ENDIF.

        ASSIGN COMPONENT 'abgru' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_abgru>).
        IF sy-subrc EQ 0.
          ASSIGN COMPONENT 'abgrudescr' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_abgrudescr>).
          IF sy-subrc EQ 0.
            READ TABLE lt_tvagt ASSIGNING FIELD-SYMBOL(<fs_tvagt>) WITH KEY spras = sy-langu  abgru = <fs_abgru> BINARY SEARCH.
            IF sy-subrc IS INITIAL.
              <fs_abgrudescr> = <fs_tvagt>-bezei.
            ENDIF.
          ENDIF.
        ENDIF.

        ASSIGN COMPONENT 'vkgrp' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_vkgrp>).
        IF sy-subrc EQ 0.
          ASSIGN COMPONENT 'vkgrpdescr' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_vkgrpdescr>).
          IF sy-subrc EQ 0.
*     assign text for vkgrp
            READ TABLE lt_tvgrt ASSIGNING FIELD-SYMBOL(<fs_tvgrt>) WITH KEY spras = sy-langu vkgrp = <fs_vkgrp> BINARY SEARCH.
            IF sy-subrc IS INITIAL.
              <fs_vkgrpdescr> = <fs_tvgrt>-bezei.
            ENDIF.
          ENDIF.
        ENDIF.

        ASSIGN COMPONENT 'vkbur' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_vkbur>).
        IF sy-subrc EQ 0.
          ASSIGN COMPONENT 'vkburdescr' OF STRUCTURE <bookings_ui5> TO FIELD-SYMBOL(<fs_vkburdescr>).
          IF sy-subrc EQ 0.
            READ TABLE lt_tvkbt ASSIGNING FIELD-SYMBOL(<fs_tvkbt>) WITH KEY spras = sy-langu vkbur = <fs_vkbur> BINARY SEARCH.
            IF sy-subrc IS INITIAL.
              <fs_vkburdescr> = <fs_tvkbt>-bezei.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF er_entity IS NOT INITIAL.

*     Changed selection from * to the required symbol to improve use of memory and performance
      ASSIGN COMPONENT 'BSARK' OF STRUCTURE er_entity TO <fs_bsark>.
      IF sy-subrc EQ 0.
*     Read Text for BSARK
        SELECT SINGLE vtext FROM t176t INTO @DATA(ls_t176t) WHERE bsark = @<fs_bsark> AND spras = @sy-langu.
      ENDIF.

      ASSIGN COMPONENT 'ABGRU' OF STRUCTURE er_entity TO <fs_abgru>.
      IF sy-subrc EQ 0.
*     Read Text for Rejecttion Reason
        SELECT SINGLE bezei FROM tvagt INTO @DATA(ls_tvagt)  WHERE abgru = @<fs_abgru> AND spras = @sy-langu.
      ENDIF.

      ASSIGN COMPONENT 'vkgrp' OF STRUCTURE er_entity TO <fs_vkgrp>.
      IF sy-subrc EQ 0.
*     Read Text for Sales Group VKGRP
        SELECT SINGLE bezei FROM tvgrt INTO @DATA(ls_tvgrt)  WHERE vkgrp = @<fs_vkgrp> AND spras = @sy-langu.
      ENDIF.

*      ASSIGN COMPONENT 'vkgrp' OF STRUCTURE er_entity TO <fs_vkbur>. "HS# 17900-
      ASSIGN COMPONENT 'VKBUR' OF STRUCTURE er_entity TO <fs_vkbur>. "HS# 17900+
      IF sy-subrc EQ 0.
*     Read Text for Sales Office
        SELECT SINGLE bezei FROM tvkbt INTO @DATA(ls_tvkbt)  WHERE vkbur = @<fs_vkbur> AND spras = @sy-langu.
      ENDIF.

      ASSIGN COMPONENT 'bsarkdescr' OF STRUCTURE er_entity TO <fs_bsarkdescr>.
      IF sy-subrc EQ 0.
        <fs_bsarkdescr> = ls_t176t.
      ENDIF.

      ASSIGN COMPONENT 'abgrudescr' OF STRUCTURE er_entity TO <fs_abgrudescr>.
      IF sy-subrc EQ 0.
        <fs_abgrudescr> = ls_tvagt.
      ENDIF.

      ASSIGN COMPONENT 'vkgrpdescr' OF STRUCTURE er_entity TO <fs_vkgrpdescr>.
      IF sy-subrc EQ 0.
        <fs_vkgrpdescr> = ls_tvgrt.
      ENDIF.

      ASSIGN COMPONENT 'vkburdescr' OF STRUCTURE er_entity TO <fs_vkburdescr>.
      IF sy-subrc EQ 0.
        <fs_vkburdescr> = ls_tvkbt.
      ENDIF.

*&* Begin of HS# 17900+
      ASSIGN COMPONENT 'SUTYP' OF STRUCTURE er_entity TO FIELD-SYMBOL(<fs_sutyp>).
      IF sy-subrc = 0.
        SELECT SINGLE text FROM /bitmym/sutyp_tt INTO @DATA(ls_sutypt) WHERE sutyp = @<fs_sutyp> AND spras = @sy-langu.
      ENDIF.

      ASSIGN COMPONENT 'SUTYPDESC' OF STRUCTURE er_entity TO FIELD-SYMBOL(<fs_sutypdesc>).
      IF sy-subrc = 0.
        <fs_sutypdesc> = ls_sutypt.
      ENDIF.
*&* End of HS# 17900+
    ENDIF.

  ENDMETHOD.


  method UI5_GET_SINGLE_ITEM_PLANT.
*____HS# 015080, VON: SSINGH, DATUM: 15.02.2022___*
    DATA : l_kunnr TYPE kunnr,
           ls_knvv TYPE knvv.

    l_kunnr = gs_comwa-kunnr.

    IF l_kunnr IS NOT INITIAL.
      CALL FUNCTION 'KNVV_SINGLE_READ'
        EXPORTING
          i_kunnr         = l_kunnr
          i_vkorg         = gs_comwa-vkorg
          i_vtweg         = gs_comwa-vtweg
          i_spart         = gs_comwa-spart
        IMPORTING
          o_knvv          = ls_knvv
        EXCEPTIONS
          not_found       = 1
          parameter_error = 2
          OTHERS          = 3.
    ENDIF.
    IF ls_knvv-vwerk IS NOT INITIAL.
      ed_werks = ls_knvv-vwerk.
    ENDIF.
    CHECK ed_werks IS INITIAL.

    ed_werks = gs_comwa-werks.

  endmethod.


  METHOD ui5_s4h_release_reservation.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*
*___ SR1-1700, User: OOGUR, Date: 19.09.2023___*This ticket is canceled because of redesign UI5


    DATA: lo_case     TYPE REF TO /bitmym/cl_case.

    SELECT SINGLE COUNT( * )
      FROM /sopromet/zzlrv
      WHERE zzlrsam = @i_zzlrsam.
    CHECK sy-subrc = 0.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = i_zzlrsam io_ui5 = io_ui5 ).

*___Start processing
    IF lo_case IS NOT INITIAL.
      lo_case->ui5_s4h_release_reserv_int( EXPORTING io_data_provider = io_data_provider
                                                     gc_case          = lo_case
*                                                     io_ui5           = io_ui5    "SR1-1700
                                            CHANGING es_data          = es_data ).
    ENDIF.

  ENDMETHOD.


  method cc_add_items.
*____HS# 016475, VON: SISMAIL, DATUM: 18.04.2022___*
*____HS# 016751, VON: SISMAIL, DATUM: 18.06.2022___*
*____HS# 016950, VON: SISMAIL, DATUM: 08.11.2022___*

    data: lt_ret_items type /bitmym/retitems_alv_tab,
          lo_appl      type ref to /bitmym/cl_mym,
          lv_error     type abap_bool,
          lo_add_res   type ref to /sopromet/cl_l_reservation,
          ld_equnr     type equnr,
          lv_add_res   type /sopromet/zzlresn,
          lv_ustatus   type j_txt04,
          lv_posnr     type posnr,
          lt_res_items type /sopromet/res_items.

*    /sopromet/cl_l_message_collect=>suspend( ).

    read table gt_reservations assigning field-symbol(<lfs_res>) with key lresrv = id_lresn.

    check sy-subrc = 0.

    loop at gt_reservations assigning field-symbol(<lfs_res1>)
        where kzper = /sopromet/cl_l_reservation=>c_pend_type_additional.
      "Check if an additional item reserv exists for that reservation
      <lfs_res1>-objkey->get_property( exporting i_feld = 'G_RESERVATION-EQUNR_SRC' importing e_value = ld_equnr ).
      lv_ustatus = <lfs_res1>-objkey->get_user_status( ).
      if id_equnr = ld_equnr
          and lv_ustatus = /sopromet/cl_l_reservation=>c_res_status_zurueck.
        lo_add_res = <lfs_res1>-objkey.
        exit.
      endif.
    endloop.

    if lo_add_res is initial.
      set_property go_appl 'GO_CASE' me.
      go_act_reservation = <lfs_res>-objkey.
      ui5_prep_reservation_tree( i_add_res = abap_true ).
      lo_add_res = we_add_itm_reserv_add( ).
    endif.

    check lo_add_res is bound.

    go_act_reservation = lo_add_res.

    get_property lo_add_res 'G_RESERVATION-ZZLRESN' lv_add_res.
    get_property lo_add_res 'G_RESERVATION_ITEMS_RET' lt_res_items.

    sort lt_res_items descending by posnr.
    read table lt_res_items into data(ls_res_items) index 1.
    if sy-subrc ne 0.
      lv_posnr = 0.
    else.
      lv_posnr = ls_res_items-posnr.
    endif.

    loop at ct_ret assigning field-symbol(<fs_ret>).
      lv_posnr = lv_posnr + 10.
      <fs_ret>-posnr = lv_posnr.
      <fs_ret>-zzlresn = lv_add_res.
    endloop.

    set_property lo_add_res 'G_RESERVATION_ITEMS_RET' ct_ret.

    move-corresponding ct_ret to lt_ret_items.

    lo_add_res->set_property(
      exporting
        i_feld  =  'GT_RETITEMS_ALV'               " Zu änderndes Feld
        i_value =  lt_ret_items                " Neuer Feldwert
    ).

    we_save( exporting id_leave_screen = abap_false id_nocommit = abap_true ).

    lo_add_res->single_items_post( abap_false ).

    get_property lo_add_res 'G_ERROR_MM_POSTING' lv_error.
    check lv_error is initial.

*&*HS# 016752+
enhancement-section cc_add_items_02 spots /bitmym/cl_case .
    if gs_ccpropso-auto_extend = abap_false.
      rd_success = abap_true.
      exit.
    endif.
*    check lo_add_res->extend_bom( importing ed_vbeln = ed_vbeln  ) eq abap_true. "HS# 016950-
    check lo_add_res->extend_bom( exporting id_from_cc = abap_true importing ed_vbeln = ed_vbeln  ) eq abap_true. "HS# 016950+

    lo_add_res->set_status( i_status = /sopromet/cl_l_reservation=>c_res_status_cleaned ).
    lo_add_res->set_status( i_status = /sopromet/cl_l_reservation=>c_res_status_geprueft ).
end-enhancement-section.
*&*HS# 016752+

enhancement-point cc_add_items_01 spots /bitmym/cl_case .

    rd_success = abap_true.

  endmethod.


  method SIMULATE_KE_ORDER.
*____HS# 015854, VON: STAORI, DATUM: 09.02.2022___*

    DATA: ls_comwa TYPE /sopromet/zzls01.

    go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

    /bitmym/cl_initial_kb=>ke_pricing_simulation_ext(
      EXPORTING
        id_booking     = gs_comwa-zzlresn                  " Booking
        io_area        = go_salesarea
        is_comwa_appl  = ls_comwa
        id_alv_display = abap_true ).
  endmethod.


METHOD call_reallocate_ref_equi.
*____HS# 016900, VON: OPECHARROMAN, DATUM: 14.02.2022___*
*___ SR2-473, User: GIVANOV, Date: 17.05.2024___*
*___ SR2-595, User: XLI, Date: 29.08.2024___*
*___ SR2-1942, User: SCOSAR, Date: 25.06.2025___*
*___ SR2-2075, User: SCOSAR, Date: 16.07.2025___*

  DATA: ls_common TYPE /bitmym/case_common,
        ls_comwa  TYPE /sopromet/zzls01,
        lt_res    TYPE /bitmym/zzlrsen_tab,
        lo_book   TYPE REF TO /sopromet/cl_l_reservation,
        lo_equi   TYPE REF TO /sopromet/cl_l_equipment.
  DATA: lv_v2    TYPE equnr. "SR2-595
  ed_atp_done = abap_false.
  CHECK go_act_reservation IS NOT INITIAL.

  go_act_reservation->get_reservation_data( IMPORTING e_reservation = DATA(ls_res) ).
  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

  CLEAR ls_comwa-kzsir.
  MOVE-CORRESPONDING ls_res TO ls_common.

  MOVE-CORRESPONDING ls_common TO ls_comwa.

  ls_comwa-matnr = ls_res-matnr.
  ls_comwa-kunnr = ls_res-kunnr.
  ls_comwa-kunnr_sb = ls_res-kunnr_sb.
  go_appl->set_property( i_feld = 'gs_comwa' i_value = ls_comwa ).

  CLEAR gt_sel_matnr[] .
  set_property go_appl 'GT_SEL_MATNR' gt_sel_matnr.

  CHECK go_appl->check_material_selected( ) EQ abap_true.

  DATA(ls_rstype) = /sopromet/cl_l_res_type=>create( i_vkorg = ls_res-vkorg i_rstyp = ls_res-rstyp )->get_rstype_field_inv( ).
  IF ls_rstype IS NOT INITIAL.
    DATA(ld_rstyp_fld) = abap_true.

  ENDIF.

  DATA(lt_auswahl) = /bitmym/cl_bar_chart=>display_atp_from_case( io_case = me ).

*___ SR2-473 Enhancment point added
ENHANCEMENT-POINT CALL_REALLOCATE_REF_EQUI SPOTS /BITMYM/CL_CASE .


*__Check if the reservation is cancelled in the ATP screen itself
  go_barc->get_property( EXPORTING i_feld = 'GS_COMWA-ABGRU' IMPORTING e_value = ls_comwa-abgru ).


  IF lt_auswahl IS NOT INITIAL.

    LOOP AT lt_auswahl ASSIGNING FIELD-SYMBOL(<fs_sets>).

      CREATE OBJECT lo_equi
        EXPORTING
          i_equnr = <fs_sets>-equnr.

      DATA(ls_equi_data) = lo_equi->exp_equi_data( ).

      IF ls_equi_data-equnr EQ ls_res-equnr.
        CLEAR ls_equi_data.
        DATA(ld_error) = abap_true.
        EXIT.
      ENDIF.

      CALL FUNCTION '/BITMYM/UPDATE_EQUNR_ZZLRV' IN UPDATE TASK
        EXPORTING
          id_lresn = ls_res-zzlresn
          id_equnr = ls_equi_data-equnr
          id_sernr = ls_equi_data-sernr
          id_eqktx = ls_equi_data-eqktx.

*     Field inventory reservation, put in customer status.
      IF ls_rstype-rstyp IS NOT INITIAL AND <fs_sets>-field_inv EQ abap_true.

        go_act_reservation->set_status( i_no_update  = abap_true i_status = /sopromet/cl_l_reservation=>c_res_status_kunde ).
        DATA(lo_cons) = lo_equi->get_current_reservation( 'ATP' ).
        IF lo_cons IS NOT INITIAL.
          lo_cons->get_reservation_data( IMPORTING e_reservation = DATA(ls_cons) ).
          IF ls_cons-zzlresn IS INITIAL.
            CLEAR ls_equi_data.
            ld_error = abap_true.
            EXIT.
          ENDIF.
          CALL FUNCTION '/BITMYM/UPDATE_RSTYP_ZZLRV' IN UPDATE TASK
            EXPORTING
              id_lresn     = ls_res-zzlresn
              id_srcrs     = ls_cons-zzlresn
              id_rstyp     = ls_rstype-rstyp
              id_field_inv = <fs_sets>-field_inv.
          ls_res-field_inv = <fs_sets>-field_inv.           "SR2-2075
        ELSE.
          CLEAR ls_equi_data.
          ld_error = abap_true.
          EXIT.

        ENDIF.

      ENDIF.

      CALL FUNCTION '/BITMYM/UPDATE_RESTAT_EQUNR' IN UPDATE TASK
        EXPORTING
          id_reservation = ls_res-zzlresn
          id_new_equnr   = ls_equi_data-equnr.

      ls_res-equnr = ls_equi_data-equnr.                    "SR2-1942
      ls_res-sernr = ls_equi_data-sernr.                    "SR2-1942
      ls_res-eqktx = ls_equi_data-eqktx.                    "SR2-1942
      go_act_reservation->set_data( is_data = VALUE #( g_reservation = ls_res ) it_fields = VALUE #( ( fieldname = 'G_RESERVATION' ) ) ). "SR2-1942

*     Only one equipment
      EXIT.
    ENDLOOP.
  ENDIF.

  IF ls_equi_data-equnr IS NOT INITIAL.
    CHECK /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true. "SR2-1942

    COMMIT WORK AND WAIT.
    ed_atp_done = abap_true.
*____SR2-595____END   INSERT___*
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        input  = ls_equi_data-equnr
      IMPORTING
        output = lv_v2.
*____SR2-595____BEGIN INSERT___*
    /bitmym/cl_message=>message( id = 'S485(/SOPROMET/ZL)' v1 = ls_res-zzlresn v2 = lv_v2 ). "SR2-595
  ELSEIF  ld_error = abap_true.
    ROLLBACK WORK.
  ENDIF.

ENDMETHOD.


METHOD reallocate_ref_equi.
*____HS# 016900, VON: OPECHARROMAN, DATUM: 14.02.2022___*

  CHECK exit_handling_case( ) EQ abap_true.

  CHECK call_reallocate_ref_equi( ) EQ abap_true.

  e_success = abap_true.
  COMMIT WORK AND WAIT.

ENDMETHOD.


METHOD create_res_after_book.
*____HS# 016491, VON: OPECHARROMAN, DATUM: 07.02.2022___*

  DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
        ls_in_data       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
        ls_out_data      TYPE REF TO data.

        gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
  set_property go_appl 'gs_comwa-trtyp_o' gs_comwa-trtyp_o.

* Get material data
  put_book_mat_to_provider( CHANGING  ct_selection = ls_in_data-casetomaterialselection  ct_single = ls_in_data-casetosingleitem  ).

  CHECK  ls_in_data-casetomaterialselection IS NOT INITIAL.


* Get info to create reservation
  MOVE-CORRESPONDING gs_comwa TO ls_in_data.
  MOVE-CORRESPONDING gs_case TO ls_in_data.

  CLEAR ls_in_data-rscat.

* Partner data
  ls_in_data-casetopartner = put_book_partners_to_provider( ).

* Build note table from the combine run texts
  IF go_texte IS BOUND.
    ls_in_data-casetonotes = go_texte->get_notes_from_sd_text( ).
  ENDIF.

* Create provider with input data
  lo_data_provider = /bitmym/cl_is_srv=>set_ui5_data_provider( is_entity = ls_in_data ).

* Create reservation with odata and provider
  /bitmym/cl_case=>create(
    io_appl = go_appl
  io_area = go_salesarea
  )->ui5_s4h_create_reservation_int( EXPORTING io_provider = lo_data_provider IMPORTING es_data = ls_out_data ).

ENDMETHOD.


  METHOD ui5_populate_calender.
*____HS# 016239, VON: SSINGH, DATUM: 08.12.2021___*
*___ SR2-2431, User: KSAMY_EXT, Date: 11.11.2025___*

    DATA :l_zeit    TYPE sy-uzeit,
          l_booking TYPE /sopromet/zzlresn,
*          l_name1   TYPE name1_gp. "SR2-2431 DEL
          l_name1   TYPE i_customer-organizationbpname1. "SR2-2431 INS


ENHANCEMENT-POINT CREATE_CALENDER_ENTRY SPOTS /BITMYM/CL_CASE .
    REFRESH gt_soli.
* Calendar logic begin
    gs_soli-line = c_calender."text-020.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_prodid."text-021.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_version."text-022.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_method.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_begin.
    APPEND gs_soli TO gt_soli.
    CLEAR gs_soli.
    ui5_time_name_cust( ).
    gs_soli-line = c_opaque.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_sequence.
    APPEND gs_soli TO gt_soli.
    CLEAR gs_soli.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        input  = gs_comwa-zzlresn
      IMPORTING
        output = l_booking.

*____SR2-2431____BEGIN COMMENT___*
*    CONCATENATE c_summary TEXT-022 l_booking INTO gs_soli-line SEPARATED BY space.
*    APPEND gs_soli TO gt_soli.
*____SR2-2431____END   COMMENT___*

*____SR2-2431____BEGIN INSERT___*
    SELECT SINGLE OrganizationBPName1 INTO @l_name1 FROM i_customer WHERE Customer = @gs_comwa-kunnr.
    CONCATENATE c_summary TEXT-022 l_booking '-' l_name1 INTO gs_soli-line SEPARATED BY space.
    APPEND gs_soli TO gt_soli.
*____SR2-2431____END   INSERT___*

    gs_soli-line = c_priority."'PRIORITY:5'.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_microsoft."'X-MICROSOFT-CDO-IMPORTANCE:1'.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_public."'CLASS:PUBLIC'.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_endevent."'END:VEVENT'.
    APPEND gs_soli TO gt_soli.
    gs_soli-line = c_endcalender."'END:VCALENDAR'.
    APPEND gs_soli TO gt_soli.
* End of Calendar
  ENDMETHOD.


METHOD get_kunnr_from_kunwe.
*____HS# 017003, VON: OPECHARROMAN, DATUM: 07.09.2022___*

  CHECK cs_comwa-kunwe IS NOT INITIAL.

* if partner object is initial, create
  IF go_partner IS INITIAL.
    gs_comwa-kunwe = cs_comwa-kunwe.
    go_partner = /bitmym/cl_partner=>create( io_case = me ).
  ENDIF.

* Get partner from kunwe
  go_appl->pai_kunwe_input( is_comwa = cs_comwa id_no_dialog = id_no_dialog ).

* Return to screen
  IF gs_comwa-kunnr IS NOT INITIAL.
    cs_comwa-kunnr = gs_comwa-kunnr.
  ENDIF.
ENDMETHOD.


  METHOD ui5_filter_booking.
*____HS# 017238, VON: MKNAUER, DATUM: 26.08.2022___*

    DATA: ld_stat  TYPE jstat-stat,
          ld_txt04 TYPE j_txt04.

ENHANCEMENT-POINT PRE_LOOP_FILTER SPOTS /BITMYM/CL_CASE .

    LOOP AT ct_bookings ASSIGNING FIELD-SYMBOL(<booking>).
      DATA(lt_jest) = FILTER #( gt_jest_bookings USING KEY objnr WHERE objnr = <booking>-objnr  ).

      CALL FUNCTION '/SOPROMET/STATUS_READ'
        EXPORTING
          i_objnr             = <booking>-objnr
          i_status            = 'E'
          i_no_status_refresh = abap_true
          i_only_active       = abap_true
          it_jest             = lt_jest
        IMPORTING
          e_stat              = ld_stat
          e_txt04             = ld_txt04.

ENHANCEMENT-POINT LOOP_FILTER SPOTS /BITMYM/CL_CASE .


    ENDLOOP.


  ENDMETHOD.


  METHOD check_before_save_booking.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR1-866, User: SCOSAR, Date: 16.06.2023___*
*___ SR2-1781, User: SCOSAR, Date: 26.06.2025___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332
*___ SR2-2120, User: SCOSAR, Date: 25.07.2025___*

    DATA: ls_rstype TYPE /sopromet/rstype.

    rd_return = abap_true.

    CHECK gs_comwa-rscat EQ 'B'.

    IF gs_comwa-rstyp IS INITIAL.
      rd_return = abap_false.
      /bitmym/cl_message=>message( id = 'E626(/SOPROMET/ZL)' ).
      MESSAGE e626(/sopromet/zl) INTO DATA(ld_msg).
*      call_message( ). "SR1-866
    ELSE.
      CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
        EXPORTING
          i_rstyp = gs_comwa-rstyp
        IMPORTING
          e_data  = ls_rstype.
      IF ls_rstype IS INITIAL.
        rd_return = abap_false.
        /bitmym/cl_message=>message( id = 'E044(/SOPROMET/ZL)' ).
        MESSAGE e044(/sopromet/zl) INTO ld_msg.
*        call_message( ). "SR1-866
      ENDIF.
    ENDIF.
    CHECK rd_return EQ abap_true.

*____SR2-1781____BEGIN INSERT___*

*____SR2-2120____BEGIN COMMENT___*
    "code below moved to check_clinical_support_change method

*    IF gs_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create.
*      IF gs_case-clini_supp NE gs_case_yy-clini_supp.
*
*
*        SELECT SINGLE FROM /bitmym/i_reservation_types_sa
*        FIELDS daysforclinicalsupport, factorycalendar
*         WHERE reservationtype EQ @gs_comwa-rstyp
*           AND salesorg EQ @gs_comwa-vkorg
*          INTO (@DATA(ld_clinic_support),@DATA(ld_fabkl)).
*
*        DATA(ld_diff) = /bitmym/cl_mym=>working_days_btw_dates( id_fabkl = ld_fabkl
*                                                                id_date_from = sy-datum
*                                                                id_date_to = gs_comwa-odate ).
*
*        IF ld_diff LT ld_clinic_support OR
*          sy-datum GE gs_comwa-odate.
*          rd_return = abap_false.
*          /bitmym/cl_message=>message( id = 'E041(/BITMYM/S4)' v1 = ld_clinic_support ).
*          MESSAGE e041(/bitmym/s4) INTO ld_msg.
*        ENDIF.
*      ENDIF.
*    ENDIF.
*____SR2-2120____END   COMMENT___*
    rd_return = check_clinical_support_change( ).           "SR2-2120
    CHECK rd_return EQ abap_true.
*____SR2-1781____END   INSERT___*

*    SELECT COUNT(*)
*      FROM /sopromet/zzl01
*      WHERE vkorg EQ gs_case-vkorg
*        AND vtweg EQ gs_case-vtweg
*        AND spart EQ gs_case-spart.
*    IF sy-subrc NE 0.
*      rd_return = abap_false.
**      /bitmym/cl_message=>message( id = 'E661(/SOPROMET/ZL)' v1 = gs_case-vkorg v2 = gs_case-vtweg v3 = gs_case-spart ).
*      MESSAGE e661(/sopromet/zl) WITH gs_case-vkorg gs_case-vtweg gs_case-spart.
*      call_message( ).
*    ENDIF.
*    CHECK rd_return EQ abap_true.

*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save_booking
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS_BOOKING SPOTS /BITMYM/CL_CASE .

    rd_return = check_before_save_items( ).
    CHECK rd_return EQ abap_true.
  ENDMETHOD.


  METHOD ui5_add_single_items.
*____HS# 015081, VON: BGUNAWAN, DATUM: 12.09.2022___*
    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider, "HS 015081
          ls_data_ui5      TYPE /bitmym/cl_s4h_reserva_mpc_ext=>ts_reservation_deep,
          lo_case          TYPE REF TO /bitmym/cl_case.

    io_ui5->get_property( EXPORTING i_feld  = 'GO_DATA_PROVIDER' IMPORTING e_value = lo_data_provider ).
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    CHECK lo_data_provider IS BOUND.

    "Create case object
    IF ls_data_ui5-zzlresn IS INITIAL.
      lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam io_ui5 = io_ui5 ).
    ELSE.
      lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam
                                         id_reservation = ls_data_ui5-zzlresn
                                         io_ui5 = io_ui5 ).
    ENDIF.

    lo_case->ui5_add_single_items_int( EXPORTING is_data_ui5 = ls_data_ui5
                                       IMPORTING es_data = es_data ).

  ENDMETHOD.


  METHOD ui5_get_customerarea.
*____HS# 015080, VON: SSINGH, DATUM: 05.01.2022___*
*____HS# 015080, VON: SCOSAR, DATUM: 22.11.2022___*

    DATA : lv_string TYPE string.
    get_property io_ui5 'GV_FILTER_STRING' lv_string.
    CHECK lv_string IS NOT INITIAL.

*    ___ Start HS# 015080 SCOSAR
    " addition for case insensitivity
    IF lv_string CS 'NAME1'.
      lv_string = to_upper( lv_string ).
      REPLACE ALL OCCURRENCES OF 'NAME1' IN lv_string WITH 'upper( NAME1 )'.
    ENDIF.
*    ___ End HS# 015080 SCOSAR

    SELECT * FROM kna1vv "INTO CORRESPONDING FIELDS OF TABLE @ct_entityset "HS# 015080 DEL
     WHERE (lv_string)
      INTO CORRESPONDING FIELDS OF TABLE @ct_entityset. "HS# 015080 INS - for search with upper( ) function, into part should be at the end of select
  ENDMETHOD.


METHOD ui5_s4h_booking_list_select.
*____HS# 015080, VON: OPECHARROMAN, DATUM: 10.12.2021___*
*____HS# 015080, VON: SCOSAR, DATUM: 11.11.2022___*
*___ SR1-1642, User: SCOSAR, Date: 31.08.2023___*

  DATA: lo_ex       TYPE REF TO cx_root,
        ls_vbadr_ag TYPE vbadr,
        ls_vbadr_xx TYPE vbadr,
        ls_rserv    TYPE /sopromet/zzlrv,
        ls_rstypt   TYPE /sopromet/rstypt,
        lr_rstyp    TYPE /sopromet/range_rstyp_tab,
        lo_book_ui5 TYPE REF TO /bitmym/cl_ui5_booking.

  REPLACE 'ZZLRESN' IN /bitmym/if_ui5~gv_filter_string WITH 'LRESN'.

* Get partner relevant filters
  DATA(ld_query) = /bitmym/if_ui5~go_user->get_parvw_query_string( ).

* Filter relevant reservations type
  go_salesarea->set_vrm_values_rstyp( EXPORTING i_rscat = /sopromet/cl_l_reservation=>c_rscat_b IMPORTING et_values = DATA(lt_rstyp_values) ).
  LOOP AT lt_rstyp_values ASSIGNING FIELD-SYMBOL(<rstyp_value>).
    APPEND INITIAL LINE TO lr_rstyp ASSIGNING FIELD-SYMBOL(<range_rstyp>).
    <range_rstyp>-sign = 'I'.
    <range_rstyp>-option = 'EQ'.
    <range_rstyp>-low   = <rstyp_value>-key.
  ENDLOOP.


* Select from view
  IF /bitmym/if_ui5~gv_filter_string IS NOT INITIAL AND ld_query IS NOT INITIAL.

    TRY.
        SELECT DISTINCT lresn, txt04, vkgrp, vkbur, name1, lrsam, vkorg
               INTO TABLE @DATA(lt_bookings) FROM  /bitmym/bookings
               WHERE  vkorg  = @gs_actual_area-vkorg
               AND    vtweg  = @gs_actual_area-vtweg
               AND    spart  = @gs_actual_area-spart
               AND    rstyp  IN @lr_rstyp
               AND    (/bitmym/if_ui5~gv_filter_string)
               AND    (ld_query)
        ORDER BY lresn DESCENDING.
      CATCH cx_root INTO lo_ex.
        /bitmym/cl_message=>message( id = 'E003(/BITMYM/S4)').
    ENDTRY.
  ELSEIF ld_query IS NOT INITIAL.

    TRY.
        SELECT DISTINCT lresn, txt04, vkgrp, vkbur , name1, lrsam, vkorg
               INTO  TABLE @lt_bookings FROM  /bitmym/bookings
               WHERE  vkorg  = @gs_actual_area-vkorg
               AND    vtweg  = @gs_actual_area-vtweg
               AND    spart  = @gs_actual_area-spart
               AND    rstyp  IN @lr_rstyp
               AND    (ld_query)
        ORDER BY lresn DESCENDING.
      CATCH cx_root INTO lo_ex.
        /bitmym/cl_message=>message( id = 'E003(/BITMYM/S4)').
    ENDTRY.
  ELSEIF  /bitmym/if_ui5~gv_filter_string IS NOT INITIAL.

    TRY.
        SELECT DISTINCT lresn, txt04, vkgrp, vkbur, name1, lrsam, vkorg
               INTO TABLE @lt_bookings FROM  /bitmym/bookings
               WHERE  vkorg  = @gs_actual_area-vkorg
               AND    vtweg  = @gs_actual_area-vtweg
               AND    spart  = @gs_actual_area-spart
               AND    rstyp  IN @lr_rstyp
               AND    (/bitmym/if_ui5~gv_filter_string)
        ORDER BY lresn DESCENDING.
      CATCH cx_root INTO lo_ex.
        /bitmym/cl_message=>message( id = 'E003(/BITMYM/S4)').
    ENDTRY.
  ELSE.
    SELECT DISTINCT lresn, txt04, vkgrp, vkbur, name1, lrsam, vkorg
       INTO TABLE @lt_bookings FROM  /bitmym/bookings
       WHERE  vkorg  = @gs_actual_area-vkorg
       AND    vtweg  = @gs_actual_area-vtweg
       AND    spart  = @gs_actual_area-spart
       AND    rstyp  IN @lr_rstyp
  ORDER BY lresn DESCENDING.
  ENDIF.


  CHECK lt_bookings IS NOT INITIAL.

*--JIRA--SR1-1642--SCOSAR--31.08.2023 11:45:50--->>>>--------------------------*
  SELECT *
    FROM /bitmym/i_booking_status
    INTO TABLE @DATA(lt_bookstat)
     FOR ALL ENTRIES IN @lt_bookings
    WHERE salesorg EQ @lt_bookings-vkorg
      AND reservation EQ @lt_bookings-lresn.
*--JIRA--SR1-1642--SCOSAR--31.08.2023 11:45:50---<<<<--------------------------*

  LOOP AT lt_bookings ASSIGNING FIELD-SYMBOL(<bookings>) WHERE lresn IS NOT INITIAL.

    CLEAR: ls_vbadr_xx,
           ls_vbadr_ag.

    APPEND INITIAL LINE TO ct_table ASSIGNING FIELD-SYMBOL(<bookings_ui5>).

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = <bookings>-lresn
      IMPORTING
        e_reservation = ls_rserv.

    CHECK sy-subrc EQ 0 AND ls_rserv-odate IS NOT INITIAL."Empty odate data can't be process in front end

    MOVE-CORRESPONDING ls_rserv TO <bookings_ui5>.

    MOVE-CORRESPONDING <bookings> TO <bookings_ui5>.

    IF ls_rstypt-rstyp NE ls_rserv-rstyp.

      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg =  ls_rserv-vkorg i_rstyp = ls_rserv-rstyp ).

      IF go_rstyp IS BOUND.
        ls_rstypt = go_rstyp->get_prop_res_type_txt( EXPORTING i_rstyp     = ls_rserv-rstyp
                                                               id_language = /bitmym/if_ui5~gd_language
                                                               i_nobuffer  = abap_true ).

      ENDIF.

    ENDIF.

    <bookings_ui5>-rstyp_text = ls_rstypt-bezei.
    <bookings_ui5>-bezei = ls_rstypt-bezei.

*  Read calendar color and status using existing method
    TRY.
        lo_book_ui5 ?= me->/bitmym/if_ui5~go_ui5.
        IF lo_book_ui5 IS BOUND.
          <bookings_ui5>-color = lo_book_ui5->get_status_color( EXPORTING i_lresn = ls_rserv-zzlresn CHANGING cd_txt30 = <bookings_ui5>-txt30  ).
          <bookings_ui5>-status = <bookings_ui5>-txt30.
        ENDIF.
      CATCH cx_root INTO lo_ex.

    ENDTRY.


    CALL FUNCTION 'CSO_O_SD_TVSB_GET'   "HS# 015884
      EXPORTING
        pi_vsbed       = ls_rserv-vsbeb
        pi_spras       = /bitmym/if_ui5~gd_language
      IMPORTING
        pe_vsbed_vtext = <bookings_ui5>-vtext.

*   Customer partner data
    /bitmym/cl_partner=>read_address_partner_info_ext(
      EXPORTING
        id_vkorg = ls_rserv-vkorg
        id_case  = ls_rserv-zzlrsam
        id_parvw = 'AG'
      CHANGING
        cs_vbadr = ls_vbadr_ag ).

    <bookings_ui5>-name1 = ls_vbadr_ag-name1.

    IF /bitmym/if_ui5~gv_parvw IS NOT INITIAL.

      /bitmym/cl_partner=>read_address_partner_info_ext(
        EXPORTING
          id_vkorg = ls_rserv-vkorg
          id_case  = ls_rserv-zzlrsam
          id_parvw = /bitmym/if_ui5~gv_parvw
        CHANGING
          cs_vbadr = ls_vbadr_xx ).

      <bookings_ui5>-nachn = ls_vbadr_xx-name1.

    ENDIF.
*___ Start HS# 015080 SCOSAR
    /bitmym/cl_ui5_util=>convert_date_to_time_stamp( EXPORTING id_datum = <bookings_ui5>-odate id_time = <bookings_ui5>-optim CHANGING cd_tmpl = <bookings_ui5>-odate_t ).
*___ End HS# 015080 SCOSAR


*--JIRA--SR1-1642--SCOSAR--31.08.2023 11:45:50--->>>>--------------------------*
    <bookings_ui5>-txt30 = VALUE #( lt_bookstat[ reservation = <bookings>-lresn ]-mmsstatustext  OPTIONAL ).
*--JIRA--SR1-1642--SCOSAR--31.08.2023 11:45:50---<<<<--------------------------*


  ENDLOOP.

* Get additional data
  ui5_s4h_bookings_get_list_text( CHANGING et_entityset = ct_table ).

ENDMETHOD.


  METHOD ui5_enqueue.
*____HS# 015080, VON: SSINGH, DATUM: 13.12.2021___*
*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___*
*____HS# 017708, VON: BGUNAWAN, DATUM: 23.12.2022___*
*___ SR2-54, User: PKSHIRSAGAR, Date: 26.06.2024___*
*___ SR2-1384, User: PKSHIRSAGAR, Date: 25.04.2025___*

    DATA: ls_data        TYPE /bitmym/ic_dequeue_locks,
          lo_equi        TYPE REF TO /sopromet/cl_l_equipment,
          lo_res         TYPE REF TO /sopromet/cl_l_reservation,
          lo_case        TYPE REF TO /bitmym/cl_case,  "#SR2-54
          lt_reservation TYPE /sopromet/ty_tree_map_tab. "#SR2-54

    io_ui5->ui5_filter2struct( CHANGING cs_struct = ls_data ).

    IF ls_data IS INITIAL.                                  "HS# 017708
      io_ui5->ui5_parameter2struct( CHANGING cs_struct = ls_data ). "HS# 017708
    ENDIF.                                                  "HS# 017708

    IF ls_data-lresn IS NOT INITIAL.
      CREATE OBJECT lo_res
        EXPORTING
          i_zzlresn = ls_data-lresn
          io_ui5    = io_ui5.

      lo_res->enqueue( ).

    ENDIF.

    IF ls_data-equnr IS NOT INITIAL.
      lo_equi = /sopromet/cl_l_equipment=>create( i_equi = ls_data-equnr ).
      lo_equi->enqueue( EXPORTING i_scope = 1 ).
    ENDIF.

    IF ls_data-matnr IS NOT INITIAL.
      CALL FUNCTION 'ENQUEUE_EIMASE'
        EXPORTING
*         MODE_MASE      = 'E'
*         MANDT          = SY-MANDT
          matnr          = ls_data-matnr
*         X_MATNR        = ' '
          _scope         = '1'
*         _WAIT          = ' '
*         _COLLECT       = ' '
        EXCEPTIONS
          foreign_lock   = 1
          system_failure = 2
          OTHERS         = 3.
      IF sy-subrc <> 0.
        /bitmym/cl_message=>message( id = 'E526(/SOPROMET/ZL)' ).
      ENDIF.

    ENDIF.

*SOA SR2-54 lock all reservations in combined run
    IF ls_data-lrsam IS NOT INITIAL.

      lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_case = ls_data-lrsam ).
      CHECK lo_case IS BOUND.
      lo_case->enqueue( ).
      lo_case->get_property( EXPORTING i_feld = 'GT_RESERVATIONS' IMPORTING e_value = lt_reservation ).
      LOOP AT lt_reservation ASSIGNING FIELD-SYMBOL(<ls_res>).
        IF <ls_res>-lresrv IS NOT INITIAL.
          CREATE OBJECT lo_res EXPORTING i_zzlresn = <ls_res>-lresrv io_ui5 = io_ui5.
          lo_res->enqueue( ).
        ENDIF.
      ENDLOOP.

    ENDIF.
*EOA SR2-54



*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___Begin INS*
    IF /bitmym/cl_monitor=>ui5_mass_lock_ext( io_ui5 = io_ui5 is_lock_str = ls_data ) NE abap_true
       AND ls_data-preselect NE abap_true. " dont show this message for rap scenario

      /bitmym/cl_message=>message( id = 'E618(/SOPROMET/ZL)' ).
    ENDIF.
*____HS# 015080, VON: GIVANOV, DATUM: 10.05.2022___End INS*
  ENDMETHOD.


  METHOD ui5_we_add_items.
*____HS# 015083, VON: SSINGH, DATUM: 14.10.2021___*
    DATA : lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
           lo_case          TYPE REF TO /bitmym/cl_case,
           ls_res           TYPE /sopromet/zzlrv,
           lt_add_ret       TYPE /BITMYM/UI5_INSPECTION_TT,
            lo_appl      TYPE REF TO /bitmym/cl_mym,
           ls_data          TYPE /bitmym/cl_inspecti_mpc_ext=>ts_additional_res.
    DATA: lo_add_res TYPE REF TO /sopromet/cl_l_reservation.
    FIELD-SYMBOLS : <fs_ret> TYPE /BITMYM/UI5_INSPECTION_S.
        FIELD-SYMBOLS: <lfs_res>     TYPE /sopromet/ty_tree_map.
    get_property io_ui5 'GO_DATA_PROVIDER' lo_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = es_entity ).

*__ 1. Create case instance
    lo_case = /bitmym/cl_case=>create( id_case     = es_entity-zzlrsam
                            id_no_link_objects = abap_true
                                       io_ui5             = io_ui5 ).

    CHECK lo_case IS  BOUND.
        READ TABLE lo_case->gt_reservations ASSIGNING <lfs_res> WITH KEY lresrv = es_entity-zzlresn.
    CHECK sy-subrc EQ 0.

    get_property io_ui5  'GO_MYM'  lo_appl.
    set_property lo_appl 'GO_CASE' lo_case.
    set_property lo_case 'GO_ACT_RESERVATION' <lfs_res>-objkey.
    lo_case->ui5_prep_reservation_tree( i_add_res = abap_false ).
*    io_ui5->MOVE-CORRESPONDING( es_entity-reservationtoresitems TO lt_add_ret.
    lt_add_ret = CORRESPONDING #( es_entity-reservationtoresitems ).
    LOOP at lt_add_ret  ASSIGNING <fs_ret>.
      <fs_ret>-additional = 'X'.
    endloop.
    lo_case->ui5_we_add_items_post( importing eo_res = lo_add_res CHANGING  ct_ret   = lt_add_ret ).



    CHECK lo_add_res IS BOUND.
    lo_add_res->dequeue( ).
    get_property lo_add_res 'G_RESERVATION' ls_res.
    es_entity-zzlresn = ls_res-zzlresn.
  ENDMETHOD.


  method KB_STOCK_LEVEL.
*____HS# 015854, VON: STAORI, DATUM: 09.02.2022___*

    DATA: ls_comwa TYPE /sopromet/zzls01.

    go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

    /bitmym/cl_initial_kb=>consi_stock_level_display(
      EXPORTING
        id_booking     = gs_comwa-zzlresn                  " Booking
        io_area        = go_salesarea
        is_comwa_appl  = ls_comwa
        id_alv_display = abap_true ).
  endmethod.


  METHOD ui5_s4h_delete_reserv_int.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*
*___ SR2-335, User: STEKDEMIR, Date: 17.04.2024___*

    DATA: lv_flag          TYPE flag,
          ls_reserv        TYPE /sopromet/zzlrv,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          lo_reserv        TYPE REF TO /sopromet/cl_l_reservation.




    lo_data_provider = io_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    CLEAR gt_reservations.
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetoreservation MAPPING lresrv = zzlresn ).
    gt_reservations = CORRESPONDING #( ( gt_reservations ) ls_data_ui5-casetosingleitem  MAPPING lresrv = lresn ).

    LOOP AT gt_reservations ASSIGNING FIELD-SYMBOL(<res>).

      lv_flag = abap_true.
      CREATE OBJECT lo_reserv
        EXPORTING
          i_zzlresn = <res>-lresrv.

      lo_reserv->get_reservation_data( IMPORTING e_reservation = ls_reserv ).
      lo_reserv->delete_reservation( ).

      IF lo_reserv->wf_check_task_active( EXPORTING i_task = /sopromet/cl_l_reservation=>c_wf_task_dispatch_order ) IS INITIAL.

        CHECK ls_reserv-abgru IS INITIAL AND ls_reserv-vbeln IS INITIAL.

        CALL FUNCTION '/SOPROMET/SET_VTIME' IN UPDATE TASK
          EXPORTING
            i_vtime        = ls_reserv-vtime
            i_reservierung = ls_reserv-zzlresn
          EXCEPTIONS
            OTHERS         = 1.

*>      Workflow
        wf_objkey   = ls_reserv-zzlresn.
*        wf_objtype  = 'ZZLRESERV'. "SR2-335
        wf_objtype = /bitmym/cl_mym=>get_object_attachment( /bitmym/cl_mym=>c_objtype_reservation ). "SR2-335
        wf_event    = 'Released'.
        wf_synchron = space.

        wf_swe_event_create( ).

      ENDIF.

    ENDLOOP.

    IF lv_flag IS NOT INITIAL.
      CALL FUNCTION '/BITMYM/CASE_UPDATE' IN UPDATE TASK
        EXPORTING
          i_trtyp     = 'D'
          is_case_new = gs_case
          is_case_old = gs_case_yy.

      COMMIT WORK AND WAIT.

      IF ls_data_ui5 IS NOT INITIAL.
        CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.
        /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                          CHANGING cr_data = es_data ).
      ENDIF.
    ENDIF.

  ENDMETHOD.


  METHOD ui5_update_own_booking.
*____HS# 016041, VON: SSINGH, DATUM: 06.10.2021___*
*___ SR2-760, User: PKSHIRSAGAR, Date: 15.08.2024___*
*___ SR2-800, User: PKSHIRSAGAR, Date: 29.08.2024___*
*___ SR2-1941, User: PKSHIRSAGAR, Date: 13.06.2025___*

    DATA : lt_vbpa              TYPE TABLE OF /bitmym/vbpa,
           lt_kna1              TYPE TABLE OF kna1,
           l_ownbooking_feature TYPE char1,
           lo_user              TYPE REF TO /bitmym/cl_user.
    FIELD-SYMBOLS : <fs_vbpa> TYPE  /bitmym/vbpa.

ENHANCEMENT-POINT CLONE_BOOKING SPOTS /BITMYM/CL_CASE .

* DATA(ls_case_data) = io_case->get_data( ). "SR2-760
    CHECK cs_data-followupallow NE abap_true.
    CHECK cs_data-xfollowup  NE abap_true.  "SR2-800
    IF /bitmym/if_ui5~gs_callerid-role IS NOT INITIAL.

*___Read features of role
      IF gt_role_feature IS  INITIAL.
        SELECT * INTO TABLE @gt_role_feature
               FROM /bitmym/ui5mrf
              WHERE role = @/bitmym/if_ui5~gs_callerid-role.
      ENDIF.
    ELSE.
      IF gt_feature IS INITIAL.
        SELECT * INTO TABLE @gt_feature
         FROM /bitmym/ui5mfeat
        WHERE    ui5verfeatureinact NE 'X'.
      ENDIF.
    ENDIF.

    IF gt_role_feature IS NOT INITIAL.
      READ TABLE  gt_role_feature WITH KEY ui5featrind =  c_ownbooking_feature TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        l_ownbooking_feature = abap_true.
      ENDIF.
    ELSE.
      READ TABLE  gt_feature WITH KEY ui5verfeature =  c_ownbooking_feature TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        l_ownbooking_feature = abap_true.
      ENDIF.
    ENDIF.

    IF it_vbpa IS NOT INITIAL.
      lt_vbpa = it_vbpa.
    ELSE.
      IF io_case IS BOUND.                                  "SR2-1941
        get_property io_case 'GT_PARTNER'         lt_vbpa.
      ENDIF.                                                ""SR2-1941
    ENDIF.

    READ TABLE lt_vbpa WITH KEY parvw = /bitmym/if_ui5~gs_callerid-parvw_cid
                                kunnr = /bitmym/if_ui5~gs_callerid-kunnr TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      cs_data-ownbooking_flg = abap_true.
    ENDIF.

*____SR2-760____BEGIN INSERT___*
    READ TABLE lt_vbpa WITH KEY parvw = /bitmym/if_ui5~gv_parvw
                             kunnr = /bitmym/if_ui5~gs_callerid-kunnr TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      cs_data-ownbooking_flg = abap_true.
    ENDIF.
*____SR2-760____END   INSERT___*

    get_property go_ui5 'GO_USER' lo_user.
    CHECK lo_user IS BOUND.
    lt_kna1 = lo_user->get_partners_for_parvw( ).
    READ TABLE lt_vbpa WITH KEY parvw = 'AG'   ASSIGNING <fs_vbpa>.
    IF sy-subrc = 0.
      READ TABLE lt_kna1 WITH KEY kunnr = <fs_vbpa>-kunnr TRANSPORTING NO FIELDS .
      CHECK sy-subrc = 0.
      IF cs_data-ownbooking_flg = abap_true AND l_ownbooking_feature = abap_true.
        cs_data-clone_flg = abap_true.
      ELSEIF l_ownbooking_feature NE abap_true.
        cs_data-clone_flg = abap_true.
      ENDIF.
    ENDIF.
  ENDMETHOD.


  METHOD ui5_bookings_read_part_single.
*____HS# 016976, VON: SBADUSHA, DATUM: 10.06.2022___*

    DATA: lo_case    TYPE REF TO /bitmym/cl_case,
          ls_comwa   TYPE /bitmym/ui5_comwa,
          lo_partner TYPE REF TO /bitmym/cl_partner.

*___Create CASE Object using reservation form UI5 COMWA
    get_property io_ui5 'GS_UI5_COMWA' ls_comwa.

    CHECK ls_comwa-lresn IS NOT INITIAL
          OR ls_comwa-lrsam IS NOT INITIAL. "Filled from Keytab "HS# 015081 "consider case info too

    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_case = ls_comwa-lrsam id_reservation = ls_comwa-lresn ). "HS# 015081 Added case data

    lo_case->get_property( EXPORTING i_feld  = 'GO_PARTNER' IMPORTING e_value = lo_partner ).

    CHECK lo_partner IS BOUND.


    lo_partner->ui5_bookings_read_part_single( EXPORTING io_ui5     = io_ui5 IMPORTING es_partner = es_partner ).
  ENDMETHOD.


  METHOD ui5_add_single_items_exstng_rs.
* .
* .
* .
*--------------------------------------------------------------------*
*___ SR2-723, User: SCOSAR, Date: 02.09.2024___*
*___ SR2-2751, User: PKSHIRSAGAR, Date: 11.02.2026___*


    DATA: ls_data_ui5      TYPE /bitmym/cl_s4h_reserva_mpc_ext=>ts_reservation_deep, "/bitmym/cl_srep_srv_vr_mpc_ext=>ts_reservation_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          ls_res           TYPE /sopromet/zzlrv,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          lt_tree          TYPE /sopromet/tree_collect_tab,
          ls_date          TYPE /bitmym/s4h_convert_dates_st,
          lo_appl          TYPE REF TO /bitmym/cl_mym,
          lt_single_yy     TYPE /sopromet/ritems_tab,
          lt_single_items  TYPE /sopromet/ritems_tab.

    DATA : lt_created_res           TYPE /sopromet/zzls03_tab, "_ SR2-2751
           lv_add_singleitem_return TYPE abap_bool.
    FIELD-SYMBOLS: <lfs_res>     TYPE /sopromet/ty_tree_map.

*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    CHECK lo_data_provider IS BOUND.
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    READ TABLE gt_reservations ASSIGNING <lfs_res> WITH KEY lresrv = ls_data_ui5-zzlresn.
    CHECK sy-subrc EQ 0.

    get_property go_ui5  'GO_MYM'  lo_appl.
    set_property lo_appl 'GO_CASE' me.
    set_property me 'GO_ACT_RESERVATION' <lfs_res>-objkey.

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_data_ui5-zzlresn
        i_no_buff     = abap_true
      IMPORTING
        e_reservation = ls_res.

    MOVE-CORRESPONDING ls_res TO gs_comwa.
    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_r.
    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    ui5_prep_reservation_tree( i_add_res = abap_false ).

    "append single items
    get_property <lfs_res>-objkey 'GT_SINGLE_ITEMS_YY' lt_single_yy.
    LOOP AT ls_data_ui5-reservationtosingleitems INTO DATA(ls_res_single_item).
      APPEND INITIAL LINE TO lt_single_yy ASSIGNING FIELD-SYMBOL(<ls_single_yy>).
      MOVE-CORRESPONDING ls_res_single_item TO <ls_single_yy>.
      <ls_single_yy>-lresn = ls_data_ui5-zzlresn.
      IF <ls_single_yy>-meins IS INITIAL.
        DATA(l_o_mat) = /sopromet/cl_l_material=>get_ref( <ls_single_yy>-matnr ).
        DATA(l_mara)  = l_o_mat->get_mara( ).
        DATA(l_mvke) = l_o_mat->get_mvke( iv_vkorg = ls_res-vkorg iv_vtweg = ls_res-vtweg iv_spart = ls_res-spart ).
        <ls_single_yy>-meins = l_mara-meins.
        IF l_mvke-vrkme IS NOT INITIAL.
          <ls_single_yy>-meins = l_mvke-vrkme.
        ENDIF.
      ENDIF.
    ENDLOOP.

    ui5_single_items_atp_check( EXPORTING io_case         = me
                                          io_appl         = go_appl
                                CHANGING  ct_single_items = lt_single_yy ).

    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.

    set_gt_single_items( it_single = lt_single_yy ).

    lt_single_items = <lfs_res>-objkey->get_prop_single_items( EXPORTING io_case = me i_auto_check = abap_true ).

*____SR2-723____BEGIN INSERT___*
    CHECK /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true.
*____SR2-723____END   INSERT___*


    gv_save_res_only = 'X'. "call save only for reservation  "SR2-2751

    CHECK ui5_post_case( ) EQ abap_true.


    "populate response
    "get_property <lfs_res>-objkey 'GT_SINGLE_ITEMS' lt_single_items.
    set_icon_avail( CHANGING ct_single_items = lt_single_items ).
    CLEAR: ls_data_ui5-reservationtosingleitems[].
    LOOP AT lt_single_items INTO DATA(ls_single_item).
      APPEND INITIAL LINE TO ls_data_ui5-reservationtosingleitems ASSIGNING FIELD-SYMBOL(<ls_res_single_item>).
      MOVE-CORRESPONDING ls_single_item TO <ls_res_single_item>.
    ENDLOOP.

    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                     CHANGING  cr_data = es_data ).

  ENDMETHOD.


  METHOD check_before_save.
*____HS# 017346, VON: SCOSAR, DATUM: 26.09.2022___*
*___ SR2-2015, User: STEKDEMIR, Date: 03.07.2025___* "CLCO-332
*___ SR2-2228, User: OOGUR, Date: 28.08.2025___*
*___ SR2-3139, User: OOGUR, Date: 21.04.2026___*


*____SR2-2228____BEGIN INSERT___*
    rd_return = abap_true.
*    CHECK /bitmym/cl_migration=>gc_migration = abap_false. "SR2-3139
    CHECK /bitmym/cl_migration=>gv_migration = abap_false.  "SR2-3139
*____SR2-2228____END   INSERT___*


    rd_return = check_before_save_customer( ).
    CHECK rd_return EQ abap_true.


    rd_return = check_before_save_dates( ).
    CHECK rd_return EQ abap_true.

    rd_return = check_before_save_overlap( ).
    CHECK rd_return EQ abap_true.


    rd_return = check_before_save_booking( ).
    CHECK rd_return EQ abap_true.


    rd_return = check_before_save_reservation( ).
    CHECK rd_return EQ abap_true.

*____SR2-2015____BEGIN INSERT___*
    gs_badi-action = rd_return.
    CALL BADI go_badi->check_before_save
      CHANGING
        cs_badi = gs_badi.
    rd_return = gs_badi-action.
    CHECK rd_return EQ abap_true.
*____SR2-2015____END   INSERT___*

ENHANCEMENT-POINT CUSTOM_VALIDATIONS SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  METHOD ui5_s4h_delete_reservation.
*____HS# 015081, VON: STEKDEMIR, DATUM: 22.09.2022___*

    DATA: lo_case     TYPE REF TO /bitmym/cl_case.

    SELECT SINGLE COUNT( * )
      FROM /sopromet/zzlrv
      WHERE zzlrsam = @i_zzlrsam.
    CHECK sy-subrc = 0.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = i_zzlrsam  io_ui5 = io_ui5 ).

*___Start processing
    IF lo_case IS NOT INITIAL.
      lo_case->ui5_s4h_delete_reserv_int( EXPORTING io_data_provider = io_data_provider
                                           CHANGING eo_case          = lo_case
                                                    es_data          = es_data ).
    ENDIF.

  ENDMETHOD.


  METHOD check_automation_dispatch_retu.
*____HS# 015537, VON: SISMAIL, DATUM: 12.08.2021___*
*___ SR1-1206, User: SISMAIL, Date: 10.05.2023___*
*___ SR1-332, User: SBADUSHA, Date: 18.10.2023___*
*___ SR2-197, User: STEKDEMIR, Date: 01.03.2024___*


    DATA : ls_rstypo TYPE /sopromet/rstypo,
           ls_rstype TYPE /sopromet/rstype.

    e_success = abap_false.


*&* New code changes Only to consider for Internal Reservation.
    IF go_rstyp IS INITIAL.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_case-vkorg i_rstyp = gs_case-rstyp ).
    ENDIF.
    CHECK go_rstyp IS BOUND. "SR2-197
    go_rstyp->get_prop_res_type( EXPORTING i_rstyp = gs_comwa-rstyp RECEIVING e_data  = ls_rstype ).  "SR1-332
    get_property go_rstyp 'GS_RSTYPO' ls_rstypo.
    "   only procced if this is internal reservation.
    CHECK ls_rstype-int_res = abap_true.
    CHECK ls_rstypo-auto_ir_del = abap_true AND ( gs_comwa-trtyp_o = c_trtyp_h OR id_create_all EQ abap_true ).

    e_pstyv = ls_rstypo-auto_ir_del_pstyv.

*&* End of adding SR1-332+
enhancement-point check_automation_dispatch_retu spots /bitmym/case .

    e_success = abap_true.

*&* Begin of Comment SR1-332-
*&*SR1-1206+
*    if go_rstyp is initial.
*      go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = gs_case-vkorg i_rstyp = gs_case-rstyp ).
*    endif.
**&*SR1-1206+
*
*    check gs_comwa-rscat is initial and go_rstyp is bound.
*
*    get_property go_rstyp 'GS_RSTYPO' ls_rstypo.
*
**&*SR1-1206+
*    e_pstyv = ls_rstypo-auto_ir_del_pstyv.
*    if g_iconnect eq abap_true and
*      ls_rstypo-auto_ir_del eq abap_true.
*      e_success = abap_true.
*      exit.
*    endif.
**&*SR1-1206+
*
*    if i_ir_check is not initial.
*      go_rstyp->get_prop_res_type( EXPORTING i_rstyp = gs_comwa-rstyp RECEIVING e_data  = ls_rstype ).  "SR1-332
**      check gs_comwa-rstyp = /sopromet/cl_l_reservation=>c_rstyp_ir and ( gs_comwa-trtyp_o = c_trtyp_h or id_create_all eq abap_true ) "SR1-332-
*      check ls_rstype-int_res = abap_true and ( gs_comwa-trtyp_o = c_trtyp_h or id_create_all eq abap_true ) "SR1-332
*        and ls_rstypo-auto_ir_del = abap_true.
*    else.
*      check ( gs_comwa-trtyp_o = c_trtyp_h or id_create_all eq abap_true ) and
*            ls_rstypo-auto_ir_del = abap_true.
*    endif.
*&* End of Comment SR1-332-
*&* Begin of adding SR1-332+


  ENDMETHOD.


  method UI5_GET_EMAIL_IDS.
*____HS# 016239, VON: SSINGH, DATUM: 08.12.2021___*
    DATA : lo_list            TYPE REF TO cl_distributionlist_bcs,
           lo_recipient       TYPE REF TO if_recipient_bcs,
           lr_exception       TYPE REF TO cx_bcs,
           lo_cx_send_req_bcs TYPE REF TO cx_send_req_bcs,
           lv_fail            TYPE char1,
           lv_private         TYPE char1.
ENHANCEMENT-POINT UI5_GET_EMAIL_ID SPOTS /BITMYM/CL_CASE .
    r_check = abap_false.
    CHECK go_rstyp IS BOUND AND go_rstyp->gs_rstypo-dislist IS NOT INITIAL.
    TRY.
        lo_list = cl_distributionlist_bcs=>getu_persistent(
            i_dliname = go_rstyp->gs_rstypo-dislist
            i_private = lv_private ).
        CHECK lo_list IS BOUND.
*        lo_recipient = lo_list.
      CATCH cx_bcs INTO lr_exception.
        lv_fail = abap_true.
    ENDTRY.
    CHECK lv_fail IS INITIAL.
    TRY.
        CALL METHOD go_request->add_recipient( lo_list ).
      CATCH cx_send_req_bcs INTO lo_cx_send_req_bcs.

        EXIT.

    ENDTRY.
    r_check = abap_true.
  endmethod.


METHOD check_to_create_res_after_book.
*____HS# 016491, VON: OPECHARROMAN, DATUM: 07.02.2022___*
*____HS# 016639, VON: OPECHARROMAN, DATUM: 15.03.2022___*
*____HS# 017190, VON: STAORI, DATUM: 24.08.2022___*
*____HS# 017919, VON: OPECHARROMAN, DATUM: 06.03.2023___*
*___ SR2-910, User: OKIMENCE, Date: 27.09.2024___*
*___ SR2-952, User: OOGUR, Date: 08.10.2024___*
*___ SR2-1103, User: SCOSAR, Date: 14.11.2024___*
*___ SR2-1568, User: SCOSAR, Date: 05.03.2025___*
*___ SR2-2124, User: GIVANOV, Date: 25.07.2025___*



*__New EHP                                                  "HS# 017190
ENHANCEMENT-POINT CREATE_RES_AFTER_BOOK_01 SPOTS /BITMYM/CL_CASE .

  CHECK gd_no_res_creation EQ abap_false.                   "HS# 017919

* Only relevant for new created bookings
*  CHECK gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create . "SR2-1568 - moved below

  CHECK gs_comwa-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.

  CHECK gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create OR "SR2-1568
        ( gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change AND check_field_inventory_items( ) EQ abap_true ). "SR2-1568

  CHECK gs_comwa-xfollowup EQ abap_false.                   "SR2-1103

  IF /bitmym/cl_migration=>gd_create_case IS INITIAL.       "HS# 016639
* Constructor buffered
    DATA(ls_res_typ_vko) = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  )->get_prop_res_type_vkorg( gs_comwa ).

    FIELD-SYMBOLS <lv_call> TYPE any.

* Check if customizing is active
    CASE ls_res_typ_vko-xbook2case.
      WHEN gc_s.
*      WHEN gc_b.                                             "SR2-952 Del
      WHEN gc_b OR gc_d.                                      "SR2-952
*        CHECK go_ui5 IS NOT INITIAL.                         "SR2-910
        CHECK go_ui5 IS BOUND AND go_ui5->get_data( )-g_mobile_call IS NOT INITIAL. "SR2-910
      WHEN OTHERS.
        EXIT.
    ENDCASE.
  ENDIF.                                                    "HS# 016639

*  CLEAR: gs_comwa-rscat, gs_comwa-zzlrsam, gs_comwa-trtyp_o.  "SR2-2124 DEL
*  set_property go_appl 'gs_comwa' gs_comwa.                     "SR2-2124 DEL

*Use local variable in order not to affect the booking
  DATA(ls_comwa) = gs_comwa.                                    "SR2-2124
  CLEAR: ls_comwa-rscat, ls_comwa-zzlrsam, ls_comwa-trtyp_o.    "SR2-2124

  go_appl->set_data( is_data = VALUE #( gs_comwa = ls_comwa ) it_fields = VALUE #( ( fieldname = 'GS_COMWA' ) ) ).  "SR2-2124


* Create reservation from booking. Read booking object and trigger reservation creation
  /bitmym/cl_case=>create( id_case = gs_case-zzlrsam io_appl = go_appl io_area = go_salesarea
       )->create_res_after_book( ).

  go_appl->set_data( is_data = VALUE #( gs_comwa = gs_comwa ) it_fields = VALUE #( ( fieldname = 'GS_COMWA' ) ) ).  "SR2-2124

ENDMETHOD.


METHOD ui5_s4h_change_reservation.
*____HS# 015081, VON: STEKDEMIR, DATUM: 16.08.2022___*
  DATA: ls_data_ui5    TYPE /bitmym/cl_inspecti_mpc_ext=>ts_reservation_deep,
        ls_update_data TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep,
        lo_case        TYPE REF TO /bitmym/cl_case.



  SELECT SINGLE COUNT( * )
    FROM /sopromet/zzlrv
    WHERE zzlrsam = @i_zzlrsam.
  CHECK sy-subrc = 0.

*___Create CASE Object
  lo_case = /bitmym/cl_case=>create( id_case = i_zzlrsam  io_ui5 = io_ui5 )."id_reservation = i_zzlresn

  io_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

  MOVE-CORRESPONDING ls_data_ui5 TO ls_update_data.
  MOVE-CORRESPONDING ls_data_ui5-mymreservationtonotes       TO  ls_update_data-casetonotes.
  MOVE-CORRESPONDING ls_data_ui5-mymreservationtopartner     TO  ls_update_data-casetopartner.
  MOVE-CORRESPONDING ls_data_ui5-mymreservationtosingleitems TO  ls_update_data-casetosingleitem.

*___Start processing
  lo_case->ui5_s4h_update_reservation_int( EXPORTING is_data_ui5 = ls_update_data IMPORTING es_data = es_data ).

ENDMETHOD.


  method UI5_CREATE_BOOKING_TEMPLATE.
*____HS# 015183, VON: SSINGH, DATUM: 27.09.2021___*
    DATA : lt_template TYPE TABLE OF /bitmym/ui5_tmpl,
           ld_nr_range TYPE inri-nrrangenr,
           l_tmpl_no   TYPE /bitmym/ui5_tmpl_no.

    FIELD-SYMBOLS : <fs_template> TYPE /bitmym/ui5_tmpl.
    CHECK cs_template IS NOT INITIAL.
    ld_nr_range = '01'.
    CALL FUNCTION 'NUMBER_GET_NEXT'
      EXPORTING
        nr_range_nr             = ld_nr_range
        object                  = c_bookin_tmpl
      IMPORTING
        number                  = l_tmpl_no
      EXCEPTIONS
        interval_not_found      = 1
        number_range_not_intern = 2
        object_not_found        = 3
        quantity_is_0           = 4
        quantity_is_not_1       = 5
        interval_overflow       = 6
        OTHERS                  = 7.

    CHECK l_tmpl_no IS NOT INITIAL.
    IF cs_template-crea_date IS INITIAL.
      cs_template-crea_date = sy-datum.
    ENDIF.
    cs_template-tmpl_no =  l_tmpl_no.
    APPEND INITIAL LINE TO lt_template ASSIGNING <fs_template>.
    <fs_template> =   cs_template.


    CALL FUNCTION '/BITMYM/UPDATE_BOOKING_TEMPL' IN UPDATE TASK
      EXPORTING
        it_template = lt_template.
    COMMIT WORK.
  endmethod.


  METHOD fill_book_auto_plant_ranges.
*____HS# 016287, VON: SBADUSHA, DATUM: 24.05.2022___*

    DATA : lt_werks_so TYPE STANDARD TABLE OF /bitmym/xwerk_so,
           lt_plants   TYPE  /sopromet/plants.


    CHECK gs_case-rscat = /sopromet/cl_l_reservation=>c_rscat_b AND check_book_auto_plant_active( ) EQ abap_true.
    IF gs_case-vkbur IS NOT INITIAL.
      go_salesarea->set_property( EXPORTING i_feld  = 'G_ACTUAL_VKBUR' i_value =  gs_case-vkbur ).
      go_salesarea->get_assigned_plants_sales_ofc( ).
      go_salesarea->get_property( EXPORTING i_feld  = 'GT_XWERK_SO' IMPORTING e_value = lt_werks_so ).
      LOOP AT lt_werks_so ASSIGNING FIELD-SYMBOL(<fs_werks_so>).
        APPEND INITIAL LINE TO lt_plants ASSIGNING FIELD-SYMBOL(<fs_plants>).
        <fs_plants>-werks = <fs_werks_so>-werks.
      ENDLOOP.
    ELSE.
      go_salesarea->get_property( EXPORTING i_feld  = 'G_PLANTS' IMPORTING e_value = lt_plants ).
    ENDIF.


    IF lt_plants IS NOT INITIAL.
      SORT lt_plants ASCENDING.
      LOOP AT lt_plants ASSIGNING <fs_plants>.
        CHECK go_salesarea->check_unbw_plant( id_werks = <fs_plants>-werks ) EQ abap_false.
        APPEND INITIAL LINE TO gt_plant_range ASSIGNING FIELD-SYMBOL(<fs_all_plants>).
        <fs_all_plants>-sign = 'I'.
        <fs_all_plants>-option = 'EQ'.
        <fs_all_plants>-low = <fs_plants>-werks.
      ENDLOOP.
    ENDIF.

ENHANCEMENT-POINT FILL_BOOK_AUTO_PLANT_RANGES_01 SPOTS /BITMYM/CL_CASE .
  ENDMETHOD.


  METHOD ui5_add_single_items_int.
*____HS# 015081, VON: BGUNAWAN, DATUM: 12.09.2022___*

    IF is_data_ui5-zzlresn IS INITIAL.
      "create new reservation and add single items into it
      ui5_add_single_items_new_res(
        EXPORTING
          is_data_ui5 = is_data_ui5
        IMPORTING
          es_data     = es_data
      ).
    ELSE.
      "append/add single items on top of existing reservation
      ui5_add_single_items_exstng_rs( IMPORTING es_data = es_data ).
    ENDIF.
  ENDMETHOD.


  METHOD compute_dates_after_change.
*____HS# 016601, VON: OPECHARROMAN, DATUM: 08.03.2022___*
*____HS# 016601, VON: GIVANOV, DATUM: 19.05.2022___*
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*
*___ SR1-1074, User: GIVANOV, Date: 27.06.2023___*
*___ SR2-912, User: STEKDEMIR, Date: 24.10.2024___*
*___ SR2-999, User: STEKDEMIR, Date: 28.10.2024___*
*___ SR2-1500, User: SCOSAR, Date: 05.02.2025___*

    DATA: lo_appl      TYPE REF TO /bitmym/cl_mym,
          ls_comwa     TYPE /sopromet/zzls01,
          ld_answer    TYPE char1,
          ls_date_data TYPE /bitmym/case_common_date.

    CLEAR gs_comwa-delv_date_inpast.                          "SR1-803
* Move input structure dates
    MOVE-CORRESPONDING cs_dates TO ls_date_data.

    CHECK ( ls_date_data IS NOT INITIAL ).

* Check customizing
    CHECK date_recalculation_cust( id_case ) IS NOT INITIAL.

* Pass comwa parameteres
    IF id_case EQ abap_true.
      CHECK ( ls_date_data-odate NE gs_case-odate OR
              ls_date_data-vedat NE gs_case-vedat
         OR ( checks_related_req_del_date( ) = abap_true AND "SR2-999
              ls_date_data-edatu NE gs_case-edatu ) ).       "SR2-999
      MOVE-CORRESPONDING gs_comwa TO ls_comwa.
      MOVE-CORRESPONDING gs_case TO ls_comwa.
    ELSE.
      CHECK ( ls_date_data-odate NE gs_comwa-odate OR
              ls_date_data-vedat NE gs_comwa-vedat
        OR  ( checks_related_req_del_date( ) = abap_true AND "SR2-999
*              ls_date_data-edatu NE gs_case-edatu ) ).       "SR2-999 "SR2-1500 - commented
              ls_date_data-edatu NE gs_comwa-edatu ) ).     "SR2-1500
      MOVE-CORRESPONDING gs_comwa TO ls_comwa.
    ENDIF.

* Clear delivery date in case of day of use change.
    IF ls_comwa-odate NE ls_date_data-odate.
      CLEAR ls_comwa-vdate.
      CLEAR ls_comwa-edatu.
**____SR2-999____BEGIN INSERT___*
    ELSE.
      IF checks_related_req_del_date( ) = abap_true AND
         ls_comwa-edatu NE ls_date_data-edatu.
        ls_comwa-edatu = ls_date_data-edatu.
        DATA(ls_appl_data) = go_appl->get_data( ).
        ls_appl_data-gs_comwa-edatu = ls_date_data-edatu.
        go_appl->set_data( it_fields = VALUE /bitmym/t_fieldname( ( fieldname = 'GS_COMWA-EDATU' ) ) is_data = ls_appl_data ).
      ENDIF.
**____SR2-999____END   INSERT___*
    ENDIF.


** Set flag for End of use date change
    set_property go_appl 'GS_COMWA-VEDAT' ls_comwa-vedat.

    ls_comwa-odate = ls_date_data-odate.
    ls_comwa-vedat = ls_date_data-vedat.

    IF ls_date_data-odate GT ls_date_data-vedat.
      ls_comwa-vedat = ls_date_data-odate .
    ENDIF.

    set_property go_appl 'GS_COMWA-KUNNR' gs_comwa-kunnr.
    set_property go_appl 'GS_COMWA-KUNWE' gs_comwa-kunwe.  "GND

* recalculate dates
    compute_dates( EXPORTING id_no_calendar = abap_true
                             iv_res_screen  = iv_res_screen "SR1-1074
                   CHANGING  cs_comwa       = ls_comwa ).
    MOVE-CORRESPONDING ls_comwa TO ls_date_data.

* Return calclated dates
    MOVE-CORRESPONDING ls_date_data TO cs_dates.

  ENDMETHOD.


METHOD put_book_mat_to_provider.
*____HS# 016491, VON: OPECHARROMAN, DATUM: 08.02.2022___*
*____HS# 016639, VON: OPECHARROMAN, DATUM: 15.03.2022___*
*____HS# 017994, VON: OPECHARROMAN, DATUM: 30.03.2023___*
*___ SR1-1293, User: OPECHARROMAN, Date: 01.06.2023___*
*___ SR2-1565, User: SCOSAR, Date: 04.03.2025___*
*___ SR2-1716, User: SSAHU,  Date: 24.07.2025___*
*___ SR2-2228, User: OOGUR,  Date: 22.09.2025___*
*___ SR2-3139, User: OOGUR,  Date: 21.04.2026___*


  DATA: lt_tree          TYPE /sopromet/tree_collect_tab,
        lt_atp_materials TYPE /sopromet/zzls07_tab,
        lt_range_kunnr   TYPE RANGE OF kunnr,
        ls_field_inv     TYPE /bitmym/field_inv_fields,
        lt_equi_range    TYPE /bitmym/t_range_equnr,
        lt_rstype_consi  TYPE RANGE OF /sopromet/rstyp,
        ls_equi          TYPE v_equi.

  CHECK gs_comwa-rscat EQ /sopromet/cl_l_reservation=>c_rscat_b.

  set_property go_appl 'GO_CASE' me.

* Get booking items
  LOOP AT gt_reservations ASSIGNING FIELD-SYMBOL(<fs_res>).
    DATA(lt_bookings) = <fs_res>-objkey->get_prop_booking_items(  ).
  ENDLOOP.

*____SR2-2228____BEGIN COMMENT___*
* Start of HS# 016639 -->
* If data migration is run, create reservations only when serial number is passed
*  IF /bitmym/cl_migration=>gd_create_case = 'Y'.
*    DELETE lt_bookings WHERE sernr IS INITIAL.
*  ENDIF.
* End of HS# 016639 -->
*____SR2-2228____END   COMMENT___*

  CHECK /bitmym/cl_migration=>gd_create_case  IS INITIAL. "SR2-2228

* There are booking items
  CHECK lt_bookings IS NOT INITIAL.

  IF <fs_res> IS ASSIGNED.
    set_property go_appl 'GD_REF_BOOKING' <fs_res>-lresrv.
  ENDIF.

* Create barchart object
  DATA(lo_barc) = /bitmym/cl_bar_chart=>create( io_application = go_appl  ).
* Check if field notification is active
  IF go_partner IS NOT INITIAL AND enh_atp_active( ) EQ abap_true.
* We determine with the current reservation type if it a field inventory reservation could be created
    DATA(ls_rstype) = /sopromet/cl_l_res_type=>create( i_vkorg = gs_case-vkorg i_rstyp = gs_case-rstyp )->get_rstype_field_inv( ).
    go_partner->set_gs_kuagv( ).                            "HS# 017994
    go_partner->set_fld_inv_cust_range( ).
    lo_barc->get_cust_range( ).
    lo_barc->get_consi_rstype(  ).
    lo_barc->get_rstyp_range( IMPORTING ct_range = lt_rstype_consi ).
    get_property lo_barc 'GT_RANGE_KUNNR' lt_range_kunnr.
  ENDIF.


* If equipment selection comes from the booking, we assing those equipment.
* If not, we run availability and determine the equipment.
* Mixed settings work by looking the equipment.
* Reference equipment will be automatically assigned if there is no availability.
  DATA(lt_equi_search) = lt_bookings[].

*  IF /bitmym/cl_migration=>gc_migration = abap_false.       "SR2-2228 "SR2-3139
  IF /bitmym/cl_migration=>gv_migration  = abap_false.       "SR2-3139

    DELETE lt_equi_search WHERE sernr IS INITIAL.

    IF lt_equi_search IS NOT INITIAL.
      SELECT equnr, sernr, matnr, eqtyp FROM equi INTO TABLE @DATA(lt_equi)
        FOR ALL ENTRIES IN @lt_equi_search
        WHERE matnr = @lt_equi_search-matnr AND
              sernr = @lt_equi_search-sernr.
      SORT lt_equi BY matnr sernr. "To be able to binary search.
    ENDIF.

  ENDIF.                                                    "SR2-2228

  LOOP AT lt_bookings ASSIGNING FIELD-SYMBOL(<fds_item>).
    CLEAR ls_field_inv.
* First assignment, single items and entries with serial numbers.
    DATA(lo_mat) = /sopromet/cl_l_material=>get_ref( <fds_item>-matnr ).
    set_property lo_mat 'GO_AREA' go_salesarea.

*     Check if single item or not
    IF lo_mat->check_set_material( ) EQ abap_false.
      APPEND INITIAL LINE TO ct_single ASSIGNING FIELD-SYMBOL(<fds_single>).
      MOVE-CORRESPONDING <fds_item> TO <fds_single>.
      <fds_single>-werks = gs_comwa-werks.

      " HS# 016639 New-->
ENHANCEMENT-POINT PUT_BOOK_MAT_TO_PROVIDER_02 SPOTS /BITMYM/CL_CASE .

    ELSE.

*   Sets
*     Assigned sets.
      IF <fds_item>-sernr IS NOT INITIAL.

        READ TABLE lt_equi ASSIGNING FIELD-SYMBOL(<fs_equi>) WITH KEY matnr = <fds_item>-matnr
                                                                      sernr = <fds_item>-sernr.
        IF sy-subrc EQ 0.

          IF <fs_equi>-eqtyp NE /sopromet/cl_l_equipment=>c_equi_typ_ref.
*       Lock
            IF lo_barc->check_lock_equi( EXPORTING id_message = abap_false id_equnr = <fs_equi>-equnr ) EQ abap_true.
*              if equi value comes from data migration, pass always value to reservation creation, even if lock fails
*               OR  /bitmym/cl_migration=>gd_create_case EQ abap_true. "SR1-1293 "SR2-2228
*             To exclude this equipment from atp selection in case it has to be run.
              APPEND INITIAL LINE TO lt_equi_range ASSIGNING FIELD-SYMBOL(<fs_range>).
              <fs_range>-sign = 'E'.
              <fs_range>-option = 'EQ'.
              <fs_range>-low = <fs_equi>-equnr.
*         Consider field inventory reservations
              IF lt_range_kunnr IS NOT INITIAL AND
                 lt_rstype_consi IS NOT INITIAL.
                DATA(lo_equi) = /sopromet/cl_l_equipment=>create( i_equi = <fs_equi>-equnr id_buffer_refresh = abap_false ).
                DATA(lo_res) = lo_equi->get_current_reservation( 'ATP' ).
                IF lo_res IS BOUND.                         "HS# 016639
                  lo_res->get_reservation_data( IMPORTING e_reservation = DATA(ls_res) ).
                  DATA(ls_eqbs) = lo_equi->get_eqbs( ).     "HS# 016639
*             Field inventory is active and the reservation is in a field inventory customer.
*                IF ls_res-kunnr IN lt_range_kunnr AND      "HS# 016639
                  IF ls_eqbs-kunnr IN lt_range_kunnr AND    "HS# 016639
                    ls_res-rstyp IN lt_rstype_consi AND
                    lo_equi->get_equi_user_status( ) = /sopromet/cl_l_equipment=>c_set_status_konsi.

                    ls_field_inv-rstyp = ls_rstype-rstyp.
                    ls_field_inv-srcrs = ls_res-zzlresn.
                    ls_field_inv-field_inv = abap_true.
                  ELSE.                                     "HS# 016639
                    CONTINUE.                               "HS# 016639
                  ENDIF.
                ELSE.                                       "HS# 016639
                  CONTINUE.                                 "HS# 016639
                ENDIF.                                      "HS# 016639
              ENDIF.

            ELSE.
              CONTINUE.
            ENDIF.
          ENDIF.


          APPEND INITIAL LINE TO ct_selection ASSIGNING FIELD-SYMBOL(<fds_selection>).
          MOVE-CORRESPONDING <fs_equi> TO <fds_selection>.
          MOVE-CORRESPONDING ls_field_inv TO <fds_selection>.
          CONTINUE.

        ENDIF.
      ENDIF.

*     If equipment not assinged, runt atp check. Equipment already selected will not be considered because they are locked.
      READ TABLE lt_atp_materials ASSIGNING FIELD-SYMBOL(<fds_no_assinged>) WITH KEY matnr = <fds_item>-matnr.
      IF sy-subrc EQ 0.
        ADD <fds_item>-menge TO <fds_no_assinged>-menge.
      ELSE.
        APPEND INITIAL LINE TO lt_atp_materials ASSIGNING <fds_no_assinged>.
        MOVE-CORRESPONDING <fds_item> TO <fds_no_assinged>.
      ENDIF.

    ENDIF.
  ENDLOOP.

ENHANCEMENT-POINT PUT_BOOK_MAT_TO_PROVIDER SPOTS /BITMYM/CL_CASE .

  IF lt_atp_materials IS NOT INITIAL.

    DATA(lt_mat) = /bitmym/cl_bar_chart=>display_atp_from_case( EXPORTING io_case           = me
                                                                          i_view_type       = /bitmym/cl_bar_chart=>c_no_display
                                                                          i_force_equi_sele = abap_true
                                                                          it_atp_materials  = lt_atp_materials
                                                                          it_range_equnr    = lt_equi_range
                                                                         ).
    LOOP AT lt_mat ASSIGNING FIELD-SYMBOL(<fds_mat>).
      APPEND INITIAL LINE TO ct_selection ASSIGNING <fds_selection>.
      MOVE-CORRESPONDING <fds_mat> TO <fds_selection>.
      <fds_selection>-asmnt = VALUE #( lt_bookings[ matnr = <fds_mat>-matnr ]-asmnt OPTIONAL ). "SR2-1565
*      /bitmym/cl_appllog=>store_message( id = 'S916(/SOPROMET/ZL)' v1 = <fds_mat>-equnr  v2 = <fds_mat>-matnr ). "SR2-1716
    ENDLOOP.

  ENDIF.

  IF ct_single IS NOT INITIAL.
    CALL FUNCTION '/SOPROMET/SINGLE_GET_EQUNR'
      EXPORTING
        i_vkorg = gs_case-vkorg
        i_vtweg = gs_case-vtweg
        i_spart = gs_case-spart
      IMPORTING
        e_vequi = ls_equi.
    IF ls_equi IS NOT INITIAL.
      APPEND INITIAL LINE TO ct_selection ASSIGNING <fds_selection>.
      <fds_selection>-equnr = ls_equi-equnr.
*      /bitmym/cl_appllog=>store_message( id = 'S916(/SOPROMET/ZL)' v1 = ls_equi-equnr v2 = ls_equi-matnr ). "SR2-1716
    ENDIF.
  ENDIF.

*____SR2-1716____BEGIN INSERT___*

  CHECK ct_selection IS INITIAL.
  DATA(ls_booking) = lt_bookings[ 1 ] .
  LOOP AT  lt_atp_materials ASSIGNING FIELD-SYMBOL(<fs_mat_sel>).
    /bitmym/cl_appllog=>store_message( id = 'S971(/SOPROMET/ZL)' v1 = ls_booking-lresn v2 = <fs_mat_sel>-matnr ).
  ENDLOOP.
*____SR2-1716____END   INSERT___*




ENDMETHOD.


  METHOD date_recalculation_cust.
*____HS# 016601, VON: PKUNAL, DATUM: 16.03.2022___*

    DATA: lv_answer TYPE char1.
    r_change_date = abap_false.

    SELECT SINGLE * FROM /sopromet/rstypo INTO @DATA(ls_rstypo)
      WHERE vkorg = @gs_actual_area-vkorg
        AND rstyp = @gs_case-rstyp.

    CASE ls_rstypo-date_recalculation.
      WHEN 'R'. "only allowed at reservation level
        CHECK id_case EQ abap_false.
        r_change_date = abap_true.
      WHEN 'C'. "At case level
        r_change_date = abap_true.
      WHEN 'P'. "Pop up
*    ___Bestägigungspopup
        CALL FUNCTION 'POPUP_TO_CONFIRM'
          EXPORTING
            text_question  = TEXT-dca
            popup_type     = 'ICON_MESSAGE_QUESTION'
          IMPORTING
            answer         = lv_answer
          EXCEPTIONS
            text_not_found = 1
            OTHERS         = 2.
        CHECK lv_answer = '1' AND sy-subrc EQ 0.
        r_change_date = abap_true.
      WHEN OTHERS. " Not allowed
ENHANCEMENT-POINT DATE_RECALCULATION_CUST SPOTS /BITMYM/CL_CASE .

    ENDCASE.

  ENDMETHOD.


  method CHECK_BOOK_AUTO_PLANT_ACTIVE.
*____HS# 016287, VON: SBADUSHA, DATUM: 24.05.2022___*

    data : lt_rstyp_vkorg type standard table of /sopromet/rstypo.

    re_check = abap_false.

    check go_salesarea is bound.

    go_salesarea->get_property( exporting i_feld  = 'GT_RSTYP_VKORG' importing  e_value = lt_rstyp_vkorg ).

    check lt_rstyp_vkorg is not initial.
    data(ls_rstyp_vkorg) = value #( lt_rstyp_vkorg[ vkorg = gs_comwa-vkorg rstyp = gs_case-rstyp ] optional ).
    check ls_rstyp_vkorg-book_auto_plant eq abap_true.

    re_check = abap_true.
  endmethod.


  METHOD determine_cust_territory.
*____HS# 015122, VON: BGUNAWAN, DATUM: 27.01.2023___*

    DATA: lo_det    TYPE REF TO /bitmym/cl_determination.

    lo_det = /bitmym/cl_determination=>create( io_appl = go_appl ).

    lo_det->determine_cust_territory( CHANGING c_territory = c_territory  ).

  ENDMETHOD.


  method intf_post_processing_int.
*____HS# 015862, VON: SISMAIL, DATUM: 04.03.2022___*

    data: lo_data_provider type ref to /iwbep/if_mgw_entry_provider,
          ls_data_ui5      type /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.

    get_property go_ui5 'GS_DATA_UI5' ls_data_ui5.
    if ls_data_ui5 is initial.
*___Step 1: Get ODATA Context from data provider object
      get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
      check lo_data_provider is bound.
      lo_data_provider->read_entry_data( importing es_data = ls_data_ui5 ).
      check ls_data_ui5 is not initial.
    endif.

ENHANCEMENT-POINT INTF_POST_PROCESSING_INT00 SPOTS /BITMYM/CL_CASE .


  endmethod.


