  method CHECK_DEL_PRIORITY_ACTIVE.
*____HS# 017034, VON: SBADUSHA, DATUM: 17.03.2023___*

    r_active = abap_false.

    CHECK del_priority_active( ) eq abap_true.

    r_active  = abap_true.
  endmethod.


  METHOD check_if_locked.
*____HS# 017610, VON: SCOSAR, DATUM: 17.03.2023___*

    DATA: t_enq     TYPE STANDARD TABLE OF seqg3.

    r_locked = abap_false.

    REFRESH t_enq.
    CALL FUNCTION 'ENQUEUE_REPORT'
      EXPORTING
        gclient               = sy-mandt
        gname                 = '/BITMYM/CASE'
        gtarg                 = CONV eqegtarg( sy-mandt && i_vkorg && i_zzlrsam )
        guname                = space
      TABLES
        enq                   = t_enq
      EXCEPTIONS
        communication_failure = 1
        system_failure        = 2
        OTHERS                = 3.

    IF NOT t_enq[] IS INITIAL.
      r_locked = abap_true.
      READ TABLE t_enq INTO DATA(lw_enq) INDEX 1.

      CASE i_msgty.
        WHEN 'E'.
          /bitmym/cl_message=>message( id = 'E473(/SOPROMET/ZL)' v1 = i_zzlrsam v2 = i_vkorg v3 = sy-msgv1 io_log = io_log ).
        WHEN OTHERS.
          /bitmym/cl_message=>message( id = 'I473(/SOPROMET/ZL)' v1 = i_zzlrsam v2 = i_vkorg v3 = sy-msgv1 io_log = io_log ).
      ENDCASE.
    ENDIF.
  ENDMETHOD.


  method set_screen_vkorg.
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*

    data : lv_umbrella type abap_bool.  "SR1-545+

* Begin of "SR1-545+ SISMAIL
    if go_salesarea is bound.
      go_salesarea->get_property( exporting i_feld  = 'GS_ACTUAL_AREA-UMBRELLA_VKORG'
                                            importing e_value = lv_umbrella ).
    endif.
    if lv_umbrella eq abap_true.
      if is_comwa-vkorg_full is not initial.
        split is_comwa-vkorg_full at '/' into gs_comwa-vkorg gs_comwa-vtweg gs_comwa-spart.
        if go_appl is bound.
          go_appl->set_property( exporting i_feld  = 'GS_COMWA-VKORG'
                                            i_value = gs_comwa-vkorg ).
          go_appl->set_property( exporting i_feld  = 'GS_COMWA-VTWEG'
                                  i_value = gs_comwa-vtweg ).
          go_appl->set_property( exporting i_feld  = 'GS_COMWA-SPART'
                        i_value = gs_comwa-spart ).
        endif.
      else. "Error
        message e997(/sopromet/zl).
      endif.
    else.
* End of "SR1-545+   SISMAIL
      gs_comwa-vkorg = is_comwa-vkorg.
      gs_comwa-vtweg = is_comwa-vtweg.
      gs_comwa-spart = is_comwa-spart.
    endif.                                                  "SR1-545+
* Begin of SR1-545
    if go_salesarea is bound.
      go_salesarea->set_property( exporting i_feld  = 'G_SELECTED_VKORGF'
                                            i_value = conv /bitmym/vkorg_complete( |{ gs_comwa-vkorg }/{ gs_comwa-vtweg }/{ gs_comwa-spart }| ) ).
    endif.
* End of SR1-545
  endmethod.


  method CHECK_CASE_DATE_AUTH.
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*

    data: ls_reservation type /sopromet/zzlrv,
          r_fieldname    type /bitmym/panel_fieldname,
          lt_date_auth   type /bitmym/date_auth_t.


    check go_act_reservation is bound.
    go_act_reservation->get_property( exporting i_feld  = 'G_RESERVATION' importing e_value = ls_reservation ).

    lt_date_auth = get_dates_customizing( ).


    loop at lt_date_auth assigning field-symbol(<fs_date_auth>).

      r_fieldname =  get_date_fieldname( i_date_code = <fs_date_auth>-date_auth ).

      loop at screen .
        check screen-name = r_fieldname or screen-name = '/SOPROMET/ZZLS01-OPTIM'.
        if screen-name = r_fieldname.
          check go_user is bound.
          if go_user->check_auth_simple( i_auth_code = <fs_date_auth>-authcode ) eq abap_false.
            screen-input = '0'.
            modify screen.
            data(lv_no_edit) = abap_true.
            continue.
          endif.
        elseif screen-name = '/SOPROMET/ZZLS01-OPTIM' and lv_no_edit = abap_true.
          screen-input = '0'.
          modify screen.
        endif.
        clear lv_no_edit.
      endloop.
    endloop.
  endmethod.


  method CHECK_CASE_DATE_AUTH_RES.
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*


    data: ls_reservation type /sopromet/zzlrv,
          r_fieldname    type /bitmym/panel_fieldname,
          lt_date_auth   type /bitmym/date_auth_t.


    check go_act_reservation is bound.
    go_act_reservation->get_property( exporting i_feld  = 'G_RESERVATION' importing e_value = ls_reservation ).

    lt_date_auth = get_dates_customizing( ).

    loop at lt_date_auth assigning FIELD-SYMBOL(<fs_date_auth>) where rscat ne /sopromet/cl_l_reservation=>c_rscat_b.
      r_fieldname =  get_date_fieldname( i_date_code = <fs_date_auth>-date_auth ).

      replace '/BITMYM/CASE' in r_fieldname with '/SOPROMET/ZZLS01'.
      loop at screen .
        check screen-name = r_fieldname or screen-name = '/SOPROMET/ZZLS01-OPTIM'.
        if screen-name = r_fieldname.
          check go_user is bound.
          if go_user->check_auth_simple( i_auth_code = <fs_date_auth>-authcode ) eq abap_false.
            screen-input = '0'.
            modify screen.
            DATA(lv_no_edit) = abap_true.
            continue.
          endif.
        elseif screen-name = '/SOPROMET/ZZLS01-OPTIM' and lv_no_edit = abap_true.
          screen-input = '0'.
          modify screen.
        endif.
        clear lv_no_edit.
      endloop.
    endloop.
  endmethod.


  method DISPLAY_POPUP_DELV_DATE_INPAST.
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*

    check gs_comwa-delv_date_inpast is not initial.

    message i532(/sopromet/zl) DISPLAY LIKE 'I' .
    call_message( ).
    clear : gs_comwa-delv_date_inpast.

  endmethod.


  METHOD get_dates_customizing.
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*


    DATA: ls_reservation TYPE /sopromet/zzlrv.
    CHECK go_act_reservation IS BOUND.
    go_act_reservation->get_property( EXPORTING i_feld  = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).

    IF gt_date_auth IS INITIAL.
      SELECT * FROM /bitmym/dat_auth INTO TABLE gt_date_auth.
    ENDIF.

    LOOP AT gt_date_auth ASSIGNING FIELD-SYMBOL(<fs_date_auth>)
            WHERE vkorg = ls_reservation-vkorg
              AND   vtweg = ls_reservation-vtweg
              AND   spart = ls_reservation-spart
              AND   rstyp = gs_case-rstyp   "@ls_reservation-rstyp
              AND  ( rscat = ls_reservation-rscat OR rscat = space )
              AND   authcode NE space.
      APPEND <fs_date_auth> TO rt_date_auth.
    ENDLOOP.

  ENDMETHOD.


  method GET_DATE_FIELDNAME.
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*

    check i_date_code is not initial.
    select single field from /bitmym/datfield into r_fieldname
      where date_auth = i_date_code.
  endmethod.


  METHOD we_demoset_auto_additem_res.
*___ SR1-775, User: SBADUSHA, Date: 08.06.2023___*
*___ SR1-775, User: SBADUSHA, Date: 14.11.2023___*

    DATA : ls_reservation  TYPE /sopromet/zzlrv,
           ls_res_type     TYPE /sopromet/rstypo,
           lt_reservations TYPE /sopromet/ty_tree_map_tab,
           ls_type         TYPE /sopromet/rstype,
           lo_res_type     TYPE REF TO /sopromet/cl_l_res_type. "G_RESERVATION_TYPE

    CHECK go_act_reservation IS BOUND.
    go_act_reservation->get_property( EXPORTING i_feld  = 'G_RESERVATION_TYPE' IMPORTING e_value = lo_res_type ).  "SR1-775

    IF lo_res_type IS BOUND.    "SR1-775
      DATA(ls_data) = lo_res_type->get_data( ). "SR1-775


      CHECK ls_data-g_res_type-demo_relevant = abap_true AND ls_data-gs_rstypo-auto_additem_res IS NOT INITIAL.  "SR1-775



*& Begin of Comment SR1-775
*    go_act_reservation->get_property( EXPORTING i_feld  = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).
*
*    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
*      EXPORTING
*        i_rstyp = ls_reservation-rstyp
*      IMPORTING
*        e_data  = ls_type.
*
*
*    CHECK ls_type-demo_relevant EQ abap_true.
*
*    lt_reservations = gt_reservations.
*
*    LOOP AT lt_reservations ASSIGNING FIELD-SYMBOL(<fs_reservations>) WHERE kzsir IS INITIAL.
*      <fs_reservations>-objkey->get_property( EXPORTING i_feld  = 'GS_RSTYP_VKORG' IMPORTING e_value = ls_res_type ).
*    ENDLOOP.
**    go_act_reservation->get_property( exporting i_feld  = 'GS_RSTYP_VKORG' importing e_value = ls_res_type ).
*
*    CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
*      EXPORTING
*        i_rstyp = ls_reservation-rstyp
*        i_vkorg = ls_reservation-vkorg
*      IMPORTING
*        e_data  = ls_res_type.
*
*    CHECK ls_res_type-auto_additem_res IS NOT INITIAL.
*& End of Comment SR1-775

    CHECK we_add_items_closed( ) EQ abap_true.

    ENDIF.  "SR1-775
  ENDMETHOD.


METHOD chg_doc_pfunc_display.
*___ SR1-1634, User: VGOYAL, Date: 01.09.2023___*
*___ SR2-1030, User: OOGUR, Date: 30.10.2024___*

  DATA:ls_range TYPE /bitmym/change_document_log.           "SR2-1030


*____SR2-1030____BEGIN INSERT___*

  CHECK gs_case IS NOT INITIAL.

  ls_range-it_objekt   = VALUE #( ( sign = 'I' opt = 'EQ' low = gc_tabname_vbpa ) ).
  ls_range-it_objektid = VALUE #( ( sign = 'I' opt = 'CP' low = gs_case-vkorg && gs_case-zzlrsam && '*'  ) ).
  ls_range-it_tabname  = VALUE #( ( sign = 'I' opt = 'EQ' low = gc_tabname_vbpa ) ).
  ls_range-it_tabkey   = VALUE #( ( sign = 'I' opt = 'CP' low = sy-mandt && gs_case-vkorg && gs_case-zzlrsam && '*'  ) ).

  CHECK ls_range IS NOT INITIAL.
  /bitmym/cl_changedocument=>create( is_range = ls_range )->start( ).

*____SR2-1030____END   INSERT___*


*____SR2-1030____BEGIN COMMENT___*
*  DATA: ls_seltab TYPE rsparams,
*        lt_seltab TYPE STANDARD TABLE OF rsparams.
*
*  DATA: tabkey    TYPE cdpos-tabkey.
*
*  MOVE 'OBJEKT'       TO ls_seltab-selname.
*  MOVE 'P'            TO ls_seltab-kind.
*  MOVE 'I'            TO ls_seltab-sign.
*  MOVE 'EQ'           TO ls_seltab-option.
*  MOVE '/BITMYM/VBPA' TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'OBJEKTID'   TO ls_seltab-selname.
*  CONCATENATE gs_case-vkorg gs_case-zzlrsam '*' INTO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'ZEIT'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'DATUM'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'AENDERER'   TO ls_seltab-selname.
*  MOVE space  TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'TABNAME'         TO ls_seltab-selname.
*  MOVE '/BITMYM/VBPA'    TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
*  MOVE 'TABKEY'    TO ls_seltab-selname.
*  CONCATENATE sy-mandt gs_case-vkorg gs_case-zzlrsam '*' INTO tabkey.
*  MOVE tabkey      TO ls_seltab-low.
*  APPEND ls_seltab TO lt_seltab.
*
**---> Aufruf Report RSSCD100 für Lesen Änderungsbelege
*  SUBMIT RSSCD100
*                     WITH SELECTION-TABLE lt_seltab
*                     AND RETURN.
*____SR2-1030____END   COMMENT___*





ENDMETHOD.


