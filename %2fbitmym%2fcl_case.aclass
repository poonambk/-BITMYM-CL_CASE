ENDMETHOD.


  METHOD determine_partner_tab_mode.
*____HS# 11948, VON: S.Taori, DATUM: 03.07.2017 ___*
*___ SR2-786, User: RJANGA, Date: 12.09.2024___*

    DATA: ld_status       TYPE tj30t-txt04.
    FIELD-SYMBOLS: <res>  TYPE /sopromet/ty_tree_map.

    ed_return = abap_false.

    LOOP AT gt_reservations ASSIGNING <res>.
      CHECK <res>-objkey IS BOUND.
      ld_status = <res>-objkey->get_user_status( ).

*____SR2-786____BEGIN INSERT___*
*-> Get Reservation category
      DATA(g_reservation_data) = <res>-objkey->get_data( ).
      CASE g_reservation_data-g_reservation-rscat.

        WHEN /sopromet/cl_l_reservation=>c_rscat_b.

*-> Get the Edit Booking - Partner configuration
          CHECK go_salesarea IS BOUND.
          DATA(g_salesarea) = go_salesarea->get_data( ).
          DATA(ld_edit_partner) = VALUE #( g_salesarea-gt_rstyp_vkorg[ vkorg = g_reservation_data-g_reservation-vkorg
                                                                       rstyp = g_reservation_data-g_reservation-rstyp ]-edit_booking_partners OPTIONAL ).

          "Read the config for Edit Booking Statuses
          DATA(lr_edit_booking_status) = VALUE /bitmym/t_range_txt04( FOR ls_edit_booking IN g_reservation_data-gt_edit_booking_status
                                                                             WHERE ( vkorg = g_reservation_data-g_reservation-vkorg
                                                                               AND   rstyp = g_reservation_data-g_reservation-rstyp )
                                                                                  (   sign = c_sign_i
                                                                                    option = c_option_eq
                                                                                       low = ls_edit_booking-booking_status ) ).

          CHECK ld_edit_partner IS INITIAL OR ld_status NOT IN lr_edit_booking_status.

        WHEN OTHERS.
*____SR2-786____END   INSERT___*

          CHECK ld_status = /sopromet/cl_l_reservation=>c_res_status_ausgeliefert OR
                ld_status = /sopromet/cl_l_reservation=>c_res_status_cleaned      OR
                ld_status = /sopromet/cl_l_reservation=>c_res_status_geprueft     OR
                ld_status = /sopromet/cl_l_reservation=>c_res_status_kunde        OR
                ld_status = /sopromet/cl_l_reservation=>c_res_status_verkauft     OR
                ld_status = /sopromet/cl_l_reservation=>c_res_status_zurueck.

      ENDCASE.                                "SR-786

      ed_return = abap_true.
      EXIT.
    ENDLOOP.

  ENDMETHOD.


  METHOD check_field_inventory.
*____HS# 014095, VON: TKERN, DATUM: 13.05.2020___*
*____HS# 014671, VON: SISMAIL, DATUM: 09.12.2020___*

    DATA: ls_res       TYPE /sopromet/zzlrv,
          ls_comwa     TYPE /sopromet/zzls01,
          ls_comwa_sav TYPE /sopromet/zzls01,
          ls_rstype    TYPE /sopromet/rstype,
          lo_rstyp     TYPE REF TO /sopromet/cl_l_res_type.

    FIELD-SYMBOLS: <mat> LIKE LINE OF gt_mat_selection.


    CHECK  go_act_reservation IS NOT INITIAL AND gs_comwa-rscat = '' AND gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.

    go_act_reservation->get_reservation_data(
       IMPORTING
         e_reservation              = ls_res ).

    CHECK sy-subrc EQ 0 AND ls_res-field_inv IS INITIAL.

    READ TABLE gt_mat_selection ASSIGNING <mat> WITH KEY
      equnr = ls_res-equnr.

    CHECK <mat> IS ASSIGNED AND <mat>-field_inv EQ abap_true.

    CREATE OBJECT lo_rstyp
      EXPORTING
        i_rstyp = gs_comwa-rstyp.

    ls_rstype = lo_rstyp->get_rstype_field_inv( ).

    CHECK ls_rstype IS NOT INITIAL.

    go_act_reservation->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).

    MOVE-CORRESPONDING gs_comwa TO ls_comwa.

    ls_comwa-rstyp     = ls_rstype-rstyp.
    ls_comwa-field_inv = <mat>-field_inv.
    ls_comwa-srcrs     = <mat>-srcrs.                       "HS# 14672

    go_act_reservation->set_property( i_feld = 'GS_COMWA' i_value = ls_comwa ).

    ls_comwa = go_act_reservation->day_compute_days_70( ).

ENHANCEMENT-POINT CHECK_FIELD_IVENTORY_01 SPOTS /BITMYM/CL_CASE .

    go_act_reservation->set_property( i_feld = 'GS_COMWA' i_value = ls_comwa ).

  ENDMETHOD.


  METHOD ui5_get_surgery_type_text.
*____HS# 015455, VON: SSINGH, DATUM: 14.06.2021___*
*____HS# 016358, VON: SSINGH, DATUM: 07.01.2022___*

    DATA : lt_sutyp_txt TYPE /bitmym/sutyp_tatt,
           lt_surtypv   TYPE TABLE OF /bitmym/sa_surty,                 "HS 016358
           ls_area      TYPE /sopromet/zzl01,                           "HS 016358
           l_tabix      TYPE sy-tabix,                                  "HS 016358
           lo_sales_area      TYPE REF TO /sopromet/cl_l_salesarea,     "HS 016358
           l_langu      TYPE sy-langu.

    get_property io_ui5 'GD_LANGUAGE' l_langu.

    SELECT * FROM /bitmym/sutyp_tt INTO TABLE lt_sutyp_txt
      WHERE spras  = l_langu.

*   begin of HS 16358
    get_property io_ui5 'GO_SALES_AREA' lo_sales_area.
    IF lo_sales_area IS BOUND.
      get_property lo_sales_area 'GS_ACTUAL_AREA' ls_area.
    ENDIF.
    SELECT * FROM /bitmym/sa_surty
       INTO TABLE lt_surtypv
      WHERE vkorg = ls_area-vkorg
        AND vtweg = ls_area-vtweg
        AND spart = ls_area-spart.
    IF sy-subrc IS INITIAL.
      LOOP AT lt_sutyp_txt ASSIGNING FIELD-SYMBOL(<fs_txt>).
        l_tabix = sy-tabix.
        READ TABLE lt_surtypv WITH KEY sutyp = <fs_txt>-sutyp TRANSPORTING NO FIELDS.
        CHECK sy-subrc NE 0.
        DELETE lt_sutyp_txt INDEX l_tabix.
      ENDLOOP.
    ENDIF.
*   end of HS 16358

    MOVE-CORRESPONDING lt_sutyp_txt TO et_entityset.

  ENDMETHOD.


  METHOD ui5_s4h_create_booking_int.
*____HS# 015080, VON: SISMAIL, DATUM: 01.06.2021___*
*____HS# 015884, VON: OPECHARROMAN, DATUM: 26.08.2021___*
*___ SR1-1987, User: PKSHIRSAGAR, Date: 30.11.2023___*
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*
*___ SR2-259, User: STEKDEMIR, Date: 10.04.2024___*
*___ SR2-2113, User: STEKDEMIR, Date: 24.07.2025___*

    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.

    DATA: ls_zzlrv       TYPE /sopromet/zzlrv,
          lt_items       TYPE TABLE OF  /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
          lt_partners    TYPE TABLE OF  /bitmym/cl_srep_srv_vr_mpc_ext=>ts_partner, "SR1-2098
          lt_notes       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>tt_notes,
          ls_comwa_appl  TYPE /sopromet/zzls01,
          ls_date_data   TYPE /bitmym/case_common_date,
          ls_copy_fields TYPE /bitmym/ic_book_create_fields,
          ls_date        TYPE /bitmym/s4h_convert_dates_st,
          ld_check       TYPE abap_bool.

*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    gd_simulate = ls_data_ui5-simulation.

    MOVE-CORRESPONDING ls_data_ui5 TO ls_zzlrv.

    lt_items = ls_data_ui5-bookingtobookingitem.
    lt_notes = ls_data_ui5-bookingtonotes.


*___Step 2: Fill CASE COMWA + APPL COMWA
    get_property go_appl 'GS_COMWA' ls_comwa_appl .

    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_b.
    gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.

*___START OF HS# 015884
*   add new fields to be passed from the input structure and
*   change so we use structure /BITMYM/IC_BOOK_CREATE_FIELDS
*   to define the relevant fields to be copied
*   Create new method to make date conversion and call the new method
    MOVE-CORRESPONDING ls_data_ui5 TO ls_copy_fields.
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.

* move odata service dates to common date structure
    MOVE-CORRESPONDING ls_data_ui5 TO ls_date.
    ls_date-kunnr = gs_comwa-kunnr.                         "HS 15801

    /bitmym/cl_ui5_util=>convert_times_to_stamps( CHANGING cs_data = ls_date ).

    MOVE-CORRESPONDING ls_date TO gs_comwa.
*___END OF HS# 015884

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application


    gs_case-redat  = ls_data_ui5-redat.                     "SR1-1987
    gs_case-rsdat =  ls_data_ui5-rsdat.                     "SR1-1987

    lt_partners = ls_data_ui5-bookingtopartner.             "SR1-2098

*___Step 3: Partner determination
*    CHECK ui5_prep_booking_partner( id_no_add_srep = abap_true ) EQ abap_true.                           "SR1-2098-
    CHECK ui5_prep_booking_partner( id_no_add_srep = abap_true it_ui5_vbpa = lt_partners ) EQ abap_true. "SR1-2098+

*   Date calculation not required. Dates come from front end
*___Step 4: Add booking items
    ui5_prep_booking_items( IMPORTING ed_success = ld_check CHANGING ct_items = ls_data_ui5-bookingtobookingitem ).

*___Step 5: Init sequence for a new case
    create_new_case( ).

*____SR2-2113____BEGIN COMMENT___*
**____SR2-259____BEGIN INSERT___*
**___Step 6: Determinate shipping condition based on sold-to or ship-to
*    DATA(ls_salesarea_data) = go_salesarea->get_data( ).
*    READ TABLE ls_salesarea_data-gt_rstyp_vkorg INTO DATA(ls_rstype) WITH KEY vkorg = gs_actual_area-vkorg rstyp = gs_comwa-rstyp.
*    IF sy-subrc = 0.
*      /bitmym/cl_ui5_s4h_icotermsget=>get_ship_cond_from_part( EXPORTING iv_kunwe        = ls_data_ui5-kunwe
*                                                                         iv_kunnr        = ls_data_ui5-kunnr
*                                                                         iv_kunwe_filter = ls_data_ui5-kunwe
*                                                                         is_actual_area  = gs_actual_area
*                                                                         iv_shcond_conf  = ls_rstype-ship_cond_src
*                                                                CHANGING cv_vsbeb        = gs_comwa-vsbeb
*                                                                         cv_vtext        = gs_comwa-vtext ).
*    ENDIF.
**____SR2-259____END   INSERT___*
*____SR2-2113____END   COMMENT___*

*___Step 7: Build Tree
    ui5_prep_reservation_tree( i_add_res = abap_true is_data = ls_zzlrv ).

*___Step 8: Prepare Text
    ui5_prep_booking_notes( it_notes = lt_notes ).

*___Step 9- Fill contract details for booking
    ls_data_ui5-contract =  rental_get_contract_book( ).    "SR1-1987

*___Step 10: Post Booking (Simulation considered)
    CHECK ui5_post_booking( ) EQ abap_true.

*___Step 11: Fill Return Daten
    ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).


  ENDMETHOD.


METHOD enqueue.
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 11864, VON: O.Pecharroman       DATUM: 24.05.2017 ___*
*____HS# 012451, VON: OPECHARROMAN, DATUM: 14.06.2018___*
*___ SR2-718, User: RJANGA, Date: 01.08.2024___*

* We create a new static method that can call without the case instance.
* Init HS# 012451

*  e_enqueue = abap_true.
*
*  check gs_case-zzlrsam is not INITIAL.                "HS# 11864
*
*  CALL FUNCTION 'ENQUEUE_/BITMYM/ECASE'
*    EXPORTING
*      mode_/bitmym/case = 'E'
*      mandt             = sy-mandt
*      vkorg             = gs_case-vkorg
*      zzlrsam           = gs_case-zzlrsam
*    EXCEPTIONS
*      foreign_lock      = 1
*      system_failure    = 2
*      OTHERS            = 3.
*
*  IF sy-subrc <> 0.
*    MESSAGE ID sy-msgid TYPE 'I' NUMBER sy-msgno
*            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
*            INTO gd_dummy_message.                          "HS# 11637
*    call_message.                                           "HS# 11637
*    e_enqueue = abap_false.
*  ENDIF.

  e_enqueue = enqueue_ext( i_vkorg   = gs_case-vkorg
                           i_zzlrsam = gs_case-zzlrsam
                           i_zzlresn = gs_comwa-zzlresn               "SR2-718
                           i_rscat   = gs_case-rscat ).               "SR2-718
* End HS# 012451

*____SR2-718____BEGIN INSERT___*

  CHECK e_enqueue = abap_true.

*Get the Booking CombinedRun WRT to Reservation CombinedRun & vice-versa.
  get_booking_res_details( ).

  e_enqueue = enqueue_ext( i_vkorg   = gs_case-vkorg
                           i_zzlrsam = gd_dependent_combinedrun
                           i_zzlresn = gd_dependent_reservation
                           i_rscat   = gd_dependent_rscat ).

*____SR2-718____END   INSERT___*

ENDMETHOD.


METHOD enqueue_ext.
*____HS# 012451, VON: OPECHARROMAN, DATUM: 14.06.2018___*
*____HS# 012677, VON: OPECHARROMAN, DATUM: 20.11.2018___*
*___ SR2-718, User: RJANGA, Date: 10.09.2024___*
*___ SR2-718, User: STEKDEMIR, Date: 17.10.2024___*

* We create a new static method that can be called without the case instance.
* We also add a new message so the combine run number is displayed in the error. Previosly it did not mentioned what combine run was locked
  DATA: x_gname  TYPE seqg3-gname,
        x_gtarg  TYPE seqg3-gtarg,
        x_guname TYPE seqg3-guname,
        ld_msgv1 TYPE sy-msgv1,
        t_enq    TYPE STANDARD TABLE OF seqg3.

  e_enqueue = abap_true.

  CHECK i_zzlrsam IS NOT INITIAL.

  CALL FUNCTION 'ENQUEUE_/BITMYM/ECASE'
    EXPORTING
      mode_/bitmym/case = i_mode
      mandt             = sy-mandt
      vkorg             = i_vkorg
      zzlrsam           = i_zzlrsam
      _scope            = '1'     " HS 12677 Do not releazse lock after commit
    EXCEPTIONS
      foreign_lock      = 1
      system_failure    = 2
      OTHERS            = 3.

  IF sy-subrc <> 0.
    ld_msgv1 = sy-msgv1. " As it is pass by reference to the method, in case it changes during the execution we lost the valud of sy-msgv1. We pass a veriable instead
    CASE i_msgty.
      WHEN 'E'.
*        /bitmym/cl_message=>message( id = 'E473(/SOPROMET/ZL)' v1 = i_zzlrsam v2 = i_vkorg v3 = ld_msgv1 io_log = io_log )."SR2-718 STEKDEMIR
        MESSAGE e921(/sopromet/zl) INTO DATA(dummy).                              "With this it can be found with where used SR2-718 STEKDEMIR
        /bitmym/cl_message=>message( id = 'E921(/SOPROMET/ZL)' v1 = ld_msgv1 io_log = io_log ).                             "SR2-718 STEKDEMIR
      WHEN OTHERS.
*        /bitmym/cl_message=>message( id = 'I473(/SOPROMET/ZL)' v1 = i_zzlrsam v2 = i_vkorg v3 = ld_msgv1 io_log = io_log )."SR2-718 STEKDEMIR
        MESSAGE e921(/sopromet/zl) INTO dummy.                                    "With this it can be found with where used SR2-718 STEKDEMIR
        /bitmym/cl_message=>message( id = 'I921(/SOPROMET/ZL)' v1 = ld_msgv1 io_log = io_log ).                             "SR2-718 STEKDEMIR
    ENDCASE.
    e_enqueue = abap_false. " Return that it is not enqueu
  ENDIF.


ENDMETHOD.


METHOD equipment_auswahl_h.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*
*____HS# 017121, VON: BGUNAWAN, DATUM: 15.12.2022___*

  DATA: ld_select    VALUE 'X',
        ld_first     TYPE tv_nodekey,
        ld_map       TYPE /sopromet/ty_tree_map,
        lt_sel_matnr TYPE /sopromet/zzls07_tab. "HS# 017121
* B.Ludwig, 28.01.2014, HS 9781

  e_equi_selected = abap_false.

  IF gd_single_only IS INITIAL.

    get_property go_appl 'GT_SEL_MATNR'   lt_sel_matnr.             "HS# 017121
    fill_booking_serial_no_atp( CHANGING ct_matnr = lt_sel_matnr ). "HS# 017121
    set_property go_appl 'GT_SEL_MATNR'   lt_sel_matnr.             "HS# 017121

*___Sets selektieren

*___Plantafel / ATP 2.0
*    gt_mat_selection = /bitmym/cl_bar_chart=>display_atp_from_case( me ).                          "HS 14145

    gt_mat_selection = /bitmym/cl_bar_chart=>display_atp_from_case( io_case     = me                "HS 14145
                                                                    i_view_type = gd_atp_view ).    "HS 14145

*___Plantafel / ATP 1.0
*   gt_mat_selection = go_main_2006->get_equipment_list( ld_select ).

    IF gt_mat_selection IS NOT INITIAL.
ENHANCEMENT-POINT EQUIPMENT_AUSWAHL_01 SPOTS /BITMYM/CASE .
      e_equi_selected = abap_true.
    ELSE.
      go_appl->clear_material_selection( ).
    ENDIF.

    IF gd_mixed IS NOT INITIAL.
      e_equi_selected = perpare_single_item( ).
    ENDIF.

  ELSE.
*___Nur Single item anlegen
    e_equi_selected = perpare_single_item( ).
  ENDIF.

ENDMETHOD.


