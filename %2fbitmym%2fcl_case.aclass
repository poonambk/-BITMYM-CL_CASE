  ENDMETHOD.


  METHOD prep_case_partner_generic.
*____HS# 013195, VON: PKUNAL, DATUM: 05.07.2019___*
*___ SR1-1164, User: OPECHARROMAN, Date: 02.05.2023___*


    DATA: ls_vbpa_new TYPE /bitmym/vbpa,
          l_parnr_new TYPE sd_partner_parnr.

    FIELD-SYMBOLS: <partner> TYPE any.

    ed_success = partner_selection( id_no_dialog = abap_true ).

    CHECK ed_success = abap_true.
    partner_put_data( ).
*    partner_get_data( ).                                    "SR1-1164

    LOOP AT it_partners ASSIGNING <partner>.
      CLEAR ls_vbpa_new.
      MOVE-CORRESPONDING <partner> TO ls_vbpa_new.
      l_parnr_new = ls_vbpa_new-kunnr.

      go_partner->add_partner_generic(  i_parvw = ls_vbpa_new-parvw
                                        i_partner_new = l_parnr_new
                                        i_overwrite = abap_true ).

    ENDLOOP.

    partner_get_data( ).                                    "SR1-1164

  ENDMETHOD.


