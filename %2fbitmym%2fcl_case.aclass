METHOD transfer_post.
*____HS# 9929, VON: Mknauer, DATUM: 12.05.2014____*
*____HS# 9976, VON: Mknauer, DATUM: 17.06.2014____*
*____HS# 11391, VON: G.Ivanov,      DATUM: 20.09.2016 ___*
*____HS# 013064, VON: GIVANOV, DATUM: 03/12/2019___*
*____HS# 013067, VON: GIVANOV, DATUM: 03/12/2019___*
*____HS# 013374, VON: STAORI,  DATUM: 16.08.2019___*

  DATA: ld_rfc TYPE rfcdest,
        ls_01  TYPE /sopromet/zzl00.

  DATA: lo_transfer TYPE REF TO /bitmym/cl_field_transfer,
        lo_psd      TYPE REF TO /bitmym/cl_psd,
        ls_psd_key  TYPE /bitmym/psdml,
        ld_lgort    TYPE vbap-lgort.

  DATA: ls_equi       TYPE rihequi,
        ls_eqbs       TYPE eqbs,
        ls_res_source TYPE /sopromet/zzlrv,
        ls_comwa      TYPE /sopromet/zzls01.

  DATA: lt_vbpa           TYPE /sopromet/vbpav_tab.

  DATA: lt_transfer     TYPE /bitmym/alv_transfer_sets_tab, "HS# 9929
        lo_equi         TYPE REF TO /sopromet/cl_l_equipment, "HS# 9929
        lt_single_items TYPE /bitmym/alv_transfer_sets_t2,
        ls_item         TYPE /sopromet/zzls04,
        ls_item_mm      TYPE bapi2017_gm_item_create,
        ls_area         TYPE /sopromet/zzl01.

  DATA: ld_booking_date     TYPE datum.                     "HS 11391

  FIELD-SYMBOLS: <vbpa>     TYPE vbpav,
                 <transfer> TYPE /bitmym/alv_transfer_sets_alv, "HS# 9929
                 <single>   TYPE /bitmym/alv_transfer_sets.

  CHECK id_transfer EQ abap_true.

  get_property me 'GO_TRANSFER' lo_transfer.
  CHECK lo_transfer IS BOUND.
*___Transferobjekt ist vorhanden

  IF go_salesarea IS BOUND.
    get_property go_salesarea 'GS_ACTUAL_AREA' ls_area.
  ENDIF.

  get_property lo_transfer 'GT_TRANSFER_SEL' lt_transfer.   "HS# 9929

*___Kudennummer / SB für Zielreservierung
  go_partner->get_property( EXPORTING i_feld = 'GT_VBPA' IMPORTING e_value = lt_vbpa ).
  READ TABLE lt_vbpa ASSIGNING <vbpa> WITH KEY parvw = 'SB'.
  IF sy-subrc IS NOT INITIAL.
    READ TABLE lt_vbpa ASSIGNING <vbpa> WITH KEY parvw = 'AG'.
  ENDIF.

  ls_comwa = is_comwa.

  IF lt_transfer IS INITIAL.                                "HS# 9929
*___Transfer ohne Referenz/Vorgängerbeleg
    get_property lo_transfer 'GS_EQUI'  ls_equi.
    get_property lo_transfer 'GS_EQBS'  ls_eqbs.
    get_property lo_transfer 'GS_ZZLRV' ls_res_source.
  ELSE.                                                     "HS# 9929
*___Transfer mit Referenz/Vorgängerbeleg                    "HS# 9929
    READ TABLE lt_transfer ASSIGNING <transfer>             "HS# 9929
               WITH KEY lresn = is_comwa-srcrs.             "HS# 9929
                                                            "HS# 9929
    IF sy-subrc EQ 0.                                       "HS# 9929
      <transfer>-oreserv->get_reservation_data(             "HS# 9929
         IMPORTING                                          "HS# 9929
          e_reservation = ls_res_source                     "HS# 9929
          e_equipment   = lo_equi ).                        "HS# 9929
                                                            "HS# 9929
      ls_equi = lo_equi->exp_equi_data( ).                  "HS# 9929
      ls_eqbs = lo_equi->get_eqbs( ).                       "HS# 9929
    ENDIF.                                                  "HS# 9929
  ENDIF.                                                    "HS# 9929

  ld_rfc        = /sopromet/rfc=>g_rfc.
  ls_01-tqueue  = 'X'.

*___Lagerortfindung
  IF it_single_items IS INITIAL.
*___Standardset
    CALL METHOD /bitmym/cl_psd=>create
      EXPORTING
        i_vkorg   = ls_equi-vkorg
        i_vtweg   = ls_equi-vtweg
        i_spart   = ls_equi-spart
*       i_vgart   = /sopromet/cl_l_order_type=>c_vgart_we   "HS 13374
        i_vgart   = /sopromet/cl_l_order_type=>c_vgart_ft   "HS 13374
      IMPORTING
        e_ref_psd = lo_psd.

    MOVE-CORRESPONDING ls_equi TO ls_psd_key.
    ls_psd_key-swerk = ls_eqbs-b_werk.                      "HS# 9976
    ls_psd_key-posart = 'H'.    "Hauptposition
    set_property lo_psd 'GS_PSDML' ls_psd_key.
    lo_psd->start_psd( ).
    get_property lo_psd 'G_LGORT' ld_lgort.
  ELSE.
*___Single Items
    lt_single_items = it_single_items.

  ENDIF.

ENHANCEMENT-POINT transfer_post_01 SPOTS /bitmym/case .

*___Queue initialisieren
*  IF it_single_items IS INITIAL.                            "HS# 013067 Commented
  IF ls_comwa-kzsir   IS INITIAL.                           "HS# 013067
    /sopromet/rfc=>set_queue( i_equi = ls_equi-equnr ).
  ELSE.
    /sopromet/rfc=>set_queue( i_lresn = ls_res_source-zzlresn ).
  ENDIF.

ENHANCEMENT-POINT transfer_post_02 SPOTS /bitmym/case .

*___Zurückbuchen
  ##ec_enhok
  CALL FUNCTION '/BITMYM/FT_POST_GR'
    IN BACKGROUND TASK DESTINATION ld_rfc
    EXPORTING
      i_reservation_to   = ls_comwa-zzlresn
      i_reservation_from = ls_res_source-zzlresn
      i_eqbs             = ls_eqbs
      i_rihequi          = ls_equi                          "#EC ENHOK
      i_lgort            = ld_lgort
      it_single_items    = lt_single_items
      is_area            = ls_area
      id_booking_date    = ld_booking_date.                 "HS# 11391 GND

ENHANCEMENT-POINT transfer_post_03 SPOTS /bitmym/case .

*___Ausbuchen
  CALL FUNCTION '/BITMYM/FT_POST_GI'
    IN BACKGROUND TASK DESTINATION ld_rfc
    EXPORTING
      i_reservation_to   = ls_comwa-zzlresn
      i_reservation_from = ls_res_source-zzlresn
      i_eqbs             = ls_eqbs                          "#EC ENHOK
      i_rihequi          = ls_equi                          "#EC ENHOK
      id_kunnr           = <vbpa>-kunnr
      i_lgort            = ld_lgort
      it_single_items    = lt_single_items
      is_area            = ls_area
      id_booking_date    = ld_booking_date.                 "HS# 11391 GND

*____HS# 013064 Begin

  CALL FUNCTION '/BITMYM/CASE_SET_RELEASED'
    IN UPDATE TASK
    EXPORTING
      i_lresn = ls_comwa-zzlresn. "destination reservation

*____HS# 013064 End

ENHANCEMENT-POINT transfer_post_04 SPOTS /bitmym/case .

ENDMETHOD.


  METHOD get_equipment_list_check_si.
*____HS# 12775, VON: G.Ivanov, DATUM: 06.11.2018 ___Created*

*   Get equipments from reservations belonging to a case

    DATA: ls_reservation     TYPE /sopromet/zzlrv,
          lv_user_status     TYPE tj30t-txt04,
          ls_act_reservation TYPE /sopromet/zzlrv.

    FIELD-SYMBOLS: <fs_reservation> TYPE /sopromet/ty_tree_map.

    ev_success = abap_false.

    READ TABLE gt_reservations ASSIGNING <fs_reservation> WITH KEY lresrv = iv_lresn.
    CHECK sy-subrc IS INITIAL.

    <fs_reservation>-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_reservation ).
*    Do single item transfer only for the current reservation and only if it is not cancelled
    IF go_act_reservation IS BOUND.
      go_act_reservation->get_property( EXPORTING i_feld = 'G_RESERVATION' IMPORTING e_value = ls_act_reservation ).
    ENDIF.

    CHECK: ls_act_reservation-zzlresn = iv_lresn,
           <fs_reservation>-abgru IS INITIAL,
           ls_reservation-kzsir   IS NOT INITIAL,
           ls_reservation-kzper   IS INITIAL.

    ev_success = abap_true.

  ENDMETHOD.


METHOD tree_case_on_off.
  go_tree_case->show_hide_tree( ).
ENDMETHOD.


METHOD tree_flow_on_off.
  go_tree_flow->show_hide_tree( ).
ENDMETHOD.


