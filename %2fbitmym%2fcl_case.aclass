ENDMETHOD.


METHOD cleanup_data.
  IF go_tree_flow IS NOT INITIAL.
    go_tree_flow->init_controls( ).
    CLEAR go_tree_flow.
  ENDIF.

  IF go_tree_case IS NOT INITIAL.
    go_tree_case->init_controls( ).
    CLEAR go_tree_case.
  ENDIF.
ENDMETHOD.


  METHOD compute_dates.
*____HS# 12094, VON: MKnauer, DATUM: 06.10.2017 ___*
*____HS# 12010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 12461, VON: SSingh,  DATUM: 18.04.2018___*
*____HS# 12469, VON: MKNAUER, DATUM: 29.06.2018___*
*____HS# 12729, VON: STAORI,  DATUM: 11.10.2018___*
*____HS# 013137, VON: OPECHARROMAN, DATUM: 15.05.2019___*
*____HS# 12765, VON: DENDRES, DATUM: 02.09.2019___*
*____HS# 013903, VON: OPECHARROMAN, DATUM: 20.02.2020___*
*____HS# 015124, VON: OPECHARROMAN, DATUM: 18.05.2021___*
*____HS# 016601, VON: OPECHARROMAN, DATUM: 09.03.2022___*
*____HS# 016825, VON: BGUNAWAN, DATUM: 01.06.2022___*
*____HS# 016944, VON: BGUNAWAN, DATUM: 08.06.2022___*
*____HS# 017003, VON: OPECHARROMAN, DATUM: 07.09.2022___*
*___ SR1-803, User: SBADUSHA, Date: 01.06.2023___*
*___ SR1-1074, User: GIVANOV, Date: 27.06.2023___*
*___ SR2-912, User: STEKDEMIR, Date: 01.10.2024___*
*___ SR2-1089, User: STEKDEMIR, Date: 11.11.2024___*

    DATA: ls_comwa_appl         TYPE /sopromet/zzls01,
          ls_comwa_yy           TYPE /sopromet/zzls01,      "HS 12469
          lo_cal_odate          TYPE REF TO cl_gui_calendar,
          lo_cal_frdat          TYPE REF TO cl_gui_calendar,
          lo_cal_vedat          TYPE REF TO cl_gui_calendar,
          lo_cal_vdate          TYPE REF TO cl_gui_calendar,
          lo_cal_edatu          TYPE REF TO cl_gui_calendar, "SR2-1089
          ls_date_data          TYPE /bitmym/case_common_date,
          lo_res                TYPE REF TO /sopromet/cl_l_reservation,
          ls_comwa_new          TYPE /sopromet/zzls01,
          ld_vdate              TYPE  cnca_utc_date,
          ld_frdat              TYPE  cnca_utc_date,
          ld_vedat              TYPE  cnca_utc_date,
          ld_edatu              TYPE  cnca_utc_date,        "SR2-1089
          ld_booking_standalone TYPE abap_bool.             "HS# 016944

*___Get the application workarea
    get_property go_appl 'GS_COMWA' ls_comwa_appl.

*__Value ls_comwa_appl right now holds the RSTYP and dates values before they were changed
    ls_comwa_yy = ls_comwa_appl.                            "HS 12469

*___Copy data from application to date fields structure
    MOVE-CORRESPONDING ls_comwa_appl TO ls_date_data.
    CLEAR ls_date_data-frdat.

    gs_comwa-rstyp      = cs_comwa-rstyp.
    ls_comwa_appl-rstyp = cs_comwa-rstyp.
    set_property go_appl 'GS_COMWA' ls_comwa_appl.

    go_rstyp = /sopromet/cl_l_res_type=>create( i_vkorg = cs_comwa-vkorg i_rstyp = cs_comwa-rstyp ). "HS# 12469

* Begin of insertion HS# 016944
    go_appl->get_property( EXPORTING i_feld = 'GD_BOOKING_STANDALONE' IMPORTING e_value = ld_booking_standalone ).
    IF ld_booking_standalone = abap_true.
      gs_comwa-kunnr = cs_comwa-kunnr.
      gs_comwa-kunwe = space.
      go_partner = /bitmym/cl_partner=>create( io_case = me ).
      partner_selection( id_no_dialog = abap_true id_suppress_mess = abap_true ).
      partner_put_data( ).
      partner_get_data( ).
    ELSE.
* End of insertion HS# 016944
      IF cs_comwa-kunnr NE ls_comwa_appl-kunnr.
*__New SoldTo => Update CASE Object
        IF cs_comwa-kunnr IS NOT INITIAL.
          gs_comwa-kunnr = cs_comwa-kunnr. "New Sold To
          gs_comwa-kunwe = space.
          go_partner = /bitmym/cl_partner=>create( io_case = me ).
          partner_selection( id_no_dialog = space id_suppress_mess = abap_true ).                       " HS # 12461
          partner_put_data( ).
          partner_get_data( ).
* Start HS# 017003   -->
*     After partner determination, partner data in comwa can be changed. Returned back to comwa paramer
          cs_comwa-kunwe = gs_comwa-kunwe.
          cs_comwa-kunnr = gs_comwa-kunnr.
* End HS# 017003   <--
        ELSE.
          CLEAR: go_partner,
                 gs_comwa-kunnr,
                 gs_comwa-kunwe.                            "HS# 013903
*       Partner info is also cleared out in application class.
          go_appl->set_property( i_feld = 'GS_COMWA-KUNWE' i_value = gs_comwa-kunwe ). "HS# 013903
          go_appl->set_property( i_feld = 'GS_COMWA-KUNNR' i_value = gs_comwa-kunnr ). "HS# 013903
        ENDIF.
      ENDIF.

    ENDIF.                                                  "HS# 016944

*___GET Calendar Controls
    IF g_iconnect EQ abap_false                             "HS# 12010
       AND id_no_calendar IS INITIAL.                       "HS# 015124
      get_calendar( EXPORTING id_calendar = 'GO_CAL_ODATE' IMPORTING eo_calendar = go_cal_odate eo_control = lo_cal_odate ).
      get_calendar( EXPORTING id_calendar = 'GO_CAL_FRDAT' IMPORTING eo_calendar = go_cal_frdat eo_control = lo_cal_frdat ).
      get_calendar( EXPORTING id_calendar = 'GO_CAL_VEDAT' IMPORTING eo_calendar = go_cal_vedat eo_control = lo_cal_vedat ).
      get_calendar( EXPORTING id_calendar = 'GO_CAL_VDATE' IMPORTING eo_calendar = go_cal_vdate eo_control = lo_cal_vdate ).
      get_calendar( EXPORTING id_calendar = 'GO_CAL_EDATU' IMPORTING eo_calendar = go_cal_edatu eo_control = lo_cal_edatu ). "SR2-1089

      IF go_cal_odate IS BOUND.                             "HS# 015124
*___Calculation is executed in Reservation object
        get_property go_cal_odate 'GD_SELECTED_DATE' ls_date_data-odate.  "Date of use
      ENDIF.                                                "HS# 015124
      IF go_cal_vedat IS BOUND.                             "HS# 015124
        get_property go_cal_vedat 'GD_SELECTED_DATE' ls_date_data-vedat.  "End of use date
      ENDIF.                                                "HS# 015124

*____SR2-1089____BEGIN INSERT___*
      IF go_cal_edatu IS BOUND.
        DATA(ls_cal_edatu) = go_cal_edatu->get_data( ).
        ls_date_data-edatu = ls_cal_edatu-gd_selected_date.  "Req. Del. Date
        IF ls_date_data-edatu IS INITIAL.
          ls_date_data-edatu = ls_date_data-odate.
        ENDIF.
      ENDIF.
*____SR2-1089____END   INSERT___*

    ELSE.                                                   "HS# 12010
      ls_date_data-odate = cs_comwa-odate.                  "HS# 12010
      ls_date_data-vedat = cs_comwa-vedat.                  "HS# 12010
      ls_date_data-edatu = cs_comwa-edatu.                  "SR2-1089
      ls_date_data-vdate = cs_comwa-vdate.                  "HS# 12765

*____SR2-912____BEGIN INSERT___*
      IF cs_comwa-edatu IS NOT INITIAL.
        ls_date_data-edatu = cs_comwa-edatu.
      ELSE.
        ls_date_data-edatu = cs_comwa-odate.
      ENDIF.
*____SR2-912____END   INSERT___*

*     No calendar object
      IF id_no_calendar IS NOT INITIAL.                     "HS# 015124
        ls_date_data-frdat = cs_comwa-frdat.                "HS# 015124
      ENDIF.                                                "HS# 015124
    ENDIF.                                                  "HS# 12010

    CREATE OBJECT lo_res.
    set_property lo_res 'GO_APPLICATION' go_appl.

*____SR2-912____BEGIN INSERT___*
    DATA(ls_res_data) = lo_res->get_data( ).
    ls_res_data-go_case = me.
    lo_res->set_data( EXPORTING is_data = ls_res_data ).
*____SR2-912____END   INSERT___*

*___Calculate Days
    IF ls_date_data-odate GT ls_date_data-vedat.
*__If ODATE was changed manually VEDAT might still be old value
      ls_date_data-vedat = ls_date_data-odate.
    ENDIF.

* Start HS# 013137 Comment -->
* Move method to reservation class and split functionality, rental and changes
**__Determine end date based on horizon maintained for rental reservation types
*    go_appl->rental_5002_determine_vedat(                   "HS# 12469
*      EXPORTING
*        io_rstyp_nn = go_rstyp
*        is_comwa_yy = ls_comwa_yy
*        is_comwa_nn = cs_comwa
*        is_date_nn  = ls_date_data ).
* End HS# 013137 Comment -->

* We split the previous method into methods and move it to the res class.
* This method determines if there was a change in the screnn 5002 that needs to recalculate vedat info
    IF g_iconnect EQ abap_false.                            "HS# 12765
      lo_res->check_change_5002_endofuse( EXPORTING is_comwa_yy   = ls_comwa_yy "HS# 013137
                                                    is_comwa_nn   = cs_comwa
                                                    is_date_nn    = ls_date_data
                                                    iv_res_screen = iv_res_screen "SR1-1074
                                                   ).
    ELSE.                                                   "HS# 12765
      lo_res->ui5_check_change_endofuse( EXPORTING is_comwa_yy = ls_comwa_yy "HS# 12765
                                                   is_comwa_nn = cs_comwa
                                                   is_date_nn  = ls_date_data ).
    ENDIF.                                                  "HS# 12765

*    ls_comwa_new = lo_res->day_compute_days_70( EXPORTING is_date_data = ls_date_data ). "HS 12729
    ls_comwa_new = lo_res->day_compute_days_70( is_date_data = ls_date_data ). "HS 12729

*___Set Calculated days in corresponding workareas
    IF ls_comwa_new-vedat IS INITIAL.
      ls_comwa_new-vedat = ls_date_data-odate.
    ENDIF.
    cs_comwa-delv_date_inpast = ls_comwa_new-delv_date_inpast. "SR1-803
    CLEAR gs_comwa-delv_date_inpast.                           "SR1-803
    gs_comwa-delv_date_inpast = ls_comwa_new-delv_date_inpast. "SR1-803
    ld_frdat = ls_comwa_new-frdat.
    ld_vedat = ls_comwa_new-vedat.
    ld_vdate = ls_comwa_new-vdate.
    ld_edatu = ls_comwa_new-edatu.                          "SR2-1089

*____a. Set the new dates in the calender controls
    IF g_iconnect EQ abap_false AND                         "HS# 12010
      id_no_calendar IS INITIAL.                            "HS# 015124
      set_calendar_dates( io_control = lo_cal_frdat io_calendar = go_cal_frdat id_date = ld_frdat ).
      set_calendar_dates( io_control = lo_cal_vdate io_calendar = go_cal_vdate id_date = ld_vdate ).
      set_calendar_dates( io_control = lo_cal_vedat io_calendar = go_cal_vedat id_date = ld_vedat ).
      set_calendar_dates( io_control = lo_cal_edatu io_calendar = go_cal_edatu id_date = ld_edatu ). "SR2-1089
    ENDIF.                                                  "HS# 12010
*___b. COMWA of application
    ls_comwa_new-odate = ls_date_data-odate.
    ls_comwa_new-prsdt = ls_date_data-odate.                "HS# 016825

*____SR2-1089____BEGIN INSERT___*
    IF ls_date_data-edatu IS INITIAL.
      ls_comwa_new-edatu = ls_date_data-odate.
    ELSE.
      ls_comwa_new-edatu = ls_date_data-edatu.
    ENDIF.
*____SR2-1089____END   INSERT___*

    MOVE-CORRESPONDING ls_comwa_new TO ls_comwa_appl.
    set_property go_appl 'GS_COMWA' ls_comwa_appl.

*__c. iCONNECT
    IF g_iconnect EQ abap_true OR                           "HS# 12010
      id_no_calendar IS NOT INITIAL.  "HS# 015124+
*      IF ls_date_data-vdate IS NOT INITIAL AND ls_date_data-vdate LT ls_comwa_new-vdate. "HS# 12765 "HS16601
*        ls_comwa_new-vdate = ls_date_data-vdate.            "HS# 12765 ""HS16601
*      ENDIF.                                                "HS# 12765 ""HS16601
      IF ls_date_data-vtime IS NOT INITIAL.                 "HS# 12765
        ls_comwa_new-vtime = ls_date_data-vtime.            "HS# 12765
      ENDIF.                                                "HS# 12765
      MOVE-CORRESPONDING ls_comwa_new TO ls_date_data.      "HS# 12010
      MOVE-CORRESPONDING ls_date_data TO cs_comwa.          "HS# 12010
    ENDIF.                                                  "HS# 12010

  ENDMETHOD.


METHOD constructor.
*> HS#9774, T.Kern - 05.02.2014
*____HS# 10467, VON: O.PECHARROMAN, DATUM: 06.10.2015____*
*____HS# 11004, VON: S.Taori,       DATUM: 26.01.2016 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM: 14.07.2017 ___*
*____HS# 11923, VON: G.Ivanov,      DATUM: 14.06.2017 ___*
*____HS# 12010, VON: MKnauer,       DATUM: 15.08.2017 ___*
*____HS# 12900, VON: RBOYAPATI,     DATUM: 06.02.2019 ___*
*____HS# 016751, VON: SISMAIL, DATUM: 20.07.2022___*
*____HS# 017041, VON: BGUNAWAN, DATUM: 14.09.2022___*
*___ SR2-54, User: OOGUR, Date: 23.02.2024___*
*___ SR2-54, User: SBADUSHA, Date: 27.06.2024___*
*___ SR2-2015, User: STEKDEMIR, Date: 04.07.2025___* "CLCO-332


  DATA: ls_comwa TYPE /sopromet/zzls01,
        l_vbelv  TYPE vbeln,
        l_ref    TYPE /bitmym/ref_book.                     "HS# 10467

  GET BADI go_badi.    "SR2-2015
  gs_badi-object = me. "SR2-2015

*___COMWA aus Applikation holen
  IF io_appl IS NOT INITIAL.
    io_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = gs_comwa ).
    io_appl->get_property( EXPORTING i_feld = 'G_VBELV' IMPORTING e_value = l_vbelv ).
    io_appl->get_property( EXPORTING i_feld = 'GD_REF_BOOKING' IMPORTING e_value = l_ref ). "HS# 10467
  ENDIF.

  gs_ccpropso = is_ccpropso. "HS# 016751+
  gd_mixed = id_mixed.                                      "HS#9774

  IF gd_mixed IS INITIAL.                                   "HS#9774
    gd_single_only = id_single.
  ELSE.
    gd_single_only = abap_false.
  ENDIF.                                                    "HS#9774

  go_salesarea   = io_area.
  go_appl        = io_appl.
  gd_case        = gs_comwa-zzlrsam = id_case.
  gd_reservation = gs_comwa-zzlresn = id_reservation.

  IF io_ui5 IS BOUND.                                       "HS# 12010
    g_iconnect = abap_true.                                 "HS# 12010
    /bitmym/if_ui5~ui5_fill_context( io_ui5 = io_ui5 ).     "HS# 12010
  ENDIF.

*____SR2-54____BEGIN INSERT___*
*    IF id_rap_framework EQ abap_true.        "SR2-54 DEL
*       gd_rap_framework = id_rap_framework.  "SR2-54 DEL
*    ENDIF.                                   "SR2-54 DEL
*____SR2-54____END   INSERT___*


*___Aktuellen Vertriebsbereich setzen
  set_sales_area( ).

*___UserObject
  IF go_salesarea IS NOT INITIAL.
    go_salesarea->get_property( EXPORTING i_feld = 'GO_USER' IMPORTING e_value = go_user ).
  ENDIF.


  IF go_appl IS BOUND.                                      "HS# 11923
    go_appl->get_property( EXPORTING i_feld = 'GO_MAIN_2006' IMPORTING e_value = go_main_2006 ). "HS# 11923
  ENDIF.                                                    "HS# 11923

*___Reservierung lesen
*  CHECK read_case( id_with_reservations = abap_true                           "HS 12900
  CHECK read_case( id_with_reservations = id_with_reservations "HS 12900
                   id_no_status_refresh = id_no_status_refresh ) EQ abap_true. "HS 11004

*___Weitere Objekte verknüpfen
  IF id_no_link_objects IS INITIAL.
    link_objects( ).
  ENDIF.

  IF gs_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create OR l_vbelv IS NOT INITIAL OR l_ref IS NOT INITIAL. "HS#9774 "HS# 10467
    IF id_no_link_objects IS INITIAL.
      partner_put_data( ).
      partner_get_data( ).
    ENDIF.
  ENDIF.

*  CHECK go_appl IS NOT INITIAL.                                                                      "HS# 11923
*  go_appl->get_property( EXPORTING i_feld = 'GO_MAIN_2006' IMPORTING e_value = go_main_2006 ).       "HS# 11923

  IF go_if_appllog IS INITIAL.                                      " HS# 11637
    go_if_appllog = /bitmym/cl_mym=>go_global_appllog .             " HS# 11637
  ENDIF.                                                            " HS# 11637

  "HS# 017040 add below enhancement point
ENHANCEMENT-POINT CONSTRUCTOR_01 SPOTS /BITMYM/CL_CASE .

ENDMETHOD.                    "create


METHOD popup_release_method_booking.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*
*____HS# 016125, VON: GIVANOV, DATUM: 09.12.2021___*
*___ SR2-952, User: OOGUR, Date: 10.10.2024___*


  DATA: ls_rstypo TYPE /sopromet/rstypo,
        l_method  TYPE char1.

  ls_rstypo = /sopromet/cl_l_res_type=>get_prop_rstypo( i_vkorg = gs_comwa-vkorg
                                                        i_rstyp = gs_comwa-rstyp ).

  CASE ls_rstypo-xbook2case.

    WHEN gc_rel_immed.

      e_check = abap_true.

    WHEN gc_rel_ask
      OR gc_rel_ask_atp                      "HS# 016125
      OR gc_d.                               "SR2-952

      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar              = TEXT-006
          text_question         = TEXT-007
          default_button        = '2'
          display_cancel_button = space
        IMPORTING
          answer                = l_method
        EXCEPTIONS
          text_not_found        = 1
          OTHERS                = 2.

      CHECK l_method EQ '1'.

      e_check = abap_true.

  ENDCASE.

ENDMETHOD.


method COPY_BOOKING_TEXT.
*____HS#11767 , VON: KSIVARMAN, DATUM: 05.04.2017 ___*
ENHANCEMENT-SECTION REFERENCE_TEXT_BOOKING_COPY SPOTS /BITMYM/CASE .

copy_booking_text_reservation( ).

END-ENHANCEMENT-SECTION.

endmethod.


  METHOD copy_booking_text_reservation.
*____HS#11767 , VON: KSIVARMAN, DATUM: 05.04.2017 ___*
*____HS# 12462, VON: S.Taori,   DATUM: 16.04.2018 ___*

*Copy booking text to reservation                                                   "Add HS#11767
    TYPES:
      BEGIN OF ty_string,
        tdid   TYPE tdid,
        string TYPE string,
      END OF ty_string .

    TYPES: ty_t_string TYPE STANDARD TABLE OF ty_string .

    DATA: lds_t_head_book TYPE lv70t_ty_xthead_table,
          lds_t_head_res  TYPE lv70t_ty_xthead_table,
          lds_head_book   TYPE lv70t_ty_xthead,
          lds_head_res    TYPE lv70t_ty_xthead,
          lds_head_aux    TYPE lv70t_ty_xthead,
          lds_tvcom_book  TYPE tvcom,
          lds_t_string    TYPE ty_t_string,
          lds_string      TYPE ty_string,
          ls_rstype       TYPE /sopromet/rstype,
          ls_rstypo       TYPE /sopromet/rstypo,
          ld_txt_schema   TYPE txtgr,
          ld_change       TYPE abap_bool,
          lds_res         TYPE /sopromet/zzlrv.

    CHECK gs_comwa-ref_book IS NOT INITIAL.

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = gs_comwa-ref_book
*       I_NO_BUFF     =
      IMPORTING
        e_reservation = lds_res.

    lds_tvcom_book-vkorg           = lds_res-vkorg.
    lds_tvcom_book-vtweg           = lds_res-vtweg.
    lds_tvcom_book-spart           = lds_res-spart.
    lds_tvcom_book-/sopromet/lrsam = lds_res-zzlrsam.
    lds_tvcom_book-/sopromet/lresn = gs_comwa-ref_book.

*___1. Schema aus VKORG Daten
    CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
      EXPORTING
        i_rstyp = gs_comwa-rstyp
        i_vkorg = gs_comwa-vkorg
      IMPORTING
        e_data  = ls_rstypo.

    IF ls_rstypo-txtgr IS NOT INITIAL.
      ld_txt_schema = ls_rstypo-txtgr.
    ENDIF.

    IF ld_txt_schema IS INITIAL.
*  ___2. Schema aus allgemeinen Einstellungen
      CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
        EXPORTING
          i_rstyp = gs_comwa-rstyp
        IMPORTING
          e_data  = ls_rstype.

      IF ls_rstype-txtgr IS NOT INITIAL.
        ld_txt_schema = ls_rstype-txtgr.
      ENDIF.

    ENDIF.

    CHECK ld_txt_schema IS NOT INITIAL.

* Get booking text data
    CALL FUNCTION 'SD_WORD_PROCESSING_PUT'
      EXPORTING
        fi_application_data  = lds_tvcom_book
        fi_display_flag      = abap_false
        fi_display_language  = '*'
        fi_group             = ld_txt_schema
        fi_new_text_language = sy-langu
        fi_object            = /bitmym/cl_texte=>c_tdobject_mymediset
        fi_default_fcode     = 'ENT1'
        fi_subscreen_number  = /bitmym/cl_texte=>c_txt_subscreen
      CHANGING
        fct_xthead           = lds_t_head_book
      EXCEPTIONS
        error_occured        = 1
        OTHERS               = 2.

* Add booking data to reservation data
    LOOP AT lds_t_head_book  INTO lds_head_aux.

      lds_head_book = lds_head_aux.

      AT END OF tdid.

        IF lds_head_book-tdversion IS NOT INITIAL.

          CALL FUNCTION 'SD_TEXT_GET_STRING'
            EXPORTING
              iv_id          = lds_head_book-tdid
              iv_spras       = sy-langu
            IMPORTING
              ev_text_string = lds_string-string.

          lds_string-tdid = lds_head_book-tdid.

          APPEND lds_string TO lds_t_string.

        ENDIF.

      ENDAT.

    ENDLOOP.

*__Set copy from booking indicator
    set_property go_texte 'G_COPY_FROM_BOOKING' abap_true.  "HS 12462

* Get reservation text data
    texte_put_data( ).

    get_property   go_texte  'GT_HEAD'   lds_t_head_res.

    LOOP AT  lds_t_head_res INTO lds_head_aux.
      lds_head_res = lds_head_aux.

      AT END OF tdid.

        READ TABLE lds_t_string INTO lds_string WITH KEY tdid = lds_head_res-tdid.

        IF sy-subrc EQ 0.

          ld_change = abap_true.
*       Change reservation text from booking text
          CALL FUNCTION 'SD_TEXT_SET_STRING'
            EXPORTING
              iv_id          = lds_head_res-tdid
              iv_spras       = sy-langu
              iv_text_string = lds_string-string
            CHANGING
              ct_xthead      = lds_t_head_book.

        ENDIF.

      ENDAT.

    ENDLOOP.

    set_property   go_texte  'GT_HEAD'  lds_t_head_res.

    IF ld_change EQ abap_true.

      set_property   go_texte  'GD_CHANGE_FLAG'   ld_change.

    ENDIF.                                                                                    "End HS#11767

  ENDMETHOD.


METHOD create_booking_from_case.
*____HS# 012705, VON: OPECHARROMAN, DATUM: 08.10.2018___*
*____HS# 017919, VON: OPECHARROMAN, DATUM: 06.03.2023___*
*___ SR2-490, User: XLI, Date: 12.08.2024___*
*___ SR2-970, User: SCOSAR, Date: 14.10.2024___*
*___ SR2-1415, User: SCOSAR, Date: 24.01.2025___*


* Create booking referecne to the current case using the dates set on screen 802

  DATA: ls_case           TYPE  /bitmym/ic_srep_case_st,
        ls_booking        TYPE  /bitmym/ic_srep_booking_st,
        lt_partner        TYPE  /bitmym/ic_srep_vbpa_tt,
        lt_bookingitem    TYPE  /bitmym/ic_srep_bitem_tt,
        lo_data_provider  TYPE REF TO /iwbep/if_mgw_entry_provider,
        lt_notes          TYPE  /bitmym/ic_srep_note_tt,
        ls_comwa          TYPE /sopromet/zzls01,
        ls_case_book_deep TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_book_deep,
        lt_link_to_res    TYPE  /bitmym/zzlrsen_tab,
        lo_case           TYPE REF TO /bitmym/cl_case.

* Extract info to create booking
  fill_booking_from_res_data( IMPORTING es_case        = ls_case
                                        es_booking     = ls_booking
                                        et_partner     = lt_partner
                                        et_bookingitem = lt_bookingitem
                                        et_notes       = lt_notes
                                        et_link_to_res = lt_link_to_res ).

*-- Delete reference to the original case in communicationstructure
  CLEAR: ls_comwa-zzlrsam, ls_comwa-zzlresn.
* Set creation mode and customer number
  ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
  ls_comwa-kunnr = ls_case-kunnr.
  ls_comwa-kunwe = ls_booking-kunwe.
  ls_comwa-xfollowup = ls_booking-xfollowup = abap_true. "SR2-970
  ls_comwa-ref_book  = ls_booking-ref_book.                 "SR2-1415
  set_property go_appl 'GS_COMWA' ls_comwa.

*___Create CASE Object
  lo_case = /bitmym/cl_case=>create( io_appl = go_appl io_area = go_salesarea ).

*-- Set data provider structure
  MOVE-CORRESPONDING ls_booking TO ls_case_book_deep.

*____SR2-490____BEGIN INSERT___*
  IF is_case IS NOT INITIAL.
    MOVE-CORRESPONDING is_case TO ls_case.
    MOVE-CORRESPONDING ls_case TO ls_case_book_deep.
  ENDIF.
*____SR2-490____END   INSERT___*

  ls_case_book_deep-casedata             = ls_case.
  ls_case_book_deep-casetopartner        = lt_partner.
  ls_case_book_deep-bookingtobookingitem = lt_bookingitem.
  ls_case_book_deep-casetonotes          = lt_notes.

*-- Set Data Provider
  lo_data_provider = /bitmym/cl_is_srv=>set_ui5_data_provider(
                                        is_entity = ls_case_book_deep ).

  lo_case->gd_no_res_creation = abap_true.                  "HS# 017919

*-- Trigger Booking Create
  lo_case->create_booking_with_ref_int( EXPORTING io_provider = lo_data_provider it_link_to_res = lt_link_to_res  ).

  lo_case->cleanup_data( ).
  CLEAR lo_case.

ENDMETHOD.


METHOD create.
*____HS# 11004, VON: S.Taori,   DATUM: 26.01.2016 ___*
*____HS# 12010, VON: MKnauer,   DATUM: 15.08.2017 ___*
*____HS# 12900, VON: RBoyapati, DATUM: 08.02.2019 ___*
*____HS# 016751, VON: SISMAIL, DATUM: 20.07.2022___*
*___ SR2-54, User: OOGUR, Date: 23.02.2024___*
*___ SR2-54, User: SBADUSHA, Date: 27.06.2024___*


  CREATE OBJECT eo_case
    EXPORTING
      id_case              = id_case
      io_area              = io_area
      io_appl              = io_appl
      id_reservation       = id_reservation
*      id_rap_framework     = id_rap_framework     "SR2-54  "SR2-54 DEL
      id_no_link_objects   = id_no_link_objects
      id_single            = id_single
      id_no_status_refresh = id_no_status_refresh "HS 11004
      id_mixed             = id_mixed
      id_with_reservations = id_with_reservations "HS 12900
      is_ccpropso          = is_ccpropso          "HS# 016751+
      io_ui5               = io_ui5.              "HS#12010

ENDMETHOD.


