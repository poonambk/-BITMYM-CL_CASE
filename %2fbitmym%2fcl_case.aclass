METHOD create_bill_w1.
*____HS# 016513, VON: OPECHARROMAN, DATUM: 11.02.2022___*

  DATA: ls_controller TYPE /sopromet/controller.

  e_success = abap_false.

ENHANCEMENT-POINT CREATE_BILL_W1_01 SPOTS /bitmym/case.

  IF NOT go_main_2006->g_l01-kzmmr IS INITIAL.
*     /sopromet/cl_l_res_main=>g_i_licence GE "HS# 16513
*     /sopromet/cl_l_res_main=>cif_lic_2006.

    ls_controller-xnopic = 'X'.
    ls_controller-xnoinb = 'X'.
    ls_controller-xnotxt = 'X'.
    ls_controller-xnobar = 'X'.
    ls_controller-xnosta = 'X'.

    CALL FUNCTION '/SOPROMET/CREATE_GOODS_RECEIPT'
      EXPORTING
        i_master                     = go_main_2006
        i_o_reservation              = go_act_reservation
        i_debit                      = 'X'
        i_controller                 = ls_controller
        i_trtyp                      = gs_comwa-trtyp_o
      EXCEPTIONS
        reservierung_existiert_nicht = 1
        reservierungs_status_falsch  = 2
        OTHERS                       = 3.
  ELSE.
    CALL FUNCTION '/SOPROMET/GET_WE_MENGE'
      EXPORTING
        i_zzlresn                    = gs_comwa-zzlresn
        i_debit                      = abap_true
        i_master                     = go_main_2006
      EXCEPTIONS
        reservierung_existiert_nicht = 1
        reservierungs_status_falsch  = 2
        OTHERS                       = 3.
  ENDIF.

  CHECK sy-subrc = 0.

  e_success = abap_true.

ENDMETHOD.


METHOD create_booking_with_ref_int.
*____HS# 012705, VON: OPECHARROMAN, DATUM: 08.10.2018___*
*
  DATA: ls_zzlrv          TYPE /sopromet/zzlrv,
        lt_items          TYPE TABLE OF  /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
        lt_notes          TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>tt_notes,
        ls_comwa_appl     TYPE /sopromet/zzls01,
        lo_res            TYPE REF TO /sopromet/cl_l_reservation,
        lo_data_provider  TYPE REF TO /iwbep/if_mgw_entry_provider,
        ls_case_book_deep TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_book_deep,
        ls_date_data      TYPE /bitmym/case_common_date,
        ld_check          TYPE abap_bool.

*___Step 1: Get data provider data
  io_provider->read_entry_data( IMPORTING es_data = ls_case_book_deep ).

  set_book_data_from_ref( EXPORTING is_data = ls_case_book_deep ).

  set_partner_data_from_ref( EXPORTING is_data = ls_case_book_deep ).

*___Step 2: Add booking items
  ui5_prep_booking_items( IMPORTING ed_success = ld_check CHANGING ct_items = ls_case_book_deep-bookingtobookingitem ).
  check ld_check = abap_true.

*___Step 3: Init sequence for a new case
  create_new_case( ).

*___Step 4: Build Tree
  ui5_prep_reservation_tree( i_add_res = abap_true is_data = ls_zzlrv ).

*___Step 5: Prepare Text
  ui5_prep_booking_notes( it_notes = ls_case_book_deep-casetonotes ).

*___Step 6: Post Booking (Simulation considered)
  CHECK ui5_post_booking( ) EQ abap_true.

*___Step 7: if reservation number is passed by, link reservation with the new created booking
  CHECK it_link_to_res IS NOT INITIAL.

* Get created booking number and combine run
  GET PARAMETER ID '/BITMYM/BOOKING' FIELD gs_comwa-zzlresn .

  CHECK gs_comwa-zzlresn IS NOT INITIAL.

  CREATE OBJECT lo_res
    EXPORTING
      i_zzlresn = gs_comwa-zzlresn.

  lo_res->link_book_to_res( it_link_to_res = it_link_to_res ).

ENDMETHOD.


METHOD fill_booking_from_res_data.
*____HS# 012705, VON: OPECHARROMAN, DATUM: 08.10.2018___*
*____HS# 012783, VON: OPECHARROMAN, DATUM: 12.11.2018___*
*____HS# 014748, VON: SISMAIL, DATUM: 18.12.2020___*
*___ SR2-970, User: SCOSAR, Date: 14.10.2024___*
*___ SR2-1415, User: SCOSAR, Date: 24.01.2025___*

  "This method prepares followup booking data "SR2-970

  DATA: ls_comwa               TYPE /sopromet/zzls01,
        ls_res                 TYPE /sopromet/zzlrv,
        lt_tree                TYPE /sopromet/tree_collect_tab,
        ls_map                 TYPE /sopromet/ty_tree_map,
        lt_single              TYPE /sopromet/ritems_tab,
        lo_res                 TYPE REF TO /sopromet/cl_l_reservation,
        ld_status              TYPE tj30t-txt04,
        ls_common_res_to_book  TYPE /bitmym/common_res_to_book, "HS# 012783
        ls_common_case_to_book TYPE /bitmym/common_case_to_book, "HS# 012783
        lo_tree                TYPE REF TO /bitmym/cl_tree,
        lt_vbpa                TYPE  /sopromet/vbpav_tab,
        lt_booking_items       TYPE /bitmym/b_items_st_tab. "SR2-1415

  FIELD-SYMBOLS: <fs_partner> TYPE /bitmym/ic_srep_vbpa_st,
                 <fs_vbpa>    TYPE vbpav,
                 <tree>       TYPE /sopromet/tree_collect,
                 <book_item>  TYPE /bitmym/ic_srep_bitem_st,
                 <items>      TYPE /sopromet/ritems_wa,
                 <res>        TYPE /sopromet/zzlrv.

  CHECK go_act_reservation IS BOUND.
  go_act_reservation->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
  go_act_reservation->get_reservation_data( IMPORTING e_reservation = ls_res ).

* Set case data from screen
*  MOVE-CORRESPONDING gs_case TO es_case.                   "HS# 012783

* 1) and 2) Set reservation data from screen + kunnr and rstyp from reservation
* Start HS 12783 -> Comment
*  MOVE-CORRESPONDING ls_res TO es_booking.
*  MOVE: ls_res-rstyp TO es_booking-rstyp,
*        ls_res-kunnr TO es_booking-kunnr.

*  MOVE: ls_res-rstyp TO es_case-rstyp,
*        ls_res-kunnr TO es_case-kunnr.
* End HS 12783 <- Comment

* Start HS 12783
* Move data from reservation and combine run to booking case
  MOVE-CORRESPONDING gs_case TO ls_common_case_to_book.
  MOVE-CORRESPONDING ls_common_case_to_book TO es_case.
  MOVE-CORRESPONDING gs_case TO ls_common_res_to_book.
  MOVE-CORRESPONDING ls_common_res_to_book TO es_case.

* Move data from reservation to boooking
  MOVE-CORRESPONDING ls_res TO  ls_common_res_to_book.
  MOVE-CORRESPONDING ls_common_res_to_book TO es_booking.

* Screen data for optim field is read from screen into the communication structure
  es_booking-optim = gs_comwa-optim.
  es_booking-opman = gs_case-opman. " HS# 014748
* End HS 12783

* 3) Set partner data from case
  IF go_partner IS NOT INITIAL.
    get_property go_partner 'GT_VBPA' lt_vbpa.
    IF gd_surg_comb_run IS NOT INITIAL. " HS# 14748
      modify_surg_comb_run( CHANGING ct_vbpa = lt_vbpa ). " HS# 14748
    ENDIF.  " HS# 14748
    LOOP AT lt_vbpa ASSIGNING <fs_vbpa>.
      APPEND INITIAL LINE TO et_partner ASSIGNING <fs_partner>.
      MOVE-CORRESPONDING <fs_vbpa> TO <fs_partner>.
    ENDLOOP.

  ENDIF.

* 4) Set booking items from reservation materials
  get_property me 'GO_TREE_CASE' lo_tree.
  CHECK lo_tree IS NOT INITIAL.
  get_property lo_tree 'GT_TREE' lt_tree .

*____SR2-970____BEGIN INSERT___*
  DATA(lo_rstyp) = /sopromet/cl_l_res_type=>create( i_vkorg = gs_comwa-vkorg i_rstyp = gs_comwa-rstyp  ).
  lo_rstyp->set_data_vkorg( gs_comwa-vkorg ).
  DATA(ls_res_typ_vko) = lo_rstyp->get_data( )-gs_rstypo.
*____SR2-970____END   INSERT___*

*____SR2-1415____BEGIN INSERT___*
  IF ls_res-rscat NE /sopromet/cl_l_reservation=>c_rscat_b.
    SELECT SINGLE t1~refbooking
      FROM /bitmym/i_bookingref AS t1
     INNER JOIN /bitmym/i_booking AS t2 ON t2~booking EQ t1~refbooking
      INTO @es_booking-ref_book
     WHERE t1~combinedrun EQ @gs_case-zzlrsam
       AND t2~followupbooking EQ @abap_false.
*____SR2-1415____END   INSERT___*

    LOOP AT lt_tree ASSIGNING <tree>
         WHERE kzper    IS INITIAL
           AND isfolder IS INITIAL.

      ls_map = lo_tree->get_map_of_node( <tree>-node_key ).

      CHECK ls_map-objkey IS NOT INITIAL.

*__Reservierungsstatus + Daten holen
      ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
      ld_status = ls_map-objkey->get_user_status( ).

      CHECK ld_status NE /sopromet/cl_l_reservation=>c_res_status_cancelled.

*   3) Add items. We dont consider single items
      IF ls_res-kzsir IS INITIAL AND
         ls_res-matnr IS NOT INITIAL.
        IF ls_res_typ_vko-flw_up_bookings_items EQ abap_true. "SR2-970 - if customizing is off, followup booking should not have items
          APPEND INITIAL LINE TO et_bookingitem ASSIGNING <book_item>.
          MOVE: ls_res-matnr TO <book_item>-matnr,
                '1' TO <book_item>-menge.
        ENDIF. "SR2-970

*     Append reservation to table to link the created booking to the existing reservation
        APPEND ls_res-zzlresn TO et_link_to_res.
      ENDIF.

* Add additional info
ENHANCEMENT-POINT fill_booking_from_res_data_01 SPOTS /bitmym/cl_case .

    ENDLOOP.
*____SR2-1415____BEGIN INSERT___*
  ELSE.
    es_booking-ref_book = ls_res-zzlresn.
    IF ls_res_typ_vko-flw_up_bookings_items EQ abap_true. "if customizing is off, followup booking should not have items
      go_act_reservation->get_property( EXPORTING i_feld = 'GT_BOOKING_ITEMS' IMPORTING e_value = lt_booking_items ).
      et_bookingitem = CORRESPONDING #( lt_booking_items EXCEPT lresn ).
    ENDIF.
    SELECT reservation
      FROM /bitmym/i_bookingnreservation
      INTO TABLE @et_link_to_res
     WHERE bookingcombinedrun    EQ @ls_res-zzlrsam
       AND reservationbookingref NE @space.
  ENDIF.
*____SR2-1415____END   INSERT___*

* 5) Set notes
* Init HS# 012783
  CHECK go_texte IS BOUND.

* Build note table from the combine run texts
  CLEAR gs_comwa-zzlresn. "SR2-970
  et_notes = go_texte->get_notes_from_sd_text( ).
* End HS# 012783

ENDMETHOD.


METHOD create_case_ptp.
*____HS# 10412,VON: T.Kern, DATUM: 12.05.2015 ___*
*___ SR2-675, User: EDFLORENTINO, Date: 30.08.2024___*

  DATA: ls_comwa  TYPE /sopromet/zzls01.

  e_success = abap_false.

*__Berechtigungsprüfung
  CHECK go_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_anlegen ) EQ abap_true.

*__COMWA füllen
  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
  MOVE-CORRESPONDING ls_comwa TO gs_case.
  MOVE-CORRESPONDING ls_comwa TO gs_comwa.

*__Neue Case Nummer ziehen
  get_new_case_number( ).

  get_customer_number_ptp( ).

  IF gs_comwa-kunnr IS NOT INITIAL.

    IF go_appl->get_data( )-go_ui5 IS BOUND.                                               "SR2-675
      DATA(lv_no_show) = abap_true.                                                        "SR2-675
    ENDIF.                                                                                 "SR2-675
    e_success = go_appl->pai_kunnr_input( is_comwa = gs_comwa id_no_dialog = lv_no_show ). "SR2-675

*    e_success = go_appl->pai_kunnr_input( is_comwa = gs_comwa ). "SR2-675 DEL
    CHECK e_success = abap_true.
  ENDIF.

  CHECK gs_comwa-kunnr IS NOT INITIAL.

ENHANCEMENT-POINT create_case_ptp_01 SPOTS /bitmym/case .

  calc_dates_ptp( ).

  MOVE-CORRESPONDING gs_comwa TO gs_case.

* Save the case
  case_save_all_dark( ).

  e_success = abap_true.

ENDMETHOD.


METHOD create_case_repair.
*____HS# 11262,VON: D.Endres, DATUM: 30.06.2016 ___*

  DATA: ls_comwa       TYPE /sopromet/zzls01,
        ls_rstype      TYPE /sopromet/rstype,
        ls_reservation TYPE /sopromet/zzlrv,
        ls_mat_sel     TYPE /sopromet/zzls06,
        ls_ptp         LIKE LINE OF gt_ptp_tab.

*__Berechtigungsprüfung
  CHECK go_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_anlegen ) EQ abap_true.

*__COMWA füllen
  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
  MOVE-CORRESPONDING ls_comwa TO gs_case.
  MOVE-CORRESPONDING ls_comwa TO gs_comwa.

  e_success = abap_false.
  go_act_reservation = io_reservation.
  CHECK get_customer_number_repair( io_reservation ) EQ abap_true.

  CHECK io_reservation IS NOT INITIAL.
  io_reservation->get_reservation_data(
    IMPORTING
      e_reservation              = ls_reservation ).

*__Neue Case Nummer ziehen
  get_new_case_number( ).

  CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
    EXPORTING
      i_rstyp = ls_reservation-rstyp
    IMPORTING
      e_data  = ls_rstype.

  gs_comwa-rstyp = ls_rstype-rstyp_rep.
  gs_comwa-odate = sy-datum.
  gs_comwa-vdate = ls_rstype-vdateo.
  gs_comwa-rdate = ls_rstype-rdateo.
  gs_comwa-srcrs = ls_reservation-zzlresn.
  gs_comwa-equnr = ls_reservation-equnr.
  gs_comwa-repref = ls_reservation-zzlresn.

  ls_mat_sel-equnr = ls_reservation-equnr.
  INSERT ls_mat_sel INTO TABLE gt_mat_selection.

  CHECK gs_comwa-kunnr IS NOT INITIAL.

  CHECK go_appl->popup_confirm_repair(
          io_reservation = io_reservation
          i_kunnr        = gs_comwa-kunnr
      ) EQ abap_true.

  IF gs_comwa-kunnr IS NOT INITIAL.
    e_success = go_appl->pai_kunnr_input( gs_comwa ).
    CHECK e_success = abap_true.
  ENDIF.

  CHECK gs_comwa-kunnr IS NOT INITIAL.

  calc_dates_repair( ).

  MOVE-CORRESPONDING gs_comwa TO gs_case.

* This Structure is used in case_save_dark to write references to Source Reservation
  ls_ptp-lresn     = ls_reservation-zzlresn.
  ls_ptp-kunnr     = ls_reservation-kunnr.
  ls_ptp-equnr     = ls_reservation-equnr.
  ls_ptp-matnr     = ls_reservation-matnr.
  ls_ptp-sernr     = ls_reservation-sernr.
  ls_ptp-oreserv   = io_reservation.
  ls_ptp-rstyp     = gs_comwa-rstyp.

  INSERT ls_ptp INTO TABLE gt_ptp_tab.

* Save the case
  case_save_all_dark( ).

  e_success = abap_true.
  CLEAR gt_ptp_tab.

ENDMETHOD.


METHOD create_case_without_selection.
*____HS# 9828, VON: Oscar Pecharroman Perez, DATUM: 25.02.2014 ___*
*____HS# 9936, VON: Oscar Pecharroman Perez, DATUM: 25.05.2014 ___*
*____HS# 10154, VON: Oscar Pecharroman Perez, DATUM: 10.10.2014 ___*
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 16.09.2015____*
*____HS# 10710, VON: S.Taori        DATUM: 02.10.2015____*
*____HS# 11618, VON: R.BOYAPATI     DATUM: 28.02.2017 ___*


  DATA: ls_comwa   TYPE /sopromet/zzls01.

  e_success = abap_false.

*__Berechtigungsprüfung
  CHECK go_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_anlegen ) EQ abap_true.

  IF check_reference_doc( ) EQ abap_true.                   "HS# 10467

    reference_doc_calc_dates( EXPORTING id_without_selection = abap_true ). "HS# 10467

  ELSE.
    IF gs_comwa-kunnr IS NOT INITIAL.
*      e_success = go_appl->pai_kunnr_input( is_comwa = gs_comwa      "HS 10710 "HS 11618
*                                         id_no_dialog = abap_true ). "HS 10710 "HS 11618
      e_success = partner_date_calc( i_no_dialog = abap_true ).       "HS# 11618
      CHECK e_success = abap_true.
    ENDIF.

  ENDIF.

*__Equipmentauswahl
  IF gd_single_only IS INITIAL.

*___Plantafel / ATP 2.0
    gt_mat_selection = /bitmym/cl_bar_chart=>display_atp_from_case( io_case = me
                                                        i_view_type = /bitmym/cl_bar_chart=>c_no_display ).

*___Plantafel / ATP 1.0
    IF gt_mat_selection IS NOT INITIAL.
      e_success = abap_true.
    ELSE.
      go_appl->clear_material_selection( ).
    ENDIF.

    IF gd_mixed IS NOT INITIAL.
      e_success = perpare_single_item( ).
    ENDIF.

  ELSE.
*___Nur Single item anlegen
    e_success = perpare_single_item( ).
  ENDIF.

  CHECK e_success = abap_true.

*__COMWA füllen
  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
  MOVE-CORRESPONDING ls_comwa TO gs_case.
  MOVE-CORRESPONDING ls_comwa TO gs_comwa.
  gs_comwa-abgru = /sopromet/cl_l_reservation=>gd_lost_abgru.

  reference_order_copy_data( ).

  reference_booking_copy_data( ).                           "HS# 10467

*__Neue Case Nummer ziehen
  get_new_case_number( ).

*__Copy text from preliminary booking
  reference_order_text_copy( ).                             "HS# 9936

*__Reservierungstyp
  read_reservation_type( ).

* Save the case
  case_save_all_dark( it_single ).                          "HS 10710

ENDMETHOD.


METHOD create_debit_note.
*____HS# 016513, VON: OPECHARROMAN, DATUM: 11.02.2022___*

  DATA: ls_controller TYPE /sopromet/controller.

  e_success = abap_false.

ENHANCEMENT-POINT create_debit_note_01 SPOTS /bitmym/case.

  IF NOT go_main_2006->g_l01-kzmmr IS INITIAL .
*     /sopromet/cl_l_res_main=>g_i_licence GE "HS# 16513
*     /sopromet/cl_l_res_main=>cif_lic_2006.

    ls_controller-xnopic = 'X'.
    ls_controller-xnoinb = 'X'.
    ls_controller-xnotxt = 'X'.
    ls_controller-xnobar = 'X'.
    ls_controller-xnosta = 'X'.

    CALL FUNCTION '/SOPROMET/CREATE_GOODS_RECEIPT'
      EXPORTING
        i_master                     = go_main_2006
        i_o_reservation              = go_act_reservation
        i_debit                      = 'X'
        i_controller                 = ls_controller
        i_trtyp                      = gs_comwa-trtyp_o
      EXCEPTIONS
        reservierung_existiert_nicht = 1
        reservierungs_status_falsch  = 2
        OTHERS                       = 3.
  ELSE.
    CALL FUNCTION '/SOPROMET/GET_WE_MENGE'
      EXPORTING
        i_zzlresn                    = gs_comwa-zzlresn
        i_debit                      = abap_true
        i_master                     = go_main_2006
      EXCEPTIONS
        reservierung_existiert_nicht = 1
        reservierungs_status_falsch  = 2
        OTHERS                       = 3.
  ENDIF.

  CHECK sy-subrc = 0.

  e_success = abap_true.

ENDMETHOD.


METHOD create_dispatch_order.
*____HS# 9784, VON: Shaheen Taori, DATUM: 28.01.2014 ___*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 11888, VON: G.Ivanov, DATUM: 07.06.2017 ___ I_NO_DISPLAY is added*
*____HS# 12102, VON: S.Taori,  DATUM: 13.11.2017 ___*
*____HS# 12197, VON: S.Singh,  DATUM: 05.12.2017 ___*
*____HS# 015862, VON: SISMAIL, DATUM: 16.09.2021___*
*___ SR1-1155, User: PKUNAL, Date: 22.11.2023___*
*___ SR2-54, User: OOGUR, Date: 16.02.2024___*
*___ SR2-54, User: SBADUSHA, Date: 26.06.2024___*


  DATA: ld_vbeln          TYPE vbeln,
        ld_suppress_popup TYPE abap_bool. "HS# 015862+

ENHANCEMENT-POINT create_dispatch_order_01  SPOTS /bitmym/case.

* Read Current Reservation
  IF go_act_reservation IS BOUND.                                                                               "*___ SR1-1155
    DATA(ls_data) = go_act_reservation->get_data( ).                                                            "*___ SR1-1155
  ENDIF.                                                                                                        "*___ SR1-1155
  e_order_created = abap_false.

  ld_vbeln = /bitmym/cl_order=>create_dispatch_order( id_case  = gs_case-zzlrsam
                                                      id_vkorg = gs_case-vkorg
                                                      i_no_display = i_no_display "HS 11888
                                                      io_ui5 = go_ui5                               "___ SR2-54
*                                                      id_rap_framework = gd_rap_framework           "___ SR2-54  "SR2-54 DEL
                                                      id_suppress_popup = ld_suppress_popup         "HS# 015862+
                                                      id_reservation = ls_data-g_reservation-zzlresn             "*___ SR1-1155
                                                      io_case  = me ). "HS 9784

  IF ld_vbeln IS INITIAL.
ENHANCEMENT-POINT create_dispatch_order_02  SPOTS /bitmym/case.
    e_order_created = abap_false.
    IF g_iconnect = abap_false.   "HS# 015862+
      go_tree_case->set_new_icons( ).
    ENDIF.                        "HS# 015862+
  ELSE.

ENHANCEMENT-POINT create_dispatch_order_03  SPOTS /bitmym/case.
    e_order_created = abap_true.
    ed_vbeln = ld_vbeln.                 "___ SR2-54
*    partner_put_data( ).                "HS 12102                  "HS# 12197
*___Nachricht ausgeben
    MESSAGE i006(/sopromet/zl) WITH ld_vbeln INTO gd_dummy_message. "HS# 11637
    call_message.                                           "HS# 11637
  ENDIF.

  partner_put_data( ).                                      "HS# 12197

ENHANCEMENT-POINT create_dispatch_order_04 SPOTS /bitmym/case .

ENDMETHOD.


METHOD create_in_field_replenishment.
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 012698, VON: PKUNAL, DATUM: 09.11.2018___*
*____HS# 012864, VON: PKUNAL, DATUM: 18.12.2018___*
*____HS# 013077, VON: STAORI, DATUM: 19.03.2019___*
*____HS# 013632, VON: SSINGH, DATUM: 15.11.2019___*


  DATA: lo_user   TYPE REF TO /bitmym/cl_user,
        ld_vbeln  TYPE vbeln,
        ld_answer.

  DATA: ld_headline TYPE string.

ENHANCEMENT-POINT create_in_field_repl_01 SPOTS /bitmym/case .

  ed_success = abap_false.

  CHECK go_act_reservation IS NOT INITIAL.

*__Berechtigungsprüfung
  get_property go_salesarea 'GO_USER' lo_user.
  CHECK lo_user IS NOT INITIAL.
  CHECK lo_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_set_field_repl ) EQ abap_true.

  CHECK case_save_final_check( ) EQ abap_true.              "HS 13077

*___Zuerst alles sichern
  case_save_all( ).

ENHANCEMENT-POINT create_in_field_repl_02 SPOTS /bitmym/case .
*___PopUp
  ##FM_OLDED
  CALL FUNCTION 'POPUP_TO_CONFIRM_STEP'
    EXPORTING
      defaultoption = 'Y'
      textline1     = TEXT-rp1
      titel         = TEXT-rp2
    IMPORTING
      answer        = ld_answer
    EXCEPTIONS
      OTHERS        = 1.

  CHECK ld_answer = 'J' OR ld_answer = 'Y'.

ENHANCEMENT-POINT create_in_field_repl_03 SPOTS /bitmym/case .
*  ld_vbeln = go_act_reservation->create_supplement_order( ).             "HS# 012864
  ld_vbeln = go_act_reservation->create_supplement_order_v2( ). "HS# 012864


ENHANCEMENT-POINT create_in_field_repl_04 SPOTS /bitmym/case .
  partner_put_data( ).                                           "HS# 013632
  IF ld_vbeln IS NOT INITIAL.
ENHANCEMENT-POINT create_in_field_repl_05 SPOTS /bitmym/case .
    ed_success = abap_true.

    MESSAGE i006(/sopromet/zl) WITH ld_vbeln INTO gd_dummy_message. "HS# 11637
    call_message.                                           "HS# 11637

    CHECK /bitmym/cl_ecatt=>check_ecatt_parameter( ) IS INITIAL. "HS #12698

    CALL FUNCTION '/SOPROMET/CHANGE_TRANSACTION'
      STARTING NEW TASK 'X'
      EXPORTING
        i_vbeln = ld_vbeln.
  ELSE.
ENHANCEMENT-POINT create_in_field_repl_06 SPOTS /bitmym/case .
    CALL FUNCTION 'CM_F_ANALYSIS'
      EXPORTING
        headline   = ld_headline
        aplid      = /sopromet/cl_l_screen=>c_aplid_mset
      EXCEPTIONS
        not_active = 1
        OTHERS     = 2.
  ENDIF.
ENDMETHOD.


METHOD get_surgeon_name.
*____HS# 014748, VON: SISMAIL, DATUM: 16.12.2020___*
*____HS# 014955, VON: SISMAIL, DATUM: 19.02.2021___*
*____HS# 014955, VON: OPECHARROMAN, DATUM: 22.06.2021___*


  DATA: lt_vbpa TYPE /sopromet/vbpav_tab,
        ls_addr TYPE ad_line_s,
        ls_kna1 TYPE kna1,
        lo_area TYPE REF TO /sopromet/cl_l_salesarea,
        ls_area TYPE /sopromet/zzl01.

  FIELD-SYMBOLS : <fs_vbpa> TYPE vbpav.

  CHECK go_partner IS NOT INITIAL.

  IF gs_comwa-opman IS NOT INITIAL.                         "HS# 014955
    gs_case-opman = gs_comwa-opman.                         "HS# 014955
  ENDIF.                                                    "HS# 014955

*  go_partner->get_property( EXPORTING i_feld = 'GT_VBPA' IMPORTING e_value =  lt_vbpa ). ""HS# 014955
  go_appl->get_property( EXPORTING i_feld = 'GO_AREA'      IMPORTING e_value = lo_area ).
  CHECK lo_area IS NOT INITIAL.
  lo_area->get_property( EXPORTING i_feld = 'GS_ACTUAL_AREA' IMPORTING e_value = ls_area ).

* New functionality to get surgeon text from partner data only relevant if corresponding customizing is active
  CHECK ls_area-parvwsurg IS NOT INITIAL.                   "HS# 014955

  go_partner->get_property( EXPORTING i_feld = 'GT_VBPA' IMPORTING e_value =  lt_vbpa ). ""HS# 014955

  UNASSIGN : <fs_vbpa>.
  READ TABLE lt_vbpa ASSIGNING <fs_vbpa> WITH KEY parvw = ls_area-parvwsurg.

  IF sy-subrc = 0.
    CALL METHOD /bitmym/cl_partner=>read_customer_address
      EXPORTING
*       i_no_addr =
        id_kunnr = <fs_vbpa>-kunnr
      IMPORTING
*       es_vbadr =
        es_addr  = ls_addr
        es_kna1  = ls_kna1.

    gs_comwa-opman = ls_kna1-name1.
    gs_case-opman = ls_kna1-name1.
*  ELSEIF gs_comwa-opman IS NOT INITIAL.                     "HS# 014955
*    gs_case-opman = gs_comwa-opman.                         "HS# 014955
  ELSEIF gs_case-opman IS NOT INITIAL.
    gs_comwa-opman = gs_case-opman.
  ELSE.
    CLEAR : gs_comwa-opman, gs_case-opman.
  ENDIF.


ENDMETHOD.


METHOD create_new_case.
*____HS# 9770,  VON: T.Kern - 09.02.2014
*____HS# 9788,  VON: Oscar Pecharroman Perez, DATUM: 29.01.2014 ___*
*____HS# 9846,  VON: MKNAUER,                 DATUM: 11.03.2014 ___*
*____HS# 9936,  VON: Oscar Pecharroman Perez, DATUM: 15.05.2014 ___*
*____HS# 10154, VON: Oscar Pecharroman Perez, DATUM: 10.10.2014 ___*
*____HS# 10467, VON: O.PECHARROMAN            DATUM: 16.09.2015____*
*____HS# 11618, VON: R.BOYAPATI               DATUM: 28.02.2017 ___*
*____HS# 11767 , VON: KSIVARAMAN,             DATUM: 05.04.2017 ___*
*____HS# 12085 , VON: KSIVARAMAN,             DATUM: 25.09.2017 ___*
*____HS# 12094, VON: MKnauer                  DATUM: 10.10.2017 ___*
*____HS# 12106, VON: G.Ivanov                 DATUM: 13.10.2017 ___*
*____HS# 12209, VON: D.Endres,                DATUM: 16.01.2018 ___*
*____HS# 12314, VON: OPECHARROMAN,            DATUM: 06.07.2018___*
*____HS# 12469, VON: STAORI,                  DATUM: 24.07.2018___*
*____HS# 014146, VON: RBoyapati,              DATUM: 08.06.2020___*
*____HS# 014619, VON: TKERN, DATUM: 03.11.2020___*
*____HS# 014944, VON: TKERN, DATUM: 17.02.2021___*
*____HS# 016372, VON: PKUNAL, DATUM: 13.01.2022___*
*____HS# 016125, VON: GIVANOV, DATUM: 08.12.2021___*
*____HS# 017485, VON: BGUNAWAN, DATUM: 09.11.2022___*
*___ SR1-912, User: GIVANOV, Date: 26.06.2023___*
*___ SR2-1827, User: SBADUSHA, Date: 29.05.2025___*
*___ SR2-1827, User: GIVANOV, Date: 02.06.2025___*
*___ SR2-1951, User: PKSHIRSAGAR, Date: 30.06.2025___*

  DATA: ls_comwa TYPE /sopromet/zzls01,
        lv_exit  TYPE abap_bool.                            "HS# 12085

  DATA: ls_comwa_init TYPE /bitmym/init_comwa_fields.       "HS# 12106
  DATA: lv_atp_on_case_create TYPE /bitmym/atp_on_case_create. "HS# 016125

  e_success = abap_false.

*__Berechtigungsprüfung
  CHECK go_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_anlegen ) EQ abap_true.


  IF check_reference_doc( ) EQ abap_true.                   "HS# 10467
    e_success = reference_doc_calc_dates( ).                "HS# 10467
    CHECK e_success = abap_true.                            "HS# 10467
  ELSE.

*____________HS# 12094___________________START_OF_DELETION
*    IF gs_comwa-kunnr IS NOT INITIAL AND g_iconnect IS INITIAL. "HS# 9788
**     e_success = go_appl->pai_kunnr_input( is_comwa = gs_comwa "HS# 9788 "HS# 11618
**                          id_no_dialog = id_no_dialog_kunnr ). "HS# 9788 "HS# 11618
*      e_success = partner_date_calc( i_no_dialog = id_no_dialog_kunnr ). "HS# 11618
*      CHECK e_success = abap_true.                          "HS# 9788
*    ENDIF.                                                  "HS# 9788
*____________HS# 12094___________________END_OF_DELETION
  ENDIF.                                                    "HS# 9774

*__Equipmentauswahl
  e_success = abap_false.                                   "HS# 9846

*  IF gs_comwa-rscat IS INITIAL                             "HS# 10467  "HS# 12209   "HS 14146
*    AND g_iconnect IS INITIAL.                             "HS# 12209               "HS 14146

  go_appl->get_property( EXPORTING i_feld = 'GV_ATP_ON_CASE_CREATE' IMPORTING e_value = lv_atp_on_case_create ). "HS# 016125
  IF lv_atp_on_case_create IS NOT INITIAL.                  "HS# 016125
    gd_atp_view = /bitmym/cl_bar_chart=>c_view_alv.         "HS# 016125
  ELSE.                                                     "HS# 016125
    IF g_iconnect IS NOT INITIAL.                           "HS# 14146
      gd_atp_view = /bitmym/cl_bar_chart=>c_no_display.     "HS# 14146
    ENDIF.                                                  "HS# 14146
  ENDIF.                                                    "HS# 016125

  IF gs_comwa-rscat IS INITIAL AND                          "HS# 14146
     id_no_atp      IS INITIAL.                             "HS# 14146


    IF go_partner IS NOT INITIAL AND enh_atp_active( ) EQ abap_true.                "HS# 14619; HS# 14944
      go_partner->set_fld_inv_cust_range( ).                "HS# 14619
    ENDIF.                                                  "HS# 14619

    IF gt_mat_selection[] IS INITIAL.                       "HS# 017485
      CHECK equipment_auswahl_h( ) EQ abap_true.
    ENDIF.                                                  "HS# 017485
  ENDIF.                                                    "HS# 10467

*____SR2-1827____BEGIN INSERT___*
  IF go_ui5 IS BOUND AND gd_mixed IS NOT INITIAL.
    perpare_single_item( ).
  ENDIF.
*____SR2-1827____END   INSERT___*


  e_success = abap_true.

* Read Booking Data
  IF gs_comwa-ref_book IS NOT INITIAL                       "HS#016372
    AND gs_comwa-xfollowup IS INITIAL.                      "SR2-1951
    read_booking_data( ).                                   "HS#016372
  ENDIF.

*__COMWA füllen
  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ).

  MOVE-CORRESPONDING ls_comwa_init TO ls_comwa.             "HS# 12106
  MOVE-CORRESPONDING ls_comwa TO gs_case.
  MOVE-CORRESPONDING ls_comwa TO gs_comwa.



  gs_comwa-abgru = /sopromet/cl_l_reservation=>gd_lost_abgru.

  rental_set_initial_values( ).                             "HS 12469

  reference_order_copy_data( ).                             "HS# 9774

  reference_booking_copy_data( ).                           "HS# 10467

  check_duplicate_po( ).                                    "HS# 9774

  e_success = exit_create_new_case( ).                      "HS# 12085

  CHECK e_success EQ abap_true.                             "HS# 12085

*__Neue Case Nummer ziehen
  get_new_case_number( ).

  init_linked_objects( ).                                   "HS# 12094

  reference_order_text_copy( ).                             "HS# 9936

  reference_booking_text_copy( ).                           "HS# 11767

*__Reservierungstyp
  read_reservation_type( ).

*  IF g_iconnect EQ abap_false.                              "HS 12314 "SR1-912 DEL
  go_appl->pbo_sub_texte(  ).                               "HS 12314
*  ENDIF.                                                    "HS 12314 "SR1-912 DEL

*  CHECK gs_comwa-kunnr IS NOT INITIAL.                         "HS# 9788
*  e_success = go_appl->pai_kunnr_input( gs_comwa ).            "HS# 9788


ENDMETHOD.


