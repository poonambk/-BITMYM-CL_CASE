  ENDMETHOD.


  METHOD ui5_get_consumption_indicator.
*____HS# 012765, VON: MKNAUER, DATUM: 28.01.2020___*
*____HS# 014112, VON: SSINGH, DATUM: 21.10.2020___*
*____HS# 014651, VON: SSINGH, DATUM: 17.11.2020___*
*____HS# 014900, VON: SSINGH,  DATUM: 10.03.2021___*
*____HS# 015196, VON: MKNAUER, DATUM: 28.06.2021___*
*____HS# 016091, VON: MKNAUER, DATUM: 22.10.2021___*
*____HS# 016487, VON: MKNAUER, DATUM: 04.02.2022___* "SR1-568
*____HS# 016542, VON: MKNAUER, DATUM: 21.02.2022___*
*____HS# 017105, VON: MKNAUER, DATUM: 25.07.2022___*
*___ SR2-376, User: OOGUR, Date: 20.08.2024___*


    DATA: ls_monitor     TYPE /bitmym/monitor,
          ls_rstype      TYPE /sopromet/rstype,             "HS# 015196
          ls_rstyp       TYPE /sopromet/rstypo,                 "HS 14112 HS 14900
          lt_range_lrsam TYPE RANGE OF /sopromet/zzlrsam,   "HS 14900
          lt_range_book  TYPE RANGE OF /sopromet/zzlresn .  "HS 14900

    DATA: ls_vbadr_sb TYPE vbadr,                           "HS# 016091
          ls_case     TYPE /bitmym/case.                    "HS# 016091


    FIELD-SYMBOLS: <book> LIKE LINE OF lt_range_book.       "HS 14900

    ed_consumable = abap_false.

    CHECK gw_mattyp_sql IS NOT INITIAL.                     "HS# 017105

*____"HS# 015196_________START_INSERT
    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp = is_data-rstyp
      IMPORTING
        e_data  = ls_rstype.

    CHECK ls_rstype-kznoi IS INITIAL.
*____"HS# 015196_________END_INSERT

*____HS# 016542, Start insert____*
ENHANCEMENT-POINT GET_INVOICE_INDICATOR SPOTS /BITMYM/CL_CASE .
*____HS# 016542, Start insert____*


*___HS# 16487_______START_INSERT "SR1-568
    IF gt_jest_bookings IS NOT INITIAL AND is_data-objnr IS NOT INITIAL.
      READ TABLE gt_jest_bookings TRANSPORTING NO FIELDS
           WITH KEY objnr = is_data-objnr txt04 = /sopromet/cl_l_reservation=>c_book_status_cancel.
      CHECK sy-subrc NE 0.
    ENDIF.
*___HS# 16487_______END_INSERT "SR1-568

*    Begin of changes HS 14651
    IF gt_range_lifnr IS INITIAL.
      /bitmym/cl_monitor=>ui5_get_lifnr_range( EXPORTING io_ui5 = go_ui5 io_appl = go_appl
                                                IMPORTING et_lifnr = gt_range_lifnr ).
    ENDIF.
*    end of changes HS 14651
*    begin of changes HS 14900
    APPEND INITIAL LINE TO lt_range_book ASSIGNING <book>.
    <book>-sign   = 'I'.
    <book>-option = 'EQ'.
    <book>-low    = is_data-zzlresn.
    /bitmym/cl_monitor=>ui5_populate_ranges( EXPORTING io_ui5 = go_ui5 io_appl = go_appl it_ref_book = lt_range_book
                                                IMPORTING et_lrsam = lt_range_lrsam ).
    IF lt_range_lrsam IS NOT INITIAL.
      REFRESH lt_range_book.
    ENDIF.

*    end of changes HS 14900
*    begin of HS 14112
*    begin of changes HS 17105
*    IF gt_aacl IS INITIAL.
*      SELECT * INTO TABLE gt_aacl FROM /bitmym/aacl WHERE consumable = 'X'. "HS 14112
*    ENDIF.
*    CHECK gt_aacl IS NOT INITIAL.
*    end of changes HS 17105

*    SELECT * INTO ls_monitor UP TO 1 ROWS FROM  /bitmym/monitor  "HS# 17105 DEL
    SELECT SINGLE moninr  INTO ls_monitor FROM  /bitmym/monitor   "HS# 17105 INS
*           FOR ALL ENTRIES IN gt_aacl                      "HS# 17105 DEL
               WHERE  status    = /bitmym/cl_monitor=>c_status_customer
*           AND    mattyp    = gt_aacl-mset_group           "HS# 17105 DEL
               AND    lifnr     IN gt_range_lifnr           "HS 14651
               AND    vkorg     = is_data-vkorg             "HS 14900
               AND    zzlrsam   IN lt_range_lrsam           "HS 14900
               AND    ref_book  IN lt_range_book                "HS 14900, HS# 17105 MOD
               AND    (gw_mattyp_sql).                          "HS# 17105 INS

*    ENDSELECT.                                             "HS# 17105 INS

    IF  sy-subrc NE 0.

*____SR2-376____BEGIN INSERT___*
      ed_consumable = ui5_check_field_inv_records( iv_zzlresn = is_data-zzlresn ).
      CHECK ed_consumable EQ abap_false.
*____SR2-376____END   INSERT___*

*     check if the booking is in status delivered or invoiced
      CHECK  is_data-txt04 = /sopromet/cl_l_reservation=>c_book_status_mat_d OR
             is_data-txt04 = /sopromet/cl_l_reservation=>c_book_status_inv_created.

      CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
        EXPORTING
          i_rstyp = is_data-rstyp
          i_vkorg = is_data-vkorg
        IMPORTING
          e_data  = ls_rstyp.


*____HS# 16091____START_INSERT
      IF ls_rstyp-icaddcons EQ abap_true.
        ed_consumable = ui5_get_consumption_ind_sb( io_case = io_case is_data = is_data ).
        CHECK ed_consumable EQ abap_false.
      ENDIF.
*____HS# 16091____END_INSERT


      CHECK ls_rstyp-icaddcons EQ abap_true.

*    SELECT * INTO ls_monitor UP TO 1 ROWS FROM  /bitmym/monitor  "HS# 17105 DEL
      SELECT SINGLE moninr  INTO ls_monitor FROM  /bitmym/monitor   "HS# 17105 INS
*           FOR ALL ENTRIES IN gt_aacl                      "HS# 17105 DEL
              WHERE  status    = /bitmym/cl_monitor=>c_status_customer
              AND    kunag     = is_data-kunnr
*           AND    mattyp    = gt_aacl-mset_group           "HS# 17105 DEL
              AND    vkorg     = is_data-vkorg
              AND    lifnr     IN gt_range_lifnr            "HS 14651
              AND    kzper    EQ space
              AND    xnonmym   = 'X'                          "HS# 17105 MOD
             AND    (gw_mattyp_sql).                          "HS# 17105 INS
*    ENDSELECT.                                             "HS# 17105 INS
    ENDIF.
*    end of HS 14112
    CHECK sy-subrc EQ 0.

    ed_consumable = abap_true.

  ENDMETHOD.


  METHOD UI5_BOOKINGS_GET_DETAIL.
