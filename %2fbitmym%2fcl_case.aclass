  METHOD partner_date_calc.
*____HS# 11618, VON: R.BOYAPATI, DATUM: 28.02.2017 ___*
*____HS# 11872, VON: O.pecharroman DATUM 26.05.2017
*____HS# 11843, VON: Pritam Kunal DATUM 06.07.2017
*____HS# 12416, VON: S.Taori      DATUM 22.03.2018 ___*

    DATA: lo_res     TYPE REF TO /sopromet/cl_l_reservation,
          ls_comwa   TYPE /sopromet/zzls01,
          ls_comwa_t TYPE /sopromet/zzls01.

    e_success = go_appl->pai_kunnr_input( is_comwa     = gs_comwa "HS# 9788
                                          id_no_dialog = i_no_dialog ). "HS# 9788
    CHECK e_success = abap_true.                            "HS# 9788

    go_appl->get_property( EXPORTING i_feld  = 'GS_COMWA'
                           IMPORTING e_value = ls_comwa ).
    go_main_2006->g_screen->set_prop_commwa( ls_comwa ).

    CREATE OBJECT lo_res.
    set_property lo_res 'GO_APPLICATION' go_appl.
*   lo_res->day_compute_days_70( ).                         "HS# 11872
*    ls_comwa_t = lo_res->day_compute_days_70( ).            "HS# 11843 "HS 12416
*    ls_comwa-vdate = ls_comwa_t-vdate.                      "HS# 11843 "HS 12416
*    ls_comwa-rdate = ls_comwa_t-rdate.                      "HS# 11843 "HS 12416
*    ls_comwa-abdat = ls_comwa_t-abdat.                      "HS# 11843 "HS 12416
*    ls_comwa-frdat = ls_comwa_t-frdat.                      "HS# 11843 "HS 12416
*   lo_res->day_compute_days( go_main_2006 ).               "HS# 11872
*   ls_comwa = go_main_2006->g_screen->get_prop_comwa( ).   "HS# 11872
    go_appl->set_property( i_feld  = 'GS_COMWA' i_value = ls_comwa ).

  ENDMETHOD.


METHOD partner_get_data.
*____HS# 11951, VON: S.Taori, DATUM: 04.07.2017 ___*
*____HS# 012919, VON: OPECHARROMAN, DATUM: 28.01.2019___*
*____HS# 014748, VON: SISMAIL, DATUM: 14.12.2020___*
*____HS# 014955, VON: SISMAIL, DATUM: 22.02.2021___*
*____HS# 016268, VON: MKNAUER, DATUM: 13.12.2021___* SR1-507
*____HS# 016705, VON: SBADUSHA, DATUM: 25.04.2022___*
*____HS# 016755, VON: SBADUSHA, DATUM: 26.04.2022___*
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*
*___ SR2-259, User: STEKDEMIR, Date: 15.03.2024___*
*___ SR2-1494, User: SCOSAR, Date: 28.03.2025___*


  DATA: ld_ad            TYPE ad_line_s,
        ld_surg_comb_run TYPE kunnr,
*        ls_knvv          TYPE knvv,                         "SR1-2098 "SR2-259 comment
*        lt_rstyp_vkorg   TYPE TABLE OF  /sopromet/rstypo,   "SR1-2098 "SR2-259 comment
        lt_vbpa          TYPE /sopromet/vbpav_tab.          "HS# 016755

  go_partner->partner_get_data( ).

  go_partner->get_property( EXPORTING i_feld = 'GD_ADRESS_AG' IMPORTING e_value = ld_ad ).
  gs_comwa-addr_ag = ld_ad.

  go_partner->get_property( EXPORTING i_feld = 'GD_ADRESS_WE' IMPORTING e_value = ld_ad ).
  gs_comwa-addr_we = ld_ad.

*Begin of comment SR2-259
** Begin of SR1-2098
*  IF go_salesarea IS BOUND.
*    go_salesarea->get_property( EXPORTING i_feld = 'GT_RSTYP_VKORG' IMPORTING e_value = lt_rstyp_vkorg ).
*    READ TABLE lt_rstyp_vkorg INTO DATA(ls_rstype) WITH KEY vkorg = gs_actual_area-vkorg rstyp = gs_comwa-rstyp.
*    IF sy-subrc = 0.
*      /bitmym/cl_ui5_s4h_icotermsget=>get_ship_cond_from_part( EXPORTING iv_kunwe        = gs_comwa-kunwe
*                                                                         iv_kunnr        = gs_comwa-kunnr
*                                                                         iv_kunwe_filter = gs_comwa-kunwe
*                                                                         is_actual_area  = gs_actual_area
*                                                                         iv_shcond_conf  = ls_rstype-ship_cond_src
*                                                                CHANGING cv_vsbeb        = gs_comwa-vsbeb
*                                                                         cv_vtext        = gs_comwa-vtext ).
*    ENDIF.
*  ENDIF.
** End of SR1-2098
* End of comment of comment SR2-259

  IF go_appl IS NOT INITIAL.
    go_appl->set_property( i_feld = 'GS_COMWA-ADDR_AG' i_value = gs_comwa-addr_ag ).
    go_appl->set_property( i_feld = 'GS_COMWA-ADDR_WE' i_value = gs_comwa-addr_we ).
    go_appl->set_property( i_feld = 'GS_COMWA-INCO1'   i_value = gs_comwa-inco1 ).
    go_appl->set_property( i_feld = 'GS_COMWA-INCO2'   i_value = gs_comwa-inco2 ).
    go_appl->set_property( i_feld = 'GS_COMWA-VSBEB'   i_value = gs_comwa-vsbeb ).
    go_appl->set_property( i_feld = 'GS_COMWA-VTEXT'   i_value = gs_comwa-vtext ). "SR1-2098
    go_appl->set_property( i_feld = 'GS_COMWA-BZIRK'   i_value = gs_comwa-bzirk ). "HS# 016268 SR1-507
    go_appl->set_property( i_feld = 'GS_COMWA-AUTLF'   i_value = gs_comwa-autlf ). "HS# 016705
    gs_case-inco1 = gs_comwa-inco1.
    gs_case-inco2 = gs_comwa-inco2.
    gs_case-vsbeb = gs_comwa-vsbeb.
    gs_case-bzirk = gs_comwa-bzirk.                         "HS# 016268 SR1-507
*    gs_case-opman = gs_comwa-opman. "HS# 014748 "HS# 014955 -> Commented
    gs_case-autlf = gs_comwa-autlf.                         "HS# 016705
  ENDIF.

* HS 11951 is substituted by 12919.
* To copy customer text we have to customize text copy control routines as defined in HS 12919
*  get_cust_text_into_res_text( ).                           "HS 11951 HS 12919

*&* Begin of HS# 016755
  IF gs_actual_area-parvwsurg IS NOT INITIAL.
    go_partner->get_property( EXPORTING i_feld = 'GT_VBPA' IMPORTING e_value =  lt_vbpa ).
    DATA(ls_vbpa) = VALUE #( lt_vbpa[ parvw = gs_actual_area-parvwsurg ] OPTIONAL ).
    IF ls_vbpa IS INITIAL.
      CLEAR: gs_comwa-opman,gs_case-opman.
    ELSEIF ls_vbpa-name1 IS NOT INITIAL.                    "SR2-1494
      gs_comwa-opman = gs_case-opman = ls_vbpa-name1.       "SR2-1494
    ENDIF.
    CLEAR ls_vbpa.                                          "SR2-1494
  ENDIF.
*&* End of HS# 016755
ENHANCEMENT-POINT partner_get_data  SPOTS /bitmym/case.


ENDMETHOD.


