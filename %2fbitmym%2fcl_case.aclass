    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

    lo_case->ui5_bookings_get_detail_int( IMPORTING er_entity = er_entity es_response_context = es_response_context  ).
  ENDMETHOD.


  METHOD ui5_bookings_get_detail_int.
*____HS# 012010, VON: MKnauer,      DATUM: 12.10.2017___*
*____HS# 012765, VON: MKNAUER,      DATUM: 25.10.2018___*
*____HS# 014112, VON: SSINGH,       DATUM: 21.10.2020___*
*____HS# 015186, VON: SSINGH,       DATUM: 15.04.2021___*
*____HS# 015419, VON: SISMAIL,      DATUM: 04.06.2021___*
*____HS# 015455, VON: SSINGH,       DATUM: 15.06.2021___*
*____HS# 015953, VON: SSINGH,       DATUM: 16.09.2021___*
*____HS# 016041, VON: SSINGH,       DATUM: 22.10.2021___*
*____HS# 016177, VON: SSINGH,       DATUM: 03.12.2021___*
*____HS# 017105, VON: BGUNAWAN,     DATUM: 06.10.2022___*
*____HS# 017422, VON: OPECHARROMAN, DATUM: 13.10.2022___*
*___ SR1-2073,   User: SSINGH,      Date:  14.12.2023___*
*___ SR1-2133,   User: SSINGH,      Date:  04.01.2024___*
*___ SR1-921,    User: SSAHU,       Date:  30.01.2024___*
*___ SR2-688,    User: SCOSAR,      Date:  26.07.2024___*
*___ SR2-984,    User: STEKDEMIR,   Date:  16.10.2024___*
*___ SR2-1073,   User: STEKDEMIR,   Date:  06.11.2024___*
*___ SR2-1211,   User: SSAHU,       Date:  26.11.2025___*
*___ SR2-2529,   User: OOGUR,       Date:  05.12.2025___*
*___ SR2-2637, User: SBADUSHA, Date: 22.01.2026___*


    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          lo_book_ui5 TYPE REF TO /bitmym/cl_ui5_booking,   "HS# 17422
          ls_rserv    TYPE /sopromet/zzlrv,
          lt_reserv   TYPE /sopromet/ty_tree_map_tab,
          ls_vbak     TYPE vbak,                            "HS# 12765
          ls_rstypt   TYPE /sopromet/rstypt,                "HS# 12765
          lo_booking  TYPE REF TO /sopromet/cl_l_reservation. "HS# 12765

    FIELD-SYMBOLS: <bookings> TYPE /bitmym/bookings,
                   <res>      TYPE /sopromet/ty_tree_map.


    /bitmym/if_ui5~go_tech_request_context->/iwbep/if_mgw_req_entity_u~get_converted_keys( IMPORTING es_key_values = er_entity ).

    CHECK er_entity-zzlresn IS NOT INITIAL.

    lo_case = /bitmym/cl_case=>create( id_reservation = er_entity-zzlresn ).

    CHECK ui5_booking_detail_check_exit( ir_case = lo_case ) EQ abap_true. "HS# 12765

    ui5_get_mattyp_sql( ).                                  "HS# 017105

    get_property lo_case 'GS_CASE'         ls_case.
    get_property lo_case 'GT_RESERVATIONS' lt_reserv.

    MOVE-CORRESPONDING ls_case TO er_entity.

    IF lt_reserv IS NOT INITIAL.
      READ TABLE lt_reserv ASSIGNING <res> INDEX 1.

      <res>-objkey->get_reservation_data( IMPORTING e_reservation = ls_rserv ).
      MOVE-CORRESPONDING ls_rserv TO er_entity.

    ENDIF.
*____SR2-2637____BEGIN INSERT___*

    SELECT SINGLE * FROM /bitmym/ibookref WHERE refbook =  @er_entity-zzlresn INTO @DATA(ls_reservations).
    IF sy-subrc = 0.
      er_entity-lsram_res = ls_reservations-combinedrun.
    ENDIF.

*____SR2-2637____END   INSERT___*

    " Begin of HS# 015419+
    CLEAR ls_vbadr_ag.
    IF gs_actual_area-parvwcrep IS NOT INITIAL.
      CALL METHOD /bitmym/cl_partner=>read_crep_address_from_kun_ext
        EXPORTING
          id_kunnr = er_entity-kunnr
          id_parvw = gs_actual_area-parvwcrep
        CHANGING
          cs_vbadr = ls_vbadr_ag.

      er_entity-name1 = ls_vbadr_ag-name1.
    ENDIF.
    IF ls_vbadr_ag-name1 IS INITIAL.
      " End of HS# 015419+
      /bitmym/cl_partner=>read_address_partner_info_ext(
        EXPORTING
          id_vkorg = ls_case-vkorg
          id_case  = ls_case-zzlrsam
          id_parvw = 'AG'
        CHANGING
          cs_vbadr = ls_vbadr_ag ).

      er_entity-name1 = ls_vbadr_ag-name1.

    ENDIF. "HS# 015419+

    IF /bitmym/if_ui5~gv_parvw IS NOT INITIAL.

      /bitmym/cl_partner=>read_address_partner_info_ext(
        EXPORTING
          id_vkorg = ls_case-vkorg
          id_case  = ls_case-zzlrsam
          id_parvw = /bitmym/if_ui5~gv_parvw
        CHANGING
          cs_vbadr = ls_vbadr_xx ).

      er_entity-nachn = ls_vbadr_xx-name1.

    ENDIF.

*_________"HS# 12765__________START_INSERT
    IF er_entity-asmnt IS NOT INITIAL.
      CALL FUNCTION 'SD_VBAK_SINGLE_READ'
        EXPORTING
          i_vbeln          = er_entity-asmnt
        IMPORTING
          e_vbak           = ls_vbak
        EXCEPTIONS
          record_not_found = 1
          OTHERS           = 2.
      IF sy-subrc EQ 0.
        er_entity-asmnt_text = ls_vbak-ktext.
      ENDIF.
    ENDIF.
*_________"HS# 12765__________END_INSERT

*_________"HS# 12765 DENDRES_____START_INSERT

    IF <res>-objkey IS BOUND.
      er_entity-txt04 = <res>-objkey->get_user_status( ).
      er_entity-txt30 = <res>-objkey->get_user_status_30( ).
    ENDIF.

*___ SR1-921 Begin
    IF er_entity-txt04 = /sopromet/cl_l_reservation=>c_ftr_status_created
      OR er_entity-txt04 = /sopromet/cl_l_reservation=>c_ftr_status_released.
      er_entity-edit_booking = 'X'.
    ENDIF.
*___ SR1-921 End

    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp      = er_entity-rstyp
        id_no_buffer = abap_true "HS# 012765
      IMPORTING
        e_text       = ls_rstypt.

    er_entity-bezei = ls_rstypt-bezei.

*_________"HS# 12765 DENDRES_____END_INSERT
    er_entity-sutext = ui5_get_surgery_text( is_data = er_entity ). "HS# 15455
    er_entity-kzedt  = lo_case->checks_related_req_del_date( ). "SR2-984

    er_entity-consumeable = ui5_get_consumption_indicator( io_case = lo_case is_data = er_entity ). "HS# 12765  " HS 14112 SR1-2133
    ui5_get_followup_fields( CHANGING cs_data = er_entity ). "HS 15186

    ui5_set_dele_flag( CHANGING cs_data = er_entity ).      "HS 15953
    ui5_check_time_format( CHANGING cs_item = er_entity ).  "SR1-2073
    ui5_update_own_booking( EXPORTING io_case = lo_case CHANGING cs_data = er_entity ). "HS 16041
    ui5_get_shipping_condition_txt( CHANGING cs_data = er_entity ). "HS 16177

*____SR2-688____BEGIN INSERT___*
    calculate_editable_flags( EXPORTING is_booking = CORRESPONDING #( er_entity ) IMPORTING ed_edit_booking   = er_entity-edit_booking
                                                                                            ed_edit_item      = er_entity-edit_item
                                                                                            ed_dispatch_exist = er_entity-dispatch_exist
                                                                                            ed_edit_partner   = er_entity-edit_partner ).
*____SR2-688____END   INSERT___*

    er_entity-item_scan       = go_rstyp->get_data( )-gs_rstypo-item_scan. "SR2-1211
    er_entity-default_address = ui5_get_rep_default_address( ). "SR2-2529

*_________HS# 017422____________________START_INSERT
    TRY.
        lo_book_ui5 ?= me->/bitmym/if_ui5~go_ui5.
        IF lo_book_ui5 IS BOUND.
          er_entity-color = lo_book_ui5->get_status_color( i_lresn = er_entity-zzlresn ).
        ENDIF.
      CATCH cx_root INTO lo_ex.

    ENDTRY.
*_________HS# 017422____________________END_INSERT

    "SR2-1073 Enhancement-point created
ENHANCEMENT-POINT UI5_BOOKINGS_GET_DETAIL_INT SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


