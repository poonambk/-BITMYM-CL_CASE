  METHOD reset_yy_attr_case_n_res.
*____HS# 014169, VON: STAORI, DATUM: 05.06.2020___*
*___ SR1-1688, User: SBADUSHA, Date: 04.10.2023___*

    DATA: lt_node_map	            TYPE /sopromet/ty_tree_map_tab,
          lt_booking_items        TYPE /bitmym/b_items_st_tab,
          lt_single_items         TYPE  /sopromet/ritems_tab,
          l_reservation_items_ret TYPE  /sopromet/res_items,
          l_reservation           TYPE  /sopromet/zzlrv,
          ls_zzlrv                TYPE /sopromet/zzlrv.  "SR1-1688

    FIELD-SYMBOLS: <map> TYPE /sopromet/ty_tree_map.

*__After the case_save_all, all the case and reservation old value attributes should be reset

*__Case attributes
    gs_case_yy = gs_case.
    gt_reservations_yy = gt_reservations.

*__Reservation attributes
    CHECK go_tree_case IS BOUND.
    get_property go_tree_case 'GT_NODE_MAP' lt_node_map.

    LOOP AT lt_node_map ASSIGNING <map>.
      CHECK <map>-objkey IS BOUND.
*__Booking items
      get_property <map>-objkey 'GT_BOOKING_ITEMS'    lt_booking_items.
      set_property <map>-objkey 'GT_BOOKING_ITEMS_YY' lt_booking_items.

*__Single items
      get_property <map>-objkey 'GT_SINGLE_ITEMS'     lt_single_items.
      set_property <map>-objkey 'GT_SINGLE_ITEMS_YY'  lt_single_items.

*__Inspection items
      get_property <map>-objkey 'G_RESERVATION_ITEMS_RET'    l_reservation_items_ret.
      get_property <map>-objkey 'G_RESERVATION_ITEMS_RET_YY' l_reservation_items_ret.

*__Reservation header
      get_property <map>-objkey 'G_RESERVATION'    l_reservation.
*&* Begin of Changes SR1-1688+
      IF <map>-kzsir = abap_true.
        CLEAR ls_zzlrv.
        CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
          EXPORTING
            i_reserv      = l_reservation-zzlresn
            i_no_buff     = abap_true
          IMPORTING
            e_reservation = ls_zzlrv.
        IF ls_zzlrv-rsnum IS NOT INITIAL.
          set_property <map>-objkey 'G_RESERVATION-RSNUM' ls_zzlrv-rsnum.
        ENDIF.
      ENDIF.
*&* End of Changes SR1-1688+
      set_property <map>-objkey 'G_RESERVATION_YY' l_reservation.
    ENDLOOP.
  ENDMETHOD.


method RELEASE_BOOKING.
*____HS# 10467, VON: O.PECHARROMAN DATUM: 22.09.2015____*

  DATA: lo_user   TYPE REF TO /bitmym/cl_user.

  DATA: lt_tree       TYPE /sopromet/tree_collect_tab,
        ls_map        TYPE /sopromet/ty_tree_map,
        c_time        TYPE sy-uzeit.

  DATA: ld_message    TYPE abap_bool.

  FIELD-SYMBOLS: <tree> TYPE /sopromet/tree_collect.

  e_released = abap_false.

  go_salesarea->get_property( EXPORTING i_feld = 'GO_USER' IMPORTING e_value = lo_user ).

  CHECK lo_user IS NOT INITIAL.
  CHECK lo_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_freigeben ) EQ abap_true.

*___Zuerst alles sichern
  case_save_all( ).

  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE' IMPORTING e_value = lt_tree ).

  LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.
    ls_map = go_tree_case->get_map_of_node( <tree>-node_key ).
    CHECK ls_map-kzper IS INITIAL.  "Keine Pending

    CALL METHOD ls_map-objkey->release_booking( ). "Freigabestatus setzen

    IF ld_message = abap_false.
      gs_comwa-txt04 = /sopromet/cl_l_reservation=>C_BOOK_STATUS_FREI.
      messaging( ).
      ld_message = abap_true.
    ENDIF.

    COMMIT WORK AND WAIT.

  ENDLOOP.

*__Statusänderungen sichern
  messaging( ).
  message_update( ).
  e_released = abap_true.

endmethod.


  METHOD release_dispatch_pgi_reserv.
*____HS# 10648, VON: S.Taori, DATUM: 17.09.2015 ___*
*____HS# 11360, VON: S.Taori, DATUM: 01.09.2016 ___*
*____HS# 11417, VON: S.Taori, DATUM: 07.10.2016 ___*

    DATA: lo_user   TYPE REF TO /bitmym/cl_user,
          ld_method TYPE char1.

    DATA: lt_tree       TYPE /sopromet/tree_collect_tab,
          ls_map        TYPE /sopromet/ty_tree_map,
          ld_ix         TYPE sy-tabix,
          ls_reserv_pai TYPE /sopromet/zzlrv,
          ls_reserv_y   TYPE /sopromet/zzlrv,
          c_time        TYPE sy-uzeit.

    DATA: ld_message    TYPE abap_bool.

    FIELD-SYMBOLS: <tree> TYPE /sopromet/tree_collect.

*__New EHP                                                                  "HS 11360
ENHANCEMENT-POINT release_dispatch_pgi_reserv_05 SPOTS /bitmym/case .

    e_released = abap_false.

    go_salesarea->get_property( EXPORTING i_feld = 'GO_USER' IMPORTING e_value = lo_user ).

    CHECK lo_user IS NOT INITIAL.
    CHECK lo_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_freigeben ) EQ abap_true.

*___Zuerst alles sichern
    case_save_all( ).

    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        text_question  = text-006
        default_button = '1'
      IMPORTING
        answer         = ld_method
      EXCEPTIONS
        text_not_found = 1
        OTHERS         = 2.

    CHECK ld_method NE 'A'.

    go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE' IMPORTING e_value = lt_tree ).

    ld_ix = 0.

    LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.
      ls_map = go_tree_case->get_map_of_node( <tree>-node_key ).
      CHECK ls_map-kzper IS INITIAL.  "Keine Pending
      ADD 1 TO ld_ix.

      CHECK ls_map-objkey IS BOUND.

      ls_map-objkey->check_intersection_release( ).

      ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_reserv_pai ).

      ls_reserv_y = ls_reserv_pai.

*__New EHS                                                  "HS 11360
ENHANCEMENT-SECTION release_dispatch_pgi_reserv_03 SPOTS /bitmym/case .

      CALL METHOD ls_map-objkey->release_reservation( ). "Freigabestatus setzen

      IF ld_message = abap_false.
        gs_comwa-txt04 = /sopromet/cl_l_reservation=>c_res_status_frei.
        messaging( ).
        ld_message = abap_true.
      ENDIF.

END-ENHANCEMENT-SECTION.

      ls_map-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION-RSNUM' IMPORTING e_value = ls_reserv_pai-rsnum ).

ENHANCEMENT-POINT release_dispatch_pgi_reserv_01 SPOTS /bitmym/case .
    ENDLOOP.

*__Statusänderungen sichern
    messaging( ).
    message_update( ).
    e_released = abap_true.
    COMMIT WORK AND WAIT.

    IF ld_method = '1'.
*__Sofortauftrag

*__New EHS                                                                  "HS 11360
ENHANCEMENT-SECTION release_dispatch_pgi_reserv_04 SPOTS /bitmym/case .
      go_appl->popup_free_reservations( ).                  "HS 11360
      IF sy-ucomm NE /bitmym/cl_l_alv_disp_ord_part=>c_fcode_disp_ord_part. "HS 11360
        e_released = abap_false.                            "HS 11360
        EXIT.                                               "HS 11360
      ENDIF.                                                "HS 11360
END-ENHANCEMENT-SECTION.

      e_released = create_dispatch_order( ).
      IF cl_gui_custom_container=>gui_is_running IS NOT INITIAL.
        COMMIT WORK AND WAIT.     " >>>>> NEW  <<<<<        "HS 11417
      ENDIF.
    ENDIF.

ENHANCEMENT-POINT release_dispatch_pgi_reserv_02 SPOTS /bitmym/case .

    CHECK g_dispatch_ord IS NOT INITIAL.
    post_gi_dispatch_order( EXPORTING i_vbeln = g_dispatch_ord ).
  ENDMETHOD.


  METHOD check_b_items_atp.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*
*____HS# 015031, VON: SSINGH, DATUM: 08.03.2021___*
*____HS# 016287, VON: SBADUSHA, DATUM: 24.05.2022___*
*____HS# 017121, VON: BGUNAWAN, DATUM: 12.12.2022___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*

    DATA: lt_atp_head TYPE /sopromet/lsatp_alv_tab,
          lt_matnr    TYPE /sopromet/zzls07_tab,
          lv_complete TYPE menge_d.

    FIELD-SYMBOLS: <lfs_head> TYPE /sopromet/lsatp_alv,
                   <matnr>    TYPE /sopromet/zzls07,
                   <item>     TYPE /bitmym/b_items_st.


    LOOP AT ct_b_items ASSIGNING <item>.

      CHECK id_force IS NOT INITIAL OR
            <item>-icon_avail IS INITIAL.

      APPEND INITIAL LINE TO lt_matnr ASSIGNING <matnr>.
      <matnr>-matnr = <item>-matnr.
      <matnr>-menge = <item>-menge.

      CLEAR <item>-icon_avail.
    ENDLOOP.

    CHECK lt_matnr IS NOT INITIAL.

    check_single_items_atp_booking( CHANGING ct_items = ct_b_items ).           "HS 15031

    fill_book_auto_plant_ranges( ). "HS# 016287+

    fill_booking_serial_no_atp( changing ct_matnr = lt_matnr ). "HS# 017121+

    gt_mat_selection = /bitmym/cl_bar_chart=>display_atp_from_case( EXPORTING io_case          = me
                                                                              i_view_type      = /bitmym/cl_bar_chart=>c_no_select
                                                                              it_atp_materials = lt_matnr ).

    CHECK go_barc IS BOUND.
    get_property go_barc 'GT_ATP_HEAD' lt_atp_head.


    LOOP AT ct_b_items ASSIGNING <item> WHERE icon_avail IS INITIAL.

      READ TABLE  lt_atp_head ASSIGNING <lfs_head> WITH KEY matnr = <item>-matnr.
      IF sy-subrc = 0.
        "
        IF <lfs_head>-vmeng GT <item>-menge.

          " Requested qty. available
          <item>-kbmeng = <item>-menge.
          lv_complete = <lfs_head>-vmeng - <lfs_head>-muvxx.   " complete sets

          IF lv_complete GE <item>-menge.
            " Complete sets available
            <item>-icon_avail = convert_atp_icon( '3' ).
          ELSE.
            " Available with incomplete sets
            <item>-icon_avail = convert_atp_icon( '2' ).
          ENDIF.

          <lfs_head>-vmeng = <lfs_head>-vmeng - <item>-menge.

        ELSE.
          " Requested qty. is Unavailable
          <item>-kbmeng = <lfs_head>-vmeng.
          <lfs_head>-vmeng = 0.

          <item>-icon_avail = convert_atp_icon( <lfs_head>-status ).

        ENDIF.
        <item>-werks = <lfs_head>-werks.   "SR1-545
      ELSE.
        " Not ATP relevant / Single items

*        <item>-icon_avail = convert_atp_icon( '0' ).                 "HS 15031

      ENDIF.

    ENDLOOP.


  ENDMETHOD.


METHOD release_reservation.
*____HS# 9958,   VON: MKnauer, DATUM: 04.06.2014 ___*
*____HS# 10241,  VON: T.Kern, DATUM: 17.12.2014 ___*
*____HS# 11498,  VON: OPecharroman, DATUM: 20.01.2017____*
*____HS# 12310,  VON: OPecharroman, DATUM: 12.02.2012____*
*____HS# 013077, VON: STAORI,       DATUM: 19.03.2019___*
*____HS# 014170, VON: STAORI,       DATUM: 19.06.2020___*
*___ SR2-335, User: STEKDEMIR, Date: 17.04.2024___*
*___ SR2-2114, User: SSAHU, Date: 12.08.2025___*

  DATA: lo_user   TYPE REF TO /bitmym/cl_user,
        ld_method TYPE char1.

  DATA: lt_tree         TYPE /sopromet/tree_collect_tab,
        ls_map          TYPE /sopromet/ty_tree_map,
        ld_ix           TYPE sy-tabix,
        ls_reserv_pai   TYPE /sopromet/zzlrv,
        ls_reserv_y     TYPE /sopromet/zzlrv,
        ls_zzlrv_recent TYPE /sopromet/zzlrv,               "HS 14170
        c_time          TYPE sy-uzeit.

  DATA: ld_message    TYPE abap_bool.                       "HS# 9958

  FIELD-SYMBOLS: <tree> TYPE /sopromet/tree_collect.

  e_released = abap_false.

  go_salesarea->get_property( EXPORTING i_feld = 'GO_USER' IMPORTING e_value = lo_user ).

  CHECK lo_user IS NOT INITIAL.
  CHECK lo_user->check_auth_with_txt( /bitmym/cl_user=>c_auth_res_freigeben ) EQ abap_true.

* The release customzing should not be available in create mode. If it is available, we avoid releasing here.
  CHECK gs_comwa-trtyp_o NE /sopromet/cl_l_screen=>c_trtyp_create. "HS# 12310.

  CHECK case_save_final_check( ) EQ abap_true.              "HS 13077

*___Zuerst alles sichern
  case_save_all( ).

  CHECK check_before_release( ) EQ abap_true.               "HS# 11498

*___Abfrage
*  ld_method = popup_release_method( )."(-)SR2-2114
  ld_method = /bitmym/cl_case=>c_freigabe_sofortauftrag.    "SR2-2114
  CHECK ld_method NE 'A'.

  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE' IMPORTING e_value = lt_tree ).

  ld_ix = 0.

  LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.
    ls_map = go_tree_case->get_map_of_node( <tree>-node_key ).
    CHECK ls_map-kzper IS INITIAL.  "Keine Pending
    ADD 1 TO ld_ix.

    CHECK ls_map-objkey IS BOUND.

    ls_map-objkey->check_intersection_release( ).           "HS# 10241

    ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_reserv_pai ).

    ls_reserv_y = ls_reserv_pai.

    CALL METHOD ls_map-objkey->release_reservation( ). "Freigabestatus setzen

    IF ld_message = abap_false.                             "HS# 9958
      gs_comwa-txt04 = /sopromet/cl_l_reservation=>c_res_status_frei. "HS# 9958
      messaging( ).                                         "HS# 9958
      ld_message = abap_true.                               "HS# 9958
    ENDIF.                                                  "HS# 9958

*    ls_map-objkey->get_property( EXPORTING i_feld = 'G_RESERVATION-RSNUM' IMPORTING e_value = ls_reserv_pai-rsnum ). "HS 14170

*______________________________________________________Start of HS 14170
*__Get RSNUM from DB as the earlier call of case_save_all might have created a new reservation
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_reserv_pai-zzlresn
        i_no_buff     = abap_true
      IMPORTING
        e_reservation = ls_zzlrv_recent.

    ls_reserv_pai-rsnum =  ls_zzlrv_recent-rsnum.
*________________________________________________________End of HS 14170

    IF  ld_method EQ c_freigabe_workflow AND
        ld_ix     EQ 1.

ENHANCEMENT-POINT release_reservation_01 SPOTS /bitmym/case .

      IF ls_reserv_pai-vdate EQ sy-datum.
        c_time = sy-uzeit.
*> Mindestens 10 Minuten später
        c_time = c_time + 120.
        IF ls_reserv_pai-vtime LT c_time.
          ls_reserv_pai-vtime = c_time.
        ENDIF.
      ELSE.
        IF ls_reserv_pai-vtime IS INITIAL.
          ls_reserv_pai-vtime = '060000'.  "6am
        ENDIF.
      ENDIF.

      CALL FUNCTION '/SOPROMET/POST_ZZLRV' IN UPDATE TASK
        EXPORTING
          n_zzlrv = ls_reserv_pai
          y_zzlrv = ls_reserv_y.

      COMMIT WORK AND WAIT.

*> Workflow
      CHECK ls_map-objkey->check_open_dispatch_wi( ) IS INITIAL.

      wf_objkey   = ls_reserv_pai-zzlresn.
*      wf_objtype  = 'ZZLRESERV'. "SR2-335
      wf_objtype = /bitmym/cl_mym=>get_object_attachment( /bitmym/cl_mym=>c_objtype_reservation ). "SR2-335
      wf_event    = 'Released'.
      wf_synchron = 'X'.
      CALL METHOD wf_swe_event_create( ).
    ENDIF.
ENHANCEMENT-POINT release_reservation_02 SPOTS /bitmym/case .
  ENDLOOP.

*__Statusänderungen sichern
  messaging( ).                                             "HS# 9958
  message_update( ).                                        "HS# 9958
  e_released = abap_true.
  COMMIT WORK AND WAIT.

  IF ld_method = c_freigabe_sofortauftrag.
*__Sofortauftrag
    e_released = create_dispatch_order( ).
  ENDIF.


ENDMETHOD.


  METHOD rental_copy_details_from_book.
*____HS# 12469, VON: STAORI, DATUM: 14.06.2018___*

    DATA: ls_booking   TYPE /sopromet/zzlrv,
          ls_case_book TYPE /bitmym/case.

*__Read booking
    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = gs_comwa-ref_book
      IMPORTING
        e_reservation = ls_booking.

    CHECK ls_booking IS NOT INITIAL.
    CALL FUNCTION '/BITMYM/DB_READ_CASE_SINGLE'
      EXPORTING
        id_vkorg = ls_booking-vkorg
        id_case  = ls_booking-zzlrsam
      IMPORTING
        es_case  = ls_case_book.

    CHECK ls_case_book IS NOT INITIAL.
    gs_case-contract     = ls_case_book-contract.
    gs_case-contract_pos = ls_case_book-contract_pos.
    gs_case-quotation    = ls_case_book-quotation.
    gs_case-rsdat        = ls_case_book-rsdat.
    gs_case-redat        = ls_case_book-redat.
    gs_case-vlauez       = ls_case_book-vlauez.
    gs_case-vlaufz       = ls_case_book-vlaufz.
  ENDMETHOD.


  METHOD rental_get_contract_book.
*____HS# 12469, VON: STAORI, DATUM: 14.06.2018___*
*____HS# 0171745, VON: OPECHARROMAN, DATUM: 15.12.2022___*"SR1-805

    DATA: lt_book_item TYPE /bitmym/b_items_st_tab,
          ld_contract  TYPE vbeln.

    FIELD-SYMBOLS: <book_item> TYPE /bitmym/b_items_st.

    CHECK /bitmym/if_ui5~g_mobile_call = abap_false.        "HS# 017174 "SR1-805

    IF id_redetermine_contract IS INITIAL.
      CHECK gs_case-contract IS INITIAL.
    ENDIF.

    get_property go_act_reservation 'GT_BOOKING_ITEMS' lt_book_item.

    LOOP AT lt_book_item ASSIGNING <book_item>.
      ld_contract = rental_get_valid_contract( id_matnr = <book_item>-matnr ).
      CHECK ld_contract IS NOT INITIAL.
      gs_case-contract = ld_contract.
      ed_contract = ld_contract.
      EXIT.
    ENDLOOP.
  ENDMETHOD.


  METHOD rental_get_screen_data.
*____HS# 12469, VON: STAORI, DATUM: 14.06.2018___*

    DATA: ls_reservation TYPE /sopromet/zzlrv,
          ls_comwa       TYPE /sopromet/zzls01,
          ls_vbak        TYPE vbak,
          lt_vbap        TYPE STANDARD TABLE OF vbap,
          ls_area        TYPE /sopromet/zzslvb_sales,
          ld_matnr       TYPE matnr,
          lo_equi        TYPE REF TO  /sopromet/cl_l_equipment,
          ls_equi        TYPE	rihequi,
          lo_det         TYPE REF TO /bitmym/cl_determination.


    FIELD-SYMBOLS: <vbap> TYPE vbap.

    CHECK check_rstyp_rental_relevant( ) EQ abap_true.

    CLEAR: cs_rental_fields-contract_price,
           cs_rental_fields-contract_currency,
           cs_rental_fields-contract_unit,
           cs_rental_fields-quotation_price,
           cs_rental_fields-quotation_currency,
           cs_rental_fields-quotation_unit.

*__Read contract text
    IF gs_case-contract IS NOT INITIAL.             "Booking

      CALL FUNCTION 'SD_VBAK_SINGLE_READ'
        EXPORTING
          i_vbeln            = gs_case-contract
          i_bypassing_buffer = abap_true
        IMPORTING
          e_vbak             = ls_vbak
        EXCEPTIONS
          record_not_found   = 1
          OTHERS             = 2.

      cs_rental_fields-contract_txt = ls_vbak-ktext.

      IF gs_comwa-rscat EQ 'B'.
*        cs_rental_fields-contract_price    = ls_vbak-netwr.
*        cs_rental_fields-contract_currency = ls_vbak-waerk.

      ELSE.                                         "Reservation
        get_property go_act_reservation 'G_EQUIPMENT  ' lo_equi.
        IF lo_equi IS BOUND.
          get_property lo_equi 'G_EQUI_DATA' ls_equi.
          ls_comwa = gs_comwa.
          MOVE-CORRESPONDING ls_comwa TO ls_area.
          ls_comwa-matnr = ls_equi-matnr.

          CREATE OBJECT lo_det
            EXPORTING
              i_area = ls_area.

          lo_det->set_property( i_feld = 'GS_COMWA'   i_value = gs_comwa ).
          ld_matnr = lo_det->get_billing_material( ).

          SELECT *
            FROM vbap
            INTO TABLE lt_vbap
           WHERE vbeln = ls_vbak-vbeln
             AND matnr = ld_matnr.

          CHECK sy-subrc EQ 0.
          READ TABLE lt_vbap ASSIGNING <vbap> INDEX 1.    "For now selecting the first contract found
          cs_rental_fields-contract_price    = <vbap>-netpr.
          cs_rental_fields-contract_currency = <vbap>-waerk.
          cs_rental_fields-contract_unit = <vbap>-kmein.
        ENDIF.
      ENDIF.
    ENDIF.

*__Read quotation
    IF gs_case-quotation IS NOT INITIAL.

      CALL FUNCTION 'SD_VBAK_SINGLE_READ'
        EXPORTING
          i_vbeln            = gs_case-quotation
          i_bypassing_buffer = abap_true
        IMPORTING
          e_vbak             = ls_vbak
        EXCEPTIONS
          record_not_found   = 1
          OTHERS             = 2.

      IF gs_comwa-rscat EQ 'B'.
        cs_rental_fields-quotation_price    = ls_vbak-netwr.
        cs_rental_fields-quotation_currency = ls_vbak-waerk.

      ELSE.                                         "Reservation

        MOVE-CORRESPONDING gs_comwa TO ls_area.

        CREATE OBJECT lo_det
          EXPORTING
            i_area = ls_area.

        lo_det->set_property( i_feld = 'GS_COMWA'   i_value = gs_comwa ).
        ld_matnr = lo_det->get_billing_material( ).

        SELECT *
          FROM vbap
          INTO TABLE lt_vbap
         WHERE vbeln = gs_case-quotation
           AND matnr = ld_matnr.

        CHECK sy-subrc EQ 0.
        READ TABLE lt_vbap ASSIGNING <vbap> INDEX 1.    "For now selecting the first contract found
        cs_rental_fields-quotation_price    = <vbap>-netpr.
        cs_rental_fields-quotation_currency = <vbap>-waerk.
        cs_rental_fields-quotation_unit = <vbap>-kmein.
      ENDIF.
    ENDIF.

    IF gs_case-rsdat IS INITIAL.
      gs_case-rsdat = sy-datum.
    ENDIF.
  ENDMETHOD.


  METHOD rental_get_valid_contract.
*____HS# 12469, VON: STAORI, DATUM: 14.06.2018___*
    DATA: ls_reservation TYPE /sopromet/zzlrv,
          ls_comwa       TYPE /sopromet/zzls01,
          lt_vbak        TYPE STANDARD TABLE OF vbak,
          lt_vbap        TYPE STANDARD TABLE OF vbap,
          ls_area        TYPE /sopromet/zzslvb_sales,
          ld_matnr       TYPE matnr,
          lo_det         TYPE REF TO /bitmym/cl_determination.

    FIELD-SYMBOLS: <vbap> TYPE vbap.

    ls_comwa = gs_comwa.

    IF id_matnr IS SUPPLIED.
      ls_comwa-matnr = id_matnr.
    ENDIF.

    MOVE-CORRESPONDING ls_comwa TO ls_area.

    CREATE OBJECT lo_det
      EXPORTING
        i_area = ls_area.

    lo_det->set_property( i_feld = 'GS_COMWA'   i_value = ls_comwa ).
    ld_matnr = lo_det->get_billing_material( ).

    CHECK ld_matnr IS NOT INITIAL.

    SELECT *
      FROM vbak
      INTO TABLE lt_vbak
     WHERE kunnr EQ gs_comwa-kunnr
       AND vbtyp EQ 'G'
       AND guebg LE gs_case-rsdat
       AND gueen GE gs_case-redat.

    CHECK lt_vbak IS NOT INITIAL.
    SELECT *
      FROM vbap
      INTO TABLE lt_vbap
       FOR ALL ENTRIES IN lt_vbak
     WHERE vbeln = lt_vbak-vbeln
       AND matnr = ld_matnr.

    CHECK sy-subrc EQ 0.
    READ TABLE lt_vbap ASSIGNING <vbap> INDEX 1.    "For now selecting the first contract found
    ed_contract = <vbap>-vbeln.
    gs_case-contract = <vbap>-vbeln.
    gs_case-contract_pos = <vbap>-posnr.

  ENDMETHOD.


  METHOD rental_populate_initial_period.
*____HS# 12469, VON: STAORI, DATUM: 24.07.2018___*

    DATA: ls_res_type TYPE /sopromet/rstype,
          ls_rstypo	  TYPE /sopromet/rstypo,
          ld_horiz    TYPE /bitmym/rental_horizon,
          ls_tvrg     TYPE tvrg.

    CHECK go_rstyp IS BOUND.

    get_property go_rstyp 'G_RES_TYPE' ls_res_type.
    ls_rstypo = go_rstyp->get_prop_res_type_vkorg( gs_comwa ).

    IF ls_res_type-rental_horizon IS NOT INITIAL .
      ld_horiz = ls_res_type-rental_horizon.
    ENDIF.

    IF ls_rstypo-rental_horizon IS NOT INITIAL .
      ld_horiz = ls_rstypo-rental_horizon.
    ENDIF.

    CHECK ld_horiz IS NOT INITIAL.

    SELECT SINGLE * FROM tvrg INTO ls_tvrg WHERE regel EQ ld_horiz.
    CHECK ls_tvrg-zeitr IS NOT INITIAL AND ls_tvrg-zeite IS NOT INITIAL.
    gs_case-vlaufz = ls_tvrg-zeitr.
    gs_case-vlauez = ls_tvrg-zeite.

  ENDMETHOD.


  METHOD rental_set_initial_values.
*____HS# 12469, VON: STAORI, DATUM: 24.07.2018___*

    CHECK check_rstyp_rental_relevant( ) EQ abap_true.
    gs_case-rsdat = gs_comwa-odate.
    gs_case-redat = gs_comwa-vedat.

    rental_populate_initial_period( ).

    IF gs_comwa-ref_book IS INITIAL.
      gs_case-contract = rental_get_valid_contract( ).
    ELSE.
      rental_copy_details_from_book( ).
    ENDIF.

  ENDMETHOD.


  METHOD reset_case_unused_flag.
*____HS# 12481, VON: S.Taori, DATUM: 26.04.2018 ___*
*___ SR2-1030, User: SCOSAR, Date: 24.10.2024___*

    DATA: ls_case_yy TYPE /bitmym/case.

*__Since we are adding new reservation(s) to an existing case, we reset the flag 'UNUSED'

    CHECK gs_case-unused IS NOT INITIAL.
    ls_case_yy     = gs_case.
    gs_case-unused = abap_false.

    CALL FUNCTION '/BITMYM/CASE_UPDATE' IN UPDATE TASK
      EXPORTING
        i_trtyp     = gs_comwa-trtyp_o
        is_case_new = gs_case
        is_case_old = ls_case_yy
        i_sales_rep = /bitmym/if_ui5~gs_callerid-kunnr. "SR2-1030

ENHANCEMENT-POINT RESET_CASE_UNUSED_FLAG SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  method SINGLE_ITEM_CHECK_BEFORE_SAVE.
*____HS# 014553, VON: STAORI, DATUM: 12.10.2020___*

    DATA:  lt_reservations TYPE /sopromet/ty_tree_map_tab.

    FIELD-SYMBOLS: <res> TYPE /sopromet/ty_tree_map.

    IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.
      get_property go_tree_case 'GT_NODE_MAP'  lt_reservations.
    ELSEIF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.
      lt_reservations = gt_reservations.
    ENDIF.

    LOOP AT lt_reservations ASSIGNING <res> WHERE kzsir IS NOT INITIAL
                                              AND kzper IS INITIAL.

*__Check for change mode if items have been modified
      IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.
        CHECK <res>-objkey->single_items_check_if_modified( ) EQ abap_true.
      ENDIF.

      ed_return = <res>-objkey->single_item_consistency_check( ).

      CHECK ed_return = abap_true.
      EXIT.
    ENDLOOP.
  endmethod.


METHOD return_equipments_list.
*____HS# 10412,VON: T.Kern,  DATUM: 12.05.2015 ___*
*____HS# 11654,VON: S.Taori, DATUM: 22.02.2017 ___*
*____HS# 11792,VON: KannanU, DATUM: 21.04.2017 ___*
*____HS# 12197,VON: S.Singh, DATUM: 05.12.2017 ___*
*____HS# 013827, VON: PKUNAL, DATUM: 16.01.2020___*
*____HS# 014096, VON: TKERN, DATUM: 26.05.2020___*
*____HS# 016110, VON: GIVANOV, DATUM: 28.10.2021___*
*___ SR2-335, User: STEKDEMIR, Date: 17.04.2024___*
*___ SR2-1621, User: SBADUSHA, Date: 26.03.2025___*

  DATA: l_o_exit       TYPE REF TO /sopromet/cl_l_screen,
        ld_exit_method TYPE seocpdname.

  DATA: l_o_alv      TYPE REF TO /sopromet/cl_l_alv_return_set,
        lt_list      TYPE /sopromet/ty_return_sets_alv_t,
        lt_field_inv TYPE /sopromet/ty_return_sets_alv_t,   "HS# 014096
        lt_ui5_ret   TYPE /bitmym/ui5_inspection_tt.        "SR2-1621

  DATA: l_titel(132),
        l_text(100),
        l_answer,
        l_vbeln      TYPE vbeln,
        lo_gate      TYPE REF TO /sopromet/cl_l_wegate,     "HS 11792
        l_canc       TYPE abap_bool.                        "HS 11792

  FIELD-SYMBOLS: <list>      TYPE /sopromet/ty_return_sets_alv,
                 <field_inv> TYPE /sopromet/ty_return_sets_alv. "HS# 014096

ENHANCEMENT-POINT return_equipments_list_02 SPOTS /bitmym/cl_case .

  ed_refresh_screen = abap_false.

*___Prüft, ob es einen Methode in einer Subklasse gibt
  l_o_exit ?= go_main_2006->g_screen->exit_class_method_for_fcode( ).

  IF l_o_exit IS INITIAL.
    l_titel = TEXT-rlb.

    go_appl->init_ptp( ).                                   "HS# 10412

    IF go_ui5 IS NOT BOUND.                                 "SR2-1621

*   Start..HS 11792
      IF gs_comwa-r_werk IS INITIAL.
        CALL METHOD /sopromet/cl_l_wegate=>start_gate_70(
          EXPORTING
            io_area  = go_salesarea
          IMPORTING
            eo_gate  = lo_gate
            e_cancel = l_canc ).

        IF l_canc = abap_false.
          gs_comwa-r_werk = lo_gate->g_comwa-werks.
        ENDIF.
      ENDIF.
*   End..HS 11792

      CREATE OBJECT l_o_alv.

      CALL METHOD l_o_alv->set_prop_repid( '/SOPROMET/SAPLZLEI' ).

      CALL METHOD l_o_alv->set_property
        EXPORTING
          i_prop_name  = 'G_SCREEN'
          i_prop_value = go_main_2006->g_screen.

      CALL METHOD l_o_alv->set_property
        EXPORTING
          i_prop_name  = 'G_TITLE'
          i_prop_value = l_titel.

      CALL METHOD l_o_alv->perpare_list( ).
ENHANCEMENT-POINT RETURN_EQUIPMENTS_LIST_04 SPOTS /BITMYM/CL_CASE .
      CALL METHOD l_o_alv->display_list( ).
      lt_list = l_o_alv->get_result( ).
*____SR2-1621____BEGIN INSERT___*
    ELSE.
      DATA(ls_data) = get_data( ).
*      ls_data-go_act_reservation->get_property( EXPORTING i_feld  = 'GT_UI5_RET' IMPORTING e_value = lt_ui5_ret ).
      IF ls_data-go_act_reservation IS BOUND.
        ls_data-go_act_reservation->ui5_ret_prepare_list( IMPORTING et_list = lt_list ).
      ENDIF.
    ENDIF.
*____SR2-1621____END   INSERT___*
*__New EHP                                                  "HS 11654
ENHANCEMENT-POINT return_equipments_list_03 SPOTS /bitmym/cl_case .

    LOOP AT lt_list ASSIGNING <list>
             WHERE NOT select IS INITIAL.
      <list>-r_werk = gs_comwa-r_werk.                      "HS 11792
      CALL FUNCTION '/SOPROMET/SET_RETURN_FLAG' IN UPDATE TASK
        EXPORTING
          i_zzlresn = <list>-lresn
          i_r_werk  = <list>-r_werk                          "HS 11792
        EXCEPTIONS
          OTHERS    = 1.

      COMMIT WORK AND WAIT.

*> Beendendes Ereignis setzen
      wf_objkey   = <list>-lresn.
*      wf_objtype  = 'ZZLRESERV'.  "SR2-335
      wf_objtype = /bitmym/cl_mym=>get_object_attachment( /bitmym/cl_mym=>c_objtype_reservation ). "SR2-335
      wf_event    = 'WeManuell'.
      wf_synchron = space.
      CALL METHOD wf_swe_event_create( ).

      COMMIT WORK.

      IF <list>-hprel IS NOT INITIAL.                       "HS# 10412

        go_appl->check_ptp( io_reservation = <list>-oreserv ). "HS# 10412

      ENDIF.                                                "HS# 10412

      IF <list>-field_inv IS NOT INITIAL.                   "HS# 014096

        APPEND INITIAL LINE TO lt_field_inv ASSIGNING <field_inv>. "HS# 014096

        <field_inv> = <list>.                               "HS# 014096

        DELETE lt_list.                                     "HS# 014096

      ENDIF.                                                "HS# 014096

    ENDLOOP.

    IF sy-subrc EQ 0.
ENHANCEMENT-SECTION return_equipments_list_01 SPOTS /bitmym/cl_case .

      /bitmym/cl_order=>create_return_order(
        EXPORTING
          id_vkorg     = gs_actual_area-vkorg
          id_vtweg     = gs_actual_area-vtweg               "HS# 016110
          id_spart     = gs_actual_area-spart               "HS# 016110
           it_list      = lt_list
           id_no_commit = abap_false
         IMPORTING
           ed_vbeln     = l_vbeln ).

      IF NOT l_vbeln IS INITIAL.

        go_appl->update_ptp_tab( it_list = lt_list i_vbeln = l_vbeln ). "HS# 10412

        ed_refresh_screen = abap_true.

      ENDIF.
      partner_put_data( ).                                  "HS# 12197
END-ENHANCEMENT-SECTION.
    ENDIF.

    IF lt_field_inv IS NOT INITIAL.                         "HS# 014096

      go_appl->return_field_inv( EXPORTING it_list = lt_field_inv ). "HS# 014096

      COMMIT WORK.

    ENDIF.                                                  "HS# 014096


  ELSE.
*___Userexit vorhanden => Diese Implementierung ausführen
    ld_exit_method = go_main_2006->g_screen->g_exit_method.
    CALL METHOD l_o_exit->(ld_exit_method).
  ENDIF.

ENHANCEMENT-POINT return_equipments_list SPOTS /bitmym/case .

ENDMETHOD.


  METHOD revise_sh_frm_partner_tab_val.
*____HS# 11291, VON: S.Taori, DATUM: 31.01.2017 ___*

    DATA: lt_vbpa    TYPE STANDARD TABLE OF vbpa.

    FIELD-SYMBOLS: <vbpa> TYPE vbpa.

    CHECK go_partner IS BOUND.
    get_property go_partner 'GT_VBPA' lt_vbpa.

    READ TABLE lt_vbpa ASSIGNING <vbpa> WITH KEY parvw = /bitmym/cl_partner=>c_parvw_we.
    IF <vbpa> IS ASSIGNED.
      e_kunwe = <vbpa>-kunnr.
    ENDIF.

ENHANCEMENT-POINT REVISE_SH_FRM_PARTNER_TAB_VAL SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  METHOD rfid_we_add_items_consume.
*____HS# 12493, VON: RBOYAPATI,     DATUM: 12.06.2018 ___*

    DATA:
      lt_add_ret TYPE /sopromet/res_items,
      lv_idx     TYPE sy-index,
      lt_uid     TYPE /bitmym/uid_data_tt,
      lv_change  TYPE abap_bool,
      lo_add_res TYPE REF TO /sopromet/cl_l_reservation.

    FIELD-SYMBOLS: <lfs_add_ret> LIKE LINE OF lt_add_ret,
                   <lfs_uid>     TYPE /bitmym/uid_data.

    CHECK /bitmym/if_ui5~gs_ui5_comwa-device IS NOT INITIAL.
    "RFID specific - auto update additional item reservation

    lo_add_res = we_add_reservation_exists( ).
    CHECK lo_add_res IS BOUND.

    lt_uid = /bitmym/cl_rfid_process_mng=>fetch_tag_reads( i_device = /bitmym/if_ui5~gs_ui5_comwa-device ).
    CHECK lt_uid IS NOT INITIAL.

    get_property lo_add_res 'G_RESERVATION_ITEMS_RET' lt_add_ret.
    CHECK lt_add_ret IS NOT INITIAL.

    LOOP AT lt_add_ret ASSIGNING <lfs_add_ret> WHERE  menge_we GT 0.
      LOOP AT lt_uid ASSIGNING <lfs_uid> WHERE  matnr = <lfs_add_ret>-matnr
                                           AND  charg = <lfs_add_ret>-charg
                                           AND  lresn = <lfs_add_ret>-zzlresn.
        lv_idx = sy-tabix.
        <lfs_add_ret>-menge_we = <lfs_add_ret>-menge_we - 1.
        lv_change = abap_true.
        DELETE lt_uid INDEX lv_idx.
        CHECK <lfs_add_ret>-menge_we EQ 0.
        EXIT.
      ENDLOOP.
    ENDLOOP.

    CHECK lv_change EQ abap_true.

    set_property lo_add_res 'G_RESERVATION_ITEMS_RET' lt_add_ret.

    lo_add_res->single_items_post( abap_false ).


  ENDMETHOD.


METHOD set_partner_data_from_ref.
*____HS# 012705, VON: OPECHARROMAN, DATUM: 08.10.2018___*
*____HS# 014696, VON: GIVANOV, DATUM: 30.11.2020___*
*___ SR1-1871, User: SBADUSHA, Date: 24.10.2023___*

  DATA: ls_vbpa	           TYPE vbpav,
        it_vbpa            TYPE  /sopromet/vbpav_tab,
        lt_go_partner_vbpa TYPE /sopromet/vbpav_tab.        "SR1-1871+

  DATA: lv_partner TYPE sd_partner_parnr.                   "HS# 014696

  FIELD-SYMBOLS: <fs_partner> TYPE /bitmym/ic_srep_vbpa_st,
                 <fs_vbpa>    TYPE vbpav.

  CHECK go_partner IS NOT INITIAL.

* Set partner info from is_data partner
  IF is_data-casetopartner IS NOT INITIAL.
    LOOP AT is_data-casetopartner ASSIGNING <fs_partner>.
      APPEND INITIAL LINE TO it_vbpa ASSIGNING <fs_vbpa>.
      MOVE-CORRESPONDING <fs_partner> TO <fs_vbpa>.

    ENDLOOP.
*    set_property go_partner 'GT_VBPA' it_vbpa.  "SR1-1871-
*    set_property go_partner 'GD_CHANGE_FLAG' abap_true .  "SR1-1871-
    partner_selection( id_no_dialog = abap_true id_suppress_mess = abap_true ).

*____HS# 014696 Begin
*___Partners are overwritten by automatic partner determination so change back to
*   ones, coming from the interface

    LOOP AT is_data-casetopartner ASSIGNING <fs_partner>.
      CLEAR ls_vbpa.
      MOVE-CORRESPONDING <fs_partner> TO ls_vbpa.

      IF ls_vbpa-kunnr IS NOT INITIAL.
        lv_partner = ls_vbpa-kunnr.
      ELSEIF ls_vbpa-pernr IS NOT INITIAL.
        lv_partner = ls_vbpa-pernr.
      ELSEIF ls_vbpa-lifnr IS NOT INITIAL.
        lv_partner = ls_vbpa-lifnr.
      ENDIF.

      go_partner->add_partner_generic( i_parvw = <fs_partner>-parvw i_partner_new = lv_partner i_overwrite = abap_true ).

    ENDLOOP.

*&* Begin of SR1-1871+
*    "Remove partner out of case partner
    get_property go_partner 'GT_VBPA' lt_go_partner_vbpa.
    LOOP AT lt_go_partner_vbpa INTO DATA(ls_go_partner_vbpa).
      READ TABLE is_data-casetopartner INTO DATA(ls_casetopartner) WITH KEY parvw = ls_go_partner_vbpa-parvw.
      IF sy-subrc <> 0.
        go_partner->delete_partner_generic( EXPORTING i_parvw = ls_go_partner_vbpa-parvw i_partner = ls_go_partner_vbpa-kunnr ).
      ENDIF.
    ENDLOOP.

    set_property go_partner 'GT_VBPA' it_vbpa.
    set_property go_partner 'GD_CHANGE_FLAG' abap_true .
*&* End of SR1-1871+
*____HS# 014696 End

    new_reservation_fill_partner_d( CHANGING cs_comwa = gs_comwa ).
  ELSE.
    CHECK ui5_prep_booking_partner( ) EQ abap_true.
  ENDIF.

ENDMETHOD.


