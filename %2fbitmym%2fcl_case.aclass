*____HS# 12012,  VON: MKnauer,        DATUM: 13.10.2017 ___*
*____HS# 11968,  VON: S.Taori,        DATUM: 06.11.2017___*
*____HS# 12183,  VON: S.Taori,        DATUM: 22.11.2017___*
*____HS# 12152,  VON: G.Ivanov,       DATUM: 01.02.2018 ___*
*____HS# 12329,  VON: MKnauer,        DATUM: 07.02.2018 ___*
*____HS# 12452,  VON: G.Ivanov,       DATUM: 12.04.2018 ___*
*____HS# 12387,  VON: RBOYAPATI,      DATUM: 03.05.2018 ___*
*____HS# 12717,  VON: STAORI,         DATUM: 09.10.2018___*
*____HS# 12765,  VON: STAORI,         DATUM: 09.08.2019___*
*____HS# 013526, VON: RBoyapati,      DATUM: 07.11.2019___*
*____HS# 014023, VON: DENDRES,        DATUM: 30.04.2020___*
*____HS# 014095, VON: TKERN,          DATUM: 07.05.2020___*
*____HS# 014300, VON: STAORI,         DATUM: 13.07.2020___*
*____HS# 014629, VON: MKNAUER,        DATUM: 30.10.2020___*
*____HS# 014671, VON: SISMAIL,        DATUM: 09.12.2020___*
*____HS# 014376, VON: OPECHARROMAN,   DATUM: 19.01.2021___*
*____HS# 015186, VON: SSINGH,         DATUM: 20.04.2021___*
*____HS# 015932, VON: STAORI,         DATUM: 04.10.2021___*
*____HS# 015929, VON: GIVANOV,        DATUM: 15.10.2021___*
*____HS# 016474, VON: SISMAIL,        DATUM: 01.03.2022___*
*____HS# 016825, VON: BGUNAWAN,       DATUM: 01.06.2022___*
*____HS# 016755, VON: SBADUSHA,       DATUM: 09.06.2022___*
*____HS# 017034, VON: SBADUSHA,       DATUM: 06.07.2022___*
*____HS# 017121, VON: BGUNAWAN,       DATUM: 04.10.2022___*
*____HS# 017087, VON: SSINGH,         DATUM: 12.10.2022___*
*____HS# 015122, VON: BGUNAWAN,       DATUM: 30.01.2023___*
*____HS# 017743, VON: OOGUR,          DATUM: 09.02.2023___*
*___ SR2-54,     User: OOGUR,         Date: 16.02.2024___*
*___ SR2-300,    User: STEKDEMIR,     Date: 27.03.2024___*
*___ SR2-490,    User: XLI,           Date: 19.08.2024___*
*___ SR2-970,    User: SCOSAR,        Date: 16.10.2024___*
*___ SR2-1030,   User: SCOSAR,        Date: 24.10.2024___*
*___ SR2-1254,   User: STEKDEMIR,     Date: 18.12.2024___*
*___ SR2-1593,   User: OOGUR,         Date: 16.06.2025___*
*___ SR2-1716,   User: SSAHU,         Date: 24.07.2025___*
*___ SR2-2337,   User: EDFLORENTINO,  Date: 01.10.2025___*
*___ SR2-2491,   User: XLI,           Date: 28.01.2026___*
*___ SR2-2751, User: PKSHIRSAGAR, Date: 11.02.2026___*


  DATA: lt_tree          TYPE /sopromet/tree_collect_tab,
        lt_map           TYPE /sopromet/ty_tree_map_tab,
        ls_map           TYPE /sopromet/ty_tree_map,
        ls_comwa         TYPE /sopromet/zzls01,
        ls_comwa_route   TYPE /sopromet/zzls01,             "HS# 9788
        ls_comwa_pai     TYPE /sopromet/zzls01,
        ls_comwa_pbo     TYPE /sopromet/zzls01,
        ls_res_pbo       TYPE /sopromet/zzlrv,
        ls_res_pai       TYPE /sopromet/zzlrv,
        ls_equi          TYPE rihequi,
        lo_equi          TYPE REF TO /sopromet/cl_l_equipment,
*        lo_transfer    TYPE REF TO /bitmym/cl_field_transfer, "HS 11684 "HS# 12152 Commented
        lo_tree_case     TYPE REF TO /bitmym/cl_tree_case,  "HS 11968
        ld_no_save       TYPE char1,
        lt_single        TYPE /sopromet/ritems_tab,
        lt_single_yy     TYPE /sopromet/ritems_tab,         "HS 12183
        l_auto_check     TYPE abap_bool,
        ld_transfer      TYPE abap_bool,
        ld_transfer_mode TYPE	/bitmym/fcode,                "HS 12765
        ls_eqbs          TYPE eqbs,                         "HS# 9882
        lt_ftsi          TYPE /bitmym/alv_transfer_sets_t2,
        ls_dates         TYPE /bitmym/case_common_date,     "HS# 11538
        ls_field_inv     TYPE /bitmym/field_inv_fields,     "HS# 014671
        lt_bookings      TYPE /bitmym/b_items_st_tab,       "HS# 10467
        ls_comwa_res     TYPE /sopromet/zzls01,             "HS# 014095
        ls_book          TYPE /bitmym/ref_book,             "HS# 10467
        lt_mym_vbpa	     TYPE	/bitmym/vbpa_tab,             "SR1-635
        l_custcheck      TYPE abap_bool,                    "HS# 10291
        lt_book_res_link TYPE /bitmym/b_rs_lnk_t,           "HS# 17034
        lt_book_serialno TYPE /bitmym/b_serno_tab.          "HS# 017121

  DATA:   lv_v1       TYPE /sopromet/zzlresn.                "SR2-490

*  DATA: ls_source_pai     TYPE /sopromet/zzls01,            "HS# 11684 "HS# 12152 Commented
*        ls_source_pbo     TYPE /sopromet/zzls01,            "HS# 11684 "HS# 12152 Commented
*        ls_res_source     TYPE /sopromet/zzlrv,             "HS# 11684 "HS# 12152 Commented
*        ls_res_source_chg TYPE /sopromet/zzlrv.             "HS# 11684 "HS# 12152 Commented

*> HS#9770, T.Kern - 05.02.2014

  FIELD-SYMBOLS: <tree>   TYPE /sopromet/tree_collect.

  e_success = abap_true.

  IF go_tree_case IS BOUND.  "*___ SR2-54
    go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE' IMPORTING e_value = lt_tree ).
    go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).
  ENDIF.                   "*___ SR2-54

  IF go_transfer IS BOUND.                                  "HS 12765
    get_property go_transfer 'GD_TRANSFER_MODE' ld_transfer_mode. "HS 12765
  ENDIF.                                                    "HS 12765

  IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.
    gs_case-zzlrsam = gs_comwa-zzlrsam.
    IF NOT gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_c.   "HS# 016474+
      gs_case-rscat    = gs_comwa-rscat.                    "HS# 11699
    ENDIF.                                                  "HS# 016474+
    gs_case-bcategory = gs_comwa-bcategory.                 "HS# 14629
    IF gs_case-rscat NE /sopromet/cl_l_reservation=>c_rscat_b AND "HS# 12058
       gs_case-rscat NE /sopromet/cl_l_reservation=>c_rscat_r. "HS# 13526
      SET PARAMETER ID '/SOPROMET/ZLS' FIELD gs_comwa-zzlrsam.
    ENDIF.                                                  "HS# 12058
  ENDIF.

*  get_case_calculated_date( ).                              "HS# 9842 HS# 11538,

  IF gv_save_res_only IS INITIAL.                           "SR2-2751

    CALL FUNCTION '/BITMYM/CASE_UPDATE' IN UPDATE TASK
      EXPORTING
        i_trtyp     = gs_comwa-trtyp_o
        is_case_new = gs_case
        is_case_old = gs_case_yy
        i_sales_rep = /bitmym/if_ui5~gs_callerid-kunnr. "SR2-1030



  ENDIF.                                                    "SR2-2751
  lo_tree_case ?= go_tree_case.                             "HS 11968

  LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.

    CLEAR: ls_comwa.                                        "HS#14095

    ld_transfer = abap_false.

    IF <tree>-trtyp = /bitmym/cl_mym=>c_trtyp_extend.
      ld_transfer = abap_true.    "Transfer aktiv
    ENDIF.

    ls_map = go_tree_case->get_map_of_node( <tree>-node_key ).

    CHECK ls_map-objkey IS NOT INITIAL.

    IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.  "HS# 014671

      go_act_reservation = ls_map-objkey.                   "HS# 014671

      check_field_inventory( ).                             "HS# 014671

      stz_prepare_res_data_h( CHANGING cs_comwa = ls_comwa ). "HS# 015932

    ENDIF." HS# 014671

    ls_map-objkey->get_reservation_data(
      IMPORTING
        e_reservation = ls_res_pai
        e_equipment   = lo_equi ).

    ls_map-objkey->set_property( i_feld = 'GO_APPLICATION' i_value = go_appl ).

    l_auto_check = abap_false.

ENHANCEMENT-POINT case_save_reservations SPOTS /bitmym/case .

    lt_single  = ls_map-objkey->get_prop_single_items( io_case = me i_auto_check = l_auto_check ). "HS#9770
    ls_res_pbo = ls_map-objkey->get_reservation_before( ).

    ls_equi = lo_equi->exp_equi_data( ).

    MOVE-CORRESPONDING ls_equi      TO ls_comwa.
    MOVE-CORRESPONDING gs_case      TO ls_comwa.

    IF gs_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create.
      MOVE-CORRESPONDING ls_res_pai   TO ls_comwa.
    ELSE.
      IF ld_transfer EQ abap_true OR
         gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_r. "HS 13526
        MOVE-CORRESPONDING ls_res_pai TO ls_comwa.
      ENDIF.
      ls_comwa-abgru = ls_res_pai-abgru.
      ls_comwa-asmnt = ls_res_pai-asmnt.                    "HS# 12329
      ls_comwa-class = ls_res_pai-class.                    "HS# 12329
      ls_comwa-klart = ls_res_pai-klart.                    "HS# 12329
      ls_comwa-draft = gs_comwa-draft.                      "HS# 14023
      ls_comwa-hard_allocated = ls_res_pai-hard_allocated.  "HS# 015929
      ls_comwa-xfollowup = ls_res_pai-xfollowup.            "SR2-970

      IF ls_res_pai-lprio IS NOT INITIAL OR                 "HS# 17034
         ls_res_pai-lprio NE '00'.                          "HS# 17034
        ls_comwa-lprio = ls_res_pai-lprio.                  "HS# 17034
      ELSE.                                                 "HS# 17034
        ls_comwa-lprio = gs_comwa-lprio.                    "HS# 17034
      ENDIF.                                                "HS# 17034

    ENDIF.

    IF ld_transfer EQ abap_true.
      CLEAR : ls_comwa-kunnr_sb. "HS# 11345  "Dont Copy SB partner while transfer, Dest Kunnr may/maynot have diff SB Partner- Filled from VBPA
      CLEAR : ls_comwa-ft_deliv.                            "SR2-2491
    ENDIF.
    ls_comwa-bstnk = gs_case-bstnk.                         " HS#10059
    ls_comwa-bsark = gs_case-bsark. "SR2-300
    ls_comwa-vsbeb = gs_case-vsbeb.                         "SR2-1254
    ls_comwa-kzsir = <tree>-kzsir.

    IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create OR
       <tree>-trtyp     EQ /bitmym/cl_mym=>c_trtyp_extend.

      go_act_reservation = ls_map-objkey.                   "HS#14095

*      check_field_inventory( ).                             "HS#14095  "HS 14671

      ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 id_comwa = gs_comwa ).
      lo_tree_case->set_res_in_tree( is_map = ls_map id_lresn = ls_comwa-zzlresn ). "HS 11968

*__Begin of Comment_________________________________________HS# 017743 "dont avaible after commited so commented.Should be fill all the case.
*      IF go_ui5 IS BOUND OR                                 "HS# 12010
*         gs_comwa-rscat EQ /sopromet/cl_l_reservation=>c_rscat_r. "HS# 13526
*        gs_comwa-zzlresn = ls_comwa-zzlresn.                "HS# 12010
*      ENDIF.                                                "HS# 12010
*__End of Comment___________________________________________HS# 017743
      gs_comwa-zzlresn = ls_comwa-zzlresn.                  "HS# 017743

*      IF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 10467  "HS 13526
      ls_comwa-rscat = gs_comwa-rscat.                      "HS# 10467
*      ENDIF.                                                     "HS# 10467  "HS 13526

      IF ls_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_c.  "HS# 016474+
        ls_comwa-kzper     = gs_comwa-kzper.                   "HS# 016474+
      ENDIF.                                                      "HS# 016474+

*      ls_comwa-opkra = gs_comwa-opkra.                      "HS# 10467 "HS# 12452 Commented
      ls_comwa-opkra     = gs_case-opkra.                   "HS# 12452
      ls_comwa-optim     = gs_comwa-optim.                  "HS# 10467
      ls_comwa-inco1     = gs_comwa-inco1.                  "HS# 10467
      ls_comwa-inco2     = gs_comwa-inco2.                  "HS# 10467
      ls_comwa-telf1     = gs_comwa-telf1.                  "HS# 10467
      ls_comwa-telf1     = gs_comwa-telf1.                  "HS# 10467
      ls_comwa-bcategory = gs_comwa-bcategory.              "HS# 14629


      IF lo_equi IS BOUND.                                  "HS#10880

        IF ls_comwa-kzsir IS INITIAL.    "HS# 9882, "HS#10880

          ls_eqbs = lo_equi->get_eqbs( ).                   "HS# 9882

          IF ls_eqbs-b_werk IS NOT INITIAL.                 "HS# 9882
            ls_comwa-werks = ls_eqbs-b_werk.                "HS# 9882
          ELSE.                                             "HS# 9882
            ls_comwa-werks   = ls_equi-swerk.
          ENDIF.                                            "HS# 9882

          ls_comwa-xcons   = fill_xcons_flag( ).

          IF ls_comwa-xcons IS NOT INITIAL AND              "HS# 015122
             ls_comwa-rscat = space.                        "HS# 015122
            determine_cust_territory( CHANGING c_territory = ls_comwa-territory ). "HS# 015122
          ENDIF.                                            "HS# 015122

        ELSE.                                               "HS#10880

          IF ls_equi-swerk IS INITIAL.

            go_act_reservation = ls_map-objkey.             "HS#10880

            single_item_get_plant( ).                       "HS#10880

            go_act_reservation->get_property( EXPORTING i_feld = 'G_RESERVATION-WERKS' IMPORTING e_value = ls_comwa-werks ). "HS#10880

          ELSE.

            ls_comwa-werks   = ls_equi-swerk.               "HS#10880

          ENDIF.

        ENDIF.                                                "HS# 9882, "HS#10880

      ENDIF.                                                "HS#10880

      ls_map-objkey->set_init_dates_from_routes( EXPORTING it_route = gt_comwa_route " HS# 11538
                                                 CHANGING  cs_dates = ls_comwa ).

    ENDIF.

    IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create OR
  <tree>-trtyp     EQ /bitmym/cl_mym=>c_trtyp_extend.       "HS#14095

      ls_map-objkey->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa_res ). "HS#14095

      IF ls_comwa_res IS NOT INITIAL.                       "HS#14095

        MOVE-CORRESPONDING ls_comwa_res TO ls_dates.        "HS#14095
        IF ls_dates IS NOT INITIAL.                         "HS# 014671
          MOVE-CORRESPONDING ls_dates TO ls_comwa.          "HS#14095
        ENDIF.                                              "HS# 014671

        MOVE-CORRESPONDING ls_comwa_res TO ls_field_inv.    "HS# 014671
        IF ls_field_inv IS NOT INITIAL.
          MOVE-CORRESPONDING ls_field_inv TO  ls_comwa.     "HS# 014671
*          ls_comwa-rstyp     = ls_comwa_res-rstyp.          "HS#14095
*          ls_comwa-field_inv = ls_comwa_res-field_inv.      "HS#14095
        ENDIF.
      ENDIF.                                                "HS#14095

    ENDIF.                                                  "HS#14095
*___Partnerdaten
    new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ). "HS# 9788

    MOVE-CORRESPONDING ls_comwa TO ls_comwa_pai.
    ls_comwa_pai-trtyp_o = gs_comwa-trtyp_o.

    IF ls_comwa_pai-r_werk IS INITIAL.                      "HS# 9893
      ls_comwa_pai-r_werk = ls_map-objkey->get_default_plant_we( ). "HS# 9893
    ENDIF.                                                  "HS# 9893

    CALL METHOD /sopromet/ex_handler=>ex_save_document_prepare
      EXPORTING
        io_partner  = go_partner
      IMPORTING
        e_dont_save = ld_no_save
      CHANGING
        c_ls01      = ls_comwa.

ENHANCEMENT-POINT case_save_prepare SPOTS /bitmym/case.

    IF ld_no_save IS NOT INITIAL.
      e_success = abap_false.
      ROLLBACK WORK.
      EXIT.
    ELSE.
      MOVE-CORRESPONDING ls_res_pbo TO ls_comwa_pbo.

      IF <tree>-trtyp EQ /bitmym/cl_mym=>c_trtyp_extend.
*__Field Transfer aktiv
        IF ls_res_pai-srcrs IS NOT INITIAL
           AND ld_transfer_mode NE /bitmym/cl_panel=>c_transfer_set_multiple. "HS 12765
*___Message Handler
          CALL METHOD /sopromet/cl_l_message_collect=>add_bapi_error
            EXPORTING
              i_msgnr = '104'
              i_msgty = 'I'
              i_msgv1 = ls_comwa_pai-zzlresn.

          SET PARAMETER ID '/SOPROMET/ZRE' FIELD ls_comwa_pai-zzlresn.
        ENDIF.

        ls_comwa_pai-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
      ENDIF.

      ls_comwa_pai-kzmonitor = fill_kzmonitor( ).

*      READ TABLE gt_comwa_route INTO ls_comwa               "HS# 9788 HS# 11538
*                      WITH KEY equnr = ls_comwa_pai-equnr.  "HS# 9788 HS# 11538
*      IF sy-subrc EQ 0.                                     "HS# 9788 HS# 11538
*        MOVE: ls_comwa-vdate TO ls_comwa_pai-vdate,         "HS# 9788 HS# 11538
*              ls_comwa-rdate TO ls_comwa_pai-rdate,         "HS# 9788 HS# 11538
*              ls_comwa-abdat TO ls_comwa_pai-abdat,         "HS# 9788 HS# 11538
*              ls_comwa-frdat TO ls_comwa_pai-frdat.         "HS# 9788 HS# 11538
*      ENDIF.                                                "HS# 9788 HS# 11538
      "HS# 10291 New Enhancement Point
ENHANCEMENT-POINT case_save_prepare1 SPOTS /bitmym/case .

      get_boxes_information( CHANGING cs_comwa = ls_comwa_pai ). "SR2-1593

      IF ls_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 10467
        lt_bookings = ls_map-objkey->get_prop_booking_items(  ). "HS# 10467

        lt_book_serialno = ls_map-objkey->get_booking_serial_no( ). "HS# 017121

        IF ls_comwa-werks IS INITIAL.                       "HS# 016287

          ls_comwa-werks = ls_map-objkey->booking_plant_determination( ). "HS# 016287

        ENDIF.                                              "HS# 016287
        SET PARAMETER ID '/BITMYM/BOOKING' FIELD ls_comwa-zzlresn. "HS# 12058
*       No reservation tab for booking. The dates for the reservation
*       are taken from the case.
        ls_comwa_pai-vdate = gs_case-vdate.                 "HS# 10467
        ls_comwa_pai-abdat = gs_case-abdat.                 "HS# 10467
        ls_comwa_pai-rdate = gs_case-rdate.                 "HS# 10467
        ls_comwa_pai-frdat = gs_case-frdat.                 "HS# 10467
        ls_comwa_pai-odate = gs_case-odate.                 "HS# 10467
        ls_comwa_pai-vsbeb = gs_case-vsbeb.                 "HS# 10467
        ls_comwa_pai-vdate = gs_case-vdate.                 "HS# 10467
        ls_comwa_pai-prsdt = gs_case-prsdt.                 "HS# 016825
        ls_comwa_pai-opman = gs_case-opman.                 "HS# 16755
        ls_comwa_pai-opkra = gs_case-opkra.                 "HS# 17087
*        MESSAGE s343(/sopromet/zl) WITH ls_comwa-zzlresn    "HS# 10467 "HS# 11378               "HS 12387
*         INTO gd_dummy_message.                             "HS# 11637                          "HS 12387
*        call_message.                                       "HS# 11637                          "HS 12387
        ui5_update_ref_booking_follow( CHANGING cs_comwa = ls_comwa_pai ). "HS 15186
*        /bitmym/cl_message=>message( id = 'S343(/SOPROMET/ZL)' v1 = ls_comwa-zzlresn ). "HS 12387  "SR2-490
        CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'                            "SR2-490
          EXPORTING                                                             "SR2-490
            input  = ls_comwa-zzlresn                                           "SR2-490
          IMPORTING                                                             "SR2-490
            output = lv_v1.                                                     "SR2-490

        /bitmym/cl_message=>message( id = 'S343(/SOPROMET/ZL)' v1 = lv_v1 ).   "SR2-490

*   Buchung & gespeichert.

      ELSE.
*        IF ld_transfer EQ abap_true.                        "HS# 11793 "HS 12007
*          ls_comwa_pai-ref_book = space.                    "HS# 11793 "HS 12007
*        ENDIF.                                              "HS# 11793 "HS 12007
        go_appl->get_property( EXPORTING i_feld = 'GD_REF_BOOKING' IMPORTING e_value = ls_book ). "HS# 10467
        IF ls_book IS NOT INITIAL.                          "HS# 10467
          ls_comwa_pai-ref_book = ls_book.                  "HS# 10467
        ENDIF.                                              "HS# 10467
      ENDIF.                                                "HS# 10467

      get_property ls_map-objkey 'GT_SINGLE_ITEMS_YY' lt_single_yy. "HS 12183

*__Begin of Insert__________________________________________HS 14300
*      CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*        EXPORTING
*          i_zzls01             = ls_comwa_pai
*          a_zzls01             = ls_comwa_pbo
*          i_post_single_items  = 'X'
*          i_delete_itm_booking = abap_true                   "HS# 14376
*        TABLES
*          xsingleitems         = lt_single
*          xsingleitems_yy      = lt_single_yy                 "HS 12183
*          xbookings            = lt_bookings                  "HS# 10467
*        EXCEPTIONS
*          OTHERS               = 1.
                                                            "HS# 14671

*__End of Insert____________________________________________HS 14300
*__Begin of Insert SR1-635
      IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create AND go_partner IS BOUND.
        go_partner->fill_mym_partner_table( is_comwa = ls_comwa_pai ).
        get_property go_partner 'GT_MYM_VBPA' lt_mym_vbpa.
      ENDIF.
*__End of Insert SR1-635

*&* Begin of HS# 17034
      IF ls_comwa_pai-ref_book IS NOT INITIAL.
        populate_book_res_link_tab( EXPORTING is_comwa_pai = ls_comwa_pai IMPORTING lt_res_link = lt_book_res_link CHANGING c_lprio = ls_comwa_pai-lprio ).
      ENDIF.

*&* End of HS# 17034

*__Begin of Comment_________________________________________HS 14300
      CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
        EXPORTING
          i_zzls01             = ls_comwa_pai
          a_zzls01             = ls_comwa_pbo
          i_post_single_items  = 'X'
          i_delete_itm_booking = abap_true                   "HS# 14376
          i_sales_rep          = /bitmym/if_ui5~gs_callerid-kunnr "SR2-1030
        TABLES
          xsingleitems         = lt_single
          xsingleitems_yy      = lt_single_yy                 "HS 12183
          xbookings            = lt_bookings                  "HS# 10467
          xvbpa                = lt_mym_vbpa                  "SR1-635
          xbook_serialno       = lt_book_serialno             "HS# 017121
        EXCEPTIONS
          OTHERS               = 1.
*__End of Comment___________________________________________HS 14300

*&* Begin of HS# 016474+
      IF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_c.
        ls_map-objkey->set_property( EXPORTING i_feld = 'G_CCOUNT' i_value = abap_true ).
        ls_map-objkey->set_property( EXPORTING i_feld = 'G_RESERVATION-SRCRS' i_value = gs_comwa-srcrs ).
        ls_map-objkey->set_property( EXPORTING i_feld = 'G_RESERVATION-ZZLRESN' i_value = ls_comwa_pai-zzlresn ).
        ls_map-objkey->set_property( EXPORTING i_feld = 'G_EQUIPMENT' i_value = lo_equi ).
        ls_map-objkey->update_cc_reservation( gs_comwa-srcrs ).
      ENDIF.
*&* End of HS# 016474+

      IF ls_comwa_pai-field_inv IS NOT INITIAL AND ls_comwa_pai-srcrs IS NOT INITIAL. "HS# 14671

        ls_map-objkey->set_property( EXPORTING i_feld = 'G_RESERVATION-SRCRS' i_value = ls_comwa_pai-srcrs ). "HS# 14671
        ls_map-objkey->set_property( EXPORTING i_feld = 'G_RESERVATION-ZZLRESN' i_value = ls_comwa_pai-zzlresn ). "HS# 14671

        ls_map-objkey->update_fi_reservation( ).            "HS# 14671

      ENDIF.

*__Begin____________________________________________________HS 15932
      IF ls_comwa_pai-stz_source IS NOT INITIAL AND gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create.
        /bitmym/cl_sterilizaion=>stz_update_source_res( EXPORTING id_stz_source = ls_comwa_pai-stz_source
                                                                  id_stz_res    = ls_comwa_pai-zzlresn ).
      ENDIF.
*__End______________________________________________________HS 15932
*____SR2-1716____BEGIN INSERT___*
      IF ls_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b.
        /bitmym/cl_appllog=>store_message( id = 'S343(/SOPROMET/ZL)' v1 = ls_comwa_pai-zzlresn ).
        /bitmym/cl_appllog=>store_message( id = 'S490(/SOPROMET/ZL)' v1 = ls_comwa_pai-zzlrsam ).
      ELSE.
        /bitmym/cl_appllog=>store_message( id = 'S970(/SOPROMET/ZL)' v1 = ls_comwa_pai-zzlresn v2 = ls_comwa_pai-matnr v3 = |{ ls_comwa_pai-equnr ALPHA = OUT }| v4 = ls_comwa_pai-eqart ).
        /bitmym/cl_appllog=>store_message( id = 'S118(/SOPROMET/ZL)' v1 = ls_comwa_pai-zzlrsam ).
      ENDIF.

*____SR2-1716____END   INSERT___*

*___HS# 12152 Begin comment
**->>>>>>>>>>>>  HS 11684
*      IF ld_transfer EQ abap_true.
**___Update source reservation for field transfer
*        get_property me 'GO_TRANSFER' lo_transfer.
*        IF lo_transfer IS BOUND.
*          get_property lo_transfer 'GS_ZZLRV_CHANGES' ls_res_source_chg.
*          get_property lo_transfer 'GS_ZZLRV'         ls_res_source.
*          IF ls_res_source NE ls_res_source_chg.
*            MOVE-CORRESPONDING ls_res_source_chg TO ls_source_pai.
*            MOVE-CORRESPONDING ls_res_source     TO ls_source_pbo.
*            ls_source_pai-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.
*
*            CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
*              EXPORTING
*                i_zzls01 = ls_source_pai
*                a_zzls01 = ls_source_pbo
*              EXCEPTIONS
*                OTHERS   = 1.
*          ENDIF.
*        ENDIF.
*      ENDIF.
**-<<<<<<<<<<<<< End of HS 11684
*___HS# 12152 End comment

      IF  <tree>-trtyp EQ /bitmym/cl_mym=>c_trtyp_extend
      AND ls_comwa_pai-srcrs   IS NOT INITIAL               "SR2-2337
      AND ls_comwa_pai-zzlresn IS NOT INITIAL.              "SR2-2337
*___ZZLRP + Monitor umkopieren
        lt_ftsi = ft_get_single_items( ls_comwa_pai-srcrs ).

        CALL FUNCTION '/BITMYM/FT_COPY_ZZLRP' IN UPDATE TASK
          EXPORTING
            i_reservation_from = ls_comwa_pai-srcrs
            i_reservation_to   = ls_comwa_pai-zzlresn
            it_single_items    = lt_ftsi.
      ENDIF.

*___Transfer starten wenn aktiv
      transfer_post( id_transfer     = ld_transfer
                     is_comwa        = ls_comwa_pai
                     it_single_items = lt_ftsi ).
    ENDIF.
  ENDLOOP.

*__Updating reservations with new equi if reallocation at intersection is activated
  reallocation_reservations_updt( ).                        "HS 12717

ENDMETHOD.


METHOD change_sold_to.
*____HS# 10081, VON: MKnauer, DATUM: 25.08.2014 ___*
*____HS# 012314, VON: OPECHARROMAN, DATUM: 10.09.2018___*
*____HS# 016046, VON: OPECHARROMAN, DATUM: 07.10.2021___*
*___ SR1-432, User: VGOYAL, Date: 02.08.2023___*

  DATA: lt_map   TYPE /sopromet/ty_tree_map_tab,
        ls_comwa TYPE /sopromet/zzls01,
        ls_res   TYPE /sopromet/zzlrv.

  FIELD-SYMBOLS: <map> TYPE /sopromet/ty_tree_map.

* Die Reservierungen müssen hier aktualisiert werden, da sonst im PBO
* des Dynpro 8000 die Daten wieder aus der Reservierung überschrieben werden.

  CHECK go_tree_case IS BOUND.  "Kann eigentlich nicht sein

  go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).

  LOOP AT lt_map ASSIGNING <map> WHERE objkey IS BOUND.
    <map>-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
    MOVE-CORRESPONDING ls_res TO ls_comwa.
    new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ).
    <map>-objkey->set_property( i_feld = 'KUNNR'    i_value = ls_comwa-kunnr ).
    <map>-objkey->set_property( i_feld = 'KUNWE'    i_value = ls_comwa-kunwe ).
    <map>-objkey->set_property( i_feld = 'KUNNR_SB' i_value = ls_comwa-kunnr_sb ).

ENHANCEMENT-POINT change_sold_to SPOTS /bitmym/case .

  ENDLOOP.

*Init HS# 012314
*  if go_texte is BOUND. "HS# 016046 Commented
  IF id_no_text_update IS INITIAL AND go_texte IS BOUND.   "HS# 016046
    go_texte->call_text_copy_routine( ).
  ENDIF.
*End HS# 012314

ENDMETHOD.


  METHOD we_check_on_save.
*____HS# 014293, VON: GIVANOV, DATUM: 10.07.2020___Created*
*____HS# 015345, VON: OPECHARROMAN, DATUM: 07.05.2021___*
*____HS# 016187, VON: OPECHARROMAN, DATUM: 14.01.2022___*
*____HS# 017767, VON: OPECHARROMAN, DATUM: 18.01.2023___*

    FIELD-SYMBOLS: <tree> TYPE LINE OF /sopromet/ty_tree_map_tab.

    ev_success = abap_true.

    IF /sopromet/cl_l_message_collect=>check_initialization( ) EQ abap_false.
      /sopromet/cl_l_message_collect=>init( ).
      DATA(ld_init) = abap_true.                            "HS# 017767
    ENDIF.

    LOOP AT it_tree ASSIGNING <tree>
       WHERE objkey IS BOUND
         AND abgru EQ space
         AND ( kzper NE /sopromet/cl_l_reservation=>c_pend_type_additional AND  "HS# 015345,
              kzper NE /sopromet/cl_l_reservation=>c_pend_type_cons_additional ). "HS# 016187

      CHECK <tree>-objkey->we_check_on_save( ) EQ abap_false .
      ev_success = abap_false.
    ENDLOOP.

    IF ev_success EQ abap_false.
      /sopromet/cl_l_message_collect=>display( ).
    ENDIF.

* HS# 017767 -->
    IF ld_init EQ abap_true.
      /sopromet/cl_l_message_collect=>suspend( ).
    ENDIF.
* HS# 017767 <--
  ENDMETHOD.


METHOD check_before_release.
* We create the method to check before releasing that there are no reservations to be reallocated
* The method is only trigger in case the enhancement functionality to reallocate is switched on
*____HS# 11498, VON: OPecharroman,  DATUM: 20.01.2017____*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 11694, VON: Kannan U,      DATUM: 07.03.2017____*
*____HS# 12370, VON: Kannan U,      DATUM: 13.03.2018____*

  DATA: lo_type        TYPE REF TO /sopromet/cl_l_res_type,
        ls_res_typ_vko TYPE /sopromet/rstypo,
        lo_ref         TYPE REF TO /bitmym/cl_refstl,
        ls_refcust     TYPE /bitmym/refcust,
        ls_area        TYPE /sopromet/zzl01,
        lt_tree        TYPE /sopromet/tree_collect_tab,
        ls_map         TYPE /sopromet/ty_tree_map,          "HS# 11694 HS# 12370
        ls_reserv      TYPE /sopromet/zzlrv.                "HS# 11694 HS# 12370

  FIELD-SYMBOLS: <tree> TYPE /sopromet/tree_collect.

  e_return = abap_true.

  IF NOT gs_comwa-rstyp IS INITIAL.
*____Reservierungstyp ist vorhanden: VKORG Eigenschaften lesen
    CREATE OBJECT lo_type
      EXPORTING
        i_rstyp = gs_comwa-rstyp.

    ls_res_typ_vko = lo_type->get_prop_res_type_vkorg( gs_comwa ).

  ENDIF.

  CHECK ls_res_typ_vko-enh_rejec = /bitmym/cl_bar_chart=>c_reallocate.

  CHECK go_appl IS NOT INITIAL.

  CREATE OBJECT lo_ref
    EXPORTING
      io_main = go_appl.

  MOVE-CORRESPONDING gs_comwa TO ls_area.
  lo_ref->set_property( EXPORTING i_feld = 'GS_AREA'  i_value = ls_area ).
  lo_ref->get_refcust( ).
  lo_ref->get_property( EXPORTING i_feld = 'GS_REFCUST' IMPORTING e_value = ls_refcust ).

  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE' IMPORTING e_value = lt_tree ).

  LOOP AT lt_tree ASSIGNING <tree> WHERE isfolder IS INITIAL.
    CLEAR: ls_map, ls_reserv.                               "HS# 11694 HS# 12370
    ls_map = go_tree_case->get_map_of_node( <tree>-node_key ). "HS# 11694 HS# 12370
    ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_reserv ). "HS# 11694 HS# 12370

    CHECK ls_reserv-abgru IS INITIAL.                       "HS# 11694 HS# 12370

    CHECK <tree>-eqart EQ ls_refcust-eqart.
    CLEAR e_return.
    MESSAGE i613(/sopromet/zl) WITH <tree>-lresn  INTO gd_dummy_message. "HS# 11637
    call_message.                                           "HS# 11637
    EXIT.
  ENDLOOP.
ENDMETHOD.


  METHOD checks_related_req_del_date.
*____HS# 014456, VON: STAORI, DATUM: 14.09.2020___*
*___ SR2-990, User: STEKDEMIR, Date: 24.10.2024___*

    DATA: ls_rstyp TYPE /sopromet/rstypo.

*____SR2-990____BEGIN INSERT___*
    ed_return = abap_true.

    IF go_rstyp IS NOT BOUND.
      go_rstyp = /sopromet/cl_l_res_type=>create( i_rstyp = gs_comwa-rstyp i_vkorg = gs_comwa-vkorg ).
    ENDIF.

    CHECK go_rstyp IS BOUND.

    ed_return = go_rstyp->get_prop_rstypo( i_rstyp = gs_comwa-rstyp i_vkorg = gs_comwa-vkorg )-kzedt.
*____SR2-990____END   INSERT___*

*____SR2-990____BEGIN COMMENT___*
*    ed_return = abap_true.
*
*    CHECK go_rstyp IS BOUND.
*
*    get_property go_rstyp 'GS_RSTYPO' ls_rstyp.
*
*    IF ls_rstyp-kzedt IS INITIAL.
*      ed_return = abap_false.
*    ENDIF.
*____SR2-990____END   COMMENT___*

  ENDMETHOD.


  METHOD exe_reject_reservation.
*____HS# 014533, VON: PKUNAL, DATUM: 30.09.2020___*

    DATA: lo_reject_alv TYPE REF TO /bitmym/cl_reject_reserv_alv.

ENHANCEMENT-POINT reject_reservation_v2_02 SPOTS /bitmym/cl_case .

    CREATE OBJECT lo_reject_alv.

    lo_reject_alv->set_property_alv( EXPORTING i_feld = 'GO_CASE' i_value = me ).

ENHANCEMENT-POINT reject_reservation_v2_03 SPOTS /bitmym/cl_case .
    lo_reject_alv->reject_reservation( ).

*___If last reservation(s) is/are being cancelled and all other reservations of the case
*   are complete, then we set the flag 'UNUSED' in case table
    check_if_case_is_unused( ).

ENHANCEMENT-POINT reject_reservation_v2_04 SPOTS /bitmym/cl_case .

  ENDMETHOD.


  METHOD check_case_status_transfer.
*____HS# 12029, VON: T.Kern, DATUM: 06.09.2017 ___*

    FIELD-SYMBOLS: <res> TYPE /sopromet/ty_tree_map.

    CLEAR: e_reservation.

    CHECK go_transfer IS BOUND.

    LOOP AT gt_reservations ASSIGNING <res> WHERE kzsir IS INITIAL AND abgru IS INITIAL.

      set_property go_transfer 'GO_RESERVATION'  <res>-objkey.

      CHECK go_transfer->reservation_check( ) EQ abap_true.

      e_reservation = <res>.

      EXIT.

    ENDLOOP.

  ENDMETHOD.


  METHOD copy_dates_from_case_customize.
*____HS# 12704, VON: STAORI, DATUM: 17.10.2018___*

    DATA: lt_csdatcop  TYPE STANDARD TABLE OF /bitmym/csdcopy2,
          ld_status    TYPE tj30t-txt04,
          ld_case_date TYPE char40.
*
    FIELD-SYMBOLS: <csdcopy2> TYPE /bitmym/csdcopy2,
                   <dynamic>  TYPE any.

    ld_status = io_res->get_user_status( ).

    lt_csdatcop = read_copy_case_date_customizin( id_status = ld_status ).

    LOOP AT lt_csdatcop ASSIGNING <csdcopy2>.
      CONCATENATE 'GS_CASE-' <csdcopy2>-case_date_field INTO ld_case_date.
      ASSIGN (ld_case_date) TO <dynamic>.
      IF sy-subrc EQ 0.
        io_res->set_property( i_feld = <csdcopy2>-case_date_field i_value = <dynamic> ).
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


METHOD check_duplicate_po.
*____HS# 11292, VON: KSIVARAMAN, DATUM: 02.08.2016____*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 13493, VON: R.Boyapat, DATUM:  25.09.2019 ___*
*____HS# 016751, VON: SISMAIL, DATUM: 21.10.2022___*

  DATA: ls_case     TYPE /bitmym/case_par.

ENHANCEMENT-POINT check_duplicate_po_01 SPOTS /bitmym/case .

*  CHECK gs_comwa-rscat NE /sopromet/cl_l_reservation=>c_rscat_r.  "HS 13526 HS# 016751-

  CHECK gs_comwa-rscat NE /sopromet/cl_l_reservation=>c_rscat_r and gs_comwa-rscat NE /sopromet/cl_l_reservation=>c_rscat_c.  "HS# 016751+

  CHECK gs_case-bstnk IS NOT INITIAL.

  CHECK gs_comwa-kunnr IS NOT INITIAL.

  CHECK gs_comwa-ref_book IS INITIAL. "HS# 11292 " Dont Validate if Res Created with Ref to Booking

*-->>Start of HS 13493
*  SELECT SINGLE * INTO CORRESPONDING FIELDS OF ls_case
*        FROM /bitmym/case_par
*         WHERE  vkorg   EQ gs_case-vkorg
*         AND    bstnk   EQ gs_case-bstnk
*         AND    kunnr   EQ gs_comwa-kunnr
*         AND    zzlrsam NE gs_case-zzlrsam.

  SELECT * INTO CORRESPONDING FIELDS OF ls_case
        UP TO 1 ROWS
        FROM /bitmym/case_par
         WHERE  vkorg   EQ gs_comwa-vkorg
         AND    zzlrsam NE gs_comwa-zzlrsam
         AND    bstnk   EQ gs_case-bstnk
         AND    kunnr   EQ gs_comwa-kunnr.
  ENDSELECT.
*--<<End of HS 13493

  CHECK sy-subrc EQ 0.

ENHANCEMENT-POINT check_duplicate_po_02 SPOTS /bitmym/case .

  MESSAGE i242(/sopromet/zl) WITH gs_case-bstnk gs_comwa-kunnr ls_case-zzlrsam
   INTO gd_dummy_message.                                   "HS# 11637
  call_message.                                             "HS# 11637
ENDMETHOD.


  METHOD case_save_no_display.
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*
*___ SR2-721, User: SCOSAR, Date: 31.10.2024___*

    start_tree_case( i_tree_dynnr = space i_tree_repid = space id_dark = abap_true ).

    CHECK case_save_final_check( ) EQ abap_true.

    messaging( ).

    case_save_all( ).

    e_lrsam = gs_case-zzlrsam.

    read_reservations( ). "SR2-721
  ENDMETHOD.


  METHOD check_if_case_is_unused.
*____HS# 12481, VON: S.Taori, DATUM: 26.04.2018 ___*

    DATA: ls_reservation TYPE /sopromet/zzlrv,
          ls_case_yy     TYPE /bitmym/case,
          ld_case_unused TYPE abap_bool.
    FIELD-SYMBOLS: <reservation> TYPE /sopromet/ty_tree_map.

    ld_case_unused = abap_true.
    LOOP AT gt_reservations ASSIGNING <reservation>.

*__If this method is called from 'Set transfer', structure IS_TRANSFERRED_RES is filled and data should be read from there
      IF is_transferred_res IS SUPPLIED AND <reservation>-lresrv EQ is_transferred_res-zzlresn.
        IF is_transferred_res-kompl IS INITIAL.
          ld_case_unused = abap_false.
          EXIT.
        ELSE.
          CONTINUE. "If transferred reservation is complete, keep on checking for other reservations in the combined run
        ENDIF.
      ENDIF.

      CHECK <reservation>-objkey IS BOUND.
*      CHECK <reservation>-objkey->get_user_status( ) NE /sopromet/cl_l_reservation=>c_res_status_cancelled.
      get_property <reservation>-objkey 'G_RESERVATION' ls_reservation.
      CHECK ls_reservation-kompl IS INITIAL AND ls_reservation-abgru IS INITIAL.
      ld_case_unused = abap_false.
      EXIT.
    ENDLOOP.

*__If all reservations of case are found complete then set the flag 'UNUSED' in case table
    CHECK ld_case_unused IS NOT INITIAL.
    ls_case_yy = gs_case.
    gs_case-unused = abap_true.

    IF gs_comwa-trtyp_o IS INITIAL.
      gs_comwa-trtyp_o = 'V'.
    ENDIF.

    CALL FUNCTION '/BITMYM/CASE_UPDATE' IN UPDATE TASK
      EXPORTING
        i_trtyp     = gs_comwa-trtyp_o
        is_case_new = gs_case
        is_case_old = ls_case_yy.

ENHANCEMENT-POINT check_if_case_is_unused_01 SPOTS /bitmym/cl_case .

    CHECK id_no_commit IS INITIAL.
    COMMIT WORK AND WAIT.
  ENDMETHOD.


METHOD check_open_orders.
*____HS# 10030, VON: S.Taori, DATUM: 18.07.2014 ___*
*____HS# 10058, VON: S.Taori, DATUM: 07.08.2014 ___*
*____HS# 11833, VON: G.Ivanov, DATUM: 08.05.2017 ___*
*____HS# 013508, VON: OPECHARROMAN, DATUM: 02.10.2019___*

  DATA: lo_appl         TYPE REF TO /bitmym/cl_mym,
        lo_equipment    TYPE REF TO /sopromet/cl_l_equipment,
        lt_zzlrsen      TYPE /sopromet/res_tab,
        lt_reservations TYPE /sopromet/ty_tree_map_tab,
        lt_open_orders  TYPE /bitmym/oorder_t.

  FIELD-SYMBOLS: <fs_zzlrsen>      TYPE /sopromet/zzlrv,
                 <fs_reservations> TYPE /sopromet/ty_tree_map.

  e_bapi_error = abap_false.

  me->get_property( EXPORTING i_feld = 'GO_APPL' IMPORTING e_value = lo_appl ).
  lo_appl->get_property( EXPORTING i_feld = 'GT_ZZLRSEN' IMPORTING e_value = lt_zzlrsen ).

*_____HS# 11833 Begin

**__Read the customizing (for which all activites, the open orders should be checked)
*  get_open_orders_cust( EXPORTING i_vgart_ex = i_vgart_ex ). "HS 10058

*_____HS# 11833 End

  LOOP AT gt_reservations ASSIGNING <fs_reservations> WHERE kzsir IS INITIAL.

    READ TABLE lt_zzlrsen ASSIGNING <fs_zzlrsen> WITH KEY zzlresn  = <fs_reservations>-lresrv.

    IF <fs_zzlrsen> IS ASSIGNED AND sy-subrc = 0.
      <fs_reservations>-objkey->get_property( EXPORTING i_feld = 'G_EQUIPMENT' IMPORTING e_value = lo_equipment ).

*_____HS# 11833 Begin

*      CALL METHOD lo_equipment->check_open_orders           "HS 10058
*        EXPORTING
*          it_vgart      = gt_vgart_chk
*        IMPORTING
*          e_open_orders = lt_open_orders.                   "HS 10058

*  check without error handling
      lt_open_orders = lo_equipment->check_open_orders_70( iv_vgart = i_vgart_ex
                                                           iv_funct = /bitmym/cl_dyn_err_hndl=>gc_function_o01  " 1:n check
                                                           iv_zzlresn = <fs_zzlrsen>-zzlresn "HS 13508
                                                           iv_with_error_handling = abap_false ).


*_____HS# 11833 End

      IF lt_open_orders IS NOT INITIAL.
        e_bapi_error = abap_true.
        EXIT.
      ENDIF.
      FREE <fs_zzlrsen>.
    ENDIF.
  ENDLOOP.
ENDMETHOD.


METHOD check_reference_booking.
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 16.09.2015____*
*____HS# 11637, VON: O.Pecharroman, DATUM:  17.02.2017 ___*
*____HS# 012533, VON: OPECHARROMAN, DATUM: 13.06.2018___*
*____HS# 014145, VON: RBoyapati,   DATUM: 08.06.2020___*
*___ SR1-545, User: BGUNAWAN, Date: 29.05.2023___*


  DATA: lds_res    TYPE /sopromet/zzlrv,
        lo_res_typ TYPE REF TO /sopromet/cl_l_res_type,
        lds_case   TYPE /bitmym/case,
        lds_ref    TYPE /bitmym/ref_book,
        l_check    TYPE abap_bool.
  DATA: lt_areas   TYPE TABLE OF /sopromet/zzl01.  "SR1-545

  e_check = abap_false.

  go_appl->get_property( EXPORTING i_feld = 'GD_REF_BOOKING' IMPORTING e_value = lds_ref ).

  CHECK lds_ref IS NOT INITIAL.
  gs_comwa-ref_book = lds_ref.

  CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
    EXPORTING
      i_reserv      = gs_comwa-ref_book
*     I_NO_BUFF     =
    IMPORTING
      e_reservation = lds_res.

  CHECK sy-subrc = 0.

**-->> Begin of HS 14145
  IF gs_comwa-rstyp IS INITIAL.
* Begin of SR1-545
    IF NOT lds_res-vkorg IS INITIAL.
      gs_comwa-rstyp = /sopromet/cl_l_res_type=>get_book_to_case_rstyp( i_rstyp_b = lds_res-rstyp
                                                                        i_vkorg   = lds_res-vkorg ).
      get_property go_salesarea 'GT_AREAS' lt_areas.
      IF NOT lt_areas IS INITIAL.
*       Check the areas IF the user is currently in an umbrella area
        READ TABLE lt_areas WITH KEY vkorg = gs_comwa-vkorg vtweg = gs_comwa-vtweg spart = gs_comwa-spart umbrella_vkorg = abap_true TRANSPORTING NO FIELDS.
        IF sy-subrc = 0.
          gs_comwa-spart = lds_res-spart.
          gs_comwa-vtweg = lds_res-vtweg.
          gs_comwa-vkorg = lds_res-vkorg.
        ENDIF.
      ENDIF.
    ELSE.
* End of SR1-545
      gs_comwa-rstyp = /sopromet/cl_l_res_type=>get_book_to_case_rstyp( i_rstyp_b = lds_res-rstyp
                                                                        i_vkorg   = gs_comwa-vkorg ).
    ENDIF.                                                                                            "SR1-545
  ENDIF.
**--<< End of HS 14145

  CREATE OBJECT lo_res_typ
    EXPORTING
      i_rstyp = gs_comwa-rstyp.

  CALL METHOD lo_res_typ->check_copy_control
    EXPORTING
      i_rstyp_b = lds_res-rstyp
      i_rstyp_r = gs_comwa-rstyp
      i_vkorg   = gs_comwa-vkorg
    IMPORTING
      e_check   = l_check.

  IF l_check NE abap_true.
    MESSAGE i342(/sopromet/zl) WITH lds_res-rstyp gs_comwa-rstyp INTO gd_dummy_message. "HS# 11637
    call_message.                                           "HS# 11637
    CLEAR gs_comwa-ref_book.                                "HS# 012533

    go_appl->set_property( EXPORTING i_feld = 'GD_REF_BOOKING' i_value = gs_comwa-ref_book ). "HS# 012533
*   Kopiersteuerung Booking & auf Reservierung & nicht vorhanden.
    EXIT.
  ENDIF.

  go_appl->set_property( i_feld = 'GS_COMWA'  i_value = gs_comwa ).

ENHANCEMENT-POINT check_reference_booking SPOTS /bitmym/case .

  e_check = abap_true.

ENDMETHOD.


METHOD CHECK_REFERENCE_DOC.
*____HS# 10467, VON: O.PECHARROMAN  DATUM: 16.09.2015____*

  e_check = check_reference_order( ).

  check e_check = abap_false.

  e_check = check_reference_booking( ).

ENDMETHOD.


METHOD check_reference_order.
*> HS#9774: T.Kern - 09.02.14
*____HS# 12303, VON: Opecharroman,  DATUM: 01.02.2018____*
*____HS# 12480, VON: Opecharroman,  DATUM: 25.04.2018____*

  DATA: ls_comwa TYPE /sopromet/zzls01. " HS# 12303

  get_property go_appl 'GS_COMWA' ls_comwa.                 "HS# 12303
  gs_comwa-vbelv = ls_comwa-vbelv.                          "HS# 12303

  e_check = abap_false.

  CHECK gs_comwa-vbelv IS NOT INITIAL.


  CALL FUNCTION 'SD_VBAK_SINGLE_READ'
    EXPORTING
      i_vbeln          = gs_comwa-vbelv
    IMPORTING
      e_vbak           = gs_vbak
    EXCEPTIONS
      record_not_found = 1
      OTHERS           = 2.

  CHECK sy-subrc = 0.
* InIT HS# 12480
*  go_partner = /bitmym/cl_partner=>create( io_case = me ). " HS# 12303
*
*  go_partner->set_ref_partner_comwa( CHANGING c_comwa = gs_comwa ).


*  CHECK gs_comwa-kunnr IS NOT INITIAL.
*
*  go_appl->set_property( i_feld = 'GS_COMWA'  i_value = gs_comwa ).
* End HS# 12480
ENHANCEMENT-POINT check_reference_order SPOTS /bitmym/case .

  e_check = abap_true.

ENDMETHOD.


  METHOD check_rstyp_rental_relevant.
*____HS# 12469, VON: STAORI, DATUM: 17.07.2018___*

