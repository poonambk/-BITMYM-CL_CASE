  endmethod.


METHOD PUT_BOOK_PARTNERS_TO_PROVIDER.
*____HS# 016491, VON: OPECHARROMAN, DATUM: 08.02.2022___*

  DATA lt_vbpa TYPE  /sopromet/vbpav_tab.

  CHECK go_partner is NOT INITIAL.

* Get partner data
  get_property go_partner 'GT_VBPA' lt_vbpa.

* Put data into provider
  LOOP AT lt_vbpa ASSIGNING FIELD-SYMBOL(<fs_vbpa>).
    APPEND INITIAL LINE TO rt_partner ASSIGNING FIELD-SYMBOL(<fs_partner>).
    MOVE-CORRESPONDING <fs_vbpa> TO <fs_partner>.
  ENDLOOP.
ENDMETHOD.


  method UI5_DELETE_BOOKING_TEMPLATE.
*____HS# 015183, VON: SSINGH, DATUM: 27.09.2021___*

    DATA : ls_template  TYPE /bitmym/ui5_tmpl,
           lt_template  TYPE TABLE OF /bitmym/ui5_tmpl,
           ls_tmpl_data TYPE /bitmym/ui5_tmpl.
    FIELD-SYMBOLS : <fs_template> TYPE /bitmym/ui5_tmpl.
    io_ui5->ui5_keytab2struct( CHANGING cs_struct = ls_template  ).
    SELECT SINGLE * FROM /bitmym/ui5_tmpl INTO ls_tmpl_data WHERE tmpl_no = ls_template-tmpl_no.
    CHECK sy-subrc = 0.
    APPEND INITIAL LINE TO lt_template ASSIGNING <fs_template>.
    <fs_template> = ls_tmpl_data.
    CALL FUNCTION '/BITMYM/UPDATE_BOOKING_TEMPL' IN UPDATE TASK
      EXPORTING
        it_template = lt_template
        id_dele     = 'X'.

    COMMIT WORK.

  endmethod.


  method UI5_GET_BOOKING_TEMPLATES.
*____HS# 015183, VON: SSINGH, DATUM: 27.09.2021___*
    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

    SELECT * FROM /bitmym/ui5_tmpl INTO TABLE et_entityset
      WHERE  intf_cid = lo_case->/bitmym/if_ui5~gv_callerid.
  endmethod.


METHOD ui5_prep_book_info_to_gt_res.
*____HS# 015081, VON: OPECHARROMAN, DATUM: 14.09.2021___*
*____HS# 015081, VON: SSINGH, DATUM: 14.12.2021___*
*____HS# 017087, VON: SSINGH, DATUM: 13.10.2022___*
*___ SR2-723, User: SCOSAR, Date: 14.10.2024___*
*___ SR2-1435, User: SCOSAR, Date: 24.01.2025___*


  DATA: ls_copy_fields TYPE /bitmym/ic_book_create_fields,
        ls_res         TYPE /sopromet/zzlrv,
        ld_index       TYPE int4,
        ls_item        TYPE /bitmym/b_items_st,
        ls_control     TYPE cxtab_control,
        lt_items       TYPE /bitmym/b_items_st_tab,
        lt_tree        TYPE /sopromet/tree_collect_tab,
        ls_date        TYPE /bitmym/s4h_convert_dates_st.

  FIELD-SYMBOLS: <fs_maktx>  TYPE maktx,
                 <fst_items> TYPE table.

*   add new fields to be passed from the input structure and
*   change so we use structure /BITMYM/IC_BOOK_CREATE_FIELDS
*   to define the relevant fields to be copied
*   Create new method to make date conversion and call the new method
  MOVE-CORRESPONDING cs_data TO ls_copy_fields.

* move odata service dates to common date structure
  MOVE-CORRESPONDING cs_data TO ls_date.


  /bitmym/cl_ui5_util=>convert_times_to_stamps( CHANGING cs_data = ls_date ).

  MOVE-CORRESPONDING ls_date TO gs_comwa.

  go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE'   IMPORTING e_value = lt_tree ).

* Move case data to reservation table data. Bookings only have one reservation
  LOOP AT lt_tree ASSIGNING FIELD-SYMBOL(<fs_res>) WHERE isfolder EQ abap_false.

    DATA(ls_map) = go_tree_case->get_map_of_node( <fs_res>-node_key ).
    CHECK ls_map IS NOT INITIAL.
    ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).
    IF ls_res IS INITIAL.
      MOVE-CORRESPONDING gs_comwa TO ls_res.
    ENDIF.
    MOVE-CORRESPONDING ls_copy_fields TO ls_res.

    MOVE-CORRESPONDING ls_date TO ls_res.
    set_property ls_map-objkey 'G_RESERVATION' ls_res.

*   Set active reservation
    go_act_reservation =  ls_map-objkey.

*   Add booking items to active reservation
    CASE   gs_comwa-trtyp_o.
      WHEN  /bitmym/cl_mym=>c_trtyp_change.

        ASSIGN COMPONENT 'bookingtobookingitem' OF STRUCTURE cs_data TO <fst_items>.
        CHECK sy-subrc EQ 0.
        CLEAR ld_index.
        LOOP AT <fst_items> ASSIGNING FIELD-SYMBOL(<fs_items>).
          ADD 1 TO ld_index.
          ls_control-current_line = ld_index.
          MOVE-CORRESPONDING <fs_items> TO ls_item.
**___Call standard method of GUI processing
          ls_map-objkey->booking_item_modify_itab(
          EXPORTING i_index = ld_index
                    i_item_wa = ls_item
            CHANGING
              c_control   = ls_control
              c_items_tab = lt_items ).

          READ TABLE lt_items ASSIGNING FIELD-SYMBOL(<bitem>) WITH KEY matnr = ls_item-matnr.
          CHECK sy-subrc EQ 0.
          ASSIGN COMPONENT 'MAKTX' OF STRUCTURE <fs_items> TO <fs_maktx>.
*          CHECK sy-subrc EQ 0. "SR2-723
*____SR2-723____BEGIN INSERT___*
          IF sy-subrc EQ 0.
            <fs_maktx> = <bitem>-maktx.
          ENDIF.

          ASSIGN COMPONENT 'MEINS' OF STRUCTURE <fs_items> TO FIELD-SYMBOL(<fs_meins>).
          IF sy-subrc EQ 0.
            <fs_meins> = <bitem>-meins.
          ENDIF.
*____SR2-723____END   INSERT___*
        ENDLOOP.

*____SR2-1435____BEGIN INSERT___*
        IF <fst_items> IS INITIAL.
          ls_map-objkey->set_property( i_feld = 'GT_BOOKING_ITEMS' i_value = VALUE /bitmym/b_items_st_tab( ) ).
        ENDIF.
*____SR2-1435____END   INSERT___*

    ENDCASE.

  ENDLOOP.

  set_property go_appl 'GS_COMWA' gs_comwa.                 "HS 15081

*___Execute ATP of booking items
  IF /bitmym/if_ui5~g_mobile_call NE abap_true.             "HS 17086
    ui5_booking_items_atp( CHANGING ct_items = <fst_items> ).
  ENDIF.                                                    "HS 17086

  set_property go_appl 'GO_CASE' me.
ENDMETHOD.


METHOD ui5_s4h_bookings_post_list.
*____HS# 015080, VON: OPECHARROMAN, DATUM: 10.12.2021___*

*___Call post list method
  /bitmym/cl_case=>create( io_ui5 = io_ui5 )->ui5_s4h_bookings_post_list_int( IMPORTING er_entity = er_entity ).
ENDMETHOD.


  METHOD ui5_single_items_atp_check.
    DATA: lo_res   TYPE REF TO /sopromet/cl_l_reservation,
          lo_ui5   type REF TO /bitmym/cl_ui5,
          ls_comwa TYPE /sopromet/zzls01.

    io_appl->get_property( EXPORTING i_feld  = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
    io_case->get_property( EXPORTING i_feld  = 'GO_UI5' IMPORTING e_value = lo_ui5 ).

    CREATE OBJECT lo_res
      EXPORTING
        i_vkorg = ls_comwa-vkorg
        i_vtweg = ls_comwa-vtweg
        i_spart = ls_comwa-spart.
    set_property lo_res 'GO_APPLICATION' io_appl.

    lo_res->set_property( EXPORTING i_feld  = 'GO_CASE' i_value = io_case ).
    lo_res->set_property( EXPORTING i_feld  = 'GO_APPLICATION' i_value = io_appl ).
    io_appl->set_property( EXPORTING i_feld = 'GO_CASE' i_value = io_case ).

    io_case->set_property( EXPORTING i_feld = 'GS_COMWA-TRTYP_O' i_value = /bitmym/cl_mym=>c_trtyp_create ).
    lo_res->set_property( EXPORTING i_feld = 'G_RESERVATION-KZSIR' i_value = abap_true ).
    lo_res->set_property( EXPORTING i_feld = 'GO_UI5' i_value = lo_ui5 ).

    lo_res->set_prop_single_items( ct_single_items ).

    ct_single_items = lo_res->get_prop_single_items( EXPORTING io_case = io_case i_auto_check = abap_true ).

    IF id_consistency_check = abap_true.
      /sopromet/cl_l_message_collect=>init( EXPORTING io_ui5 = lo_ui5 ).
      lo_res->single_item_consistency_check( ).
    ENDIF.
  ENDMETHOD.


  METHOD ui5_single_items_atp_ext.
*____HS# 015081, VON: BGUNAWAN, DATUM: 26.09.2022___*
    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider, "HS 015081
          ls_data_ui5      TYPE /bitmym/cl_s4h_reserva_mpc_ext=>ts_reservation_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          lo_appl          TYPE REF TO /bitmym/cl_mym,
          ls_comwa         TYPE /sopromet/zzls01,
          ls_comwa_case    TYPE /sopromet/zzls01,
          ls_copy_fields   TYPE /bitmym/ic_book_create_fields,
          lt_singleitems   TYPE /sopromet/ritems_tab,
          lt_single_items  TYPE /sopromet/ritems_tab.

    io_ui5->get_property( EXPORTING i_feld  = 'GO_DATA_PROVIDER' IMPORTING e_value = lo_data_provider ).

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    CHECK lo_data_provider IS BOUND.

    "Prepare case and appl comwa
    io_ui5->get_property( EXPORTING i_feld  = 'GO_MYM' IMPORTING e_value = lo_appl ).
    lo_appl->get_property( EXPORTING i_feld  = 'GS_COMWA' IMPORTING e_value = ls_comwa ).
    ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.


    lo_appl->set_property( EXPORTING i_feld = 'GS_COMWA' i_value = ls_comwa ).


    "Create case object
    IF ls_data_ui5-zzlrsam IS NOT INITIAL AND ls_data_ui5-zzlresn IS INITIAL.
      lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam io_ui5 = io_ui5 ).
    ELSEIF ls_data_ui5-zzlrsam IS NOT INITIAL AND ls_data_ui5-zzlresn IS NOT INITIAL.
      lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam
                                         id_reservation = ls_data_ui5-zzlresn
                                         io_ui5 = io_ui5 ).
    ELSE.
      lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).
    ENDIF.

    lo_case->get_property( EXPORTING i_feld  = 'GS_COMWA' IMPORTING e_value = ls_comwa_case ).
    ls_comwa_case-kunnr = ls_data_ui5-kunnr.
    ls_comwa_case-kunwe = ls_data_ui5-kunwe.
    ls_comwa_case-rstyp = |{ ls_data_ui5-rstyp ALPHA = IN }|.
    lo_case->set_property(  EXPORTING i_feld = 'GS_COMWA' i_value = ls_comwa_case ).
    CHECK lo_case->ui5_prep_booking_partner( id_no_add_srep = abap_true ) EQ abap_true.

    lo_case->ui5_single_items_atp_int( EXPORTING is_data_ui5 = ls_data_ui5
                                       IMPORTING es_data = es_data ).

  ENDMETHOD.


  method UI5_UPDATE_RESERVATION.
*____HS# 015081, VON: SBADUSHA, DATUM: 09.09.2022___*

    DATA: ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_reservation_deep,
*          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider.



    get_property io_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    CHECK lo_data_provider IS BOUND.
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( id_case = ls_data_ui5-zzlrsam id_reservation = ls_data_ui5-zzlresn io_ui5 = io_ui5 ).

    lo_case->ui5_update_reservation_int( IMPORTING es_data = es_data ).
  endmethod.


  METHOD ui5_update_reservation_int.
*____HS# 015081, VON: SBADUSHA, DATUM: 09.09.2022___*

    DATA: ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_reservation_deep,
          lo_case          TYPE REF TO /bitmym/cl_case,
          ls_res           TYPE /sopromet/zzlrv,
          lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          lt_tree          TYPE /sopromet/tree_collect_tab,
          ls_date          TYPE /bitmym/s4h_convert_dates_st,
*          ls_res           TYPE /sopromet/zzlrv,
          lo_appl          TYPE REF TO /bitmym/cl_mym.
*          lo_case          TYPE REF TO /bitmym/cl_case.
*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.
    CHECK lo_data_provider IS BOUND.
    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).
    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_r.
    gs_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_change.

    CALL FUNCTION '/SOPROMET/RESERV_SINGLE_READ'
      EXPORTING
        i_reserv      = ls_data_ui5-zzlresn
        i_no_buff     = abap_true
      IMPORTING
        e_reservation = ls_res.

    MOVE-CORRESPONDING ls_res TO gs_comwa.

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    start_tree_case( i_tree_dynnr = space i_tree_repid = space id_dark = abap_true ).

    CHECK go_tree_case IS NOT INITIAL.

    go_tree_case->get_property( EXPORTING i_feld = 'GT_TREE'     IMPORTING e_value = lt_tree ).

    LOOP AT lt_tree ASSIGNING FIELD-SYMBOL(<fs_res>) WHERE isfolder EQ abap_false.

      DATA(ls_map) = go_tree_case->get_map_of_node( <fs_res>-node_key ).

      CHECK ls_map IS NOT INITIAL.

      CHECK ls_map-lresrv EQ ls_data_ui5-zzlresn.

      ls_map-objkey->get_reservation_data( IMPORTING e_reservation = ls_res ).

      MOVE-CORRESPONDING ls_data_ui5 TO ls_date.
*
      IF ls_date IS NOT INITIAL.
        /bitmym/cl_ui5_util=>convert_times_to_stamps( CHANGING cs_data = ls_date ).
      ENDIF.

      MOVE-CORRESPONDING ls_date TO ls_res.
      set_property ls_map-objkey 'G_RESERVATION' ls_res.
    ENDLOOP.

*    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application
*___Step 6: Create tree
    ui5_prep_reservation_tree( ).

    ui5_prep_booking_notes( it_notes = ls_data_ui5-reservationtonotes ).


*___Step 11: Post Reservation
    CHECK ui5_post_case( ) EQ abap_true.

*___Step 12: Fill Return Data
*  ui5_case_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).
    CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.     "HS# 016491
    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data_ui5
                                                      CHANGING cr_data = es_data ).

  ENDMETHOD.


  method BOOKING_GET_DEL_PRIORITY.
*____HS# 017034, VON: SBADUSHA, DATUM: 14.03.2023___*

    check go_act_reservation is bound.
*    go_act_reservation->booking_get_del_priority( changing c_lprio = c_lprio c_bezei = c_bezei ).

    check del_priority_active( ) eq abap_true.
    check read_knvv_int( ) eq abap_true.
    if c_lprio is initial or c_lprio eq '00'.
*    c_bezei = read_del_prio_text( ).
      c_lprio = gs_knvv-lprio.
      c_bezei = go_act_reservation->get_del_priority_text( i_lprio = c_lprio ).
    else.
      c_bezei = go_act_reservation->get_del_priority_text( i_lprio = c_lprio ).
    endif.
  endmethod.


  method DEL_PRIORITY_ACTIVE.
*____HS# 017034, VON: SBADUSHA, DATUM: 14.03.2023___*

    data : ls_rstyp_vkorg type /sopromet/rstypo.

    rd_active = abap_false.

ENHANCEMENT-POINT DEL_PRIORITY_ACTIVE_01 SPOTS /BITMYM/CASE /BITMYM/CL_CASE .

    call function '/SOPROMET/RSTYPO_SINGLE_READ'
      exporting
        i_rstyp = gs_comwa-rstyp
        i_vkorg = gs_comwa-vkorg
      importing
        e_data  = ls_rstyp_vkorg.

    check ls_rstyp_vkorg-actv_dlv_prio eq abap_true.

ENHANCEMENT-POINT DEL_PRIORITY_ACTIVE_02 SPOTS /BITMYM/CL_CASE .

    rd_active = abap_true.

  endmethod.


  method POPULATE_BOOK_RES_LINK_TAB.
*____HS# 017034, VON: SBADUSHA, DATUM: 14.03.2023___*


    refresh lt_res_link.
    read table gt_res_link into data(ls_res_link) with key equnr = is_comwa_pai-equnr.

    check sy-subrc eq 0.

    append initial line to lt_res_link assigning field-symbol(<fs_res_link>).
    move-corresponding ls_res_link to <fs_res_link>.
    <fs_res_link>-mandt     = sy-mandt.
    <fs_res_link>-ref_lresn = is_comwa_pai-zzlresn.
    if is_comwa_pai-lprio is initial or
       is_comwa_pai-lprio eq '00'.
      <fs_res_link>-lprio     = ls_res_link-lprio.
      c_lprio = ls_res_link-lprio.
    else.
      <fs_res_link>-lprio     = is_comwa_pai-lprio.
    endif.

  endmethod.


  method READ_KNVV_INT.
*____HS# 017034, VON: SBADUSHA, DATUM: 14.03.2023___*

    rd_found = abap_false.


    check gs_comwa is not initial.

    call function 'KNVV_SINGLE_READ'
      exporting
        i_kunnr         = gs_comwa-kunnr
        i_vkorg         = gs_comwa-vkorg
        i_vtweg         = gs_comwa-vtweg
        i_spart         = gs_comwa-spart
      importing
        o_knvv          = gs_knvv
      exceptions
        not_found       = 1
        parameter_error = 2
        others          = 3.


    check gs_knvv is not initial.

    rd_found = abap_true.

  endmethod.


METHOD add_single_parts_pack.
*____HS# 017900, VON: SBADUSHA, DATUM: 15.03.2023___*
*___ SR1-1076, User: SBADUSHA, Date: 23.01.2024___*
*___ SR2-206, User: SBADUSHA, Date: 27.03.2024___*

* Begin of commment SR2-206
*  DATA: lo_equi         TYPE REF TO /sopromet/cl_l_equipment,
*        ls_equi         TYPE rihequi,
*        ls_comwa        TYPE /sopromet/zzls01,
*        ls_copy_data    TYPE /sopromet/s_add_to_reserv,
*        ld_trtyp        TYPE /sopromet/zzls01-trtyp,
*        lt_reservations TYPE /sopromet/ty_tree_map_tab,
*        ls_res_pai      TYPE /sopromet/zzlrv,
*        lo_equires      TYPE REF TO /sopromet/cl_l_equipment,
*        l_objnr       TYPE jsto-objnr
*       ,l_stsma       TYPE tj30-stsma
*       ,l_user_status TYPE tj30t-txt04.
*
*  FIELD-SYMBOLS: <equi> TYPE /sopromet/zzls06.
*
*  rd_success = abap_false.
*
*  CHECK gt_mat_selection IS NOT INITIAL.
*  READ TABLE gt_mat_selection ASSIGNING <equi> INDEX 1.
*
*  lo_equi = /sopromet/cl_l_equipment=>create( i_equi = <equi>-equnr ). "HS# 11997
*  ls_equi = lo_equi->exp_equi_data( ).
*
*
*  me->get_property(
*    EXPORTING
*      i_feld  = 'GT_RESERVATIONS'
*    IMPORTING
*      e_value = lt_reservations
*  ).
*
*  LOOP AT lt_reservations ASSIGNING FIELD-SYMBOL(<fs_reservation>).
*    <fs_reservation>-objkey->get_reservation_data(
*           IMPORTING
*             e_reservation              = ls_res_pai
*             e_equipment                = lo_equires ).
*  ENDLOOP.
*
**___Hinzufügen des 'Dummy Equipments'
**  MOVE-CORRESPONDING gs_comwa     TO ls_copy_data.
**  MOVE-CORRESPONDING ls_copy_data TO ls_comwa.
**  MOVE-CORRESPONDING ls_equi TO ls_comwa.
**  MOVE-CORRESPONDING gs_comwa TO ls_comwa.
*
*  MOVE-CORRESPONDING ls_res_pai TO ls_comwa.
*  CLEAR ls_comwa-vbeln.
**  IF ls_comwa-vkorg IS INITIAL.                             "HS#10880
**    ls_comwa-vkorg = gs_comwa-vkorg.                        "HS#10880
**    ls_comwa-vtweg = gs_comwa-vtweg.                        "HS#10880
**    ls_comwa-spart = gs_comwa-spart.                        "HS#10880
**  ENDIF.                                                    "HS#10880
**
**  ls_comwa-werks   = ls_equi-swerk.
*  ls_comwa-ernam   = sy-uname.
*  ls_comwa-erdat   = sy-datum.
**  ls_comwa-kzsir   = 'X'.
*  ls_comwa-eqktx = ls_equi-eqktx.
**  MOVE-CORRESPONDING
*
*  ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 ).
*  APPEND VALUE #( zzlresn = ls_comwa-zzlresn ) TO et_created_res.
*
*  ls_comwa-vbelv   = gs_case-vbelv.
*  ls_comwa-vkbur   = gs_case-vkbur.
*
*  MOVE-CORRESPONDING gs_case TO ls_comwa.
*  ls_comwa-equnr = <equi>-equnr.
**  ls_comwa-matnr = VALUE #( it_singleitems[ 1 ]-pac_matnr OPTIONAL ). "SR1-1076
**  ls_comwa-sernr = VALUE #( it_singleitems[ 1 ]-pac_sernr OPTIONAL ). "SR1-1076
*  ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
*
*  CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
*    EXPORTING
*      i_zzls01            = ls_comwa
*      i_post_single_items = abap_true
*    TABLES
*      xsingleitems        = it_singleitems.
*
**  COMMIT WORK AND WAIT.
**  l_objnr+0(2)   = /sopromet/cl_l_reservation=>c_status_typ_res.             "lt. Knami 28.5.
**  l_objnr+2(20)  = ls_comwa-zzlresn.
**  l_user_status  = /sopromet/cl_l_reservation=>c_res_status_ausgeliefert.
**  l_stsma        = 'LEIHSRES'.    "get_status_schema( i_rscat = g_reservation-rscat ).
**  CALL FUNCTION '/SOPROMET/SET_STATUS_EXTERN' IN UPDATE TASK
**    EXPORTING
**      i_objnr = l_objnr
**      i_txt04 = l_user_status
**      i_stsma = l_stsma
**    EXCEPTIONS
**      OTHERS  = 1.
*
*  rd_success = abap_true.
* End of commment SR2-206
ENDMETHOD.


  method check_del_prio_from_refbook.
*____HS# 017034, VON: SBADUSHA, DATUM: 07.07.2022___*

    data : ld_ref_booking type /bitmym/ref_book.

    check go_act_reservation is bound.

    go_appl->get_property( exporting i_feld  = 'GD_REF_BOOKING' importing e_value = ld_ref_booking ).

    if ld_ref_booking is initial.
      booking_get_del_priority( changing c_lprio = c_lprio c_bezei = c_bezei  ).
      go_act_reservation->set_property( exporting i_feld  = 'LPRIO'    i_value =  c_lprio ).
    else.
      read table gt_res_link into data(ls_res_link) with key equnr = i_equnr matnr = i_matnr.
      c_lprio = ls_res_link-lprio.
      c_bezei = go_act_reservation->get_del_priority_text( i_lprio = c_lprio ).
      go_act_reservation->set_property( exporting i_feld  = 'LPRIO'    i_value =  c_lprio ).
    endif.
  endmethod.


  method chk_actv_dlv_prio.
*____HS# 017034, VON: SBADUSHA, DATUM: 22.07.2022___*

    data : ls_rstyp_vkorg type /sopromet/rstypo,
           ls_reservation type /sopromet/zzlrv.
    check go_act_reservation is bound.


    go_act_reservation->get_property( exporting i_feld  = 'GS_RSTYP_VKORG' importing e_value = ls_rstyp_vkorg ).

    if ls_rstyp_vkorg is initial.
      go_act_reservation->get_property( exporting i_feld  = 'G_RESERVATION' importing e_value = ls_reservation ).

      call function '/SOPROMET/RSTYPO_SINGLE_READ'
        exporting
          i_rstyp = gs_comwa-rstyp                      " ls_reservation-rstyp
          i_vkorg = gs_comwa-vkorg   ""ls_reservation-vkorg
        importing
          e_data  = ls_rstyp_vkorg.
      r_actv_del = ls_rstyp_vkorg-actv_dlv_prio.
    else.
      r_actv_del = ls_rstyp_vkorg-actv_dlv_prio.
    endif.





  endmethod.


  method derive_book_res_link.
*____HS# 017034, VON: SBADUSHA, DATUM: 06.07.2022___*
*___ SR1-769, User: SBADUSHA, Date: 26.10.2023___*

    types : begin of ty_eq_mat_link,
              equnr type equnr,
              matnr type matnr,
            end of ty_eq_mat_link.
    data: lt_sel_matnr   type /sopromet/zzls07_tab,         "HS# 017034
          l_o_mat        type ref to /sopromet/cl_l_material, "HS# 017034
          lo_area        type ref to /sopromet/cl_l_salesarea, "HS# 017034
          lv_counter     type i,                            "HS# 017034
          lv_tabix       like sy-tabix,
          lt_eq_mat_link type standard table of ty_eq_mat_link,
          lt_eq_mat_ref  type standard table of ty_eq_mat_link,
          lo_equi        type ref to /sopromet/cl_l_equipment,
          l_equi_data    type rihequi.

    go_appl->get_property( exporting i_feld = 'GT_SEL_MATNR' importing e_value = lt_sel_matnr ).

    select * from /bitmym/b_items into table @data(lt_bookings) where lresn = @gs_comwa-ref_book.

    loop at gt_mat_selection assigning field-symbol(<f_mat_selection>).
      create object lo_equi
        exporting
          i_equnr = <f_mat_selection>-equnr.              " loanset number

      check lo_equi is bound.
      l_equi_data = lo_equi->exp_equi_data( ).

      append initial line to lt_eq_mat_link assigning field-symbol(<fs_eq_mat>).
      <fs_eq_mat>-equnr = <f_mat_selection>-equnr.
      <fs_eq_mat>-matnr = l_equi_data-matnr.
    endloop.

    loop at lt_sel_matnr into data(ls_sel_matnr).
      read table lt_bookings into data(ls_bookings) with key matnr = ls_sel_matnr-matnr.
      if sy-subrc = 0.
        l_o_mat = /sopromet/cl_l_material=>get_ref( ls_bookings-matnr ).
        set_property l_o_mat 'GO_AREA' go_salesarea.

        check l_o_mat->check_set_material( ) eq abap_true.
        lv_counter = ls_bookings-menge.
        refresh lt_eq_mat_ref.
        lt_eq_mat_ref = value #( for ls_eq_mat in lt_eq_mat_link where ( matnr = ls_sel_matnr-matnr  ) ( corresponding #( ls_eq_mat ) )  ).
        do lv_counter times.
          add 1 to  lv_tabix.
          append initial line to gt_res_link assigning field-symbol(<fs_res_link>).
          <fs_res_link>-lresn = ls_bookings-lresn.
          <fs_res_link>-posnr = ls_bookings-posnr.
          <fs_res_link>-lprio = ls_bookings-lprio.


          read table lt_eq_mat_ref into data(ls_eq_mat_ref) index lv_tabix.
          <fs_res_link>-equnr = ls_eq_mat_ref-equnr.
          <fs_res_link>-matnr = ls_eq_mat_ref-matnr.
        enddo.
      endif.
      clear: lv_counter, lv_tabix.
    endloop.

  endmethod.


  method get_booking_ref.
*____HS# 017034, VON: SBADUSHA, DATUM: 08.07.2022___*

   DATA : l_reservation TYPE /SOPROMET/ZZLRV.
    check go_act_reservation is bound.

    if go_act_reservation->check_booking_ref( ) eq abap_true.
       go_act_reservation->get_property( exporting i_feld  = 'G_RESERVATION' importing e_value = l_reservation ).

       IF l_reservation-ref_book IS NOT INITIAL.
          l_ref_book = l_reservation-ref_book.
       ENDIF.
    endif.
  endmethod.


method READ_DEL_PRIO_TEXT.
