  ENDMETHOD.


  METHOD ui5_s4hbookings_get_detail_int.
*____HS# 015080, VON: SISMAIL, DATUM: 25.03.2021___*
*____HS# 015884, VON: OPECHARROMAN, DATUM: 27.08.2021___*
*____HS# 015080, VON: SCOSAR, DATUM: 05.04.2023___*
*___ SR2-688, User: SCOSAR, Date: 11.09.2024___*
*___ SR2-1781, User: SCOSAR, Date: 25.06.2025___*

    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          ls_rserv    TYPE /sopromet/zzlrv,
          lt_reserv   TYPE /sopromet/ty_tree_map_tab,
          ls_vbak     TYPE vbak,
          ls_rstypt   TYPE /sopromet/rstypt,
          lo_booking  TYPE REF TO /sopromet/cl_l_reservation,
          ls_typeo    TYPE /sopromet/rstypo.

    FIELD-SYMBOLS: <bookings> TYPE /bitmym/bookings,
                   <res>      TYPE /sopromet/ty_tree_map.


    /bitmym/if_ui5~go_tech_request_context->/iwbep/if_mgw_req_entity_u~get_converted_keys( IMPORTING es_key_values = er_entity ).

    CHECK er_entity-zzlresn IS NOT INITIAL.

    lo_case = /bitmym/cl_case=>create( id_reservation = er_entity-zzlresn ).

    CHECK ui5_booking_detail_check_exit( ir_case = lo_case ) EQ abap_true. "HS# 12765

    get_property lo_case 'GS_CASE'         ls_case.
    get_property lo_case 'GT_RESERVATIONS' lt_reserv.

    MOVE-CORRESPONDING ls_case TO er_entity.

    IF lt_reserv IS NOT INITIAL.
      READ TABLE lt_reserv ASSIGNING <res> INDEX 1.

      <res>-objkey->get_reservation_data( IMPORTING e_reservation = ls_rserv ).
      MOVE-CORRESPONDING ls_rserv TO er_entity.

    ENDIF.

    /bitmym/cl_partner=>read_address_partner_info_ext(
      EXPORTING
        id_vkorg = ls_case-vkorg
        id_case  = ls_case-zzlrsam
        id_parvw = 'AG'
       CHANGING
         cs_vbadr = ls_vbadr_ag ).

    er_entity-name1 = ls_vbadr_ag-name1.

    IF /bitmym/if_ui5~gv_parvw IS NOT INITIAL.

      /bitmym/cl_partner=>read_address_partner_info_ext(
        EXPORTING
         id_vkorg = ls_case-vkorg
         id_case  = ls_case-zzlrsam
         id_parvw = /bitmym/if_ui5~gv_parvw
        CHANGING
         cs_vbadr = ls_vbadr_xx ).

      er_entity-nachn = ls_vbadr_xx-name1.

    ENDIF.

    IF er_entity-asmnt IS NOT INITIAL.
      CALL FUNCTION 'SD_VBAK_SINGLE_READ'
        EXPORTING
          i_vbeln          = er_entity-asmnt
        IMPORTING
          e_vbak           = ls_vbak
        EXCEPTIONS
          record_not_found = 1
          OTHERS           = 2.
      IF sy-subrc EQ 0.
        er_entity-asmnt_text = ls_vbak-ktext.
      ENDIF.
    ENDIF.

    IF <res> IS ASSIGNED AND <res>-objkey IS BOUND.
      er_entity-txt04 = <res>-objkey->get_user_status( ).
      er_entity-txt30 = <res>-objkey->get_user_status_30( ).
    ENDIF.

    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp      = er_entity-rstyp
        id_no_buffer = abap_true
      IMPORTING
        e_text       = ls_rstypt.

    er_entity-bezei = ls_rstypt-bezei.


    /bitmym/cl_ui5_util=>convert_dates_to_times( CHANGING cs_data = er_entity ).

    CALL FUNCTION '/SOPROMET/RSTYPO_SINGLE_READ'
      EXPORTING
        i_rstyp = er_entity-rstyp
        i_vkorg = er_entity-vkorg
      IMPORTING
        e_data  = ls_typeo.
    IF NOT ls_typeo IS INITIAL.
      er_entity-book2case = ls_typeo-xbook2case.
    ENDIF.


    CALL FUNCTION 'CSO_O_SD_TVSB_GET'
      EXPORTING
        pi_vsbed       = er_entity-vsbeb
        pi_spras       = /bitmym/if_ui5~gd_language
      IMPORTING
        pe_vsbed_vtext = er_entity-vtext.

*___ Start HS# 015080 - SCOSAR - 05.04.2023 16:40:19
    SELECT SINGLE fullname FROM /bitmym/iuser INTO er_entity-fullname WHERE username EQ er_entity-ernam.
*___ End HS# 015080 - SCOSAR - 05.04.2023 16:40:19

*____SR2-688____BEGIN INSERT___*

    calculate_editable_flags( EXPORTING is_booking = CORRESPONDING #( er_entity ) IMPORTING ed_edit_booking   = er_entity-edit_booking
                                                                                            ed_edit_item      = er_entity-edit_item
                                                                                            ed_dispatch_exist = er_entity-dispatch_exist
                                                                                            ed_edit_partner   = er_entity-edit_partner
                                                                                            ed_clnsupreq_ctrl = er_entity-clnsupreq_ctrl ). "SR2-1781
*____SR2-688____END   INSERT___*



      ui5_s4h_bookings_get_list_text( CHANGING er_entity = er_entity ).

  ENDMETHOD.


METHOD unassign_equipment.
*____HS# 015408, VON: MTOMITA, DATUM: 22.06.2021___*
*___ SR2-1942, User: SCOSAR, Date: 25.06.2025___*

  DATA: l_o_alv      TYPE REF TO /bitmym/cl_alv_unassign,
        lt_list      TYPE        /bitmym/unassign_equi_t,
        l_titel(132),
        ls_res       TYPE /sopromet/zzlrv,
        ls_unassign  TYPE /bitmym/unassign_equi.

  FIELD-SYMBOLS: <list> TYPE /bitmym/unassign_equi_s,
                 <res>  TYPE  /sopromet/ty_tree_map.

  LOOP AT gt_reservations ASSIGNING <res>
    WHERE abgru   IS INITIAL
      AND eqtyp  NE /sopromet/cl_l_equipment=>c_equi_typ_ref.

    CHECK <res>-objkey IS BOUND.

    CHECK <res>-objkey->get_user_status( ) EQ /sopromet/cl_l_reservation=>c_res_status_gesperrt
      OR <res>-objkey->get_user_status( ) EQ /sopromet/cl_l_reservation=>c_res_status_frei.

    get_property <res>-objkey 'G_RESERVATION' ls_res.

    APPEND INITIAL LINE TO lt_list ASSIGNING <list>.

    <list>-vdate = ls_res-vdate.
    <list>-lresn = ls_res-zzlresn.
    <list>-equnr = ls_res-equnr.
    <list>-sernr = ls_res-sernr.
    <list>-matnr = ls_res-matnr.
    <list>-eqktx = ls_res-eqktx.
    <list>-oreserv = <res>-objkey.

ENHANCEMENT-POINT UNASSIGN_EQUIPMENT_05 SPOTS /BITMYM/CL_CASE .

  ENDLOOP.

  CREATE OBJECT l_o_alv.

  CALL METHOD l_o_alv->set_prop_repid( '/BITMYM/SAPLUNASSIGN_EQUI_ALV' ).

  l_titel = TEXT-001.

  CALL METHOD l_o_alv->set_property
    EXPORTING
      i_prop_name  = 'G_TITLE'
      i_prop_value = l_titel.

  CALL METHOD l_o_alv->set_property
    EXPORTING
      i_prop_name  = 'GT_LIST'
      i_prop_value = lt_list.

  l_o_alv->perpare_list( ).

  l_o_alv->display_list_lvc( ).

  CHECK sy-ucomm = /bitmym/cl_alv_unassign=>c_unassign.

  lt_list = l_o_alv->get_result( ).

  LOOP AT lt_list ASSIGNING <list>
          WHERE NOT select IS INITIAL.

ENHANCEMENT-POINT UNASSIGN_EQUIPMENT_01 SPOTS /BITMYM/CL_CASE .

    <list>-oreserv->unassign_equipment( ).

  ENDLOOP.

  CHECK /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) EQ abap_true. "SR2-1942

  COMMIT WORK AND WAIT.


ENHANCEMENT-POINT UNASSIGN_EQUIPMENT_04 SPOTS /BITMYM/CL_CASE .


ENDMETHOD.


