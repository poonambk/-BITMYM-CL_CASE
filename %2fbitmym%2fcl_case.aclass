  IF id_no_commit EQ abap_false.

      COMMIT WORK AND WAIT.

* Init "HS# 012698
    IF sy-subrc IS INITIAL.
      IF gs_comwa-rscat IS INITIAL.
         CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'                         "SR2-595
            EXPORTING                                                         "SR2-595
              input  = gs_case-zzlrsam                                        "SR2-595
            IMPORTING                                                         "SR2-595
              output = lv_v1.                                                 "SR2-595
        /bitmym/cl_message=>message( id = 'S490(/SOPROMET/ZL)'  v1 = lv_v1 ). "SR2-595
      ELSE.                                                 "HS# 016491
        check_to_create_res_after_book( ).                  "HS# 016491
      ENDIF.
*      /bitmym/cl_mms_events=>create( iv_trtyp   = gs_comwa-trtyp_o iv_rscat   = gs_comwa-rscat                                                             "SR2-193
*                                     iv_zzlresn = gs_comwa-zzlresn iv_zzlrsam = gs_comwa-zzlrsam iv_vkorg = gs_comwa-vkorg )->start_event( ). "HS# 017743  "SR2-193
    ENDIF.
* End "HS# 012698
  ENDIF.

*___BADI: Refresh Customer data
  CALL METHOD /sopromet/ex_handler=>ex_refresh_after_save
    EXPORTING
      i_master = go_main_2006.

  reset_yy_attr_case_n_res( ).                              "HS 14169


