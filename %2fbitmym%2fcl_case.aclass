  METHOD single_item_get_plant.
*____HS# 10880, VON: T.Kern, DATUM: 20.11.2015 ___*
*____HS# 015080, VON: SSINGH, DATUM: 15.02.2022___*
*____HS# 015081, VON: BGUNAWAN, DATUM: 12.09.2022___*

    DATA: lo_gate    TYPE REF TO /sopromet/cl_l_wegate,
          l_plant_we TYPE werks_d,
          ls_res     TYPE /sopromet/zzlrv.

    e_check = abap_false.

    CLEAR e_werks.

    IF go_act_reservation IS BOUND.

      go_act_reservation->get_reservation_data(
         IMPORTING
           e_reservation              = ls_res ).

    ENDIF.

    IF ls_res-werks IS INITIAL.

*      begin of chnages HS 15080
        IF go_ui5 IS BOUND.
          ls_res-werks = ui5_get_single_item_plant( ).
          e_werks = ls_res-werks. "HS# 015081
          CHECK ls_res-werks IS INITIAL.
        ENDIF.
*      end of changes HS 15080

ENHANCEMENT-SECTION single_item_get_plant SPOTS /bitmym/case .

      CREATE OBJECT lo_gate
        EXPORTING
          io_area       = go_salesarea
          id_no_picture = abap_true
          id_no_reorg   = abap_true.

      ls_res-werks = lo_gate->ask_we_plant( i_value = abap_true ).

END-ENHANCEMENT-SECTION.

      IF go_act_reservation IS BOUND.

        go_act_reservation->set_property( i_feld = 'WERKS' i_value = ls_res-werks ).

      ENDIF.

    ENDIF.

    CHECK ls_res-werks IS NOT INITIAL.

    e_werks = ls_res-werks.
    e_check = abap_true.

  ENDMETHOD.


