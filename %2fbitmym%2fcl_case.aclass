* It needs to be implementated in each class. To be copied
  /bitmym/cl_appllog=>call_message( EXPORTING io_appllog = go_if_appllog ).
ENDMETHOD.


  method /bitmym/if_ui5~ui5_fill_context.
*____HS# 012010, VON: MKnauer,   DATUM: 12.10.2017___*
*____HS# 012387, VON: RBoyapati, DATUM: 12.06.2018___*
*____HS# 012765, VON: MKNAUER, DATUM: 12.12.2018___*
*____HS# 014979, VON: MKNAUER, DATUM: 23.02.2021___*
*____HS# 015385, VON: MTOMITA, DATUM: 21.05.2021___*
*____HS# 015385, VON: OPECHARROMAN, DATUM: 21.09.2021___*
*____HS# 016086, VON: SSINGH, DATUM: 28.10.2021___*
*____HS# 017639, VON: SSINGH, DATUM: 30.11.2022___*


    data: lv_service    type string,
          lo_odata      type ref to data,                   "HS# 015385
          ls_zzlrv      type /sopromet/zzlrv,
          ls_comwa_appl type /sopromet/zzls01.
    field-symbols: <fs_source_st> type any.                 "HS# 015385

    check io_ui5 is bound or go_ui5 is bound.

    if io_ui5 is supplied.
      go_ui5 = io_ui5.
    endif.

    go_ui5->ui5_get_context(   importing eo_appl_log              = /bitmym/if_ui5~go_appl_log
                                         eo_ui5_runtime           = /bitmym/if_ui5~go_ui5_runtime
                                         eo_ui5_message_container = /bitmym/if_ui5~go_ui5_message_container
                                         eo_area                  = /bitmym/if_ui5~go_sales_area
                                         ed_callerid              = /bitmym/if_ui5~gv_callerid
                                         es_callerid              = /bitmym/if_ui5~gs_callerid
                                         ev_parvw                 = /bitmym/if_ui5~gv_parvw
                                         eo_user                  = /bitmym/if_ui5~go_user "HS# 012765
                                         eo_mym_appl              = /bitmym/if_ui5~go_mym_appl
                                         es_ui5_comwa             = /bitmym/if_ui5~gs_ui5_comwa "HS 12387
                                         eo_data_provider         = /bitmym/if_ui5~go_data_provider
                                         ev_filter_string         = /bitmym/if_ui5~gv_filter_string
                                         eo_tech_request_content  = /bitmym/if_ui5~go_tech_request_context
                                         ed_language              = /bitmym/if_ui5~gd_language "HS# 014979
                                         es_role_assignment       = /bitmym/if_ui5~gs_role_assignment "HS# 12765
                                          es_paging                = /bitmym/if_ui5~gs_paging "HS 017639
                                         ed_mobile_call           = /bitmym/if_ui5~g_mobile_call "HS 16086

                                         ).

    go_salesarea  = /bitmym/if_ui5~go_sales_area.
    go_if_appllog = /bitmym/if_ui5~go_appl_log.
    go_appl       = /bitmym/if_ui5~go_mym_appl.

    if /bitmym/if_ui5~go_data_provider is bound.
* Start of HS# 015385
*1) Map data provider into source structure so we are not dependent on service or entity set
      lo_odata = go_ui5->get_any_data_str_from_provider( ).
      if lo_odata is not initial.
        assign lo_odata->* to <fs_source_st>.
        move-corresponding <fs_source_st> to ls_zzlrv.
      endif.
*      ENDIF.
* End of HS# 015385
      gs_comwa-rstyp = ls_zzlrv-rstyp.
    endif.

    if go_appl is bound.
      go_appl->get_property( exporting i_feld = 'GS_COMWA' importing e_value = ls_comwa_appl ).
      gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.
    endif.

  endmethod.


METHOD /bitmym/if_util~get_property.
  FIELD-SYMBOLS: <feld> TYPE ANY.

  ASSIGN (i_feld) TO <feld>.
  CHECK sy-subrc EQ 0.

  e_value = <feld>.

ENDMETHOD.


METHOD /bitmym/if_util~set_property.
  FIELD-SYMBOLS: <feld> TYPE ANY.

  ASSIGN  (i_feld)  TO <feld>.
  CHECK sy-subrc EQ 0.
  <feld> = i_value.
ENDMETHOD.


METHOD /sopromet/if_workflow~wf_swe_event_create.
  CALL FUNCTION 'SWE_EVENT_CREATE'
    EXPORTING
      objtype              = wf_objtype
      objkey               = wf_objkey
      event                = wf_event
      start_recfb_synchron = wf_synchron
    TABLES
      event_container      = wf_event_container
    EXCEPTIONS
      objtype_not_found    = 1
      OTHERS               = 2.
ENDMETHOD.


  method ADD_BOOKING_ITEMS.
    CHECK go_act_reservation is bound.
    go_act_reservation->add_booking_items( it_b_items = it_b_items ).

  endmethod.


  METHOD add_period_to_date.
*____HS# 12469, VON: STAORI, DATUM: 24.07.2018___*

    DATA: ld_time  TYPE mara-mhdhb,
          ld_iprkz TYPE mara-iprkz.

    ld_time = id_period_value.

*__domain value for field IPRKZ is DATTP and values are space = day, 1 = week, 2 = month and 3 = year
*__And that for field VLAUEZ is 1= day, 2 = Week, 3 = month and 4 = year
    CASE id_period_unit.
      WHEN '1'.
        ld_iprkz = ' '.
      WHEN '2'.
        ld_iprkz = '1'.
      WHEN '3'.
        ld_iprkz = '2'.
      WHEN '4'.
        ld_iprkz = '3'.
    ENDCASE.

    CALL FUNCTION 'ADD_TIME_TO_DATE'
      EXPORTING
        i_idate               = id_base_date
        i_time                = ld_time
        i_iprkz               = ld_iprkz
      IMPORTING
        o_idate               = ed_result_date
      EXCEPTIONS
        invalid_period        = 1
        invalid_round_up_rule = 2
        internal_error        = 3
        OTHERS                = 4.
  ENDMETHOD.


METHOD add_reservation.

  CHECK add_reservation_confirmation( ) EQ abap_true.
  CHECK add_reservation_atp( ) EQ abap_true.
  e_success = abap_true.
  COMMIT WORK AND WAIT.

ENDMETHOD.


METHOD add_reservation_70.
*____HS# 9837,  VON: MKnauer, DATUM: 04.03.2014 ___*
*____HS# 12011, VON: S.Taori, DATUM: 23.08.2017 ___*
*____HS# 12481, VON: S.Taori, DATUM: 27.04.2018 ___*
*___ SR2-721, User: SCOSAR, Date: 30.08.2024___*

  DATA: lt_created_res    TYPE /sopromet/zzls03_tab. "SR2-721

  CHECK add_reservation_confirmation( ) EQ abap_true.

*  CHECK add_reservation_atp_70( ) EQ abap_true. "SR2-721
  CHECK add_reservation_atp_70( IMPORTING et_created_res = lt_created_res ) EQ abap_true. "SR2-721

  /bitmym/cl_cr_synchronizer=>add_created_res_to_list( io_case = me it_created_res = lt_created_res id_set_g_res = abap_true ). "SR2-721
  check /bitmym/cl_cr_synchronizer=>create( io_case = me )->synchronize( ) eq abap_true. "SR2-721

  reset_case_unused_flag( ).                                "HS 12481
  e_success = abap_true.
  COMMIT WORK AND WAIT.

*__New EHP                                                  HS 12011
ENHANCEMENT-POINT add_reservation_70_01 SPOTS /bitmym/cl_case .
ENDMETHOD.


METHOD add_reservation_atp.
*____HS# 9882, VON:MKnauer, DATUM: 28.03.2014 ___*
*____HS# 014300, VON: STAORI, DATUM: 15.07.2020___*

  DATA: lt_auswahl    TYPE STANDARD TABLE OF /sopromet/zzls06,
        lt_sel        TYPE /sopromet/zzls07_tab,
        lt_sel_equi   TYPE STANDARD TABLE OF /sopromet/zzls06,
        ld_matnr      TYPE matnr,
        ls_comwa      TYPE /sopromet/zzls01,
        lo_equi       TYPE REF TO /sopromet/cl_l_equipment,
        ls_equi_data  TYPE rihequi,
        ls_copy_data  TYPE /sopromet/s_add_to_reserv,
        ls_eqbs        TYPE eqbs.                           "HS# 9882

  FIELD-SYMBOLS: <sel>  TYPE /sopromet/zzls07,
                 <sets> TYPE /sopromet/zzls06.

  ed_atp_done = abap_false.

ENHANCEMENT-POINT add_reservation_atp_01 SPOTS /bitmym/case.

  go_main_2006->g_start_fcode = /sopromet/cl_l_bar_chart=>c_fcode_atp_check.
  CHECK go_appl->check_material_selected( ) EQ abap_true.

  go_appl->get_property( EXPORTING i_feld = 'GT_SEL_MATNR' IMPORTING e_value = lt_sel ).

  IF lt_sel IS INITIAL.
    go_appl->get_property( EXPORTING i_feld = 'GS_COMWA-MATNR' IMPORTING e_value = ld_matnr ).
    APPEND INITIAL LINE TO lt_sel ASSIGNING <sel>.
    <sel>-matnr = ld_matnr.
  ENDIF.

*__Daten an altes myM übergeben
  go_main_2006->set_property( i_feld = 'GT_SEL_MATNR'    i_value = lt_sel ).
  go_main_2006->set_property( i_feld = 'GT_EQUI_AUSWAHL' i_value = lt_sel_equi ).
  go_main_2006->set_property( i_feld = 'G_START_FCODE' i_value = /sopromet/cl_l_bar_chart=>c_fcode_atp_check ).
  lt_auswahl = go_main_2006->get_equipment_list( 'X' ).

  CHECK lt_auswahl IS NOT INITIAL.

ENHANCEMENT-POINT add_reservation_atp_02 SPOTS /bitmym/case.

  LOOP AT lt_auswahl ASSIGNING <sets>.

ENHANCEMENT-POINT add_reservation_atp_03 SPOTS /bitmym/case.

    CREATE OBJECT lo_equi
      EXPORTING
        i_equnr = <sets>-equnr.

    ls_equi_data = lo_equi->exp_equi_data( ).

*___COMWA aufbauen
    MOVE-CORRESPONDING ls_equi_data TO ls_comwa.
    MOVE-CORRESPONDING gs_case      TO ls_copy_data.
    MOVE-CORRESPONDING ls_copy_data TO ls_comwa.


    ls_eqbs = lo_equi->get_eqbs( ).                         "HS# 9882
    IF ls_eqbs-b_werk IS NOT INITIAL.                       "HS# 9882
      ls_comwa-werks = ls_eqbs-b_werk.                      "HS# 9882
    ELSE.                                                   "HS# 9882
      ls_comwa-werks   = ls_equi_data-swerk.
    ENDIF.                                                  "HS# 9882

    ls_comwa-ernam   = sy-uname.
    ls_comwa-erdat   = sy-datum.
    ls_comwa-kzadd   = 'X'.

    ls_comwa-xcons     = fill_xcons_flag( ).
    ls_comwa-kzmonitor = fill_kzmonitor( ).

*___Partnerdaten
    new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ).

    ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 ).

*___Userexit: Transaktionstyp = 'E'xtend
    ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_extend.

    CALL METHOD /sopromet/ex_handler=>ex_pbo_reservation
      CHANGING
        i_zzls01 = ls_comwa.

    ls_comwa-trtyp_o = ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_create.

ENHANCEMENT-POINT add_reservation_atp_05 SPOTS /bitmym/case.

*__Begin of Comment_________________________________________HS 14300
    CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
      EXPORTING
        i_zzls01 = ls_comwa.
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*    CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*      EXPORTING
*        i_zzls01 = ls_comwa.
*__End of Insert____________________________________________HS 14300
  ENDLOOP.

ENHANCEMENT-POINT add_reservation_atp_04 SPOTS /bitmym/case.

  ed_atp_done = abap_true.



ENDMETHOD.


METHOD add_reservation_atp_70.
*____HS# 9837,   VON: MKnauer,      DATUM: 04.03.2014 ___*
*____HS# 9968,   VON: OPecharroman, DATUM: 03.06.2014 ___*
*____HS# 10029,  VON: S.Taori,      DATUM: 18.07.2014 ___*
*____HS# 10474,  VON: T.Kern,       DATUM: 16.09.2015___*
*____HS# 10853,  VON: S.Taori,      DATUM: 07.12.2015 ___*
*____HS# 11162,  VON: OPecharroman, DATUM: 18.04.2016 ___*
*____HS# 12203,  VON: G.Ivanov,     DATUM: 05.12.2017 ___*
*____HS# 12358,  VON: S.Taori,      DATUM: 22.02.2018 ___*
*____HS# 12452,  VON: G.Ivanov,     DATUM: 12.05.2018 ___*
*____HS# 014300, VON: STAORI,       DATUM: 15.07.2020___*
*____HS# 015929, VON: GIVANOV,      DATUM: 15.10.2021___*
*____HS# 016831, VON: SBADUSHA,     DATUM: 01.06.2022___*
*____HS# 017046, VON: MKNAUER,      DATUM: 05.07.2022___*
*____HS# 017190, VON: STAORI,       DATUM: 15.08.2022___*
*____HS# 015081, VON: BGUNAWAN,     DATUM: 29.08.2022___*
*____HS# 017034, VON: SBADUSHA,     DATUM: 14.03.2023___*
*___ SR2-416,    User: SSINGH,      Date:  03.05.2024___*
*___ SR2-614,    User: XLI,         Date:  24.07.2024___*
*___ SR2-731,    User: SCOSAR,      Date:  14.08.2024___*
*___ SR2-728,    User: SCOSAR,      Date:  26.08.2024___*
*___ SR2-721,    User: SCOSAR,      Date:  30.08.2024___*
*___ SR2-871,    User: SCOSAR,      Date:  25.09.2024___*
*___ SR2-1030,   User: SCOSAR,      Date:  24.10.2024___*
*___ SR2-1329,   User: STEKDEMIR,   Date:  08.01.2025___*
*___ SR2-1565, User: SCOSAR, Date: 04.03.2025___*
*___ SR2-1554, User: SCOSAR, Date: 17.03.2025___*

  DATA: lt_auswahl   TYPE STANDARD TABLE OF /sopromet/zzls06,
        ls_comwa     TYPE /sopromet/zzls01,
        lo_equi      TYPE REF TO /sopromet/cl_l_equipment,
        ls_equi_data TYPE rihequi,
        ls_copy_data TYPE /sopromet/s_add_to_reserv.

  DATA: ls_reservation TYPE /sopromet/zzlrv.                "HS# 017046

  DATA: lt_sel_matnr TYPE /sopromet/zzls07_tab.             "HS# 015081

  FIELD-SYMBOLS: <sel>  TYPE /sopromet/zzls07,
                 <sets> TYPE /sopromet/zzls06.

  ed_atp_done = abap_false.

ENHANCEMENT-POINT add_reservation_atp_70_01 SPOTS /bitmym/case .

  CHECK go_appl->check_material_selected( ) EQ abap_true.

  go_appl->get_property( EXPORTING i_feld = 'GS_COMWA' IMPORTING e_value = ls_comwa ). "HS10474

  go_appl->check_matnr_deletion( EXPORTING i_matnr = ls_comwa-matnr io_main = go_appl ). "HS# 016831

  CLEAR ls_comwa-kzsir.                                     "HS# 11162
  ls_comwa-vdate = gs_comwa-vdate.                          "HS# 9968
  ls_comwa-werks = gs_comwa-werks.                          "HS# 9968
  ls_comwa-matnr = gs_comwa-matnr.                          "HS# 9968
  ls_comwa-kunnr = gs_comwa-kunnr.                          "HS# 9968
  ls_comwa-abdat = gs_comwa-abdat.                          "HS# 9968
  ls_comwa-rdate = gs_comwa-rdate.                          "HS# 9968
  ls_comwa-frdat = gs_comwa-frdat.                          "HS# 9968
  ls_comwa-vedat = gs_comwa-vedat.                          "HS# 9968
  ls_comwa-rstyp = gs_comwa-rstyp.                          "HS# 9968
  ls_comwa-odate = gs_comwa-odate.                          "HS# 9968
  ls_comwa-edatu = gs_comwa-edatu.                          "SR2-1329

*____SR2-416____BEGIN INSERT___*
  DATA(ls_rstype) = /sopromet/cl_l_res_type=>create( i_vkorg = ls_comwa-vkorg i_rstyp = gs_case-rstyp )->get_rstype_field_inv( ).
  IF gs_comwa-rstyp NE gs_case-rstyp.
    IF  ls_rstype-rstyp IS NOT INITIAL.
      ls_comwa-rstyp = gs_comwa-rstyp = gs_case-rstyp.
    ENDIF.
  ENDIF.
*____SR2-416____END   INSERT___*

  go_appl->set_property( i_feld = 'gs_comwa' i_value = ls_comwa ). "HS# 9968

* New parameter to skip the atp pop up and to use instead equipment passed from gt_sel_matnr.
* In case id_from_selmatnr eq abap_true, table gt_sel_matnr has to have material and serial number.
* Additional reservations will be created for those equipment passed with gt_sel_matnr.
  IF id_from_selmatnr EQ abap_false.                        "HS# 015081
*__Check if it's single item only assortment
    IF gd_single_only IS  INITIAL.                          "HS 12358

*    lt_auswahl = /bitmym/cl_bar_chart=>display_atp_from_case( io_case = me ).                          "HS# 017190
*      lt_auswahl = /bitmym/cl_bar_chart=>display_atp_from_case( i_view_type = i_view_type io_case = me ). "HS# 017190 "SR2-871
      lt_auswahl = /bitmym/cl_bar_chart=>display_atp_from_case( i_view_type = i_view_type i_fieldinv = id_field_inv io_case = me ). "HS# 017190 "SR2-871

*__Check if the reservation is cancelled in the ATP screen itself
      IF go_barc IS BOUND.                                  "HS# 017190
        go_barc->get_property( EXPORTING i_feld = 'GS_COMWA-ABGRU' IMPORTING e_value = ls_comwa-abgru ). "HS 10373
      ENDIF.                                                "HS# 017190

    ENDIF.                                                  "HS 12358
*Start of insertion HS# 015081
  ELSE.

    get_property go_appl 'GT_SEL_MATNR' lt_sel_matnr.
    CHECK lt_sel_matnr IS NOT INITIAL.
    SELECT matnr, sernr, equnr FROM equi INTO TABLE @DATA(lt_equi)
      FOR ALL ENTRIES IN @lt_sel_matnr
      WHERE matnr = @lt_sel_matnr-matnr AND
            sernr = @lt_sel_matnr-sernr.

    LOOP AT lt_equi ASSIGNING FIELD-SYMBOL(<fs_equi>).
*      you have matnr sernr you have to get equnr from equi to pass to lt_auswahl
      APPEND INITIAL LINE TO lt_auswahl ASSIGNING <sets>.
      <sets>-equnr = <fs_equi>-equnr.
      <sets>-field_inv = id_field_inv. "SR2-871
    ENDLOOP.
  ENDIF.
*End of insertion HS# 015081

*  CHECK lt_auswahl IS NOT INITIAL.                         "HS 12358
  IF lt_auswahl IS NOT INITIAL.                             "HS 12358

ENHANCEMENT-POINT add_reservation_atp__70_02 SPOTS /bitmym/case .

    LOOP AT lt_auswahl ASSIGNING <sets>.

ENHANCEMENT-POINT add_reservation_atp_03_70 SPOTS /bitmym/case .

      CLEAR: ls_comwa-srcrs, ls_comwa-field_inv.            "SR2-1554

      CREATE OBJECT lo_equi
        EXPORTING
          i_equnr = <sets>-equnr.

      ls_equi_data = lo_equi->exp_equi_data( ).

*___COMWA aufbauen
      MOVE-CORRESPONDING ls_equi_data TO ls_comwa.
      MOVE-CORRESPONDING gs_case      TO ls_copy_data.
      MOVE-CORRESPONDING ls_copy_data TO ls_comwa.

      ls_comwa-werks   = ls_equi_data-swerk.
      ls_comwa-ernam   = sy-uname.
      ls_comwa-erdat   = sy-datum.
      ls_comwa-kzadd   = 'X'.
      ls_comwa-vkbur   = gs_case-vkbur.                     "HS 10853

      ls_comwa-xcons     = fill_xcons_flag( ).
      ls_comwa-kzmonitor = fill_kzmonitor( ).
      ls_comwa-hard_allocated = <sets>-hard_allocated.      "HS# 015929

      booking_get_del_priority( CHANGING c_lprio = ls_comwa-lprio c_bezei = ls_comwa-bezei ). "HS# 17034

*___Partnerdaten
      new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ).

      ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 ).
*____SR2-721____BEGIN COMMENT___*
*Start of insertion HS# 015081
*      APPEND VALUE #( zzlresn = ls_comwa-zzlresn
*                      matnr   = ls_comwa-matnr
*                      equnr   = <sets>-equnr
*                    ) TO et_created_res.
*End of insertion HS# 015081
*____SR2-721____END   COMMENT___*


*___Userexit: Transaktionstyp = 'E'xtend
      ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_extend.

      CALL METHOD /sopromet/ex_handler=>ex_pbo_reservation
        CHANGING
          i_zzls01 = ls_comwa.

      ls_comwa-trtyp_o = ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_create.

ENHANCEMENT-POINT add_reservation_atp_70_05 SPOTS /bitmym/case .

      ls_comwa-vbelv   = gs_case-vbelv.                     "HS 10029
*____SR2-416____BEGIN INSERT___*
      IF ls_rstype-rstyp IS NOT INITIAL AND <sets>-field_inv EQ abap_true.
        DATA(lo_cons) = lo_equi->get_current_reservation( 'ATP' ).
        IF lo_cons IS NOT INITIAL.
          lo_cons->get_reservation_data( IMPORTING e_reservation = DATA(ls_cons) ).
          IF ls_cons-zzlresn IS INITIAL.
            CLEAR ls_equi_data.
            EXIT.
          ENDIF.
          ls_comwa-srcrs = ls_cons-zzlresn.
          ls_comwa-field_inv = <sets>-field_inv. "SR2-871
        ELSE.
          CLEAR ls_equi_data.
          EXIT.
        ENDIF.
        ls_comwa-rstyp = ls_rstype-rstyp.
      ENDIF.
*____SR2-416____END   INSERT___*

      add_res_fill_assortment_number( CHANGING cs_comwa = ls_comwa ). "HS 12358
*____SR2-731____BEGIN INSERT___*
      IF id_ref_book IS NOT INITIAL.
        ls_comwa-ref_book = id_ref_book.
      ENDIF.
*____SR2-731____END   INSERT___*

*____SR2-1565____BEGIN INSERT___*
      IF go_appl IS BOUND.
        lt_sel_matnr = go_appl->get_data( )-gt_sel_matnr.
        ls_comwa-asmnt = VALUE #( lt_sel_matnr[ matnr = ls_comwa-matnr ]-asmnt OPTIONAL ).
      ENDIF.
*____SR2-1565____END   INSERT___*

      APPEND CORRESPONDING #( ls_comwa ) TO et_created_res. "SR2-721

*__Begin of Comment_________________________________________HS 14300
      CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
        EXPORTING
          i_zzls01    = ls_comwa
          i_sales_rep = /bitmym/if_ui5~gs_callerid-kunnr. "SR2-1030
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*      CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*        EXPORTING
*          i_zzls01 = ls_comwa.
*__End of Insert____________________________________________HS 14300

*____SR2-721____BEGIN COMMENT___*
*___HS#___17046_____START_OF_INSERT
*        MOVE-CORRESPONDING ls_comwa TO ls_reservation.
*
*        CALL FUNCTION '/BITMYM/SYNC_BITEMS' IN UPDATE TASK
*          EXPORTING
**           is_reservation = ls_reservation "SR2-728
*            it_reservation = VALUE /sopromet/zzlrv_tab( ( ls_reservation ) ) "SR2-728
*            id_trtyp       = 'H'.
*___HS#___17046_____END _OF_INSERT
*____SR2-721____END   COMMENT___*

      lo_equi->dequeue( ). "SR2-614
    ENDLOOP.
  ENDIF.                                                    "HS 12358

  add_si_res_asmt_has_sing_items( ).                        "HS 12358


ENHANCEMENT-POINT add_reservation_atp_70_04 SPOTS /bitmym/case .

  ed_atp_done = abap_true.


ENDMETHOD.


METHOD add_reservation_confirmation.
*____HS# 014548, VON: OPECHARROMAN, DATUM: 06.10.2020___*

  DATA: ld_answer,
        ld_fcode TYPE sy-ucomm.

  e_confirmed = abap_false.

  CHECK exit_handling_case( ) EQ abap_true.                 "HS# 014548

*#HS9856
  IF go_appl IS BOUND.
    go_appl->clear_material_selection( ).
  ENDIF.
*#HS9856

*___Bestägigungspopup
  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      text_question  = TEXT-ext
      popup_type     = 'ICON_MESSAGE_QUESTION'
    IMPORTING
      answer         = ld_answer
    EXCEPTIONS
      text_not_found = 1
      OTHERS         = 2.

  CHECK ld_answer = '1'.

*__Dialog starten
  CALL FUNCTION '/BITMYM/APPL_ADD_RESERVATION'
    IMPORTING
      ed_fcode = ld_fcode.

  CHECK ld_fcode = 'EXECUTE'.

  e_confirmed = abap_true.

ENDMETHOD.


  METHOD add_res_fill_assortment_number.
*____HS# 12358, VON: S.Taori,  DATUM: 22.02.2018 ___*
    DATA: ls_vbak  TYPE vbak.

    CHECK go_asmnt IS BOUND.

    get_property go_asmnt 'GS_VBAK' ls_vbak.
    CHECK ls_vbak IS NOT INITIAL.

    cs_comwa-asmnt = ls_vbak-vbeln.

  ENDMETHOD.


METHOD add_single_parts.
* B.Ludwig, 31.03.2014, #9884
*____HS# 10029, VON: S.Taori, DATUM: 18.07.2014 ___*
*____HS# 10880, VON: T.Kern, DATUM: 20.11.2015 ___*
*____HS# 10853, VON: S.Taori, DATUM: 07.12.2015 ___*
*____HS# 11018, VON: MKnauer, DATUM: 02.02.2016 ___*
*____HS# 11228, VON: S.Taori, DATUM: 20.06.2016 ___*
*____HS# 11383, VON: G.Ivanov, DATUM: 20.09.2016 ___*
*____HS# 11997, VON: MKnauer, DATUM: 02.08.2017 ___*
*____HS# 12481, VON: S.Taori, DATUM: 27.04.2018 ___*
*____HS# 014300, VON: STAORI, DATUM: 15.07.2020___*
*____HS# 015081, VON: BGUNAWAN, DATUM: 12.09.2022___*
*___ SR2-731, User: SCOSAR, Date: 15.08.2024___*
*___ SR2-723, User: SCOSAR, Date: 30.08.2024___*
*___ SR2-1030, User: SCOSAR, Date: 24.10.2024___*
*___ SR2-1565, User: SCOSAR, Date: 07.03.2025___*

  DATA: ld_answer,
        lo_equi      TYPE REF TO /sopromet/cl_l_equipment,
        ls_equi      TYPE rihequi,
        ls_comwa     TYPE /sopromet/zzls01,
        ls_copy_data TYPE /sopromet/s_add_to_reserv,
        ld_trtyp     TYPE /sopromet/zzls01-trtyp.

  FIELD-SYMBOLS: <equi> TYPE /sopromet/zzls06.

*In case the user wants to stay at the same screen
  e_success = abap_undefined.                                              "HS# 11383 GND

*Save case current changes before adding new reservation
  IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.                  "HS# 11383 GND
    IF i_skip_popup EQ abap_false.                          "HS# 015081
      CHECK exit_handling_case( iv_no_unpublish = abap_true ) EQ abap_true. "HS# 11383 GND
    ENDIF.                                                  "HS# 015081
  ENDIF.                                                                  "HS# 11383 GND

  e_success = abap_false.                                   "HS# 11383 GND Moved from top to here

  ld_trtyp = gs_comwa-trtyp_o.                              "HS# 11018

  IF i_skip_popup EQ abap_false.                            "HS# 015081
*___Bestägigungspopup
ENHANCEMENT-SECTION popup_add_single_parts SPOTS /bitmym/cl_case .

CALL FUNCTION 'POPUP_TO_CONFIRM'
  EXPORTING
    text_question  = TEXT-sip
    popup_type     = 'ICON_MESSAGE_QUESTION'
  IMPORTING
    answer         = ld_answer
  EXCEPTIONS
    text_not_found = 1
    OTHERS         = 2.

END-ENHANCEMENT-SECTION.

    CHECK ld_answer = '1'.
  ENDIF.                                                    "HS# 015081

  CHECK prepare_single_item( ) EQ abap_true.

  CHECK gt_mat_selection IS NOT INITIAL.
  READ TABLE gt_mat_selection ASSIGNING <equi> INDEX 1.

  lo_equi = /sopromet/cl_l_equipment=>create( i_equi = <equi>-equnr ). "HS# 11997
  ls_equi = lo_equi->exp_equi_data( ).

  IF ls_equi-swerk IS INITIAL.                              "HS#10880

    single_item_get_plant( IMPORTING e_werks = ls_equi-swerk ). "HS#10880

  ENDIF.                                                    "HS#10880

  fill_go_main_2006( ).

*___Hinzufügen des 'Dummy Equipments'
  MOVE-CORRESPONDING gs_comwa     TO ls_copy_data.
  MOVE-CORRESPONDING ls_copy_data TO ls_comwa.
  MOVE-CORRESPONDING ls_equi TO ls_comwa.

  IF ls_comwa-vkorg IS INITIAL.                             "HS#10880
    ls_comwa-vkorg = gs_comwa-vkorg.                        "HS#10880
    ls_comwa-vtweg = gs_comwa-vtweg.                        "HS#10880
    ls_comwa-spart = gs_comwa-spart.                        "HS#10880
  ENDIF.                                                    "HS#10880

  ls_comwa-werks   = ls_equi-swerk.
  ls_comwa-ernam   = sy-uname.
  ls_comwa-erdat   = sy-datum.
  ls_comwa-kzsir   = 'X'.

  IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.    "HS# 11018
*____SR2-731____BEGIN INSERT___*
    IF i_ref_book IS NOT INITIAL.
      ls_comwa-ref_book = i_ref_book.
    ENDIF.
*____SR2-731____END   INSERT___*
    ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 ).
*    APPEND VALUE #( zzlresn = ls_comwa-zzlresn ) TO et_created_res. "HS# 015081 "SR2-723 - commented
    APPEND CORRESPONDING #( ls_comwa ) TO et_created_res. "SR2-723
  ENDIF.                                                    "HS# 11018

  ls_comwa-vbelv   = gs_case-vbelv.                         "HS 10029
  ls_comwa-vkbur   = gs_case-vkbur.                         "HS 10853

  IF i_asmnt IS NOT INITIAL.                                "SR2-1565
    ls_comwa-asmnt = i_asmnt.                               "SR2-1565
  ENDIF.                                                    "SR2-1565

*___Userexit: Transaktionstyp = 'E'xtend
  ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_extend.

  CALL METHOD /sopromet/ex_handler=>ex_pbo_reservation
    CHANGING
      i_zzls01 = ls_comwa.

  ls_comwa-trtyp_o = /bitmym/cl_mym=>c_trtyp_create.
* Request #9884
ENHANCEMENT-POINT add_single_parts SPOTS /bitmym/case .

  reset_case_unused_flag( ).                                "HS 12481

  IF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_change.    "HS# 11018


*__Begin of Comment_________________________________________HS 14300
    CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
      EXPORTING
        i_zzls01            = ls_comwa
        i_post_single_items = i_post_single_items           "HS# 015081
        i_sales_rep         = /bitmym/if_ui5~gs_callerid-kunnr "SR2-1030
      TABLES                                                "HS# 015081
        xsingleitems        = it_singleitems.                      "HS# 015081
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*    CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*      EXPORTING
*        i_zzls01 = ls_comwa.
*__End of Insert____________________________________________HS 14300
    IF i_no_commit EQ abap_false. "SR2-723
      COMMIT WORK AND WAIT.       "SR2-723
    ENDIF.                        "SR2-723

  ELSEIF gs_comwa-trtyp_o EQ /bitmym/cl_mym=>c_trtyp_create. "HS# 11018
    go_tree_case->add_single_node( is_comwa = ls_comwa ).   "HS# 11018
  ENDIF.                                                    "HS# 11018

*__Restart Info setzten
  e_success = abap_true.

*__                                                         "HS 11228
ENHANCEMENT-POINT add_single_parts_02 SPOTS /bitmym/case .

  CHECK gs_comwa-trtyp_o NE /bitmym/cl_mym=>c_trtyp_create. "HS# 11018

  go_appl->set_property( i_feld = 'GS_RESTART_INFO-ZZLRSAM' i_value = gs_comwa-zzlrsam ).

ENDMETHOD.


  METHOD add_si_res_asmt_has_sing_items.
*____HS# 12358, VON: S.Taori, DATUM: 22.02.2018 ___*
*____HS# 014300, VON: STAORI, DATUM: 15.07.2020___*
*___ SR2-1030, User: SCOSAR, Date: 24.10.2024___*

    DATA: ld_mixed      TYPE abap_bool,
          ld_single     TYPE abap_bool,
          lt_assortment	TYPE /bitmym/assortment_t,
          ls_equi       TYPE v_equi,
          ls_comwa      TYPE /sopromet/zzls01,
          ls_copy_data  TYPE /sopromet/s_add_to_reserv,
          lt_single     TYPE /sopromet/ritems_tab.

    FIELD-SYMBOLS: <single>     TYPE /sopromet/ritems_wa,
                   <assortment> TYPE /bitmym/assortment.

    CHECK go_asmnt IS BOUND.

    get_property go_asmnt 'G_MIXED'   ld_mixed.
    get_property go_asmnt 'G_MAT_SI'  ld_single.

    CHECK ld_mixed IS NOT INITIAL OR ld_single IS NOT INITIAL.

    get_property go_asmnt 'GT_ASSORTMENT' lt_assortment.
    DELETE lt_assortment WHERE mattype NE '2'.    "Keep only single items
    CHECK  lt_assortment IS NOT INITIAL.

    CALL FUNCTION '/SOPROMET/SINGLE_GET_EQUNR'
      EXPORTING
        i_vkorg = gs_actual_area-vkorg
        i_vtweg = gs_actual_area-vtweg
        i_spart = gs_actual_area-spart
      IMPORTING
        e_vequi = ls_equi.

    MOVE-CORRESPONDING ls_equi TO ls_comwa.
    MOVE-CORRESPONDING gs_case TO ls_copy_data.
    MOVE-CORRESPONDING ls_copy_data TO ls_comwa.

    ls_comwa-werks = ls_equi-swerk.
    ls_comwa-ernam = sy-uname.
    ls_comwa-erdat = sy-datum.
    ls_comwa-kzadd = 'X'.
    ls_comwa-kzsir = 'X'.
    ls_comwa-kzmonitor = fill_kzmonitor( ).
    ls_comwa-vkbur = gs_case-vkbur.

    new_reservation_fill_partner_d( CHANGING cs_comwa = ls_comwa ).

    ls_comwa-zzlresn = /sopromet/cl_l_reservation=>number_get_next( i_master = go_main_2006 ).
    ls_comwa-trtyp_o = /sopromet/cl_l_screen=>c_trtyp_create.
    ls_comwa-vbelv   = gs_case-vbelv.

    LOOP AT lt_assortment ASSIGNING <assortment>.
      APPEND INITIAL LINE TO lt_single ASSIGNING <single>.
      <single>-matnr = <assortment>-matnr.
      <single>-menge = <assortment>-menge.
    ENDLOOP.

    add_res_fill_assortment_number( CHANGING cs_comwa = ls_comwa ).

*__Begin of Comment_________________________________________HS 14300
    CALL FUNCTION '/SOPROMET/RESERVATION_SAVE' IN UPDATE TASK
      EXPORTING
        i_zzls01            = ls_comwa
        i_post_single_items = 'X'
        i_sales_rep         = /bitmym/if_ui5~gs_callerid-kunnr "SR2-1030
      TABLES
        xsingleitems        = lt_single.
*__End of Comment___________________________________________HS 14300

*__Begin of Insert__________________________________________HS 14300
*    CALL FUNCTION '/BITMYM/RESERVATION_SAVE' IN UPDATE TASK
*      EXPORTING
*        i_zzls01            = ls_comwa
*        i_post_single_items = 'X'
*      TABLES
*        xsingleitems        = lt_single.
*__End of Insert____________________________________________HS 14300
  ENDMETHOD.


METHOD alert_get_released_sets.
*____HS# 10901, VON: JGreuel, DATUM: 01.12.2015 ___*

  DATA: lo_equi TYPE REF TO /sopromet/cl_l_equipment,
        ls_equi TYPE rihequi.

  FIELD-SYMBOLS: <res>   TYPE /sopromet/ty_tree_map,
                 <alert> TYPE /bitmym/alert01s.

  LOOP AT gt_reservations ASSIGNING <res> WHERE abgru IS INITIAL.
    <res>-objkey->get_reservation_data( IMPORTING e_equipment = lo_equi ).
    ls_equi = lo_equi->exp_equi_data( ).
    APPEND INITIAL LINE TO et_sets ASSIGNING <alert>.
    MOVE-CORRESPONDING ls_equi TO <alert>.
    <alert>-lresn = <res>-lresrv.                           "HS# 10901
  ENDLOOP.

ENDMETHOD.


METHOD append_reservations.
*____HS# 9923, VON: BLUDWIG, DATUM: 07.05.2014 ___*


  DATA: lt_reserv TYPE STANDARD TABLE OF /sopromet/zzlrv,
        lo_res    TYPE REF TO /sopromet/cl_l_reservation,
        ls_res    TYPE /sopromet/zzlrv,
        ls_equi   TYPE rihequi,
        lo_equi   TYPE REF TO  /sopromet/cl_l_equipment,
        lt_old    TYPE STANDARD TABLE OF /sopromet/zzls04,  "HS# 9923
        lt_new    TYPE STANDARD TABLE OF /sopromet/zzlrp.   "HS# 9923


  FIELD-SYMBOLS: <res_all> TYPE /sopromet/zzlrv,
                 <res_new> TYPE /sopromet/ty_tree_map,
                 <res_old> TYPE /sopromet/ty_tree_map,      "HS# 9923
                 <old>     TYPE /sopromet/zzls04,           "HS# 9923
                 <new>     TYPE /sopromet/zzlrp.            "HS# 9923

  ed_success = abap_false.

  SELECT * INTO TABLE lt_reserv FROM  /sopromet/zzlrv
        WHERE  vkorg    = gs_actual_area-vkorg
        AND    zzlrsam  = gd_case.

  CHECK sy-subrc EQ 0.

  LOOP AT lt_reserv ASSIGNING <res_all> WHERE kzper IS NOT INITIAL. "HS# 9923

    READ TABLE gt_reservations ASSIGNING <res_old>
               WITH KEY lresrv = <res_all>-zzlresn.

    IF sy-subrc IS NOT INITIAL.                             "HS# 9923
*___Neue Reservierung => Anhängen
      ed_success = abap_true.

      lo_res = /sopromet/cl_l_reservation=>create_pending( id_pending     = <res_all>-kzper
                                                           id_reservation = <res_all>-zzlresn ).

      CALL METHOD lo_res->get_reservation_data
        IMPORTING
          e_reservation = ls_res
          e_equipment   = lo_equi.

      ls_equi = lo_equi->exp_equi_data( ).
      APPEND INITIAL LINE TO gt_reservations ASSIGNING <res_new>.

      MOVE-CORRESPONDING ls_res  TO <res_new>.
      MOVE-CORRESPONDING ls_equi TO <res_new>.
      <res_new>-objkey = lo_res.
      <res_new>-lresrv = ls_res-zzlresn.
      <res_new>-lrsam  = gd_case.
*____ "HS# 9923_______________________________________________START_INSERT
    ELSE.

      SELECT * INTO TABLE lt_new FROM  /sopromet/zzlrp
             WHERE  zzlresn  = <res_all>-zzlresn.

      <res_old>-objkey->get_reservation_data( IMPORTING e_reservation_items_ret = lt_old ).

      LOOP AT lt_old ASSIGNING <old> .
        READ TABLE lt_new ASSIGNING <new> WITH KEY zzlresn = <old>-zzlresn
                                                     posnr = <old>-posnr.
        CHECK sy-subrc EQ 0.                                "HS# 9923

        CHECK <old>-menge_wa NE <new>-menge_wa.
*___Geänderte Position
        ed_success = abap_true.
        EXIT.
      ENDLOOP.

      LOOP AT lt_new ASSIGNING <new>.
        READ TABLE lt_old TRANSPORTING NO FIELDS
             WITH KEY zzlresn = <new>-zzlresn
                        posnr = <new>-posnr.
        CHECK sy-subrc NE 0.
*___Neue Position in ZZLRP
        ed_success = abap_true.
        EXIT.
      ENDLOOP.

      CHECK ed_success = abap_true.

*___Änderung ist vorhanden => Neue Instance erzeugen um Daten neu zu laden
      <res_old>-objkey = /sopromet/cl_l_reservation=>create_pending( id_pending     = <res_all>-kzper
                                                                     id_reservation = <res_all>-zzlresn ).

    ENDIF.
*____ "HS# 9923_______________________________________________START_INSERT

  ENDLOOP.


ENDMETHOD.


