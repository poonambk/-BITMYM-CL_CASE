  METHOD ui5_bookings_get_notes.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    DATA: lo_case  TYPE REF TO /bitmym/cl_case,
          ls_comwa TYPE /bitmym/ui5_comwa.

*___Create CASE Object using reservation form UI5 COMWA
    get_property io_ui5 'GS_UI5_COMWA' ls_comwa.

    CHECK ls_comwa-lresn IS NOT INITIAL. "Filled from Keytab

    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_reservation = ls_comwa-lresn ).

    lo_case->ui5_bookings_get_notes_int( IMPORTING es_response_context = es_response_context et_entityset = et_entityset ).
  ENDMETHOD.


  METHOD ui5_bookings_get_notes_int.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    DATA:  ls_header TYPE thead,
           lt_lines  TYPE tline_t,
           ls_stxh   TYPE stxh.

    FIELD-SYMBOLS: <line> TYPE tline,
                   <note> TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_notes.

    CHECK go_texte IS BOUND.

    lt_lines = go_texte->get_ui5_booking_text( ).

    CHECK lt_lines IS NOT INITIAL.

    LOOP AT lt_lines ASSIGNING <line>.
      APPEND INITIAL LINE TO et_entityset ASSIGNING <note>.
      <note>-note1 = <line>-tdline .
    ENDLOOP.


  ENDMETHOD.


  METHOD ui5_bookings_get_partners.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 015081, VON: OPECHARROMAN, DATUM: 22.09.2021___*

    DATA: lo_case  TYPE REF TO /bitmym/cl_case,
          ls_comwa TYPE /bitmym/ui5_comwa.

*___Create CASE Object using reservation form UI5 COMWA
    get_property io_ui5 'GS_UI5_COMWA' ls_comwa.

    CHECK ls_comwa-lresn IS NOT INITIAL
          OR ls_comwa-lrsam IS NOT INITIAL. "Filled from Keytab "HS# 015081 "consider case info too

    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 id_case = ls_comwa-lrsam id_reservation = ls_comwa-lresn ). "HS# 015081 Added case data

    lo_case->ui5_bookings_get_partners_int( IMPORTING es_response_context = es_response_context et_entityset = et_entityset ).
  ENDMETHOD.


  METHOD ui5_bookings_get_partners_int.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    CHECK go_partner IS BOUND.

    go_partner->get_ui5_partners( IMPORTING et_entityset = et_entityset ).

  ENDMETHOD.


  METHOD ui5_prep_booking_partner_exit.
*____HS# 012765, VON: DENDRES, DATUM: 12.09.2019___*
ENHANCEMENT-POINT UI5_PREP_BOOKING_PARTNER01 SPOTS /BITMYM/CL_CASE .

  ENDMETHOD.


  METHOD ui5_booking_items_atp.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 012765, VON: DENDRES, DATUM: 18.03.2020___*
*____HS# 014745, VON: SISMAIL, DATUM: 09.12.2020___*
*____HS# 015031, VON: SSINGH, DATUM: 09.03.2021___*
*____HS# 015080, VON: OPECHARROMAN, DATUM: 10.11.2021___*
*____HS# 015080, VON: SSINGH, DATUM: 23.11.2021___*
*____HS# 017013, VON: SSINGH, DATUM: 27.06.2022___*
*___ SR2-528, User: RJANGA, Date: 27.06.2024___*
*___ SR2-728, User: SCOSAR, Date: 16.08.2024___*

    DATA: lt_materials TYPE /sopromet/zzls07_tab,
          lt_atp_info  TYPE /sopromet/lsatp_alv_tab,
          lt_items     TYPE TABLE OF /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem.


    FIELD-SYMBOLS: <input>  TYPE /sopromet/zzls07_tab,
                   <item>   TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
                   <atpin>  TYPE /sopromet/zzls07,
                   <atpout> TYPE LINE OF /sopromet/lsatp_alv_tab.


    CHECK gd_simulate EQ abap_true.

*-> Begin of SR2-528
    "   Consolidate Quantity based on material number
    LOOP AT ct_items ASSIGNING <item>.
      READ TABLE lt_items ASSIGNING FIELD-SYMBOL(<lfs_item>) WITH KEY matnr    = <item>-matnr
*____SR2-728____BEGIN INSERT___* if item is rejected, should not be consolidated
                                                                      sernr    = <item>-sernr
                                                                      werks    = <item>-werks
                                                                      atpswerk = <item>-atpswerk
                                                                      abgru    = <item>-abgru
                                                                      updated  = <item>-updated.
*____SR2-728____END   INSERT___*
      IF sy-subrc NE 0.
        APPEND INITIAL LINE TO lt_items ASSIGNING <lfs_item>.
        MOVE-CORRESPONDING <item> TO <lfs_item>.
      ELSE.
        ADD <item>-menge TO <lfs_item>-menge.
      ENDIF.
    ENDLOOP.
*-> End Of SR2-528

*  lt_items = ct_items.   "(-)SR2-528


    ui5_single_item_atp_booking( CHANGING ct_items = lt_items ). "HS 15031
    ct_items = lt_items.                                    "HS 15031


*___Fill Material table needed for ATP
    LOOP AT lt_items ASSIGNING <item> WHERE mattyp = /bitmym/cl_assortment=>c_type_set.

      READ TABLE lt_materials ASSIGNING <atpin> WITH KEY matnr = <item>-matnr.
      IF sy-subrc NE 0.
        APPEND INITIAL LINE TO lt_materials ASSIGNING <atpin>.
        MOVE-CORRESPONDING <item> TO <atpin>.
      ELSE.
        ADD <item>-menge TO <atpin>-menge.
      ENDIF.

    ENDLOOP.

    CHECK lt_materials IS NOT INITIAL.

*___Trigger Standard ATP
    /bitmym/cl_bar_chart=>ui5_get_atp_info( EXPORTING io_case          = me
                                                      io_ui5           = go_ui5
                                                      it_atp_materials = lt_materials
                                            IMPORTING et_atp_info      = lt_atp_info ).


    LOOP AT lt_items ASSIGNING <item> WHERE mattyp = /bitmym/cl_assortment=>c_type_set.

      READ TABLE lt_atp_info ASSIGNING <atpout> WITH KEY matnr = <item>-matnr.

      CHECK sy-subrc EQ 0.                                  "HS# 14745

      <item>-vmeng = <atpout>-vmeng.                        "HS# 01276
      <item>-muvxx = <atpout>-muvxx.                        "HS# 01276

      IF <atpout>-status = '3'.                             "HS# 14745

        <item>-available = abap_true.

      ENDIF.                                                "HS# 14745
      <item>-icon_avail =  <atpout>-status.                 "HS# 15080
*      HS 17013
ENHANCEMENT-POINT UPDATE_AVAIL SPOTS /BITMYM/CL_CASE .
    ENDLOOP.

    ct_items = lt_items.


  ENDMETHOD.


  METHOD ui5_booking_result.
*____HS# 012010, VON: MKnauer,   DATUM: 12.10.2017___*
*____HS# 012387, VON: RBoyapati, DATUM: 30.04.2018___*
*____HS# 012765, VON: DENDRES, DATUM: 10.09.2019___*
*____HS# 015080, VON: OPECHARROMAN, DATUM: 08.10.2021___*


    DATA: ls_data TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.

    CHECK /bitmym/if_ui5~go_ui5_runtime IS BOUND.           "HS 12387

    ls_data = is_data_ui5.

    ls_data-zzlresn                = gs_comwa-zzlresn.

    IF gd_simulate EQ abap_true.
      MOVE-CORRESPONDING gs_comwa TO ls_data.               "HS 12765
      ls_data-bookingtobookingitem = is_data_ui5-bookingtobookingitem.
*     convert dates from comwa to front end format if required.
      /bitmym/cl_ui5_util=>convert_dates_to_times( CHANGING cs_data = ls_data ). "HS# 015080
    ENDIF.

    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data
                                                      CHANGING cr_data = es_data ).

  ENDMETHOD.


  METHOD ui5_booking_st_overview_int.
*____HS# 012765, VON: SSingh, DATUM: 05.12.2018___*

    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          ls_rserv    TYPE /sopromet/zzlrv,
          ld_query    TYPE string,                          "HS# 012765
          lt_reserv   TYPE /sopromet/ty_tree_map_tab.
    DATA: lt_colors    TYPE TABLE OF /bitmym/stcol.         "HS# 012765
    FIELD-SYMBOLS:  <tj30>      TYPE v_tj30.

    DATA: lt_tj30 TYPE TABLE OF v_tj30,
          l_stsma TYPE j_stsma.
    FIELD-SYMBOLS: <color> TYPE /bitmym/stcol."HS# 012765.
    FIELD-SYMBOLS: <bookings>      TYPE /bitmym/bookings,
                   <bookingst_ui5> TYPE LINE OF /bitmym/cl_srep_srv_vr_mpc=>tt_bookingstoverview,
                   <res>           TYPE /sopromet/ty_tree_map.
    SELECT * INTO TABLE lt_colors FROM /bitmym/stcol        "HS# 012765
            WHERE stsma EQ /sopromet/cl_l_reservation=>c_status_schema_book. "HS# 012765
    ld_query = /bitmym/if_ui5~go_user->get_parvw_query_string( ). "HS# 12765
    TRY.
        SELECT DISTINCT lresn txt04
               INTO CORRESPONDING FIELDS OF TABLE lt_bookings FROM  /bitmym/bookings
               WHERE  vkorg  = gs_actual_area-vkorg
               AND    vtweg  = gs_actual_area-vtweg
               AND    spart  = gs_actual_area-spart
               AND    (/bitmym/if_ui5~gv_filter_string)
               AND    (ld_query)                            "HS# 12765
        ORDER BY lresn.

      CATCH cx_root INTO lo_ex.
    ENDTRY.

    CHECK lt_bookings IS NOT INITIAL.

    DELETE ADJACENT DUPLICATES FROM lt_bookings COMPARING lresn.

    l_stsma       = /sopromet/cl_l_reservation=>get_status_schema( i_rscat = /sopromet/cl_l_reservation=>c_rscat_b ).

    CALL FUNCTION 'BSV_GET_STATUS_PROFILE'
      EXPORTING
        client   = sy-mandt
        language = sy-langu
        stsma    = l_stsma
      TABLES
        status   = lt_tj30.

    LOOP AT lt_bookings ASSIGNING <bookings> WHERE lresn IS NOT INITIAL.
      lo_case = /bitmym/cl_case=>create( id_reservation = <bookings>-lresn ).
      get_property lo_case 'GT_RESERVATIONS' lt_reserv.

      READ TABLE et_entityset ASSIGNING  <bookingst_ui5> WITH KEY txt04 = <bookings>-txt04.
      IF sy-subrc = 0.
        <bookingst_ui5>-count = <bookingst_ui5>-count + 1.
      ELSE.
        APPEND INITIAL LINE TO et_entityset ASSIGNING <bookingst_ui5>.

        MOVE-CORRESPONDING <bookings> TO <bookingst_ui5>.
*      MOVE-CORRESPONDING ls_case    TO <bookings_ui5>.
        <bookingst_ui5>-count = 1.
        READ TABLE lt_tj30 ASSIGNING <tj30> WITH KEY txt04 = <bookings>-txt04.
        CHECK sy-subrc = 0.
        IF lt_reserv IS NOT INITIAL.
          READ TABLE lt_reserv ASSIGNING <res> INDEX 1.
          <bookingst_ui5>-txt30 = <res>-objkey->get_user_status_30( ).
        ELSE.
          <bookingst_ui5>-txt30 = <tj30>-txt30.
        ENDIF.

        READ TABLE lt_colors ASSIGNING <color> WITH KEY estat = <tj30>-estat. "HS# 012765

        IF sy-subrc EQ 0 AND  <color>-color IS NOT INITIAL. "HS# 012765
          <bookingst_ui5>-color = <color>-color.            "HS# 012765
        ELSE.                                               "HS# 012765
*___DEFAULTS if no CONFIG
          CASE <bookingst_ui5>-txt04.
            WHEN '0001'.
              <bookingst_ui5>-color = '#fa8231'.
            WHEN '0002'.
              <bookingst_ui5>-color = '#fed330'.
            WHEN '0003'.
              <bookingst_ui5>-color = '#45aaf2'.
            WHEN '0004'.
              <bookingst_ui5>-color = '#0fb9b1'.
            WHEN '0005'.
              <bookingst_ui5>-color = '#0fb9b1'.
            WHEN '0006'.
              <bookingst_ui5>-color = '#26de81'.
            WHEN '0007'.
              <bookingst_ui5>-color = '#eb3b5a'.
            WHEN OTHERS.
              <bookingst_ui5>-color = '#fa8231'.
          ENDCASE.

*  End Todo
        ENDIF.
      ENDIF.

    ENDLOOP.

*    delete et_entityset where txt30 is INITIAL.

  ENDMETHOD.


  METHOD UI5_KUNNR_ST_OVERVIEW.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

    lo_case->ui5_kunnr_st_overview_int( IMPORTING es_response_context = es_response_context et_entityset = et_entityset ).
  ENDMETHOD.


  method UI5_CASE_ADD_RESERVATIONS.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*
*____HS# 015862, VON: SISMAIL, DATUM: 16.09.2021___*

    DATA: lds_init_mat_book TYPE /sopromet/zzls06_tab,
          lt_map            TYPE /sopromet/ty_tree_map_tab,
          ls_res            type /sopromet/zzlrv,
          lo_reservation    type ref to /sopromet/cl_l_reservation.

    FIELD-SYMBOLS: <node> like line of lt_map,
                   <res_out> like line of ct_reservations.

*___Loop over created Reservations and add to output structure
      go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).

      LOOP at lt_map ASSIGNING <node>.
        if <node>-objkey is bound.
          APPEND INITIAL LINE TO ct_reservations ASSIGNING <res_out>.
          lo_reservation = <node>-objkey.
          lo_reservation->get_reservation_data(
            IMPORTING
              e_reservation = ls_res ).
          MOVE-CORRESPONDING ls_res to <res_out>.
          <res_out>-ref_book = gs_comwa-ref_book.   "HS# 015862+
          <res_out>-zzlresn = <node>-lresrv.
        endif.
      endloop.

  endmethod.


  METHOD ui5_case_result.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*
*____HS# 016491, VON: OPECHARROMAN, DATUM: 09.02.2022___*

    DATA: ls_data TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep.

    ls_data = is_data_ui5.
    ls_data-zzlrsam              = gs_comwa-zzlrsam.

    ui5_case_add_reservations( CHANGING ct_reservations = ls_data-casetoreservation ).


    CHECK /bitmym/if_ui5~go_ui5_runtime IS NOT INITIAL.     "HS# 016491
    /bitmym/if_ui5~go_ui5_runtime->copy_data_to_ref( EXPORTING is_data = ls_data
                                                      CHANGING cr_data = es_data ).

  ENDMETHOD.


  METHOD ui5_case_save_text.
*____HS# 012209, VON: DEndres, DATUM: 29.01.2018___*

    DATA: ls_header TYPE thead.

    CHECK i_header IS NOT INITIAL AND it_lines IS NOT INITIAL.
    ls_header = i_header.
    ls_header-tdspras  = sy-langu.

    CONCATENATE gs_comwa-vkorg gs_comwa-zzlrsam INTO ls_header-tdname.

    CALL FUNCTION 'SAVE_TEXT'
      EXPORTING
        header = ls_header
      TABLES
        lines  = it_lines.

    set_property go_texte 'GD_CHANGE_FLAG' abap_true.
  ENDMETHOD.


  METHOD ui5_create_booking.
*____HS# 015080, VON: SISMAIL, DATUM: 29.03.2021 ___*

    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_create_booking_int( IMPORTING es_data = es_data ).


  ENDMETHOD.


  METHOD ui5_create_booking_int.
*____HS# 012010, VON: MKnauer,   DATUM: 12.10.2017___*
*____HS# 12387, VON: RBOYAPATI,  DATUM: 24.05.2018___*
*____HS# 12387, VON: DENDRES,    DATUM: 19.07.2018___*
*____HS# 12729, VON: STAORI,     DATUM: 11.10.2018___*
*____HS# 12765, VON: DENDRES,    DATUM: 02.09.2019___*
*____HS# 13576, VON: MKNAUER,    DATUM: 06.12.2019___*
*____HS# 14023, VON: DENDRES,    DATUM: 30.04.2020___*
*____HS# 014038, VON: DENDRES, DATUM: 12.08.2020___*
*____HS# 014879, VON: MKNAUER, DATUM: 03.02.2021___*
*____HS# 015080, VON: SISMAIL, DATUM: 01.06.2021___*
*____HS# 015186, VON: SSINGH, DATUM: 19.04.2021___*
*____HS# 015455, VON: SSINGH, DATUM: 14.06.2021___*
*____HS# 015884, VON: OPECHARROMAN, DATUM: 26.08.2021___*
*____HS# 016177, VON: SSINGH, DATUM: 19.11.2021___*
*____HS# 016239, VON: SSINGH, DATUM: 03.12.2021___*
*___ SR2-2053, User: SBADUSHA, Date: 10.09.2025___*


    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_booking_deep.

    DATA: ls_zzlrv       TYPE /sopromet/zzlrv,
          lt_items       TYPE TABLE OF  /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
          lt_notes       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>tt_notes,
          ls_comwa_appl  TYPE /sopromet/zzls01,
          ls_date_data   TYPE /bitmym/case_common_date,
          ls_copy_fields TYPE /bitmym/ic_book_create_fields, "HS# 015884
          ld_check       TYPE abap_bool.                    "HS 12729

*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

*____HS# 014879_____START_INSERT
*____HS# 014879_____END_INSERT

    gd_simulate = ls_data_ui5-simulation.



    MOVE-CORRESPONDING ls_data_ui5 TO ls_zzlrv.

    lt_items = ls_data_ui5-bookingtobookingitem.
    lt_notes = ls_data_ui5-bookingtonotes.


*___Step 2: Fill CASE COMWA + APPL COMWA
    get_property go_appl 'GS_COMWA' ls_comwa_appl .

    gs_comwa-rscat   = /sopromet/cl_l_reservation=>c_rscat_b.
    gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.

*___START OF HS# 015884
*   add new fields to be passed from the input structure and
*   change so we use structure /BITMYM/IC_BOOK_CREATE_FIELDS
*   to define the relevant fields to be copied
*   Commented -->
*    gs_comwa-kunnr = ls_zzlrv-kunnr.
*    gs_comwa-rstyp = ls_zzlrv-rstyp.
*    gs_comwa-vdate = ls_zzlrv-vdate.                        "HS 12765
*    gs_comwa-odate = ls_zzlrv-odate.
*    gs_comwa-vedat = ls_zzlrv-vedat.                        "HS 12387
*    gs_comwa-bstnk = ls_zzlrv-bstnk.
*    gs_comwa-opman = ls_zzlrv-opman.                        "HS 12387
*    gs_comwa-opkra = ls_zzlrv-opkra.                        "HS 12387
*    gs_comwa-optim = ls_zzlrv-optim.                        "HS 12387
*    gs_comwa-vtime = ls_zzlrv-vtime.                        "HS 12387
*    gs_comwa-ref_book   = ls_zzlrv-ref_book.                     "HS 15186
*    gs_comwa-xfollowup  = ls_zzlrv-xfollowup.                    "HS 15186
*    gs_comwa-numwp = ls_data_ui5-numwp.                     "HS# 13576
*    gs_comwa-numex = ls_data_ui5-numex.                     "HS# 13576
*    gs_comwa-edatu = ls_data_ui5-edatu.                     "HS# 13576
*    gs_comwa-draft = ls_data_ui5-draft.                     "HS# 14023
*    gs_comwa-estvalue = ls_data_ui5-estvalue.               "HS# 14038
*    gs_comwa-waers = ls_data_ui5-waers.                     "HS# 14038
*    gs_comwa-sutyp      = ls_data_ui5-sutyp.                     "HS# 15455
*
*
**HS# 015080+
*    gs_comwa-inco1 = ls_zzlrv-inco1.
*    gs_comwa-inco2 = ls_zzlrv-inco2.
*    gs_comwa-telf1 = ls_zzlrv-telf1.
*    gs_comwa-ihrez = ls_zzlrv-ihrez.
*    gs_comwa-abdat = ls_data_ui5-abdat.
**HS# 015080+
* <--  Commented
    MOVE-CORRESPONDING ls_data_ui5 TO ls_copy_fields.
    ls_copy_fields-vkbur = gs_comwa-vkbur.                  "SR2-2053.
    MOVE-CORRESPONDING ls_copy_fields TO gs_comwa.
*___END OF HS# 015884
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application


*___Step 3: Partner determination
    CHECK ui5_prep_booking_partner( ) EQ abap_true.


*___Step 4: Date calculation
    compute_dates( CHANGING cs_comwa = gs_comwa ).
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 5: Add booking items
*    CHECK ui5_prep_booking_items( CHANGING ct_items = ls_data_ui5-bookingtobookingitem ) EQ abap_true. "HS 12729
    ui5_prep_booking_items( IMPORTING ed_success = ld_check CHANGING ct_items = ls_data_ui5-bookingtobookingitem ). "HS 12729

*___Step 6: Init sequence for a new case
    create_new_case( ).

*___Step 7: Build Tree
*    ui5_prep_reservation_tree( ).                                                           "HS 12387
    ui5_prep_reservation_tree( i_add_res = abap_true is_data = ls_zzlrv ). "HS 12387

*___Step 8: Prepare Text
    ui5_prep_booking_notes( it_notes = lt_notes ).

*___Step - Fill contract details for booking
    rental_get_contract_book( ).                            "HS 12469

*___Step 9: Post Booking (Simulation considered)
    CHECK ui5_post_booking( ) EQ abap_true.

    ui5_trigger_outlook_notif( ).                           "HS 16239
*   update the followup booking                             "HS 15186
    ui5_update_followup_booking( ).                         "HS 15186

*___Step 10: Fill Return Daten
    ui5_booking_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).

  ENDMETHOD.


  METHOD UI5_CREATE_CASE.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*

    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_create_case_int( IMPORTING es_data = es_data ).

  ENDMETHOD.


  METHOD ui5_create_case_int.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*
*____HS# 014145, VON: RBoyapati, DATUM: 08.06.2020___*
*____HS# 015081, VON: OPECHARROMAN, DATUM: 09.09.2021___*

    DATA: lo_data_provider TYPE REF TO /iwbep/if_mgw_entry_provider,
          ls_data_ui5      TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case_deep.

    DATA: ls_case       TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_case,
          ls_comwa_appl TYPE /sopromet/zzls01.

*___Step 1: Get ODATA Context from data provider object
    get_property go_ui5 'GO_DATA_PROVIDER' lo_data_provider.

    CHECK lo_data_provider IS BOUND.

    lo_data_provider->read_entry_data( IMPORTING es_data = ls_data_ui5 ).

    MOVE-CORRESPONDING ls_data_ui5 TO ls_case.

*___Step 2: Fill CASE COMWA + APPL COMWA
    get_property go_appl 'GS_COMWA' ls_comwa_appl .

    gs_comwa-trtyp_o = ls_comwa_appl-trtyp_o.

    gs_comwa-kunnr = ls_case-kunnr.
    gs_comwa-rstyp = ls_case-rstyp.
    gs_comwa-odate = ls_case-odate.
    gs_comwa-bstnk = ls_case-bstnk.

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 3: Partner determination
    CHECK ui5_prep_case_partner( it_partners = ls_data_ui5-casetopartner ) EQ abap_true.

*___Step 4: Date calculation
    compute_dates( CHANGING cs_comwa = gs_comwa ).
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

*___Step 5: Add Equipment Selection
    CHECK ui5_prep_equi_sel( it_matsel = ls_data_ui5-casetomaterialselection ) EQ abap_true.

*___Step 6: Overwrite determined Shipping Information
    ui5_overwrite_values( i_case = ls_case ).

*___Step 7: Init sequence for a new case
*    create_new_case( ).                                 "HS 14145
    create_new_case( id_no_atp = abap_true ).               "HS 14145

*___Step 8: Build Tree
    ui5_prep_reservation_tree( ).

*___Step 9: Prepare Single Items
    ui5_prep_single_items( CHANGING ct_items   = ls_data_ui5-casetosingleitem ).

*___Step 10: Prepare Text
*   Old text method saves without calling texts routines.
*   We replace it with the existing text interface that is already used for bookings
*    ui5_prep_case_notes( it_notes = ls_data_ui5-casetonotes ). "HS 015081
    ui5_prep_booking_notes( it_notes = ls_data_ui5-casetonotes ). "HS 015081

*___Step 11: Post Reservation
    CHECK ui5_post_case( ) EQ abap_true.

*___Step 12: Fill Return Data
    ui5_case_result( EXPORTING is_data_ui5 = ls_data_ui5 IMPORTING es_data = es_data ).

  ENDMETHOD.


  method AUTO_REFILL.
*____HS# 13961, VON: R.Boyapati,    DATUM: 24.03.2020 ___*

    CHECK go_act_reservation IS BOUND.

    go_act_reservation->auto_refill( i_push = i_push ).


  endmethod.


  METHOD dequeue.
*____HS# 012900, VON: RBOYAPATI, DATUM: 27.02.2019___*

*-- Exclusive Lock: To unlock any exclusive locks (usually set by /BITMYM/CL_CASE->MAINTAIN_EXISTING_CASE)

    CALL FUNCTION 'DEQUEUE_/BITMYM/ECASE'
      EXPORTING
        vkorg   = gs_comwa-vkorg
        zzlrsam = gs_comwa-zzlrsam.

  ENDMETHOD.


  METHOD upload_booking_item_from_excel.
*____HS# 015324, VON: PKUNAL, DATUM: 04.05.2021___*
*___ SR2-483, User: SBADUSHA, Date: 19.06.2024___*

    DATA: lv_filename  TYPE localfile,
          lv_index     TYPE int4,
          ls_book_item TYPE /bitmym/b_items_st,
          lt_data      TYPE /bitmym/book_item_excel_temp_t,
          ls_data      TYPE /bitmym/book_item_excel_temp,
          lo_excel     TYPE REF TO /bitmym/cl_excel.


    lv_filename = /bitmym/cl_excel=>read_upload_filename( ).
    CHECK lv_filename IS NOT INITIAL.

*   Create excel objcet with the same application object created for the lxe class
    lo_excel = /bitmym/cl_excel=>create( i_file = lv_filename i_est = '/BITMYM/BOOK_ITEM_EXCEL_TEMP' ).

    lo_excel->excel_to_table( CHANGING ct_tab = lt_data ).
    CHECK lt_data IS NOT INITIAL.
*____SR2-483____BEGIN COMMENT___*
*    IF c_item_tab IS INITIAL.
*      CLEAR lv_index.
*    ELSE.
*      DESCRIBE TABLE c_item_tab LINES lv_index.
*      lv_index = lv_index + 1.
*    ENDIF.
*____SR2-483____END   COMMENT___*
    LOOP AT lt_data INTO ls_data.
      MOVE-CORRESPONDING ls_data TO ls_book_item.
      APPEND ls_book_item TO c_item_tab.
    ENDLOOP.

    booking_item_modify_itab( EXPORTING i_index     = lv_index     i_item_wa   = i_item_wa
                              CHANGING  c_items_tab = c_item_tab  c_control   = c_control ).

  ENDMETHOD.


  METHOD ui5_kunnr_st_overview_int.
*____HS# 012765, VON: SSingh, DATUM: 05.12.2018___*

    DATA: lt_bookings TYPE STANDARD TABLE OF /bitmym/bookings,
          lo_ex       TYPE REF TO cx_root,
          lo_case     TYPE REF TO /bitmym/cl_case,
          ls_case     TYPE /bitmym/case,
          ls_vbadr_ag TYPE vbadr,
          ls_vbadr_xx TYPE vbadr,
          ls_rserv    TYPE /sopromet/zzlrv,
          ld_query    TYPE string,                          "HS# 012765
          lt_reserv   TYPE /sopromet/ty_tree_map_tab.
    FIELD-SYMBOLS:  <tj30>      TYPE v_tj30.

    DATA: lt_tj30 TYPE TABLE OF v_tj30,
          l_stsma TYPE j_stsma.
    FIELD-SYMBOLS: <bookings>   TYPE /bitmym/bookings,
                   <custst_ui5> TYPE LINE OF /bitmym/cl_srep_srv_vr_mpc=>tt_customerstoverview,
                   <res>        TYPE /sopromet/ty_tree_map.
    ld_query = /bitmym/if_ui5~go_user->get_parvw_query_string( ). "HS# 12765
    TRY.
        SELECT DISTINCT lresn
               INTO CORRESPONDING FIELDS OF TABLE lt_bookings FROM  /bitmym/bookings
               WHERE  vkorg  = gs_actual_area-vkorg
               AND    vtweg  = gs_actual_area-vtweg
               AND    spart  = gs_actual_area-spart
               AND    (/bitmym/if_ui5~gv_filter_string)
               AND    (ld_query)                            "HS# 12765
        ORDER BY lresn.

      CATCH cx_root INTO lo_ex.
    ENDTRY.

    CHECK lt_bookings IS NOT INITIAL.

    DELETE ADJACENT DUPLICATES FROM lt_bookings COMPARING lresn.

    LOOP AT lt_bookings ASSIGNING <bookings> WHERE lresn IS NOT INITIAL.
      lo_case = /bitmym/cl_case=>create( id_reservation = <bookings>-lresn ).
      get_property lo_case 'GS_CASE'         ls_case.
      CLEAR ls_vbadr_ag.
      /bitmym/cl_partner=>read_address_partner_info_ext(
        EXPORTING
          id_vkorg = ls_case-vkorg
          id_case  = ls_case-zzlrsam
          id_parvw = 'AG'
         CHANGING
           cs_vbadr = ls_vbadr_ag ).
      READ TABLE et_entityset ASSIGNING  <custst_ui5> WITH KEY name1 = ls_vbadr_ag-name1.
      IF sy-subrc = 0.
        <custst_ui5>-count = <custst_ui5>-count + 1.
      ELSE.
        APPEND INITIAL LINE TO et_entityset ASSIGNING <custst_ui5>.
        <custst_ui5>-name1 = ls_vbadr_ag-name1.
        <custst_ui5>-count = 1.
      ENDIF.

    ENDLOOP.

    SORT et_entityset BY count DESCENDING.
    DELETE et_entityset FROM 6.

*    delete et_entityset where txt30 is INITIAL.

  ENDMETHOD.


  method WE_REFRESH.
*____HS# 013188, VON: RBOYAPATI, DATUM: 08.08.2019___*

    FIELD-SYMBOLS: <lfs_change> LIKE LINE OF it_changes.

    IF it_changes IS NOT INITIAL.
      LOOP AT it_changes ASSIGNING <lfs_change>.
        <lfs_change>-objkey->gd_we_init_cat = abap_true.
      ENDLOOP.
    ELSEIF go_act_reservation IS BOUND.
      go_act_reservation->gd_we_init_cat = abap_true.
    ENDIF.

    we_refresh_tree_case( ).
  endmethod.


  METHOD set_case_to_restart.
*____HS# 012732, VON: PKUNAL, DATUM: 19.07.2019___*

    DATA: lv_case TYPE /sopromet/zzlrsam.

*   Check if any reservation exist in the case table
    SELECT SINGLE zzlrsam INTO lv_case FROM /bitmym/case WHERE vkorg = gs_actual_area-vkorg AND zzlrsam = gs_comwa-zzlrsam.
    IF sy-subrc IS NOT INITIAL.
      CLEAR gs_comwa-zzlrsam.
    ENDIF.

    go_appl->set_property( i_feld = 'GS_RESTART_INFO-ZZLRSAM' i_value = gs_comwa-zzlrsam ).

  ENDMETHOD.


  METHOD ui5_overwrite_values.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*

    DATA: ls_case TYPE /bitmym/case.

    MOVE-CORRESPONDING i_case TO ls_case.
    get_property go_appl 'GS_COMWA' gs_comwa.

    IF ls_case-vsbeb IS NOT INITIAL.
      gs_case-vsbeb = ls_case-vsbeb.
      gs_comwa-vsbeb = ls_case-vsbeb.
    ENDIF.

    IF ls_case-inco1 IS NOT INITIAL.
      gs_comwa-inco1 = ls_case-inco1.
      gs_comwa-inco2 = ls_case-inco2.
    ENDIF.

    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

  ENDMETHOD.


  METHOD ui5_post_booking.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    ed_success = abap_false.

    MOVE-CORRESPONDING gs_comwa TO gs_case.   "Fill CASE Structure
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    CHECK case_save_final_check( ) EQ abap_true.

    IF gd_simulate EQ abap_false.
      messaging( ).
      case_save_all( ).
    ENDIF.

    ed_success = abap_true.

  ENDMETHOD.


  METHOD UI5_POST_CASE.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*

    ed_success = abap_false.

    MOVE-CORRESPONDING gs_comwa TO gs_case.   "Fill CASE Structure
    set_property go_appl 'GS_COMWA' gs_comwa. "Synchronize back to application

    CHECK case_save_final_check( ) EQ abap_true.

    IF gd_simulate EQ abap_false.
      messaging( ).
      case_save_all( ).
    ENDIF.

    ed_success = abap_true.

  ENDMETHOD.


  METHOD ui5_prep_booking_items.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 016200, VON: SSINGH, DATUM: 26.01.2022___*
*____HS# 016859, VON: GIVANOV, DATUM: 13.07.2022___*
*____HS# 0171745, VON: OPECHARROMAN, DATUM: 12.08.2022___*"SR1-805
*___ SR1-1350, User: OPECHARROMAN, Date: 20.06.2023___*
*___ SR1-22, User: SSAHU, Date: 08.12.2023___*
*___ SR2-693, User: SSINGH, Date: 25.07.2024___*
*___ SR2-723, User: SCOSAR, Date: 23.09.2024___*
*___ SR2-970, User: SCOSAR, Date: 11.10.2024___*

    DATA: lt_items      TYPE TABLE OF /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
          lt_b_items    TYPE /bitmym/b_items_st_tab,
          lc_control    TYPE cxtab_control,
          ls_wa         TYPE /bitmym/b_items_st,
          ls_global     TYPE /sopromet/l00,                 "HS 16200
          ls_rstype     TYPE /sopromet/rstype,              "HS 16200
          l_reservation TYPE /sopromet/zzlrv,               "HS 16200
          ld_line       TYPE cxtab_control-current_line.


    FIELD-SYMBOLS: <item>  TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem,
                   <bitem> TYPE LINE OF /bitmym/b_items_st_tab.


    lt_items = ct_items.

    CREATE OBJECT go_act_reservation.
    MOVE-CORRESPONDING gs_comwa TO l_reservation.           "HS# 016859
    set_property go_act_reservation 'G_RESERVATION' l_reservation. "HS# 016859
*____SR2-693____BEGIN INSERT___*
    CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'
      EXPORTING
        i_rstyp = gs_comwa-rstyp
      IMPORTING
        e_data  = ls_rstype.
    ls_global = /sopromet/cl_l_global=>get_prop_global( ).
*____SR2-693____END   INSERT___*

    prepare_followup_items( CHANGING ct_items = lt_items ). "SR2-970

    LOOP AT lt_items ASSIGNING <item>.

      ADD 1 TO ld_line.
      lc_control-current_line = ld_line.

      MOVE-CORRESPONDING <item> TO ls_wa.

* HS# 017174 ->"SR1-805
* Mobile app performances is compromised when using a significan number of records in the booking
* In some scenarios with large number of items it was taking more than 30 seconds
* For mobile app we simplify the way we get the material and position info to be able to have a reliable performance
      IF /bitmym/if_ui5~g_mobile_call = abap_true.
        go_act_reservation->ui5_booking_item_modify_itab( CHANGING cs_item_wa   = <item> ).
      ELSE.
* HS# 017175 <-"SR1-805
*___Call standard method of GUI processing
        go_act_reservation->booking_item_modify_itab(
          EXPORTING
            i_index     = ld_line
            i_item_wa   = ls_wa
          CHANGING
            c_items_tab = lt_b_items
            c_control   = lc_control ).


        READ TABLE lt_b_items ASSIGNING <bitem> WITH KEY matnr = ls_wa-matnr.
        CHECK sy-subrc EQ 0.
        <item>-idnlf = <bitem>-idnlf.                       "INS SR1-22
        <item>-maktx = <bitem>-maktx.
        <item>-meins = <bitem>-meins.                       "HS# 016859
      ENDIF.                                                "HS# 017174 "SR1-805

*      begin of Changes HS 16200
*      IF <item>-mattyp = /bitmym/cl_assortment=>c_type_set. "HS 16200 "SR2-693 DEL
      IF <item>-mattyp = /bitmym/cl_assortment=>c_type_set AND ls_rstype-rstyp_fld IS NOT INITIAL. "SR2-693

*____SR2-693____BEGIN COMMENT___*
*
**       Serial number is relevant for all reservation types, not only field inventory. There is no need to read it from MARC as it is based on global value SR1-1350
**        CALL FUNCTION '/SOPROMET/RSTYPE_SINGLE_READ'  "SR1-1350 comment
**          EXPORTING
**            i_rstyp = gs_comwa-rstyp
**          IMPORTING
**            e_data  = ls_rstype.
*
**        CHECK ls_rstype-rstyp_fld IS NOT INITIAL.           "SR1-1350 comment
*        ls_global = /sopromet/cl_l_global=>get_prop_global( ). "HS 16200
**        SELECT SINGLE sernp FROM marc INTO (<item>-serail) WHERE matnr = ls_wa-matnr AND sernp = ls_global-serail. "HS 16200 "SR1-1350 comment
*        <item>-serail = ls_global-serail.                   "SR1-1350
*____SR2-693____END   COMMENT___*

        SELECT SINGLE sernp FROM marc INTO (<item>-serail) WHERE matnr = ls_wa-matnr AND sernp = ls_global-serail. "SR2-693
      ENDIF.                                                "HS 16200
*      end of changes HS 16200
    ENDLOOP.

    consolidate_bitems( CHANGING c_items_tab = lt_items ). "SR2-723

    ct_items = lt_items.

    ed_success = abap_true.

*___Execute ATP of booking items
    ui5_booking_items_atp( CHANGING ct_items = ct_items ).

  ENDMETHOD.


  METHOD ui5_prep_booking_notes.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*
*____HS# 012783, VON: OPECHARROMAN, DATUM: 13.11.2018___*

* Init HS# 012783 Comment ->
*    DATA:  ls_header TYPE thead,
*           lt_lines  TYPE tline_t.
*
*    FIELD-SYMBOLS: <line> TYPE tline,
*                   <note> TYPE /bitmym/cl_srep_srv_vr_mpc_ext=>ts_notes.
*
*    CHECK go_texte IS BOUND.
*    CHECK it_notes IS NOT INITIAL.
*
**___Text Header
*    ls_header-tdobject = /bitmym/cl_texte=>c_tdobject_mymediset.
*    CONCATENATE gs_comwa-vkorg gs_comwa-zzlrsam INTO ls_header-tdname.
*    ls_header-tdspras  = sy-langu.
*    get_property go_texte 'GD_TDID_ICONNECT' ls_header-tdid .
*
**___Text Lines
*    LOOP AT it_notes ASSIGNING <note>.
*      APPEND INITIAL LINE TO lt_lines ASSIGNING <line>.
*      <line>-tdformat = '*'.
*      <line>-tdline   = <note>-note1.
*    ENDLOOP.
*
*    CALL FUNCTION 'SAVE_TEXT'
*      EXPORTING
*        header = ls_header
*      TABLES
*        lines  = lt_lines.
*
*    set_property go_texte 'GD_CHANGE_FLAG' abap_true.
* Init HS# 012783 <--Comment

* Init HS# 012783
* We add the possibility to take over other text ids.
* We change so the text is saved with satandard mym method to save text at save_all

* In case the tdid comes empty we default the iconnect text id so we keep the default functionality
* In case it comes with value, we save the text in that text id

* PUt and start sd text object data
  go_texte->put_data_header( ).

* Get tdid info from notes table
  go_texte->get_tdid_from_notes( EXPORTING it_notes = it_notes ).

* Set sd texts from notes table
  go_texte->set_sd_text_from_notes( ).
* End HS# 012783

ENDMETHOD.


  METHOD ui5_prep_booking_partner.
*____HS# 12010, VON: MKnauer, DATUM: 13.10.2017 ___*
*____HS# 12765, VON: MKNAUER, DATUM: 04.06.2019___*
*____HS# 014889, VON: SISMAIL, DATUM: 16.02.2021___*
*____HS# 015080, VON: SISMAIL, DATUM: 02.07.2021___*
*____HS# 015080, VON: OPECHARROMAN, DATUM: 13.10.2021___*
*____HS# 015884, VON: OPECHARROMAN, DATUM: 26.08.2021___*
*____HS# 016976, VON: BGUNAWAN, DATUM: 16.06.2022___*
*___ SR1-2098, User: MTOMITA, Date: 11.01.2024___*
*___ SR2-2678, User: RJANGA, Date: 08.01.2026___*


    DATA: ls_partner_fields TYPE /bitmym/ic_partner_fields. "HS# 015884

    MOVE-CORRESPONDING gs_comwa TO ls_partner_fields.       "HS# 015884

* Begin of SR1-2098
    prepare_booking_ship_to( EXPORTING it_ui5_vbpa = it_ui5_vbpa
                                       it_partner  = gt_partner
                              CHANGING co_partner  = go_partner
                                       cs_comwa    = gs_comwa ).
* End of SR1-2098

*   If we are calling with a case number, partner is initialized in the case constructor.
*   Partner selection not required
    IF gs_case-zzlrsam IS INITIAL.                          "HS 015080
      ed_success = partner_selection( id_no_dialog = abap_true ).

      CHECK ed_success = abap_true.
    ENDIF.                                                  "HS 015080

    ed_success = abap_true.                                 "HS 015080

    partner_put_data( ).
*    partner_get_data( ).  "HS# 014889-
    IF id_no_add_srep IS INITIAL.
      go_partner->ui5_add_sales_rep_partner( ). "HS# 015080+
    ENDIF.

*    go_partner->ui5_set_booking_partner( ).                 "HS 12765   "SR2-2678
    ed_success = go_partner->ui5_set_booking_partner( ).                 "SR2-2678
    CHECK ed_success = abap_true.                                        "SR2-2678

    go_partner->ui5_address_check_and_change( ).            "HS# 016976

    partner_get_data( ).  "SR1-2098+

*___START OF  "HS# 015884
*   The partner selection defaults some fields from the kunnr partner.
*   In case the odata service passes these values, we replace back these values with the ones set in the odata service
    IF ls_partner_fields IS NOT INITIAL.
      MOVE-CORRESPONDING ls_partner_fields TO gs_comwa.
    ENDIF.

*    go_partner->ui5_add_sales_rep_partner( ). "HS# 015080-
*    partner_get_data( ).  "HS# 014889+ "SR1-2098-

    ui5_prep_booking_partner_exit( ).                       "HS 12765

  ENDMETHOD.


  METHOD doc_hier_disp.
*____HS# 013597, VON: PKUNAL, DATUM: 06.11.2019___*

    CHECK go_appl IS BOUND.
    CALL FUNCTION '/BITMYM/DISP_DOC_HIERARCHY'
      EXPORTING
        io_appl = go_appl.

  ENDMETHOD.


  METHOD ui5_prep_case_notes.
*____HS# 012209, VON: DEndres, DATUM: 29.01.2018___*
*____HS# 015081, VON: OPECHARROMAN, DATUM: 09.09.2021___*

*** OBSOLETE Call instead ui5_prep_booking_notes( it_notes = lt_notes ).


    DATA:  ls_header     TYPE thead,
           lt_lines      TYPE tline_t,
           lt_lines_in   TYPE stringtab,
           lt_cast_notes TYPE TABLE OF /bitmym/ic_srep_note_st. "/bitmym/api_tline_tt.

    FIELD-SYMBOLS: <line>     TYPE tline,
                   <castnote> TYPE /bitmym/ic_srep_note_st, "api_tline,
                   <line_in>  TYPE string,
                   <note>     TYPE any.

    CHECK go_texte IS BOUND.

*___Step 1: Prepare and cast inputdata
    LOOP AT it_notes ASSIGNING <note>.
      APPEND INITIAL LINE TO lt_cast_notes ASSIGNING <castnote>.
      MOVE-CORRESPONDING <note> TO <castnote>.
**      IF <castnote>-tdid IS INITIAL.                                    " Read Customizing or remove
**        get_property go_texte 'GD_TDID_ICONNECT' <castnote>-tdid .
**      ENDIF.
*      IF <castnote>-tdobject IS INITIAL.
*        get_property go_texte 'C_TDOBJECT_MYMEDISET' <castnote>-tdobject.
*      ENDIF.
    ENDLOOP.

    CHECK lt_cast_notes IS NOT INITIAL.
    SORT lt_cast_notes BY tdid.

*___Step 2: Split UI5 String into Header and seperated lines Table
    LOOP AT lt_cast_notes ASSIGNING <castnote>.
      AT NEW tdid.
        IF lt_lines IS NOT INITIAL.
          me->ui5_case_save_text( it_lines = lt_lines i_header = ls_header ).
          CLEAR: lt_lines, ls_header.
        ENDIF.
      ENDAT.
      SPLIT <castnote>-note1 AT cl_abap_char_utilities=>newline INTO TABLE lt_lines_in.
      LOOP AT lt_lines_in ASSIGNING <line_in>.
        APPEND INITIAL LINE TO lt_lines ASSIGNING <line>.
        <line>-tdformat = '*'.
        <line>-tdline = <line_in>.
      ENDLOOP.
      ls_header-tdid = <castnote>-tdid.
      ls_header-tdobject = <castnote>-tdobject.
    ENDLOOP.

    me->ui5_case_save_text( it_lines = lt_lines i_header = ls_header ).

  ENDMETHOD.


  METHOD ui5_prep_case_partner.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*

    DATA: ls_vbpa_new TYPE /bitmym/vbpa,
          l_parnr_new TYPE sd_partner_parnr.

    FIELD-SYMBOLS: <partner> TYPE any.

    ed_success = partner_selection( id_no_dialog = abap_true ).

    CHECK ed_success = abap_true.
    partner_put_data( ).
    partner_get_data( ).

    LOOP AT it_partners ASSIGNING <partner>.
      CLEAR ls_vbpa_new.
      MOVE-CORRESPONDING <partner> TO ls_vbpa_new.
      l_parnr_new = ls_vbpa_new-kunnr.

      go_partner->ui5_add_partner(  i_parvw = ls_vbpa_new-parvw
                                    i_partner_new = l_parnr_new
                                    i_overwrite = abap_true ).
    ENDLOOP.

  ENDMETHOD.


  METHOD ui5_prep_equi_sel.
*____HS# 012209, VON: D.Endres, DATUM: 16.01.2018___*
*___ SR1-2079, User: SCOSAR, Date: 04.01.2024___*
*___ SR2-2059, User: RJANGA, Date: 21.07.2025___*
*___ SR2-3139, User: OOGUR,  Date: 21.04.2026___*


    FIELD-SYMBOLS: <matsel_in> TYPE any,
                   <matsel>    TYPE /sopromet/zzls06.
    DATA:          ld_si_equnr TYPE equnr.                  "SR2-2059

*____SR2-2059____BEGIN INSERT___*
    CALL FUNCTION '/SOPROMET/SINGLE_GET_EQUNR'
      EXPORTING
        i_vkorg = gs_actual_area-vkorg
        i_vtweg = gs_actual_area-vtweg
        i_spart = gs_actual_area-spart
      IMPORTING
        e_equnr = ld_si_equnr.
*____SR2-2059____END   INSERT___*


    LOOP AT it_matsel ASSIGNING <matsel_in>.

*____SR2-2059____BEGIN INSERT___*
      ASSIGN COMPONENT /sopromet/cl_l_equipment=>c_equnr OF STRUCTURE <matsel_in> TO FIELD-SYMBOL(<lfs_equnr>).
      IF <lfs_equnr> IS ASSIGNED
        AND /bitmym/cl_migration=>gv_migration = abap_false."SR2-3139
        CHECK <lfs_equnr> NE ld_si_equnr.
      ENDIF.
*____SR2-2059____END   INSERT___*

      APPEND INITIAL LINE TO gt_mat_selection ASSIGNING <matsel>.
      MOVE-CORRESPONDING <matsel_in> TO <matsel>.
    ENDLOOP.

*____SR2-2059____BEGIN COMMENT___*
**____SR1-2079____BEGIN INSERT___*
*    SORT gt_mat_selection BY equnr.
*    DELETE ADJACENT DUPLICATES FROM gt_mat_selection COMPARING equnr.
**____SR1-2079____END   INSERT___*
*____SR2-2059____END   COMMENT___*

    CHECK gt_mat_selection IS NOT INITIAL.

    ed_success = abap_true.

  ENDMETHOD.


  METHOD ui5_prep_reservation_tree.
*____HS# 012010, VON: MKnauer,  DATUM: 12.10.2017___*
*____HS# 012209, VON: D.Endres, DATUM: 19.01.2018___*
*____HS# 12387, VON: RBOYAPATI, DATUM: 24.05.2018 ___*
*____HS# 012705, VON: OPECHARROMAN, DATUM: 17.10.2018___*

    DATA: lds_init_mat_book TYPE /sopromet/zzls06_tab,
          lt_map            TYPE /sopromet/ty_tree_map_tab.

    FIELD-SYMBOLS: <map> TYPE /sopromet/ty_tree_map.

*    IF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 012209
    IF i_add_res EQ abap_true.                              "HS# 012387
      APPEND INITIAL LINE TO lds_init_mat_book .
      gt_mat_selection = lds_init_mat_book.
    ENDIF.                                                  "HS# 012209

*   HS 12705 adds dynpro and repid equal to empty so no container is initialiced and it can also be called online.
*   If no dynpro is entered, the method sets value 8000 and the container object is created.
    start_tree_case( i_tree_dynnr = space i_tree_repid = space id_dark = abap_true ). "HS 12705

*___Replace reservation object in tree by go_act_reservation, This holds the items.
*    IF gs_comwa-rscat = /sopromet/cl_l_reservation=>c_rscat_b. "HS# 012209
    IF i_add_res EQ abap_true.                              "HS# 012387

      go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).

      CHECK lt_map IS NOT INITIAL.
      READ TABLE lt_map ASSIGNING <map> INDEX 1.
      <map>-objkey = go_act_reservation.

      go_tree_case->set_property( i_feld = 'GT_NODE_MAP'  i_value = lt_map ).

      <map>-objkey->set_property( i_feld = 'ASMNT' i_value = is_data-asmnt ). "HS# 012387

    ENDIF.                                                  "HS# 012209

  ENDMETHOD.


  METHOD ui5_prep_single_items.
*____HS# 012209, VON: D.Endres, DATUM: 26.01.2018___*
*____HS# 013195, VON: OPECHARROMAN, DATUM: 02.07.2019___*

    DATA: "lt_items_in TYPE TABLE OF /bitmym/cl_srep_srv_vr_mpc_ext=>ts_bookingitem, "HS# 013195
      lt_sitems TYPE /sopromet/ritems_tab,
      lt_map    TYPE /sopromet/ty_tree_map_tab.             "HS# 013195

    FIELD-SYMBOLS: <item_in> TYPE any,
                   <map> TYPE /sopromet/ty_tree_map,
                   <sitem>   TYPE /sopromet/ritems_wa.

    CHECK ct_items IS NOT INITIAL.

*    CREATE OBJECT go_act_reservation.                      "HS# 013195

*   Start HS# 013195 -->
*   Read single item node to add single item components
    go_tree_case->get_property( EXPORTING i_feld = 'GT_NODE_MAP' IMPORTING e_value = lt_map ).
    CHECK lt_map IS NOT INITIAL.
    READ TABLE lt_map ASSIGNING <map> WITH KEY kzsir = abap_true.
    CHECK sy-subrc EQ 0.
    go_act_reservation = <map>-objkey.
*   End HS# 013195 <--

*    LOOP AT lt_items_in ASSIGNING <item_in>.               "HS# 013195
    LOOP AT ct_items ASSIGNING <item_in>.                   "HS# 013195
      APPEND INITIAL LINE TO lt_sitems ASSIGNING <sitem>.
      MOVE-CORRESPONDING <item_in> TO <sitem>.
    ENDLOOP.

    set_gt_single_items( it_single = lt_sitems ).

*___Execute ATP of booking items
*-> Check

  ENDMETHOD.


  METHOD UI5_S4H_CREATE_BOOKING.
*____HS# 012010, VON: MKnauer, DATUM: 12.10.2017___*

    DATA: lo_case TYPE REF TO /bitmym/cl_case.

*___Create CASE Object
    lo_case = /bitmym/cl_case=>create( io_ui5 = io_ui5 ).

*___Start processing
    lo_case->ui5_s4h_create_booking_int( IMPORTING es_data = es_data ).


  ENDMETHOD.


  method ENH_ATP_ACTIVE.
*____HS# 014944, VON: TKERN, DATUM: 17.02.2021___*

    DATA: lo_rstyp  TYPE REF TO /sopromet/cl_l_res_type,
          ls_rstypo TYPE /sopromet/rstypo.

    e_check = abap_false.

    CHECK gs_comwa-rstyp IS NOT INITIAL.

    CREATE OBJECT lo_rstyp
      EXPORTING
        i_rstyp = gs_comwa-rstyp.

    CHECK lo_rstyp IS BOUND.

    ls_rstypo = lo_rstyp->get_prop_res_type_vkorg( i_comwa = gs_comwa ).

    IF NOT ls_rstypo-enh_set_atp IS INITIAL.
      e_check = abap_true.
    ENDIF.

  endmethod.


